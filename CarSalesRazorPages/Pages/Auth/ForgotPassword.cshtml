@page
@model CarSalesRazorPages.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<!-- Page Title Banner -->
<div class="py-4 mb-5 text-center" style="background-color: #f7f7f7; border-bottom: 1px solid #eee;">
    <h3 class="fw-bold m-0 text-secondary" style="letter-spacing: 1px;">MY ACCOUNT</h3>
</div>

<div class="container mb-5 pb-5">
    <div class="row">
        <div class="col-lg-6 col-md-8">
            <p class="text-muted mb-4">
                Quên mật khẩu? Vui lòng nhập địa chỉ email. Bạn sẽ nhận được một mã OTP tạo mật khẩu mới qua email.
            </p>
            
            @if (Model.ErrorMessage != null)
            {
                <div class="alert alert-danger p-2 mb-4">@Model.ErrorMessage</div>
            }

            <form method="post">
                <div class="form-group mb-4">
                    <label class="fw-bold mb-2" style="font-size: 14px;">Địa chỉ email *</label>
                    <input class="form-control rounded-0 p-2" name="Email" type="email" required />
                </div>
                
                <button type="submit" class="btn text-white fw-bold rounded-0 px-4 py-2" style="background-color: #405471; letter-spacing: 1px;">
                    ĐẶT LẠI MẬT KHẨU
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
