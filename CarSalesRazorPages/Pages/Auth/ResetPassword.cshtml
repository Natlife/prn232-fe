@page
@model CarSalesRazorPages.Pages.Auth.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-lg">
            <div class="card-header bg-info text-white text-center">
                <h3 class="font-weight-light my-2">Đặt lại mật khẩu mới</h3>
            </div>
            <div class="card-body">
                <p class="text-muted text-center">Nhập mã OTP đã được gửi vào Email <b>@Model.Email</b> cùng với mật khẩu mới.</p>
                
                @if (Model.ErrorMessage != null)
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                <form method="post">
                    <input type="hidden" name="Email" value="@Model.Email" />
                    
                    <div class="form-group mb-3">
                        <label class="small mb-1">Mã OTP (6 số)</label>
                        <input class="form-control" name="Otp" placeholder="Nhập mã OTP" maxlength="6" />
                    </div>
                    
                    <div class="form-group mb-3">
                        <label class="small mb-1">Mật khẩu mới</label>
                        <input class="form-control" name="NewPassword" type="password" placeholder="Nhập mật khẩu mới" />
                    </div>

                    <div class="form-group mt-4 mb-0 text-center">
                        <button type="submit" class="btn btn-info text-white w-100">Đổi mật khẩu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
