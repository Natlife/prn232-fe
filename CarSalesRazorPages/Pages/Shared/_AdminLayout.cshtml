<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Group7 Admin Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Outfit', 'Inter', sans-serif;
            background-color: #f8fafc;
            overflow-x: hidden;
        }

        /* Sidebar Styles */
        .admin-sidebar {
            width: 280px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #0f172a;
            color: #e2e8f0;
            z-index: 1000;
            transition: all 0.3s ease;
            box-shadow: 4px 0 10px rgba(0, 0, 0, 0.05);
            display: flex;
            flex-direction: column;
        }

        .admin-brand {
            padding: 1.5rem 1.5rem;
            border-bottom: 1px solid #1e293b;
        }

        .admin-menu {
            flex-grow: 1;
            padding: 1.5rem 0;
            overflow-y: auto;
        }

        .admin-menu-item {
            display: flex;
            align-items: center;
            padding: 0.75rem 1.5rem;
            color: #94a3b8;
            text-decoration: none;
            transition: all 0.2s ease;
            border-left: 4px solid transparent;
            font-weight: 500;
        }

        .admin-menu-item:hover {
            color: #f8fafc;
            background-color: #1e293b;
        }

        .admin-menu-item.active {
            color: #ffc107;
            background-color: #1e293b;
            border-left-color: #ffc107;
        }

        .admin-menu-item i {
            font-size: 1.25rem;
            margin-right: 0.75rem;
            transition: transform 0.2s ease;
        }

        .admin-menu-item:hover i {
            transform: scale(1.1);
        }

        /* Main Content Wrapper */
        .admin-wrapper {
            margin-left: 280px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease;
        }

        /* Header Navbar */
        .admin-header {
            height: 70px;
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .admin-content {
            padding: 2rem;
            flex-grow: 1;
        }

        /* Responsive styling */
        @@media (max-width: 991.98px) {
            .admin-sidebar {
                transform: translateX(-280px);
            }
            .admin-sidebar.show {
                transform: translateX(0);
            }
            .admin-wrapper {
                margin-left: 0;
            }
            .admin-header-toggle {
                display: block !important;
            }
        }

        .admin-header-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: #334155;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <aside class="admin-sidebar" id="adminSidebar">
        <div class="admin-brand d-flex align-items-center justify-content-between">
            <a asp-page="/Index" class="text-white text-decoration-none d-flex align-items-center">
                <i class="bi bi-shield-lock-fill text-warning fs-3 me-2"></i>
                <div class="lh-1">
                    <h5 class="m-0 fw-bold text-white">GROUP7</h5>
                    <small class="text-secondary fw-bold" style="font-size: 9px; letter-spacing: 1px;">DASHBOARD</small>
                </div>
            </a>
            <button class="btn btn-link text-white d-lg-none p-0" onclick="toggleSidebar()"><i class="bi bi-x-lg"></i></button>
        </div>
        
        <div class="admin-menu">
            <div class="px-4 py-2 text-uppercase text-secondary fw-bold" style="font-size: 10px; letter-spacing: 1px;">Quản lý hệ thống</div>
            
            <a class="admin-menu-item" href="/Admin/Cars">
                <i class="bi bi-car-front-fill text-primary"></i> Quản lý ô tô
            </a>
            
            <a class="admin-menu-item" href="/Admin/Captchas">
                <i class="bi bi-key-fill text-danger"></i> Gen mã captcha
            </a>

            <a class="admin-menu-item" asp-page="/Parts/Manage">
                <i class="bi bi-tools text-warning"></i> Quản lý phụ tùng
            </a>
            
            <a class="admin-menu-item" asp-page="/PartOrders/Manage">
                <i class="bi bi-file-earmark-text text-info"></i> Quản lý đơn phụ tùng
            </a>
            
            <a class="admin-menu-item" asp-page="/MaintenancePackages/Manage">
                <i class="bi bi-ui-checks-grid text-success"></i> Quản lý gói bảo dưỡng
            </a>

            <a class="admin-menu-item" href="/Admin/MaintenanceAppointments">
                <i class="bi bi-calendar-check text-primary"></i> Lịch hẹn bảo dưỡng
            </a>

            <div class="px-4 py-3 border-top border-secondary border-opacity-10 text-uppercase text-secondary fw-bold" style="font-size: 10px; letter-spacing: 1px; margin-top: 1rem;">Giao diện</div>
            
        </div>

        <div class="p-3 border-top border-secondary border-opacity-10 text-center">
            <small class="text-secondary" style="font-size: 11px;">Group7 &copy; 2026 Admin Panel</small>
        </div>
    </aside>

    <!-- Right-Side Wrapper -->
    <div class="admin-wrapper">
        <!-- Top Header -->
        <header class="admin-header shadow-sm">
            <div class="d-flex align-items-center">
                <button class="admin-header-toggle me-3" onclick="toggleSidebar()">
                    <i class="bi bi-list"></i>
                </button>
                <h5 class="fw-bold text-slate-800 m-0 d-none d-md-block">Giao diện Quản trị</h5>
            </div>
            
            <div class="d-flex align-items-center">
                <span class="me-3 d-none d-sm-inline-block">Xin chào, <b class="text-dark">@User.Identity?.Name</b>!</span>
                <a class="btn btn-outline-danger btn-sm fw-bold border-2 rounded-pill px-3" asp-page="/Auth/Logout">
                    <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                </a>
            </div>
        </header>

        <!-- Main Body -->
        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleSidebar() {
            var sidebar = document.getElementById("adminSidebar");
            sidebar.classList.toggle("show");
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
