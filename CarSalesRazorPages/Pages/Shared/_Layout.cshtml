<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Group7</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="bg-light">
    <header>
        <!-- Top Bar -->
        <div class="bg-dark text-white py-1" style="font-size: 13px; border-bottom: 1px solid #333;">
            <div class="container d-flex justify-content-between align-items-center">
                <div>
                    <span>Chào mừng bạn tới <span class="text-danger fw-bold">Group7</span></span>
                </div>
                <div class="d-flex align-items-center">
                    <!-- Shopping Cart Icon Link -->
                    <a asp-page="/PartOrders/Cart" class="text-white text-decoration-none me-4 position-relative">
                        <i class="bi bi-cart3 fs-5"></i>
                        @{
                            var cartJson = Context.Session.GetString("PartCart");
                            var cartCount = string.IsNullOrEmpty(cartJson) ? 0 : System.Text.Json.JsonSerializer.Deserialize<List<CarSalesRazorPages.Models.CartItemViewModel>>(cartJson)!.Sum(x => x.Quantity);
                        }
                        <span id="navbarCartCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger @(cartCount > 0 ? "" : "d-none")" style="font-size: 9px; padding: 3px 6px;">
                            @cartCount
                        </span>
                    </a>

                    <!-- User authentication / History Links -->
                    @if (User.Identity!.IsAuthenticated)
                    {
                        @if (!User.IsInRole("Admin"))
                        {
                            <a class="text-white text-decoration-none me-3" asp-page="/PartOrders/MyOrders"><i class="bi bi-clock-history me-1"></i>Lịch sử mua</a>
                        }
                        <span class="me-3">Xin chào, <b>@User.Identity.Name</b>!</span>
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="text-warning text-decoration-none fw-bold me-3" asp-page="/Admin/Cars"><i class="bi bi-gear-fill me-1"></i>Trang Quản Trị</a>
                        }
                        <a class="text-white text-decoration-none" asp-page="/Auth/Logout">Đăng xuất</a>
                    }
                    else
                    {
                        <a class="text-white text-decoration-none" href="#" data-bs-toggle="modal" data-bs-target="#loginModal">Đăng nhập</a>
                        <span class="mx-2">/</span>
                        <a class="text-white text-decoration-none" href="#" data-bs-toggle="modal" data-bs-target="#registerModal">Đăng ký</a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- Sticky Header Wrapper -->
    <div class="sticky-top shadow-sm" style="z-index: 1040;">
            <!-- Middle Bar (Logo & Search) -->
            <div class="bg-dark text-white py-3 border-bottom" style="border-color: #333 !important;">
                <div class="container d-flex justify-content-between align-items-center">
                    <!-- Logo -->
                    <a asp-page="/Index" class="text-white text-decoration-none d-flex align-items-center" style="width: 250px;">
                        <i class="bi bi-car-front-fill fs-1 me-2 text-light"></i>
                        <div class="lh-1">
                            <h2 class="m-0 fw-bold fst-italic" style="font-family: 'Arial Black', sans-serif; letter-spacing: -1px;">
                                Group<span class="text-light">7</span>
                            </h2>
                            <small class="text-secondary fw-bold" style="letter-spacing: 2px; font-size: 10px;">ECO DRIVE</small>
                        </div>
                    </a>
                    
                    <!-- Search Bar -->
                    <div class="flex-grow-1 mx-4">
                        <div class="input-group" style="max-width: 600px; margin: 0 auto;">
                            <input type="text" class="form-control rounded-0 py-2 border-0" placeholder="Bạn đang tìm sản phẩm nào...">
                            <button class="btn btn-light rounded-0 border-0 px-3" type="button"><i class="bi bi-search text-secondary"></i></button>
                        </div>
                    </div>
                    
                    <!-- Empty Space for balance -->
                    <div style="width: 250px;"></div>
                </div>
            </div>

            <!-- Yellow Navigation Bar -->
            <nav class="navbar navbar-expand-lg navbar-light p-0" style="background-color: #ffc107;">
                <div class="container">
                    <button class="navbar-toggler my-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-bold" style="font-size: 14px;">
                            <li class="nav-item bg-dark">
                                <a class="nav-link text-danger px-4 py-3" asp-page="/Index">
                                    <i class="bi bi-house-door-fill me-1"></i>TRANG CHỦ
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark px-4 py-3 hover-bg-warning" href="#">GIỚI THIỆU</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link text-dark px-4 py-3 hover-bg-warning dropdown-toggle" href="#" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    SẢN PHẨM <i class="bi bi-chevron-down ms-1" style="font-size: 10px;"></i>
                                </a>
                                <ul class="dropdown-menu border-0 rounded-0 shadow-sm m-0" aria-labelledby="navbarDropdownMenuLink" style="background-color: #ffc107;">
                                    <li><a class="dropdown-item text-dark hover-bg-warning py-2 px-4 fw-bold" asp-page="/Cars/Index">Ô TÔ</a></li>
                                    <li><a class="dropdown-item text-dark hover-bg-warning py-2 px-4 fw-bold" asp-page="/Parts/Index">PHỤ TÙNG</a></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-dark hover-bg-warning py-2 px-4 fw-bold" asp-page="/Parts/Manage"><i class="bi bi-speedometer2 me-1"></i>TRANG QUẢN TRỊ</a></li>
                                    }
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark px-4 py-3 hover-bg-warning" href="#">TIN TỨC</a>
                            </li>
                            <li class="nav-item">
                                @if (User.IsInRole("Admin"))
                                {
                                    <a class="nav-link text-dark px-4 py-3 hover-bg-warning" asp-page="/MaintenancePackages/Manage">BẢO DƯỠNG (ADMIN)</a>
                                }
                                else
                                {
                                    <a class="nav-link text-dark px-4 py-3 hover-bg-warning" asp-page="/Maintenance/Index">BẢO DƯỠNG</a>
                                }
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark px-4 py-3 hover-bg-warning" href="#">LIÊN HỆ</a>
                            </li>
                            @if (User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark px-4 py-3 hover-bg-warning" asp-page="/Cars/History">LỊCH SỬ MUA/CỌC</a>
                                </li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark px-4 py-3 hover-bg-warning" asp-page="/Admin/Cars">QUẢN LÝ XE</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark px-4 py-3 hover-bg-warning" asp-page="/Admin/Captchas">QUẢN LÝ CAPTCHA</a>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </div>
    </div>

    <!-- Floating Contact Buttons -->
    <div class="floating-buttons">
        <a href="#" class="btn btn-warning rounded-pill mb-2 shadow fw-bold d-block text-start text-dark border-0" style="background-color: #fca311;">
            <i class="bi bi-chat-dots-fill me-2"></i>Chat Zalo
        </a>
        <a href="#" class="btn btn-primary rounded-pill mb-2 shadow fw-bold d-block text-start border-0" style="background-color: #0d6efd;">
            <i class="bi bi-facebook me-2"></i>Chat Facebook
        </a>
        <a href="tel:0359492991" class="btn btn-danger rounded-pill shadow fw-bold d-block text-start border-0" style="background-color: #dc3545;">
            <i class="bi bi-telephone-fill me-2"></i>Hotline: (+84) 0359492991
        </a>
    </div>

    <!-- Main Content -->
    <div class="container-fluid p-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="text-white pt-5 pb-3 mt-5" style="background-color: #262626; font-size: 14px;">
        <div class="container">
            <div class="row">
                <!-- Column 1: Logo & Info -->
                <div class="col-lg-5 col-md-12 mb-4">
                    <a asp-page="/Index" class="text-white text-decoration-none d-flex align-items-center mb-3">
                        <i class="bi bi-car-front-fill fs-1 me-2 text-light"></i>
                        <div class="lh-1">
                            <h2 class="m-0 fw-bold fst-italic" style="font-family: 'Arial Black', sans-serif; letter-spacing: -1px;">
                                Group<span class="text-light">7</span>
                            </h2>
                            <small class="text-secondary fw-bold" style="letter-spacing: 2px; font-size: 10px;">ECO DRIVE</small>
                        </div>
                    </a>
                    <p class="text-secondary pe-lg-5 mb-4 lh-lg">
                        Xe điện Group7 được thành lập với niềm đam mê và khát vọng thành công trong lĩnh vực Thể thao. Chúng tôi đã và đang khẳng định được vị trí hàng đầu bằng những sản phẩm tốt nhất.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="btn btn-danger rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px; background-color: #f00; cursor: default;"><i class="bi bi-facebook"></i></span>
                        <span class="btn btn-danger rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px; background-color: #f00; cursor: default;"><i class="bi bi-tiktok"></i></span>
                        <span class="btn btn-danger rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px; background-color: #f00; cursor: default;"><i class="bi bi-envelope-fill"></i></span>
                        <span class="btn btn-danger rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px; background-color: #f00; cursor: default;"><i class="bi bi-telephone-fill"></i></span>
                    </div>
                </div>

                <!-- Column 2: Liên hệ -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <h5 class="fw-bold mb-4">Liên hệ</h5>
                    <ul class="list-unstyled text-secondary lh-lg">
                        <li class="mb-3 d-flex align-items-center">
                            <i class="bi bi-envelope-fill me-3 fs-5 text-white"></i>
                            <span>dinhnhatquan0311@gmail.com</span>
                        </li>
                        <li class="mb-3 d-flex align-items-center">
                            <i class="bi bi-telephone-fill me-3 fs-5 text-white"></i>
                            <span>0359492991</span>
                        </li>
                    </ul>
                </div>

                <!-- Column 3: Dịch vụ -->
                <div class="col-lg-3 col-md-6 mb-4">
                    <h5 class="fw-bold mb-4">Dịch vụ</h5>
                    <ul class="list-unstyled text-secondary lh-lg">
                        <li class="mb-2"><a href="#" class="text-secondary text-decoration-none hover-text-white d-flex align-items-center"><i class="bi bi-chevron-right small me-2"></i>Giới thiệu</a></li>
                        <li class="mb-2"><a href="#" class="text-secondary text-decoration-none hover-text-white d-flex align-items-center"><i class="bi bi-chevron-right small me-2"></i>Sản phẩm</a></li>
                        <li class="mb-2"><a href="#" class="text-secondary text-decoration-none hover-text-white d-flex align-items-center"><i class="bi bi-chevron-right small me-2"></i>Tin tức</a></li>
                        <li class="mb-2"><a href="#" class="text-secondary text-decoration-none hover-text-white d-flex align-items-center"><i class="bi bi-chevron-right small me-2"></i>Liên hệ</a></li>
                    </ul>
                </div>
            </div>
            
            <!-- Bottom Copyright -->
            <div class="mt-4 pt-4 border-top text-center text-secondary" style="font-size: 13px; border-color: #333 !important;">
                Copyright &copy; 2026 ECO DRIVE Group7 . All rights reserved. Web Design by groub7
            </div>
        </div>
    </footer>

    <!-- Login Modal -->
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white border-0">
                    <h5 class="modal-title" id="loginModalLabel">Đăng nhập</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="loginError" class="alert alert-danger" style="display: none;"></div>
                    <form id="loginForm">
                        <div class="form-group mb-3">
                            <label class="small mb-1">Email</label>
                            <input class="form-control" name="Email" type="email" required placeholder="Nhập địa chỉ email" />
                        </div>
                        <div class="form-group mb-3">
                            <label class="small mb-1">Mật khẩu</label>
                            <div class="input-group">
                                <input class="form-control" name="Password" type="password" id="modalLoginPassword" required placeholder="Nhập mật khẩu" />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('modalLoginPassword')">👁️</button>
                            </div>
                        </div>
                        <div class="form-group d-flex align-items-center justify-content-between mt-4 mb-0">
                            <a class="small text-decoration-none" asp-page="/Auth/ForgotPassword">Quên mật khẩu?</a>
                            <button type="submit" class="btn btn-primary px-4">Đăng nhập</button>
                        </div>
                    </form>
                </div>
                <div class="modal-footer justify-content-center bg-light border-0">
                    <div class="small"><a href="#" data-bs-toggle="modal" data-bs-target="#registerModal" data-bs-dismiss="modal" class="text-decoration-none">Chưa có tài khoản? Đăng ký ngay!</a></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Register Modal -->
    <div class="modal fade" id="registerModal" tabindex="-1" aria-labelledby="registerModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-success text-white border-0">
                    <h5 class="modal-title" id="registerModalLabel">Tạo tài khoản mới</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="registerError" class="alert alert-danger" style="display: none;"></div>
                    <form id="registerForm">
                        <div class="form-group mb-3">
                            <label class="small mb-1">Họ và tên</label>
                            <input class="form-control" name="FullName" required placeholder="Nhập họ và tên" />
                        </div>
                        <div class="form-group mb-3">
                            <label class="small mb-1">Email</label>
                            <input class="form-control" name="Email" type="email" required placeholder="Nhập email" />
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-group mb-3 mb-md-0">
                                    <label class="small mb-1">Mật khẩu</label>
                                    <div class="input-group">
                                        <input class="form-control" name="Password" type="password" id="modalRegPassword" required placeholder="Mật khẩu" />
                                        <button class="btn btn-outline-secondary px-2" type="button" onclick="togglePassword('modalRegPassword')">👁️</button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="small mb-1">Xác nhận mật khẩu</label>
                                    <div class="input-group">
                                        <input class="form-control" name="ConfirmPassword" type="password" id="modalRegConfirmPassword" required placeholder="Xác nhận" />
                                        <button class="btn btn-outline-secondary px-2" type="button" onclick="togglePassword('modalRegConfirmPassword')">👁️</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group mt-4 mb-0 text-center">
                            <button type="submit" class="btn btn-success btn-block w-100">Đăng ký tài khoản</button>
                        </div>
                    </form>
                </div>
                <div class="modal-footer justify-content-center bg-light border-0">
                    <div class="small"><a href="#" data-bs-toggle="modal" data-bs-target="#loginModal" data-bs-dismiss="modal" class="text-decoration-none">Đã có tài khoản? Đi đến đăng nhập</a></div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function togglePassword(inputId) {
            var input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
            } else {
                input.type = "password";
            }
        }

        // AJAX Handle Login
        document.getElementById('loginForm')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            const btn = form.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang đăng nhập...';

            const formData = new FormData(form);
            try {
                const res = await fetch('/Auth/Login', { method: 'POST', body: formData });
                const result = await res.json();
                if (result.success) {
                    window.location.href = result.redirectUrl || '/';
                } else {
                    const err = document.getElementById('loginError');
                    err.innerText = result.message;
                    err.style.display = 'block';
                    btn.disabled = false;
                    btn.innerText = 'Đăng nhập';
                }
            } catch (ex) {
                document.getElementById('loginError').innerText = "Lỗi kết nối đến máy chủ.";
                document.getElementById('loginError').style.display = 'block';
                btn.disabled = false;
                btn.innerText = 'Đăng nhập';
            }
        });

        // AJAX Handle Register
        document.getElementById('registerForm')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            
            if (form.Password.value !== form.ConfirmPassword.value) {
                const err = document.getElementById('registerError');
                err.innerText = "Mật khẩu xác nhận không khớp.";
                err.style.display = 'block';
                return;
            }

            const btn = form.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang đăng ký...';

            const formData = new FormData(form);
            try {
                const res = await fetch('/Auth/Register', { method: 'POST', body: formData });
                const result = await res.json();
                if (result.success) {
                    window.location.href = '/Auth/VerifyEmail?email=' + encodeURIComponent(result.email);
                } else {
                    const err = document.getElementById('registerError');
                    err.innerText = result.message;
                    err.style.display = 'block';
                    btn.disabled = false;
                    btn.innerText = 'Đăng ký tài khoản';
                }
            } catch (ex) {
                document.getElementById('registerError').innerText = "Lỗi kết nối đến máy chủ.";
                document.getElementById('registerError').style.display = 'block';
                btn.disabled = false;
                btn.innerText = 'Đăng ký tài khoản';
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>