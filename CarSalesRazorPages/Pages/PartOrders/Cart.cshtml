@page
@model CarSalesRazorPages.Pages.PartOrders.CartModel
@{
    ViewData["Title"] = "Giỏ hàng Phụ tùng";
    var totalAmount = Model.Cart.Sum(x => x.Price * x.Quantity);
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="fw-bold text-dark border-start border-warning border-4 ps-3 m-0" style="font-family: 'Outfit', sans-serif;">
                GIỎ HÀNG CỦA BẠN
            </h1>
            <p class="text-secondary m-0 ps-3">Quản lý các phụ tùng bạn muốn đặt mua</p>
        </div>
    </div>

    @Html.AntiForgeryToken()

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        </div>
    }

    @if (Model.Cart == null || !Model.Cart.Any())
    {
        <div class="text-center py-5 bg-white shadow-sm rounded-3">
            <i class="bi bi-cart-x text-secondary" style="font-size: 5rem;"></i>
            <h4 class="mt-3 fw-bold text-dark">Giỏ hàng của bạn đang trống!</h4>
            <p class="text-secondary">Hãy quay lại cửa hàng để lựa chọn các sản phẩm chất lượng cao.</p>
            <a asp-page="/Parts/Index" class="btn btn-warning fw-bold border-0 px-4 py-2 mt-2 text-dark" style="background-color: #ffc107;">Quay lại mua sắm</a>
        </div>
    }
    else
    {
        <div class="row">
            <!-- Left Side: Table of items -->
            <div class="col-lg-8 mb-4">
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark text-white">
                                <tr>
                                    <th class="ps-4">Sản phẩm</th>
                                    <th>Giá bán</th>
                                    <th>Số lượng</th>
                                    <th>Thành tiền</th>
                                    <th class="text-end pe-4">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Cart)
                                {
                                    var displayImageUrl = string.IsNullOrWhiteSpace(item.ImageUrl) 
                                        ? "https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=80&q=80" 
                                        : item.ImageUrl;
                                        
                                    <tr id="cart-row-@item.PartId">
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <img src="@displayImageUrl" alt="@item.PartName" class="rounded object-fit-cover me-3" style="width: 60px; height: 60px;" />
                                                <div>
                                                    <div class="fw-bold text-dark text-truncate" style="max-width: 250px;">@item.PartName</div>
                                                    <small class="text-secondary" style="font-family: monospace;">@item.PartCode</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="fw-bold">@item.Price.ToString("N0") đ</td>
                                        <td>
                                            <input type="number" class="form-control text-center qty-input" 
                                                   style="width: 80px;" 
                                                   value="@item.Quantity" 
                                                   min="1" 
                                                   max="@item.StockQuantity"
                                                   onchange="updateQty(@item.PartId, this.value)" />
                                            <small class="text-muted d-block mt-1" style="font-size: 10px;">Tối đa: @item.StockQuantity</small>
                                        </td>
                                        <td class="fw-bold text-danger subtotal-field" id="subtotal-@item.PartId">
                                            @((item.Price * item.Quantity).ToString("N0")) đ
                                        </td>
                                        <td class="text-end pe-4">
                                            <button class="btn btn-link text-danger p-0" onclick="removeItem(@item.PartId)">
                                                <i class="bi bi-trash-fill fs-5"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right Side: Order Summary -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-4">
                        <h4 class="fw-bold text-dark mb-4 pb-2 border-bottom">TỔNG ĐƠN HÀNG</h4>
                        <div class="d-flex justify-content-between mb-3 fs-5">
                            <span class="text-secondary">Tổng cộng:</span>
                            <span class="fw-bold text-danger" id="cart-total">@totalAmount.ToString("N0") đ</span>
                        </div>
                        <p class="text-muted small">Phí vận chuyển sẽ được hiển thị khi kiểm tra thông tin địa chỉ giao hàng.</p>
                        
                        <div class="d-grid gap-2 mt-4">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <a asp-page="/PartOrders/Checkout" class="btn btn-warning py-3 fw-bold border-0 text-dark" style="background-color: #ffc107;">
                                    TIẾN HÀNH THANH TOÁN <i class="bi bi-arrow-right-short ms-1"></i>
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-warning py-3 fw-bold border-0 text-dark" style="background-color: #ffc107;" data-bs-toggle="modal" data-bs-target="#loginModal">
                                    ĐĂNG NHẬP ĐỂ THANH TOÁN <i class="bi bi-lock-fill ms-1"></i>
                                </button>
                            }
                            <a asp-page="/Parts/Index" class="btn btn-light py-2 fw-bold text-secondary">
                                <i class="bi bi-chevron-left me-1"></i> TIẾP TỤC MUA SẮM
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function updateQty(partId, quantity) {
            if (quantity <= 0) {
                removeItem(partId);
                return;
            }

            $.ajax({
                url: '/PartOrders/Checkout?handler=UpdateCart',
                type: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                data: { partId: partId, quantity: quantity },
                success: function(res) {
                    if (res.success) {
                        $('#subtotal-' + partId).text(res.subTotal);
                        $('#cart-total').text(res.cartTotal);
                    } else {
                        Swal.fire('Lỗi!', res.message, 'error').then(() => {
                            location.reload();
                        });
                    }
                },
                error: function() {
                    Swal.fire('Lỗi!', 'Lỗi kết nối máy chủ.', 'error');
                }
            });
        }

        function removeItem(partId) {
            Swal.fire({
                title: 'Xóa khỏi giỏ hàng?',
                text: "Bạn muốn xóa sản phẩm này ra khỏi giỏ hàng?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#262626',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/PartOrders/Checkout?handler=RemoveFromCart',
                        type: 'POST',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        data: { partId: partId },
                        success: function(res) {
                            if (res.success) {
                                $('#cart-row-' + partId).remove();
                                $('#cart-total').text(res.cartTotal);
                                updateNavbarCartCount(res.cartCount);
                                
                                if (res.cartCount === 0) {
                                    location.reload();
                                }
                            } else {
                                Swal.fire('Thất bại!', res.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Lỗi!', 'Lỗi kết nối mạng.', 'error');
                        }
                    });
                }
            });
        }

        function updateNavbarCartCount(count) {
            var badge = $('#navbarCartCount');
            if (badge.length) {
                badge.text(count);
                if (count > 0) {
                    badge.removeClass('d-none');
                } else {
                    badge.addClass('d-none');
                }
            }
        }
    </script>
}

<style>
    .object-fit-cover {
        object-fit: cover;
    }
</style>
