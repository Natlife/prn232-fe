@page
@model CarSalesRazorPages.Pages.Admin.CaptchasModel
@{ 
    Layout = "_AdminLayout"; 
    ViewData["Title"] = "Quản lý Captcha Đặt cọc & Mua xe";
}

<div class="container py-5" style="min-height: 80vh;">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none text-dark">Trang chủ</a></li>
            <li class="breadcrumb-item active text-warning fw-bold" aria-current="page">Quản lý Captcha</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">🔑 Quản lý Captcha Đặt cọc / Mua đứt</h2>
            <p class="text-muted mb-0">Sinh mã xác nhận bảo mật để trao đổi trực tiếp với khách hàng</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow rounded-4 p-4 sticky-lg-top" style="top: 100px;">
                <h4 class="fw-bold text-dark mb-3"><i class="bi bi-magic text-warning me-2"></i>Sinh mã mới</h4>
                <p class="text-muted small mb-4">Để trống ô "Mã thủ công" để hệ thống tự sinh ngẫu nhiên 6 ký tự. Mã sẽ tự động chuyển thành CHỮ HOA.</p>

                <form method="post" asp-page-handler="GenerateCaptcha">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary" style="font-size: 13px;">Chọn xe ô tô *</label>
                        <select name="carId" class="form-select rounded-3" required>
                            <option value="">-- Chọn xe --</option>
                            @foreach (var car in Model.Cars)
                            {
                                <option value="@car.CarId">@car.CarName — @car.Status</option>
                            }
                        </select>
                        @if (!Model.Cars.Any())
                        {
                            <div class="text-danger small mt-1"><i class="bi bi-info-circle-fill me-1"></i>Không có xe khả dụng/đặt cọc.</div>
                        }
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary" style="font-size: 13px;">Mã thủ công (Tùy chọn)</label>
                        <input name="code" type="text" class="form-control rounded-3 text-uppercase font-monospace" placeholder="VD: VIP2026" maxlength="20" />
                    </div>
                    <button type="submit" class="btn btn-dark w-100 fw-bold py-2 rounded-3" @(Model.Cars.Any() ? "" : "disabled")>
                        <i class="bi bi-cpu-fill me-2"></i>Sinh mã xác thực
                    </button>
                </form>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <div class="p-3 bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold"><i class="bi bi-list-stars me-2"></i>Danh sách mã hiện có</h5>
                    <span class="badge bg-secondary rounded-pill">@Model.Captchas.Count mã</span>
                </div>

                @if (!Model.Captchas.Any())
                {
                    <div class="text-center py-5">
                        <span class="display-3">🔑</span>
                        <h5 class="fw-bold text-dark mt-3 mb-1">Chưa có mã captcha nào</h5>
                        <p class="text-muted small">Hãy sử dụng form bên trái để tạo mã đầu tiên.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="py-3 px-4" style="font-size: 13px;">Mã</th>
                                    <th class="py-3" style="font-size: 13px;">Xe tương ứng</th>
                                    <th class="py-3" style="font-size: 13px;">Trạng thái</th>
                                    <th class="py-3" style="font-size: 13px;">Ngày tạo</th>
                                    <th class="py-3 px-4" style="font-size: 13px;">Ngày dùng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var captcha in Model.Captchas)
                                {
                                    <tr class="@(captcha.IsUsed ? "table-success" : "")">
                                        <td class="py-3 px-4">
                                            <span class="badge bg-dark text-warning font-monospace fs-6 px-3 py-2 rounded-2">
                                                @captcha.Code
                                            </span>
                                        </td>
                                        <td class="py-3">
                                            <div class="fw-bold text-dark">@(captcha.Car?.CarName ?? "N/A")</div>
                                            <div class="text-muted" style="font-size: 12px;">@(captcha.Car?.Model ?? "")</div>
                                        </td>
                                        <td class="py-3">
                                            @if (captcha.IsUsed)
                                            {
                                                <span class="badge bg-success rounded-pill px-3">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Đã dùng
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark rounded-pill px-3">
                                                    <i class="bi bi-hourglass-split me-1"></i>Chưa dùng
                                                </span>
                                            }
                                        </td>
                                        <td class="py-3 text-secondary" style="font-size: 13px;">
                                            @captcha.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td class="py-3 px-4 text-secondary" style="font-size: 13px;">
                                            @(captcha.UsedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
