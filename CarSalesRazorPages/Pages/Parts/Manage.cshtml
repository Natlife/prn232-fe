@page
@model CarSalesRazorPages.Pages.Parts.ManageModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Phụ tùng - Admin";
    var categories = Model.Categories;
}

<div class="container-fluid py-5 px-md-5">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="fw-bold text-dark border-start border-warning border-4 ps-3 m-0" style="font-family: 'Outfit', sans-serif;">
                QUẢN LÝ PHỤ TÙNG
            </h1>
            <p class="text-secondary m-0 ps-3">Danh sách toàn bộ phụ tùng trong hệ thống</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <button class="btn btn-success fw-bold border-0 px-4 py-2 me-2" onclick="openInventoryReceiptModal()">
                <i class="bi bi-box-seam-fill me-2"></i> NHẬP KHO PHỤ TÙNG
            </button>
        </div>
    </div>

    @Html.AntiForgeryToken()

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
        </div>
    }

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark text-white">
                        <tr>
                            <th class="ps-4">Hình ảnh</th>
                            <th>Mã phụ tùng</th>
                            <th>Tên phụ tùng</th>
                            <th>Danh mục</th>
                            <th>Thương hiệu</th>
                            <th>Giá bán</th>
                            <th>Tồn kho</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Parts == null || !Model.Parts.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-secondary">
                                    <i class="bi bi-tools fs-1 d-block mb-3"></i>
                                    Chưa có phụ tùng nào được tạo.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var part in Model.Parts)
                            {
                                var displayImageUrl = string.IsNullOrWhiteSpace(part.ImageUrl) 
                                    ? "https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=100&q=80" 
                                    : part.ImageUrl;
                                    
                                <tr>
                                    <td class="ps-4">
                                        <a asp-page="./History" asp-route-id="@part.PartId" title="Xem lịch sử nhập xuất">
                                            <img src="@displayImageUrl" alt="@part.PartName" class="rounded object-fit-cover" style="width: 60px; height: 60px;" />
                                        </a>
                                    </td>
                                    <td class="fw-bold text-secondary" style="font-family: monospace;">
                                        <a asp-page="./History" asp-route-id="@part.PartId" class="text-decoration-none text-secondary" title="Xem lịch sử nhập xuất">@part.PartCode</a>
                                    </td>
                                    <td>
                                        <a asp-page="./History" asp-route-id="@part.PartId" class="text-decoration-none text-dark" title="Xem lịch sử nhập xuất">
                                            <div class="fw-bold text-dark">@part.PartName</div>
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@part.Category?.CategoryName</span>
                                    </td>
                                    <td>@part.Brand</td>
                                    <td class="fw-bold text-danger">@part.Price.ToString("N0") đ</td>
                                    <td class="fw-bold">@part.Quantity</td>
                                    <td>
                                        @if (part.Status == "Available")
                                        {
                                            <span class="badge bg-success">Còn hàng</span>
                                        }
                                        else if (part.Status == "Out of Stock")
                                        {
                                            <span class="badge bg-warning text-dark">Hết hàng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Ngưng bán</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4 text-nowrap">
                                        <button class="btn btn-outline-primary btn-sm fw-bold" onclick="openEditModal(@part.PartId)">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap CRUD Modal -->
<div class="modal fade" id="partModal" tabindex="-1" aria-labelledby="partModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="partModalLabel">Thêm phụ tùng mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="modalError" class="alert alert-danger d-none"></div>
                <form id="partForm">
                    <input type="hidden" id="partId" value="0" />
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Tên phụ tùng <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="partName" required maxlength="150" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Mã phụ tùng <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="partCode" required maxlength="50" placeholder="VD: PT-LOPHIEU-MICH" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                            <select class="form-select" id="categoryId" required>
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.CategoryId">@cat.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Thương hiệu / Hãng</label>
                            <input type="text" class="form-control" id="brand" maxlength="100" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Giá bán (VND) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="price" required min="1000" max="1000000000" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Số lượng tồn kho <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="quantity" required min="0" max="100000" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Đường dẫn hình ảnh (URL)</label>
                            <input type="url" class="form-control" id="imageUrl" maxlength="500" placeholder="https://..." />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả phụ tùng</label>
                        <textarea class="form-control" id="description" rows="3" maxlength="1000"></textarea>
                    </div>

                    <div class="text-end mt-4">
                        <button type="button" class="btn btn-secondary px-4 fw-bold me-2" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-warning px-4 fw-bold text-dark" style="background-color: #ffc107;" id="btnSubmit">Lưu lại</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Inventory Receipt Modal -->
<div class="modal fade" id="inventoryReceiptModal" tabindex="-1" aria-labelledby="inventoryReceiptModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header bg-success text-white py-3">
                <h5 class="modal-title fw-bold" id="inventoryReceiptModalLabel">
                    <i class="bi bi-box-seam-fill me-2"></i> PHIẾU NHẬP KHO PHỤ TÙNG
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="card bg-light border-0 shadow-sm mb-4">
                    <div class="card-body p-3">
                        <label class="form-label fw-bold text-dark"><i class="bi bi-pencil-square me-1 text-success"></i> Ghi chú nhập kho</label>
                        <textarea class="form-control border-0 shadow-none bg-white" id="receiptNotes" rows="2" placeholder="Ví dụ: Nhập kho phụ tùng định kỳ..."></textarea>
                    </div>
                </div>

                <h6 class="fw-bold mb-3 text-secondary d-flex align-items-center">
                    <i class="bi bi-list-stars me-2 text-success"></i> DANH SÁCH CHI TIẾT NHẬP KHO
                </h6>
                <div class="table-responsive mb-3 border rounded shadow-xs">
                    <table class="table table-hover align-middle mb-0" style="font-size: 14px;" id="receiptItemsTable">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 25%;">Nhà cung cấp & Lọc</th>
                                <th style="width: 42%;">Phụ tùng / Mô tả</th>
                                <th style="width: 10%;">Số lượng</th>
                                <th style="width: 10%;">Giá nhập (VND)</th>
                                <th style="width: 10%;">Hạn sử dụng</th>
                                <th style="width: 3%;"></th>
                            </tr>
                        </thead>
                        <tbody id="receiptItemsTableBody">
                            <!-- Rows added dynamically via JS -->
                        </tbody>
                    </table>
                </div>
                
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <button type="button" class="btn btn-outline-success btn-sm fw-bold px-3 shadow-sm" onclick="addReceiptItemRow()">
                        <i class="bi bi-plus-circle-fill me-1"></i> THÊM DÒNG PHỤ TÙNG
                    </button>
                </div>

                <div class="text-end mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-secondary px-4 fw-bold me-2" data-bs-dismiss="modal">HỦY BỎ</button>
                    <button type="button" class="btn btn-success px-4 fw-bold shadow-sm" id="btnSaveReceipt" onclick="submitInventoryReceipt()">
                        <i class="bi bi-check-circle-fill me-1"></i> LƯU PHIẾU NHẬP
                    </button>
                </div>
            </div>
        </div>
    </div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let pkgModal = null;
        $(document).ready(function() {
            pkgModal = new bootstrap.Modal(document.getElementById('partModal'));
        });

        // Inventory Receipt flows
        let allPartsList = [];
        let allSuppliersList = [];
        let filteredPartsList = [];
        let receiptRowIndex = 0;
        let supplierOptionsHtml = '<option value="">-- Chọn nhà cung cấp * --</option>';
        let categoryFilterOptionsHtml = '<option value="">-- Tất cả danh mục --</option>';

        let categoryOptionsHtml = '<option value="">-- Chọn danh mục * --</option>';
        @foreach (var cat in Model.Categories)
        {
            <text>categoryOptionsHtml += `<option value="@cat.CategoryId">@cat.CategoryName</option>`;</text>
        }

        // Open Inventory Receipt Modal
        function openInventoryReceiptModal() {
            const modal = new bootstrap.Modal(document.getElementById('inventoryReceiptModal'));
            modal.show();

            const token = '@User.FindFirst("jwt_token")?.Value';

            if (allSuppliersList.length === 0) {
                fetch('http://localhost:5084/api/Suppliers', {
                    headers: { 'Authorization': 'Bearer ' + token }
                })
                .then(res => res.json())
                .then(suppliers => {
                    allSuppliersList = suppliers;

                    // Build supplier options
                    supplierOptionsHtml = '<option value="">-- Chọn nhà cung cấp * --</option>';
                    allSuppliersList.forEach(s => {
                        if (s.status === 'Active') {
                            supplierOptionsHtml += `<option value="${s.supplierId}">${s.supplierName}</option>`;
                        }
                    });

                    // Build category options
                    categoryFilterOptionsHtml = '<option value="">-- Tất cả danh mục --</option>';
                    @foreach (var cat in Model.Categories)
                    {
                        <text>categoryFilterOptionsHtml += `<option value="@cat.CategoryId">@cat.CategoryName</option>`;</text>
                    }

                    // Reset rows and selection
                    document.getElementById('receiptNotes').value = '';
                    document.getElementById('receiptItemsTableBody').innerHTML = '';
                    addReceiptItemRow();
                })
                .catch(err => {
                    Swal.fire('Lỗi', 'Không thể tải danh sách nhà cung cấp: ' + err.message, 'error');
                });
            } else {
                document.getElementById('receiptNotes').value = '';
                document.getElementById('receiptItemsTableBody').innerHTML = '';
                addReceiptItemRow();
            }
        }

        // Fetch parts list for a specific row based on row-level Supplier & Category filters
        function fetchPartsForRow(row, preselectPartId) {
            const supplierId = row.querySelector('.row-supplier-select')?.value || 0;
            const categoryId = row.querySelector('.row-category-filter')?.value || 0;
            const token = '@User.FindFirst("jwt_token")?.Value';
            
            const url = categoryId 
                ? `http://localhost:5084/api/Parts/filter?categoryId=${categoryId}&supplierId=${supplierId || 0}`
                : `http://localhost:5084/api/Parts`;
            
            const valInput = row.querySelector('.receipt-part-select-val');
            if (valInput && !preselectPartId) valInput.value = '';
            
            fetch(url, {
                headers: { 'Authorization': 'Bearer ' + token }
            })
            .then(res => res.json())
            .then(parts => {
                row.partsCache = parts.value || parts;
                populateSearchDropdownMenu(row);

                if (preselectPartId) {
                    const target = (row.partsCache || []).find(p => p.partId == preselectPartId);
                    if (target) {
                        const inputEl = row.querySelector('.search-part-input');
                        if (inputEl) {
                            inputEl.value = `${target.partCode} - ${target.partName}`;
                            onPartInputFromList(inputEl);
                        }
                    }
                }
            })
            .catch(err => {
                console.error("Lỗi tải phụ tùng cho dòng: ", err);
                row.partsCache = [];
            });
        }

        function populateSearchDropdownMenu(row) {
            const input = row.querySelector('.search-part-input');
            if (!input) return;
            const datalistId = input.getAttribute('list');
            let datalist = datalistId ? document.getElementById(datalistId) : null;
            if (!datalist) {
                datalist = row.querySelector('.parts-datalist');
            }

            const parts = row.partsCache || [];
            let html = '';
            parts.forEach(p => {
                if (p.status !== 'Inactive') {
                    const valStr = `${p.partCode} - ${p.partName}`;
                    html += `<option value="${valStr}">${p.partName} (Mã: ${p.partCode} | Tồn: ${p.quantity} | Giá: ${p.price.toLocaleString()}đ)</option>`;
                }
            });
            if (datalist) {
                datalist.innerHTML = html;
            }
        }

        function onPartInputFromList(inputEl) {
            const row = inputEl.closest('.receipt-item-row');
            if (!row) return;

            const hiddenValInput = row.querySelector('.receipt-part-select-val');
            const val = inputEl.value.trim();
            const parts = row.partsCache || [];

            const matched = parts.find(p => 
                (p.partCode + ' - ' + p.partName) === val ||
                p.partCode.toLowerCase() === val.toLowerCase() ||
                p.partName.toLowerCase() === val.toLowerCase() ||
                (p.partName + ' (' + p.partCode + ')') === val
            );

            if (matched) {
                hiddenValInput.value = matched.partId;
                const priceInput = row.querySelector('.import-price-input') || row.querySelector('.receipt-price');
                if (priceInput && (!priceInput.value || priceInput.value == 0)) {
                    priceInput.value = matched.price;
                }
            } else {
                hiddenValInput.value = '';
            }
        }


        // Add a new row to the receipt detail items table
        function addReceiptItemRow() {
            const tbody = document.getElementById('receiptItemsTableBody');
            const currentIndex = tbody.querySelectorAll('.receipt-item-row').length;

            const tr = document.createElement('tr');
            tr.className = 'receipt-item-row';
            tr.setAttribute('data-index', currentIndex);

            tr.innerHTML = `
                <td>
                    <div class="mb-2">
                        <label class="form-label mb-1 fw-bold text-secondary" style="font-size: 11px;">Nhà cung cấp <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm row-supplier-select" name="Items[${currentIndex}].SupplierId" required onchange="fetchPartsForRow(this.closest('.receipt-item-row'))">
                            ${supplierOptionsHtml}
                        </select>
                    </div>
                    <div>
                        <label class="form-label mb-1 fw-bold text-secondary" style="font-size: 11px;">Lọc danh mục</label>
                        <select class="form-select form-select-sm row-category-filter" onchange="fetchPartsForRow(this.closest('.receipt-item-row'))">
                            ${categoryFilterOptionsHtml}
                        </select>
                    </div>
                </td>
                <td>
                    <div class="d-flex gap-1 mb-2">
                        <button type="button" class="btn btn-xs btn-outline-primary fw-bold btn-existing-mode active" onclick="setRowMode(this, false)">
                            <i class="bi bi-list-check me-1"></i> Chọn sẵn
                        </button>
                        <button type="button" class="btn btn-xs btn-outline-success fw-bold btn-new-mode" onclick="setRowMode(this, true)">
                            <i class="bi bi-plus-circle me-1"></i> Tạo mới
                        </button>
                    </div>
                    
                    <input type="hidden" class="row-is-new-part" name="Items[${currentIndex}].IsNewPart" value="false" />

                    <!-- Selection mode container -->
                    <div class="existing-part-container position-relative">
                        <input type="text" class="form-control form-control-sm search-part-input" list="razorPartsDatalist_${currentIndex}" placeholder="Nhập tên hoặc mã phụ tùng..." onchange="onPartInputFromList(this)" oninput="onPartInputFromList(this)" autocomplete="off" />
                        <datalist id="razorPartsDatalist_${currentIndex}" class="parts-datalist"></datalist>
                        <input type="hidden" class="receipt-part-select-val" name="Items[${currentIndex}].PartId" />
                    </div>


                    <!-- Creation mode subform container -->
                    <div class="new-part-container d-none border rounded p-3 bg-light shadow-xs mt-2" style="font-size: 11px; border-left: 3px solid #198754 !important;">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="fw-bold mb-1" style="color: #444;">Tên phụ tùng mới <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm new-part-name" name="Items[${currentIndex}].NewPart.PartName" placeholder="Tên..." />
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold mb-1" style="color: #444;">Mã phụ tùng mới <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm new-part-code" name="Items[${currentIndex}].NewPart.PartCode" placeholder="Mã..." />
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold mb-1" style="color: #444;">Danh mục *</label>
                                <select class="form-select form-select-sm new-part-category" name="Items[${currentIndex}].NewPart.CategoryId">
                                    ${categoryOptionsHtml}
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold mb-1" style="color: #444;">Thương hiệu</label>
                                <input type="text" class="form-control form-control-sm new-part-brand" name="Items[${currentIndex}].NewPart.Brand" placeholder="Toyota, Honda..." />
                            </div>
                            <div class="col-md-4">
                                <label class="fw-bold mb-1" style="color: #444;">Giá bán ra *</label>
                                <input type="number" class="form-control form-control-sm new-part-price-sell" name="Items[${currentIndex}].NewPart.Price" placeholder="0" min="0" />
                            </div>
                            <div class="col-md-4">
                                <label class="fw-bold mb-1" style="color: #444;">Đơn vị</label>
                                <input type="text" class="form-control form-control-sm new-part-uom" name="Items[${currentIndex}].NewPart.UnitOfMeasure" value="Cái" />
                            </div>
                            <div class="col-md-4">
                                <label class="fw-bold mb-1" style="color: #444;">Bảo hành (tháng)</label>
                                <input type="number" class="form-control form-control-sm new-part-warranty" name="Items[${currentIndex}].NewPart.WarrantyMonths" value="0" min="0" />
                            </div>
                            <div class="col-md-4">
                                <label class="fw-bold mb-1" style="color: #444;">Min Level</label>
                                <input type="number" class="form-control form-control-sm new-part-min" name="Items[${currentIndex}].NewPart.MinStockLevel" value="5" min="0" />
                            </div>
                            <div class="col-md-4">
                                <label class="fw-bold mb-1" style="color: #444;">Max Level</label>
                                <input type="number" class="form-control form-control-sm new-part-max" name="Items[${currentIndex}].NewPart.MaxStockLevel" value="100" min="1" />
                            </div>
                            <div class="col-md-4">
                                <label class="fw-bold mb-1" style="color: #444;">Vị trí kho</label>
                                <input type="text" class="form-control form-control-sm new-part-location" name="Items[${currentIndex}].NewPart.WarehouseLocation" placeholder="Khu A..." />
                            </div>
                            <div class="col-md-12">
                                <label class="fw-bold mb-1" style="color: #444;">Mô tả ngắn</label>
                                <input type="text" class="form-control form-control-sm new-part-desc" name="Items[${currentIndex}].NewPart.Description" placeholder="Mô tả..." />
                            </div>
                        </div>
                    </div>
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm receipt-qty" name="Items[${currentIndex}].Quantity" min="1" value="1" required style="font-size: 13px;" />
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm receipt-price" name="Items[${currentIndex}].ImportPrice" min="0" placeholder="0" required style="font-size: 13px;" />
                </td>
                <td>
                    <input type="date" class="form-control form-control-sm receipt-expired" name="Items[${currentIndex}].ExpiredAt" style="font-size: 13px;" />
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-link text-danger p-0" onclick="removeReceiptRow(this)"><i class="bi bi-trash-fill fs-5"></i></button>
                </td>
            `;

            tbody.appendChild(tr);

            // Fetch list for row immediately when added
            fetchPartsForRow(tr);
            reindexRows();
        }

        // Toggle row edit modes
        function setRowMode(btn, isNew) {
            const row = btn.closest('.receipt-item-row');
            
            row.querySelector('.btn-existing-mode').classList.toggle('active', !isNew);
            row.querySelector('.btn-new-mode').classList.toggle('active', isNew);
            
            row.querySelector('.row-is-new-part').value = isNew;
            
            const existingPartContainer = row.querySelector('.existing-part-container');
            const newPartContainer = row.querySelector('.new-part-container');
            
            if (isNew) {
                existingPartContainer.classList.add('d-none');
                newPartContainer.classList.remove('d-none');
                row.querySelector('.receipt-part-select-val').value = "";
                row.querySelector('.search-part-input').value = "";
            } else {
                existingPartContainer.classList.remove('d-none');
                newPartContainer.classList.add('d-none');
                
                // Clear new part form inputs
                newPartContainer.querySelectorAll('input, select, textarea').forEach(el => {
                    if (el.tagName === 'SELECT') {
                        el.value = "";
                    } else if (el.classList.contains('new-part-uom')) {
                        el.value = "Cái";
                    } else if (el.classList.contains('new-part-min')) {
                        el.value = "5";
                    } else if (el.classList.contains('new-part-max')) {
                        el.value = "100";
                    } else if (el.classList.contains('new-part-warranty')) {
                        el.value = "0";
                    } else {
                        el.value = "";
                    }
                });
            }
        }

        // Reindex input fields sequentially
        function reindexRows() {
            const rows = document.querySelectorAll(".receipt-item-row");
            rows.forEach((row, index) => {
                row.setAttribute('data-index', index);
                row.querySelectorAll("[name]").forEach(input => {
                    input.name = input.name.replace(/Items\[\d+\]/, `Items[${index}]`);
                });
            });
        }

        // Remove row helper
        function removeReceiptRow(btn) {
            const tbody = document.getElementById('receiptItemsTableBody');
            if (tbody.querySelectorAll('.receipt-item-row').length > 1) {
                btn.closest('.receipt-item-row').remove();
                reindexRows();
            } else {
                Swal.fire('Nhắc nhở', 'Phải có ít nhất 1 phụ tùng nhập kho.', 'warning');
            }
        }

        // Submit Inventory Receipt
        function submitInventoryReceipt() {
            const notes = document.getElementById('receiptNotes').value.trim();
            const rows = document.querySelectorAll('.receipt-item-row');
            const items = [];
            
            // Check duplicates per supplier
            const supplierPartsMap = new Map();

            for (let row of rows) {
                const supplierIdVal = row.querySelector('.row-supplier-select').value;
                if (!supplierIdVal) {
                    Swal.fire('Nhắc nhở', 'Vui lòng chọn nhà cung cấp cho tất cả các hàng.', 'warning');
                    return;
                }
                const supplierId = parseInt(supplierIdVal);

                const isNewPart = row.querySelector('.row-is-new-part').value === 'true';
                const quantity = parseInt(row.querySelector('.receipt-qty').value);
                const importPrice = parseFloat(row.querySelector('.receipt-price').value);
                const expiredVal = row.querySelector('.receipt-expired').value;
                const expiredAt = expiredVal ? new Date(expiredVal).toISOString() : null;

                if (isNaN(quantity) || quantity <= 0) {
                    Swal.fire('Nhắc nhở', 'Số lượng phải lớn hơn 0.', 'warning');
                    return;
                }
                if (isNaN(importPrice) || importPrice < 0) {
                    Swal.fire('Nhắc nhở', 'Giá nhập không được âm.', 'warning');
                    return;
                }
                if (expiredVal && new Date(expiredVal).setHours(0,0,0,0) < new Date().setHours(0,0,0,0)) {
                    Swal.fire('Nhắc nhở', 'Hạn sử dụng không được nhỏ hơn ngày hiện tại.', 'warning');
                    return;
                }

                let itemDto = {
                    supplierId: supplierId,
                    isNewPart: isNewPart,
                    quantity: quantity,
                    importPrice: importPrice,
                    expiredAt: expiredAt
                };

                if (isNewPart) {
                    const partName = row.querySelector('.new-part-name').value.trim();
                    const partCode = row.querySelector('.new-part-code').value.trim();
                    const categoryId = parseInt(row.querySelector('.new-part-category').value);
                    const brand = row.querySelector('.new-part-brand').value.trim();
                    const price = parseFloat(row.querySelector('.new-part-price-sell').value);
                    const uom = row.querySelector('.new-part-uom').value.trim();
                    const warranty = parseInt(row.querySelector('.new-part-warranty').value) || 0;
                    const minLvl = parseInt(row.querySelector('.new-part-min').value) || 5;
                    const maxLvl = parseInt(row.querySelector('.new-part-max').value) || 100;
                    const location = row.querySelector('.new-part-location').value.trim();
                    const desc = row.querySelector('.new-part-desc').value.trim();

                    if (!partName || !partCode || isNaN(categoryId) || isNaN(price)) {
                        Swal.fire('Nhắc nhở', 'Vui lòng điền đầy đủ Tên, Mã, Danh mục và Giá bán ra cho tất cả các phụ tùng mới.', 'warning');
                        return;
                    }
                    if (price < 0) {
                        Swal.fire('Nhắc nhở', 'Giá bán ra của phụ tùng mới không được âm.', 'warning');
                        return;
                    }
                    if (minLvl < 0 || maxLvl <= 0 || minLvl > maxLvl) {
                        Swal.fire('Nhắc nhở', 'Hạn mức tồn kho không hợp lệ (Min <= Max, Max > 0).', 'warning');
                        return;
                    }

                    itemDto.partId = null;
                    itemDto.newPart = {
                        categoryId: categoryId,
                        partName: partName,
                        partCode: partCode,
                        brand: brand || null,
                        price: price,
                        minStockLevel: minLvl,
                        maxStockLevel: maxLvl,
                        unitOfMeasure: uom || "Cái",
                        warehouseLocation: location || null,
                        warrantyMonths: warranty,
                        description: desc || null
                    };
                } else {
                    const partIdVal = row.querySelector('.receipt-part-select-val').value;
                    if (!partIdVal) {
                        Swal.fire('Nhắc nhở', 'Vui lòng chọn phụ tùng cho tất cả các hàng.', 'warning');
                        return;
                    }
                    const partId = parseInt(partIdVal);

                    if (!supplierPartsMap.has(supplierId)) {
                        supplierPartsMap.set(supplierId, new Set());
                    }
                    const selectedPartIds = supplierPartsMap.get(supplierId);

                    if (selectedPartIds.has(partId)) {
                        const partText = row.querySelector('.search-part-input').value;
                        Swal.fire('Nhắc nhở', `Phụ tùng '${partText}' đã có trong phiếu nhập cho nhà cung cấp này. Vui lòng cập nhật số lượng ở dòng hiện tại.`, 'warning');
                        return;
                    }
                    selectedPartIds.add(partId);
                    itemDto.partId = partId;
                    itemDto.newPart = null;
                }

                items.push(itemDto);
            }

            const payload = {
                notes: notes,
                items: items
            };

            const token = '@User.FindFirst("jwt_token")?.Value';
            const saveBtn = document.getElementById('btnSaveReceipt');
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang lưu...';

            fetch('http://localhost:5084/api/inventory/receipt', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + token
                },
                body: JSON.stringify(payload)
            })
            .then(res => {
                if (!res.ok) {
                    return res.json().then(err => { throw new Error(err.message || 'Lỗi lưu phiếu nhập kho'); });
                }
                return res.json();
            })
            .then(data => {
                Swal.fire({
                    title: 'Thành công!',
                    text: data.message || 'Tạo phiếu nhập kho thành công.',
                    icon: 'success',
                    confirmButtonColor: '#ffc107'
                }).then(() => {
                    location.reload();
                });
            })
            .catch(err => {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> LƯU PHIẾU NHẬP';
                Swal.fire('Thất bại', err.message, 'error');
            });
        }

        function getHeaders() {
            return {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            };
        }

        function openAddModal() {
            $('#modalError').addClass('d-none');
            $('#partForm')[0].reset();
            $('#partId').val('0');
            $('#partModalLabel').text('Thêm phụ tùng mới');
            pkgModal.show();
        }

        function openEditModal(partId) {
            $('#modalError').addClass('d-none');
            $('#partForm')[0].reset();
            
            $.ajax({
                url: `/Parts/Manage?handler=GetPartJson&id=${partId}`,
                type: 'GET',
                success: function(part) {
                    $('#partId').val(part.partId);
                    $('#partName').val(part.partName);
                    $('#partCode').val(part.partCode);
                    $('#categoryId').val(part.categoryId);
                    $('#brand').val(part.brand);
                    $('#price').val(part.price);
                    $('#quantity').val(part.quantity);
                    $('#imageUrl').val(part.imageUrl);
                    $('#description').val(part.description);
                    
                    $('#partModalLabel').text('Cập nhật thông tin phụ tùng');
                    pkgModal.show();
                },
                error: function() {
                    Swal.fire('Lỗi!', 'Không thể tải thông tin phụ tùng.', 'error');
                }
            });
        }

        $('#partForm').on('submit', function(e) {
            e.preventDefault();
            
            var form = $(this);
            if (!form.valid()) return;

            var btn = $('#btnSubmit');
            btn.prop('disabled', true).text('Đang lưu...');

            const payload = {
                PartId: parseInt($('#partId').val()),
                PartName: $('#partName').val().trim(),
                PartCode: $('#partCode').val().trim(),
                CategoryId: parseInt($('#categoryId').val()),
                Brand: $('#brand').val().trim(),
                Price: parseFloat($('#price').val()),
                Quantity: parseInt($('#quantity').val()),
                ImageUrl: $('#imageUrl').val().trim(),
                Description: $('#description').val().trim()
            };

            $.ajax({
                url: '/Parts/Manage?handler=Save',
                type: 'POST',
                headers: getHeaders(),
                data: JSON.stringify(payload),
                success: function(res) {
                    btn.prop('disabled', false).text('Lưu lại');
                    if (res.success) {
                        pkgModal.hide();
                        Swal.fire({
                            title: 'Thành công!',
                            text: res.message,
                            icon: 'success',
                            confirmButtonColor: '#ffc107'
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        $('#modalError').html(res.message).removeClass('d-none');
                    }
                },
                error: function() {
                    btn.prop('disabled', false).text('Lưu lại');
                    Swal.fire('Lỗi!', 'Lỗi kết nối máy chủ.', 'error');
                }
            });
        });

        function confirmResell(partId, name) {
            Swal.fire({
                title: 'Bán lại phụ tùng',
                text: "Nhập số lượng bán lại cho phụ tùng '" + name + "':",
                input: 'number',
                inputAttributes: {
                    min: 1,
                    step: 1
                },
                inputValue: 1,
                showCancelButton: true,
                confirmButtonColor: '#198754',
                cancelButtonColor: '#262626',
                confirmButtonText: 'Xác nhận',
                cancelButtonText: 'Hủy',
                inputValidator: (value) => {
                    if (!value || parseInt(value) <= 0) {
                        return 'Vui lòng nhập số lượng lớn hơn 0!'
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    var qty = parseInt(result.value);
                    $.ajax({
                        url: `/Parts/Manage?handler=Resell&id=${partId}&quantity=${qty}`,
                        type: 'POST',
                        headers: getHeaders(),
                        success: function(res) {
                            if (res.success) {
                                Swal.fire({
                                    title: 'Thành công!',
                                    text: res.message,
                                    icon: 'success',
                                    confirmButtonColor: '#ffc107'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Thất bại!', res.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Lỗi!', 'Lỗi kết nối mạng.', 'error');
                        }
                    });
                }
            });
        }

        function confirmDiscontinue(partId, name) {
            Swal.fire({
                title: 'Xác nhận ngưng bán?',
                text: "Bạn có chắc chắn muốn ngưng bán phụ tùng '" + name + "'? Khách hàng sẽ không thể mua sản phẩm này nữa!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ffc107',
                cancelButtonColor: '#262626',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `/Parts/Manage?handler=Discontinue&id=${partId}`,
                        type: 'POST',
                        headers: getHeaders(),
                        success: function(res) {
                            if (res.success) {
                                Swal.fire({
                                    title: 'Thành công!',
                                    text: res.message,
                                    icon: 'success',
                                    confirmButtonColor: '#ffc107'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Thất bại!', res.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Lỗi!', 'Lỗi kết nối mạng.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}

