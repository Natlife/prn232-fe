@page
@model CarSalesRazorPages.Pages.Parts.ManageModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Phụ tùng - Admin";
    var categories = Model.Categories;
}

<div class="container-fluid py-5 px-md-5">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="fw-bold text-dark border-start border-warning border-4 ps-3 m-0" style="font-family: 'Outfit', sans-serif;">
                QUẢN LÝ PHỤ TÙNG
            </h1>
            <p class="text-secondary m-0 ps-3">Danh sách toàn bộ phụ tùng trong hệ thống</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <button class="btn btn-success fw-bold border-0 px-4 py-2 me-2" onclick="openInventoryReceiptModal()">
                <i class="bi bi-box-seam-fill me-2"></i> NHẬP KHO PHỤ TÙNG
            </button>
            <button class="btn btn-warning fw-bold border-0 px-4 py-2 text-dark" style="background-color: #ffc107;" onclick="openAddModal()">
                <i class="bi bi-plus-circle-fill me-2"></i> THÊM PHỤ TÙNG MỚI
            </button>
        </div>
    </div>

    @Html.AntiForgeryToken()

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
        </div>
    }

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark text-white">
                        <tr>
                            <th class="ps-4">Hình ảnh</th>
                            <th>Mã phụ tùng</th>
                            <th>Tên phụ tùng</th>
                            <th>Danh mục</th>
                            <th>Thương hiệu</th>
                            <th>Giá bán</th>
                            <th>Tồn kho</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Parts == null || !Model.Parts.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-secondary">
                                    <i class="bi bi-tools fs-1 d-block mb-3"></i>
                                    Chưa có phụ tùng nào được tạo.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var part in Model.Parts)
                            {
                                var displayImageUrl = string.IsNullOrWhiteSpace(part.ImageUrl) 
                                    ? "https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=100&q=80" 
                                    : part.ImageUrl;
                                    
                                <tr>
                                    <td class="ps-4">
                                        <img src="@displayImageUrl" alt="@part.PartName" class="rounded object-fit-cover" style="width: 60px; height: 60px;" />
                                    </td>
                                    <td class="fw-bold text-secondary" style="font-family: monospace;">@part.PartCode</td>
                                    <td>
                                        <div class="fw-bold text-dark">@part.PartName</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@part.Category?.CategoryName</span>
                                    </td>
                                    <td>@part.Brand</td>
                                    <td class="fw-bold text-danger">@part.Price.ToString("N0") đ</td>
                                    <td class="fw-bold">@part.Quantity</td>
                                    <td>
                                        @if (part.Status == "Available")
                                        {
                                            <span class="badge bg-success">Còn hàng</span>
                                        }
                                        else if (part.Status == "Out of Stock")
                                        {
                                            <span class="badge bg-warning text-dark">Hết hàng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Ngưng bán</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4 text-nowrap">
                                        @if (part.Status != "Inactive")
                                        {
                                            <button class="btn btn-outline-warning btn-sm me-2 fw-bold" onclick="confirmDiscontinue(@part.PartId, '@Html.Raw(JavaScriptEncoder.Default.Encode(part.PartName))')">
                                                <i class="bi bi-slash-circle me-1"></i> Ngưng bán
                                            </button>
                                        }
                                        <button class="btn btn-outline-primary btn-sm me-2 fw-bold" onclick="openEditModal(@part.PartId)">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </button>
                                        <button class="btn btn-outline-success btn-sm fw-bold" onclick="confirmResell(@part.PartId, '@Html.Raw(JavaScriptEncoder.Default.Encode(part.PartName))')">
                                            <i class="bi bi-arrow-repeat me-1"></i> Bán lại
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap CRUD Modal -->
<div class="modal fade" id="partModal" tabindex="-1" aria-labelledby="partModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="partModalLabel">Thêm phụ tùng mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="modalError" class="alert alert-danger d-none"></div>
                <form id="partForm">
                    <input type="hidden" id="partId" value="0" />
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Tên phụ tùng <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="partName" required maxlength="150" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Mã phụ tùng <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="partCode" required maxlength="50" placeholder="VD: PT-LOPHIEU-MICH" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                            <select class="form-select" id="categoryId" required>
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.CategoryId">@cat.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Thương hiệu / Hãng</label>
                            <input type="text" class="form-control" id="brand" maxlength="100" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Giá bán (VND) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="price" required min="1000" max="1000000000" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Số lượng tồn kho <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="quantity" required min="0" max="100000" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Đường dẫn hình ảnh (URL)</label>
                            <input type="url" class="form-control" id="imageUrl" maxlength="500" placeholder="https://..." />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả phụ tùng</label>
                        <textarea class="form-control" id="description" rows="3" maxlength="1000"></textarea>
                    </div>

                    <div class="text-end mt-4">
                        <button type="button" class="btn btn-secondary px-4 fw-bold me-2" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-warning px-4 fw-bold text-dark" style="background-color: #ffc107;" id="btnSubmit">Lưu lại</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Inventory Receipt Modal -->
<div class="modal fade" id="inventoryReceiptModal" tabindex="-1" aria-labelledby="inventoryReceiptModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header bg-success text-white py-3">
                <h5 class="modal-title fw-bold" id="inventoryReceiptModalLabel">
                    <i class="bi bi-box-seam-fill me-2"></i> PHIẾU NHẬP KHO PHỤ TÙNG
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-bold">Nhà cung cấp <span class="text-danger">*</span></label>
                    <select class="form-select form-select-lg" id="receiptSupplierId" required>
                        <option value="">-- Đang tải nhà cung cấp... --</option>
                    </select>
                </div>
                
                <div class="mb-4">
                    <label class="form-label fw-bold">Ghi chú nhập kho</label>
                    <textarea class="form-control" id="receiptNotes" rows="2" placeholder="Ví dụ: Nhập kho phụ tùng định kỳ..."></textarea>
                </div>

                <h6 class="fw-bold mb-2 text-secondary d-flex align-items-center">
                    <i class="bi bi-list-stars me-2"></i> DANH SÁCH CHI TIẾT NHẬP KHO
                </h6>
                <div class="table-responsive mb-3 border rounded">
                    <table class="table table-striped table-hover align-middle mb-0" style="font-size: 14px;">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 40%;">Phụ tùng</th>
                                <th style="width: 15%;">Số lượng</th>
                                <th style="width: 20%;">Giá nhập (VND)</th>
                                <th style="width: 20%;">Hạn sử dụng</th>
                                <th style="width: 5%;"></th>
                            </tr>
                        </thead>
                        <tbody id="receiptItemsTableBody">
                            <!-- Rows added dynamically via JS -->
                        </tbody>
                    </table>
                </div>
                
                <button type="button" class="btn btn-outline-success btn-sm fw-bold px-3" onclick="addReceiptItemRow()">
                    <i class="bi bi-plus-circle-fill me-1"></i> THÊM DÒNG PHỤ TÙNG
                </button>

                <div class="text-end mt-4">
                    <button type="button" class="btn btn-secondary px-4 fw-bold me-2" data-bs-dismiss="modal">HỦY BỎ</button>
                    <button type="button" class="btn btn-success px-4 fw-bold" id="btnSaveReceipt" onclick="submitInventoryReceipt()">
                        <i class="bi bi-check-circle-fill me-1"></i> LƯU PHIẾU NHẬP
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let pkgModal = null;
        $(document).ready(function() {
            pkgModal = new bootstrap.Modal(document.getElementById('partModal'));
        });

        // Inventory Receipt flows
        let allPartsList = [];
        let allSuppliersList = [];

        function openInventoryReceiptModal() {
            const modal = new bootstrap.Modal(document.getElementById('inventoryReceiptModal'));
            modal.show();

            // Fetch suppliers and parts from API backend
            if (allPartsList.length === 0 || allSuppliersList.length === 0) {
                Promise.all([
                    fetch('http://localhost:5084/api/Suppliers').then(res => res.json()),
                    fetch('http://localhost:5084/odata/Parts?$expand=Category').then(res => res.json())
                ]).then(([suppliers, partsData]) => {
                    allSuppliersList = suppliers;
                    allPartsList = partsData.value || partsData;

                    // Populate Supplier dropdown
                    const supplierSelect = document.getElementById('receiptSupplierId');
                    supplierSelect.innerHTML = '<option value="">-- Chọn nhà cung cấp --</option>';
                    allSuppliersList.forEach(s => {
                        supplierSelect.innerHTML += `<option value="${s.supplierId}">${s.supplierName} (${s.contactName})</option>`;
                    });

                    // Reset rows
                    document.getElementById('receiptItemsTableBody').innerHTML = '';
                    addReceiptItemRow();
                }).catch(err => {
                    Swal.fire('Lỗi', 'Không thể tải danh sách nhà cung cấp hoặc phụ tùng: ' + err.message, 'error');
                });
            } else {
                document.getElementById('receiptItemsTableBody').innerHTML = '';
                addReceiptItemRow();
            }
        }

        function addReceiptItemRow() {
            const tbody = document.getElementById('receiptItemsTableBody');
            
            // Build options list
            let partOptions = '<option value="">-- Chọn phụ tùng --</option>';
            allPartsList.forEach(p => {
                const categoryName = p.Category?.CategoryName || '';
                const isPerishable = ["Dầu nhớt", "Hóa chất", "Ắc quy"].includes(categoryName);
                const perishableBadge = isPerishable ? ' *Hạn sử dụng' : '';
                partOptions += `<option value="${p.partId}" data-code="${p.partCode}" data-name="${p.partName}" data-perishable="${isPerishable}">${p.partName} (${p.partCode})${perishableBadge}</option>`;
            });

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>
                    <select class="form-select form-select-sm receipt-part-select" onchange="onReceiptPartChange(this)">
                        ${partOptions}
                    </select>
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm receipt-qty" min="1" value="1" required />
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm receipt-price" min="0" placeholder="0" required />
                </td>
                <td>
                    <input type="date" class="form-control form-control-sm receipt-expired" />
                    <small class="text-danger d-none expired-req">* Bắt buộc</small>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-link text-danger p-0" onclick="removeReceiptRow(this)"><i class="bi bi-trash-fill fs-5"></i></button>
                </td>
            `;
            tbody.appendChild(tr);
        }

        function onReceiptPartChange(selectEl) {
            const selectedOption = selectEl.options[selectEl.selectedIndex];
            const isPerishable = selectedOption.getAttribute('data-perishable') === 'true';
            const row = selectEl.closest('tr');
            const expiredInput = row.querySelector('.receipt-expired');
            const expiredReq = row.querySelector('.expired-req');
            
            if (isPerishable) {
                expiredInput.setAttribute('required', 'required');
                expiredReq.classList.remove('d-none');
            } else {
                expiredInput.removeAttribute('required');
                expiredReq.classList.add('d-none');
            }
        }

        function removeReceiptRow(btn) {
            const tbody = document.getElementById('receiptItemsTableBody');
            if (tbody.children.length > 1) {
                btn.closest('tr').remove();
            } else {
                Swal.fire('Nhắc nhở', 'Phải có ít nhất 1 phụ tùng nhập kho.', 'warning');
            }
        }

        function submitInventoryReceipt() {
            const supplierId = document.getElementById('receiptSupplierId').value;
            if (!supplierId) {
                Swal.fire('Nhắc nhở', 'Vui lòng chọn nhà cung cấp.', 'warning');
                return;
            }
            const notes = document.getElementById('receiptNotes').value.trim();
            
            const rows = document.querySelectorAll('#receiptItemsTableBody tr');
            const items = [];
            
            for (let row of rows) {
                const partSelect = row.querySelector('.receipt-part-select');
                const partId = partSelect.value;
                if (!partId) {
                    Swal.fire('Nhắc nhở', 'Vui lòng chọn phụ tùng cho tất cả các hàng.', 'warning');
                    return;
                }
                const quantity = parseInt(row.querySelector('.receipt-qty').value);
                const importPrice = parseFloat(row.querySelector('.receipt-price').value);
                const expiredInput = row.querySelector('.receipt-expired');
                const isPerishable = partSelect.options[partSelect.selectedIndex].getAttribute('data-perishable') === 'true';
                
                let expiredAt = expiredInput.value ? new Date(expiredInput.value).toISOString() : null;
                
                if (isPerishable && !expiredAt) {
                    Swal.fire('Nhắc nhở', 'Các phụ tùng thuộc nhóm Dầu nhớt, Hóa chất, Ắc quy bắt buộc phải nhập Hạn sử dụng.', 'warning');
                    return;
                }
                
                if (isNaN(quantity) || quantity <= 0) {
                    Swal.fire('Nhắc nhở', 'Số lượng phải lớn hơn 0.', 'warning');
                    return;
                }
                if (isNaN(importPrice) || importPrice < 0) {
                    Swal.fire('Nhắc nhở', 'Giá nhập không được nhỏ hơn 0.', 'warning');
                    return;
                }
                
                items.push({
                    partId: parseInt(partId),
                    quantity: quantity,
                    importPrice: importPrice,
                    expiredAt: expiredAt
                });
            }

            const payload = {
                supplierId: parseInt(supplierId),
                notes: notes,
                items: items
            };

            const token = '@User.FindFirst("jwt_token")?.Value';
            
            const saveBtn = document.getElementById('btnSaveReceipt');
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang lưu...';

            fetch('http://localhost:5084/api/inventory/receipt', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + token
                },
                body: JSON.stringify(payload)
            })
            .then(res => {
                if (!res.ok) {
                    return res.json().then(err => { throw new Error(err.message || 'Lỗi lưu phiếu nhập kho'); });
                }
                return res.json();
            })
            .then(data => {
                Swal.fire({
                    title: 'Thành công!',
                    text: 'Tạo phiếu nhập kho thành công.',
                    icon: 'success',
                    confirmButtonColor: '#ffc107'
                }).then(() => {
                    location.reload();
                });
            })
            .catch(err => {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> LƯU PHIẾU NHẬP';
                Swal.fire('Thất bại', err.message, 'error');
            });
        }

        function getHeaders() {
            return {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            };
        }

        function openAddModal() {
            $('#modalError').addClass('d-none');
            $('#partForm')[0].reset();
            $('#partId').val('0');
            $('#partModalLabel').text('Thêm phụ tùng mới');
            pkgModal.show();
        }

        function openEditModal(partId) {
            $('#modalError').addClass('d-none');
            $('#partForm')[0].reset();
            
            $.ajax({
                url: `/Parts/Manage?handler=GetPartJson&id=${partId}`,
                type: 'GET',
                success: function(part) {
                    $('#partId').val(part.partId);
                    $('#partName').val(part.partName);
                    $('#partCode').val(part.partCode);
                    $('#categoryId').val(part.categoryId);
                    $('#brand').val(part.brand);
                    $('#price').val(part.price);
                    $('#quantity').val(part.quantity);
                    $('#imageUrl').val(part.imageUrl);
                    $('#description').val(part.description);
                    
                    $('#partModalLabel').text('Cập nhật thông tin phụ tùng');
                    pkgModal.show();
                },
                error: function() {
                    Swal.fire('Lỗi!', 'Không thể tải thông tin phụ tùng.', 'error');
                }
            });
        }

        $('#partForm').on('submit', function(e) {
            e.preventDefault();
            
            var form = $(this);
            if (!form.valid()) return;

            var btn = $('#btnSubmit');
            btn.prop('disabled', true).text('Đang lưu...');

            const payload = {
                PartId: parseInt($('#partId').val()),
                PartName: $('#partName').val().trim(),
                PartCode: $('#partCode').val().trim(),
                CategoryId: parseInt($('#categoryId').val()),
                Brand: $('#brand').val().trim(),
                Price: parseFloat($('#price').val()),
                Quantity: parseInt($('#quantity').val()),
                ImageUrl: $('#imageUrl').val().trim(),
                Description: $('#description').val().trim()
            };

            $.ajax({
                url: '/Parts/Manage?handler=Save',
                type: 'POST',
                headers: getHeaders(),
                data: JSON.stringify(payload),
                success: function(res) {
                    btn.prop('disabled', false).text('Lưu lại');
                    if (res.success) {
                        pkgModal.hide();
                        Swal.fire({
                            title: 'Thành công!',
                            text: res.message,
                            icon: 'success',
                            confirmButtonColor: '#ffc107'
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        $('#modalError').html(res.message).removeClass('d-none');
                    }
                },
                error: function() {
                    btn.prop('disabled', false).text('Lưu lại');
                    Swal.fire('Lỗi!', 'Lỗi kết nối máy chủ.', 'error');
                }
            });
        });

        function confirmResell(partId, name) {
            Swal.fire({
                title: 'Bán lại phụ tùng',
                text: "Nhập số lượng bán lại cho phụ tùng '" + name + "':",
                input: 'number',
                inputAttributes: {
                    min: 1,
                    step: 1
                },
                inputValue: 1,
                showCancelButton: true,
                confirmButtonColor: '#198754',
                cancelButtonColor: '#262626',
                confirmButtonText: 'Xác nhận',
                cancelButtonText: 'Hủy',
                inputValidator: (value) => {
                    if (!value || parseInt(value) <= 0) {
                        return 'Vui lòng nhập số lượng lớn hơn 0!'
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    var qty = parseInt(result.value);
                    $.ajax({
                        url: `/Parts/Manage?handler=Resell&id=${partId}&quantity=${qty}`,
                        type: 'POST',
                        headers: getHeaders(),
                        success: function(res) {
                            if (res.success) {
                                Swal.fire({
                                    title: 'Thành công!',
                                    text: res.message,
                                    icon: 'success',
                                    confirmButtonColor: '#ffc107'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Thất bại!', res.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Lỗi!', 'Lỗi kết nối mạng.', 'error');
                        }
                    });
                }
            });
        }

        function confirmDiscontinue(partId, name) {
            Swal.fire({
                title: 'Xác nhận ngưng bán?',
                text: "Bạn có chắc chắn muốn ngưng bán phụ tùng '" + name + "'? Khách hàng sẽ không thể mua sản phẩm này nữa!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ffc107',
                cancelButtonColor: '#262626',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `/Parts/Manage?handler=Discontinue&id=${partId}`,
                        type: 'POST',
                        headers: getHeaders(),
                        success: function(res) {
                            if (res.success) {
                                Swal.fire({
                                    title: 'Thành công!',
                                    text: res.message,
                                    icon: 'success',
                                    confirmButtonColor: '#ffc107'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Thất bại!', res.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Lỗi!', 'Lỗi kết nối mạng.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}

