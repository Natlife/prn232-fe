@page "{id:int}"
@model CarSalesRazorPages.Pages.Parts.HistoryModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Lịch sử biến động phụ tùng - " + Model.Part.PartName;
    var displayImageUrl = string.IsNullOrWhiteSpace(Model.Part.ImageUrl) 
        ? "https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=100&q=80" 
        : Model.Part.ImageUrl;
}

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container-fluid py-4 px-md-5" style="font-family: 'Outfit', sans-serif; background-color: #f8f9fa;">
    
    <!-- Back button & Header -->
    <div class="mb-4">
        <a asp-page="./Manage" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-2 mb-3 fw-medium">
            <i class="bi bi-arrow-left"></i> Quay lại Danh sách quản lý
        </a>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h1 class="fw-extrabold text-dark m-0 d-flex align-items-center gap-2" style="font-size: 2.2rem; font-weight: 800; letter-spacing: -0.5px;">
                    <span class="text-warning">|</span> LỊCH SỬ BIẾN ĐỘNG PHỤ TÙNG
                </h1>
                <p class="text-muted m-0 mt-1" style="font-size: 15px;">
                    Xem chi tiết thông tin và toàn bộ nhật ký nhập - xuất của phụ tùng trong hệ thống.
                </p>
            </div>
        </div>
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
        </div>
    }

    <div class="row g-4">
        <!-- Left column: Part Details Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="bg-dark text-white p-4 text-center">
                    <img src="@displayImageUrl" alt="@Model.Part.PartName" class="img-fluid rounded-3 border border-secondary shadow-sm mb-3" style="max-height: 180px; object-fit: cover;" />
                    <h4 class="fw-bold m-0 text-truncate">@Model.Part.PartName</h4>
                    <code class="text-warning fs-6" style="font-family: monospace;">@Model.Part.PartCode</code>
                </div>
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2 text-secondary">
                        <i class="bi bi-info-circle-fill me-2"></i>Thông tin chi tiết
                    </h5>
                    
                    <div class="mb-3 d-flex justify-content-between align-items-center">
                        <span class="text-muted">Danh mục:</span>
                        <span class="badge bg-light text-dark border fw-medium px-3 py-2">@(Model.Part.Category?.CategoryName ?? "Chưa phân loại")</span>
                    </div>
                    
                    <div class="mb-3 d-flex justify-content-between">
                        <span class="text-muted">Thương hiệu:</span>
                        <span class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.Part.Brand) ? "OEM" : Model.Part.Brand)</span>
                    </div>

                    <div class="mb-3 d-flex justify-content-between">
                        <span class="text-muted">Giá bán:</span>
                        <span class="fw-bold text-danger fs-5">@Model.Part.Price.ToString("N0") đ</span>
                    </div>

                    <div class="mb-3 d-flex justify-content-between align-items-center">
                        <span class="text-muted">Tồn kho hiện tại:</span>
                        @if (Model.Part.Quantity <= Model.Part.MinStockLevel)
                        {
                            <span class="fw-bold text-danger d-flex align-items-center gap-1 bg-danger bg-opacity-10 px-2 py-1 rounded">
                                <i class="bi bi-exclamation-triangle-fill"></i> @Model.Part.Quantity @(Model.Part.UnitOfMeasure ?? "Cái") (Thấp)
                            </span>
                        }
                        else
                        {
                            <span class="fw-bold text-success bg-success bg-opacity-10 px-3 py-1 rounded">
                                @Model.Part.Quantity @(Model.Part.UnitOfMeasure ?? "Cái")
                            </span>
                        }
                    </div>

                    <div class="mb-3 d-flex justify-content-between">
                        <span class="text-muted">Định mức tối thiểu:</span>
                        <span class="fw-medium text-secondary">@Model.Part.MinStockLevel @(Model.Part.UnitOfMeasure ?? "Cái")</span>
                    </div>

                    <div class="mb-3 d-flex justify-content-between">
                        <span class="text-muted">Định mức tối đa:</span>
                        <span class="fw-medium text-secondary">@Model.Part.MaxStockLevel @(Model.Part.UnitOfMeasure ?? "Cái")</span>
                    </div>

                    <div class="mb-3 d-flex justify-content-between">
                        <span class="text-muted">Vị trí kho:</span>
                        <span class="fw-medium text-dark">@(string.IsNullOrEmpty(Model.Part.WarehouseLocation) ? "Chưa sắp xếp" : Model.Part.WarehouseLocation)</span>
                    </div>

                    <div class="mb-3 d-flex justify-content-between">
                        <span class="text-muted">Bảo hành:</span>
                        <span class="fw-medium text-dark">@Model.Part.WarrantyMonths tháng</span>
                    </div>

                    <div class="mb-3 d-flex justify-content-between">
                        <span class="text-muted">Hạn sử dụng (EXP):</span>
                        <span class="fw-bold text-primary">@(Model.Part.ExpiredAt?.ToString("dd/MM/yyyy") ?? "Không có")</span>
                    </div>

                    <div class="mb-3 d-flex justify-content-between">
                        <span class="text-muted">Trạng thái bán:</span>
                        @if (Model.Part.Status == "Available")
                        {
                            <span class="badge bg-success">Đang kinh doanh</span>
                        }
                        else if (Model.Part.Status == "Out of Stock")
                        {
                            <span class="badge bg-warning text-dark">Tạm hết hàng</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Ngưng kinh doanh</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Part.Description))
                    {
                        <div class="mt-4">
                            <span class="text-muted d-block mb-1">Mô tả:</span>
                            <p class="text-secondary bg-light p-3 rounded" style="font-size: 14px; line-height: 1.5;">@Model.Part.Description</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right column: Transaction History Table -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark m-0 d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history text-warning"></i> Nhật ký biến động kho hàng
                    </h5>
                    <span class="badge bg-secondary text-white rounded-pill px-3 py-2 fw-bold">@Model.Transactions.Count lần ghi nhận</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4" style="width: 18%;">Thời gian</th>
                                    <th style="width: 15%;">Loại giao dịch</th>
                                    <th style="width: 12%;">Số lượng</th>
                                    <th style="width: 18%;">Người thực hiện</th>
                                    <th style="width: 17%;">Mã tham chiếu</th>
                                    <th class="pe-4" style="width: 20%;">Ghi chú</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Transactions.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-secondary">
                                            <i class="bi bi-clipboard2-x fs-1 d-block mb-3 text-muted"></i>
                                            Chưa ghi nhận giao dịch nhập xuất nào cho phụ tùng này.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var tx in Model.Transactions)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-medium text-secondary" style="font-size: 13.5px;">@tx.TransactionDate</td>
                                            <td>
                                                @if (tx.TransactionType == "Import")
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1"><i class="bi bi-download me-1"></i>Nhập kho</span>
                                                }
                                                else if (tx.TransactionType == "Export")
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger fw-bold px-2 py-1"><i class="bi bi-upload me-1"></i>Xuất kho</span>
                                                }
                                                else if (tx.TransactionType == "Return")
                                                {
                                                    <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-2 py-1"><i class="bi bi-arrow-return-left me-1"></i>Hoàn hàng</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info bg-opacity-10 text-info fw-bold px-2 py-1"><i class="bi bi-sliders me-1"></i>Điều chỉnh</span>
                                                }
                                            </td>
                                            <td class="fw-bold @(tx.TransactionType == "Import" || tx.TransactionType == "Return" ? "text-success" : "text-danger")">
                                                @(tx.TransactionType == "Import" || tx.TransactionType == "Return" ? "+" : "-")@tx.Quantity
                                            </td>
                                            <td class="text-secondary fw-semibold">
                                                <i class="bi bi-person-fill me-1"></i> @tx.StaffName
                                            </td>
                                            <td>
                                                @if (tx.ReferenceId.HasValue)
                                                {
                                                    <span class="badge bg-light text-dark border fw-medium" style="font-family: monospace;">@tx.ReferenceType #@tx.ReferenceId</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td class="text-muted pe-4" style="font-size: 13.5px;">@tx.Notes</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
