@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Thumbnail switcher
        function setMainImage(src, thumbEl) {
            document.getElementById('mainImage').src = src;
            document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
            thumbEl.classList.add('active');
        }

        // Quantity control
        function changeQty(delta) {
            var input = document.getElementById('qtyInput');
            var val = parseInt(input.value) + delta;
            var max = parseInt(input.max);
            if (val < 1) val = 1;
            if (val > max) val = max;
            input.value = val;
        }

        // Add to cart using qty input value
        function addToCartDetail(partId, maxQty) {
            var isAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
            if (!isAuthenticated) {
                Swal.fire({
                    title: 'YÃªu cáº§u Ä‘Äƒng nháº­p!',
                    text: 'Vui lÃ²ng Ä‘Äƒng nháº­p Ä‘á»ƒ thÃªm phá»¥ tÃ¹ng vÃ o giá» hÃ ng.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ffc107',
                    cancelButtonColor: '#262626',
                    confirmButtonText: 'ÄÄƒng nháº­p',
                    cancelButtonText: 'Há»§y'
                }).then((result) => {
                    if (result.isConfirmed) {
                        var myModal = new bootstrap.Modal(document.getElementById('loginModal'));
                        myModal.show();
                    }
                });
                return;
            }

            var qty = parseInt(document.getElementById('qtyInput').value);
            if (qty < 1 || qty > maxQty) {
                Swal.fire('Sá»‘ lÆ°á»£ng khÃ´ng há»£p lá»‡', `Vui lÃ²ng chá»n tá»« 1 Ä‘áº¿n ${maxQty}`, 'warning');
                return;
            }

            var btn = document.getElementById('btnAddToCart');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Äang thÃªm...';

            $.ajax({
                url: ''/PartOrders/Checkout?handler=AddToCart'',
                type: 'POST',
                data: { partId: partId, quantity: qty },
                success: function(res) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-cart-plus-fill me-2"></i> ThÃªm vÃ o giá» hÃ ng';
                    if (res.success) {
                        updateNavbarCartCount(res.cartCount);
                        Swal.fire({
                            title: 'ÄÃ£ thÃªm vÃ o giá» hÃ ng!',
                            text: res.message,
                            icon: 'success',
                            showCancelButton: true,
                            confirmButtonColor: '#ffc107',
                            cancelButtonColor: '#262626',
                            confirmButtonText: 'Äi Ä‘áº¿n giá» hÃ ng',
                            cancelButtonText: 'Tiáº¿p tá»¥c mua sáº¯m'
                        }).then((navResult) => {
                            if (navResult.isConfirmed) {
                                window.location.href = ''/PartOrders/Cart'';
                            }
                        });
                    } else {
                        Swal.fire('Tháº¥t báº¡i!', res.message, 'error');
                    }
                },
                error: function() {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-cart-plus-fill me-2"></i> ThÃªm vÃ o giá» hÃ ng';
                    Swal.fire('Lá»—i!', 'ÄÃ£ xáº£y ra lá»—i káº¿t ná»‘i.', 'error');
                }
            });
        }

        function updateNavbarCartCount(count) {
            var badge = $('#navbarCartCount');
            if (badge.length) {
                badge.text(count);
                count > 0 ? badge.removeClass('d-none') : badge.addClass('d-none');
            }
        }
    </script>
}

<style>
