                                <tr>
                                    <th scope="row" class="spec-label">Tráº¡ng thÃ¡i</th>
                                    <td>
                                        @switch (Model.Part!.Status)
                                        {
                                            case "Available":
                                                <span class="badge bg-success px-3 py-2">Äang bÃ¡n</span>
                                                break;
                                            case "Out of Stock":
                                                <span class="badge bg-warning text-dark px-3 py-2">Háº¿t hÃ ng</span>
                                                break;
                                            case "Inactive":
                                                <span class="badge bg-secondary px-3 py-2">NgÆ°ng bÃ¡n</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary px-3 py-2">@Model.Part!.Status</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="spec-label">NgÃ y cáº­p nháº­t</th>
                                    <td>@Model.Part!.CreatedAt.ToString("dd/MM/yyyy")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- Delivery tab -->
                <div class="tab-pane fade" id="delivery" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="delivery-option-card">
                                <div class="delivery-icon"><i class="bi bi-shop"></i></div>
                                <h6 class="fw-bold mt-2 mb-1">Nháº­n táº¡i cá»­a hÃ ng</h6>
