@model CarSalesManagementSystemClient.Models.CarViewModel
@{
    ViewData["Title"] = Model.CarName + " - Chi tiết xe";
    var displayImageUrl = string.IsNullOrWhiteSpace(Model.ImageUrl) 
        ? "https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=600&q=80" 
        : Model.ImageUrl;
}

<!-- Google Fonts & Stylesheets -->
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    body {
        background-color: #f8f9fa;
    }
    .font-outfit {
        font-family: 'Outfit', sans-serif;
    }
    .detail-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        overflow: hidden;
    }
    .badge-status {
        font-size: 0.85rem;
        padding: 8px 16px;
        border-radius: 50px;
        font-weight: 600;
    }
    .price-tag {
        font-size: 2.2rem;
        font-weight: 800;
        color: #dc3545;
    }
    .spec-item {
        background-color: #fff;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 16px;
        transition: all 0.3s ease;
        text-align: center;
    }
    .spec-item:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
        border-color: #ffc107;
    }
    .btn-action-buy {
        background: linear-gradient(135deg, #28a745, #218838);
        color: white;
        border: none;
        font-weight: 700;
        padding: 16px;
        border-radius: 12px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .btn-action-buy:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(40,167,69,0.3);
        color: white;
    }
    .btn-action-deposit {
        background: linear-gradient(135deg, #ffc107, #e0a800);
        color: #1f2937;
        border: none;
        font-weight: 700;
        padding: 16px;
        border-radius: 12px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .btn-action-deposit:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255,193,7,0.3);
        color: #1f2937;
    }
    .canvas-container {
        position: relative;
        width: 100%;
        height: 400px;
        background: radial-gradient(circle, #1e293b, #0f172a);
        border-radius: 16px;
        overflow: hidden;
    }
    #car3dCanvasContainer {
        width: 100%;
        height: 100%;
    }
    .color-swatch {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        cursor: pointer;
        display: inline-block;
        margin-right: 10px;
        border: 2px solid #fff;
        box-shadow: 0 0 0 1px #cbd5e1;
        transition: all 0.2s ease;
    }
    .color-swatch.active {
        box-shadow: 0 0 0 2px #ffc107;
        transform: scale(1.15);
    }
    .specs-table td {
        padding: 12px 16px;
    }
</style>

<div class="container py-5 font-outfit">
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Cars" asp-action="Index" class="text-decoration-none text-dark">Showroom</a></li>
                    <li class="breadcrumb-item active text-danger fw-bold" aria-current="page">@Model.CarName</li>
                </ol>
            </nav>
        </div>
        <div class="col-md-4 text-md-end">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm fw-bold px-3 py-2">
                <i class="bi bi-arrow-left me-1"></i> Quay lại showroom
            </a>
        </div>
    </div>

    <!-- Main Detail Section -->
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card detail-card p-0 mb-4">
                <img src="@displayImageUrl" alt="@Model.CarName" class="w-100 object-fit-cover" style="height: 350px;">
            </div>

            <div class="card detail-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark m-0 d-flex align-items-center">
                        <i class="bi bi-box-3d me-2 text-warning"></i> Trải nghiệm góc nhìn 3D tương tác
                    </h5>
                    <button id="btnRotateToggle" class="btn btn-warning btn-sm fw-bold px-3 py-1.5 border-0 text-dark d-flex align-items-center">
                        <i class="bi bi-pause-fill me-1"></i> Tự động xoay
                    </button>
                </div>
                
                <div class="canvas-container">
                    <div id="car3dCanvasContainer"></div>
                </div>

                <div class="mt-4 text-center">
                    <p class="fw-bold text-secondary mb-2" style="font-size: 14px;">THỬ THAY ĐỔI MÀU SƠN XE 3D</p>
                    <div class="d-flex justify-content-center align-items-center">
                        <div class="color-swatch active" data-color="blue" style="background-color: #3b82f6;" title="Xanh Dương"></div>
                        <div class="color-swatch" data-color="red" style="background-color: #ef4444;" title="Đỏ"></div>
                        <div class="color-swatch" data-color="white" style="background-color: #f3f4f6;" title="Trắng"></div>
                        <div class="color-swatch" data-color="black" style="background-color: #111827;" title="Đen"></div>
                        <div class="color-swatch" data-color="gray" style="background-color: #6b7280;" title="Xám"></div>
                        <div class="color-swatch" data-color="yellow" style="background-color: #facc15;" title="Vàng"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card detail-card p-4 h-100 d-flex flex-column">
                <div class="mb-3">
                    <small class="text-secondary fw-bold text-uppercase" style="letter-spacing: 1.5px;">@Model.Brand.BrandName</small>
                    <h2 class="fw-extrabold text-dark mt-1 mb-2">@Model.CarName</h2>
                    
                    <div class="d-flex align-items-center gap-2">
                        @if (Model.Status == "Available")
                        {
                            <span class="badge bg-success badge-status"><i class="bi bi-check-circle-fill me-1"></i> Sẵn sàng bàn giao</span>
                        }
                        else if (Model.Status == "Reserved")
                        {
                            <span class="badge bg-warning text-dark badge-status"><i class="bi bi-exclamation-circle-fill me-1"></i> Đang được đặt cọc giữ xe</span>
                        }
                        else if (Model.Status == "Sold")
                        {
                            <span class="badge bg-danger badge-status"><i class="bi bi-x-circle-fill me-1"></i> Đã bán</span>
                        }
                    </div>
                </div>

                <div class="bg-light rounded-3 p-4 mb-4">
                    <small class="text-secondary d-block fw-bold mb-1" style="font-size: 12px; letter-spacing: 1px;">GIÁ BÁN NIÊM YẾT</small>
                    <div class="price-tag">@Model.Price.ToString("N0") <span style="font-size: 1.5rem;">VND</span></div>
                    <hr class="my-3 text-secondary opacity-25">
                    <div class="row text-secondary" style="font-size: 13px;">
                        <div class="col-6">
                            <i class="bi bi-shield-check text-success me-1"></i> Bảo hành chính hãng
                        </div>
                        <div class="col-6">
                            <i class="bi bi-patch-check text-success me-1"></i> Cam kết chất lượng
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold text-dark mb-2">Giới thiệu mẫu xe</h5>
                    <p class="text-muted" style="line-height: 1.6;">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "Chưa có mô tả chi tiết từ showroom cho mẫu xe này. Vui lòng liên hệ trực tiếp showroom của chúng tôi để được tư vấn kĩ hơn về các thông số kĩ thuật và ưu đãi đi kèm." : Model.Description)
                    </p>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6 col-sm-3">
                        <div class="spec-item">
                            <i class="bi bi-calendar-event text-danger fs-4 d-block mb-1"></i>
                            <small class="text-secondary d-block" style="font-size: 11px;">ĐỜI XE</small>
                            <span class="fw-bold text-dark">@Model.Year</span>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="spec-item">
                            <i class="bi bi-speedometer2 text-danger fs-4 d-block mb-1"></i>
                            <small class="text-secondary d-block" style="font-size: 11px;">SỐ KM ĐÃ ĐI</small>
                            <span class="fw-bold text-dark">@Model.Mileage.ToString("N0") km</span>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="spec-item">
                            <i class="bi bi-gear-fill text-danger fs-4 d-block mb-1"></i>
                            <small class="text-secondary d-block" style="font-size: 11px;">HỘP SỐ</small>
                            <span class="fw-bold text-dark">@(Model.Transmission == "Automatic" ? "Tự động" : "Số sàn")</span>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="spec-item">
                            <i class="bi bi-fuel-pump-fill text-danger fs-4 d-block mb-1"></i>
                            <small class="text-secondary d-block" style="font-size: 11px;">NHIÊN LIỆU</small>
                            <span class="fw-bold text-dark">@Model.FuelType</span>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold text-dark mb-2">Thông số kĩ thuật</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered specs-table bg-white">
                            <tbody>
                                <tr>
                                    <td class="fw-bold bg-light text-secondary" style="width: 35%;">Model / Phiên bản</td>
                                    <td>@Model.Model</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold bg-light text-secondary">Màu ngoại thất</td>
                                    <td>@Model.Color</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold bg-light text-secondary">Xuất xứ hãng</td>
                                    <td>@Model.Brand.Country</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold bg-light text-secondary">Thông tin hãng</td>
                                    <td class="text-muted" style="font-size: 13px;">@Model.Brand.Description</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="row g-3 mt-auto">
                    <div class="col-6">
                        <button class="btn btn-action-deposit w-100 d-flex align-items-center justify-content-center gap-2" onclick="alert('Tính năng Đặt Cọc sẽ được tích hợp ở luồng thanh toán sắp tới.')">
                            <i class="bi bi-cash-stack fs-5"></i>
                            <span>Đặt Cọc Xe</span>
                        </button>
                    </div>
                    <div class="col-6">
                        <button class="btn btn-action-buy w-100 d-flex align-items-center justify-content-center gap-2" onclick="alert('Tính năng Mua Đứt sẽ được tích hợp ở luồng thanh toán sắp tới.')">
                            <i class="bi bi-cart-check fs-5"></i>
                            <span>Mua Đứt Xe</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function() {
        const container = document.getElementById('car3dCanvasContainer');
        if (!container) return;
        
        container.style.position = 'relative';
        const debugDiv = document.createElement('div');
        debugDiv.id = 'debugConsoleLogOverlay';
        debugDiv.style.position = 'absolute';
        debugDiv.style.bottom = '10px';
        debugDiv.style.left = '10px';
        debugDiv.style.right = '10px';
        debugDiv.style.maxHeight = '120px';
        debugDiv.style.overflowY = 'auto';
        debugDiv.style.background = 'rgba(0,0,0,0.85)';
        debugDiv.style.color = '#00ff00';
        debugDiv.style.fontFamily = 'monospace';
        debugDiv.style.fontSize = '11px';
        debugDiv.style.padding = '8px';
        debugDiv.style.borderRadius = '4px';
        debugDiv.style.zIndex = '9999';
        debugDiv.style.pointerEvents = 'none';
        debugDiv.style.display = 'none';
        debugDiv.innerHTML = '<strong>Console Errors:</strong><br>';
        container.appendChild(debugDiv);
        
        window.logToDebug = function(msg, type = 'info') {
            if (msg.includes('warning X4122') || msg.includes('double precision') || msg.includes('precision')) {
                return;
            }
            if (type === 'error') {
                debugDiv.style.display = 'block';
            }
            const span = document.createElement('span');
            span.style.color = type === 'error' ? '#ff3333' : (type === 'warn' ? '#ffcc00' : '#00ff00');
            span.innerText = `[${type.toUpperCase()}] ${msg}`;
            debugDiv.appendChild(span);
            debugDiv.appendChild(document.createElement('br'));
            debugDiv.scrollTop = debugDiv.scrollHeight;
        };

        const originalLog = console.log;
        const originalError = console.error;
        const originalWarn = console.warn;
        
        console.log = function(...args) {
            originalLog.apply(console, args);
            window.logToDebug(args.map(a => typeof a === 'object' ? JSON.stringify(a) : a).join(' '), 'info');
        };
        console.error = function(...args) {
            originalError.apply(console, args);
            window.logToDebug(args.map(a => typeof a === 'object' ? JSON.stringify(a) : a).join(' '), 'error');
        };
        console.warn = function(...args) {
            originalWarn.apply(console, args);
            window.logToDebug(args.map(a => typeof a === 'object' ? JSON.stringify(a) : a).join(' '), 'warn');
        };

        window.addEventListener('error', function(e) {
            window.logToDebug(`${e.message} at ${e.filename}:${e.lineno}`, 'error');
        });
    })();
</script>

@Html.Raw("<script type=\"importmap\">{\n  \"imports\": {\n    \"three\": \"https://cdn.jsdelivr.net/npm/three@latest/build/three.module.js\",\n    \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@latest/examples/jsm/\"\n  }\n}</script>")

<script type="module">
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
    import { USDLoader } from 'three/addons/loaders/USDLoader.js';
    import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';

    const container = document.getElementById('car3dCanvasContainer');
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x1e293b);
    
    const gridHelper = new THREE.GridHelper(30, 30, 0x475569, 0x334155);
    gridHelper.position.y = -1.2;
    scene.add(gridHelper);

    const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 100);
    camera.position.set(6, 3, 8);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.shadowMap.enabled = true;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.3;
    container.appendChild(renderer.domElement);

    const pmremGenerator = new THREE.PMREMGenerator(renderer);
    scene.environment = pmremGenerator.fromScene(new RoomEnvironment(renderer), 0.04).texture;

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.minDistance = 3;
    controls.maxDistance = 15;
    controls.maxPolarAngle = Math.PI / 2 - 0.05;

    const ambientLight = new THREE.AmbientLight(0xffffff, 1.2);
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xffffff, 2.0);
    dirLight.position.set(10, 20, 10);
    scene.add(dirLight);

    const light2 = new THREE.DirectionalLight(0x38bdf8, 1.2);
    light2.position.set(-10, 5, -10);
    scene.add(light2);

    const frontLight = new THREE.DirectionalLight(0xffffff, 1.5);
    frontLight.position.set(0, 5, 15);
    scene.add(frontLight);

    const paintColorMap = {
        'blue':   0x1e3a5f,
        'red':    0x8b0000,
        'white':  0xe8e8e8,
        'black':  0x141414,
        'gray':   0x5a6472,
        'yellow': 0xc8960c
    };
    
    let initialColorHex = paintColorMap['white'];
    const dbColor = "@(Model.Color?.ToLower() ?? "blue")";
    if (dbColor.includes('red') || dbColor.includes('đỏ')) initialColorHex = paintColorMap['red'];
    else if (dbColor.includes('white') || dbColor.includes('trắng')) initialColorHex = paintColorMap['white'];
    else if (dbColor.includes('black') || dbColor.includes('đen')) initialColorHex = paintColorMap['black'];
    else if (dbColor.includes('gray') || dbColor.includes('xám') || dbColor.includes('ghi')) initialColorHex = paintColorMap['gray'];
    else if (dbColor.includes('yellow') || dbColor.includes('vàng')) initialColorHex = paintColorMap['yellow'];

    document.querySelectorAll('.color-swatch').forEach(swatch => {
        const colorName = swatch.getAttribute('data-color');
        if (paintColorMap[colorName] === initialColorHex) {
            document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('active'));
            swatch.classList.add('active');
        }
    });

    const paintMaterials = [];

    const loadingEl = document.createElement('div');
    loadingEl.style.position = 'absolute';
    loadingEl.style.top = '50%';
    loadingEl.style.left = '50%';
    loadingEl.style.transform = 'translate(-50%, -50%)';
    loadingEl.style.color = '#fff';
    loadingEl.style.fontFamily = 'sans-serif';
    loadingEl.style.fontWeight = 'bold';
    loadingEl.style.fontSize = '14px';
    loadingEl.innerHTML = '<div class="spinner-border text-warning me-2" role="status" style="width: 1.5rem; height: 1.5rem; vertical-align: middle;"></div> Đang tải mô hình 3D...';
    container.style.position = 'relative';
    container.appendChild(loadingEl);

    const loader = new USDLoader();
    let carModel = null;
    let autoRotate = true;

    loader.load(
        '/2020_Aston_Martin_DBS_GT_Zagato__www.vecarz.usdz',
        (usdz) => {
            if (loadingEl.parentNode) {
                loadingEl.parentNode.removeChild(loadingEl);
            }

            carModel = usdz;

            //
            //sarpaint
            //dbody, door, hood, bumper, mirror_c
            const BODY_MESH_KW  = ['dbody', 'door', 'hood', 'bumper', 'mirror_c'];
            const PAINT_MAT_KW  = ['sarpaint', 'paint', 'carpaint', 'car_paint', 'body_paint'];

            const isBodyPanel = (matName, meshName) =>
                PAINT_MAT_KW.some(k => matName.includes(k)) ||
                BODY_MESH_KW.some(k => meshName.includes(k));

            carModel.traverse((child) => {
                if (child.isMesh) {
                    child.castShadow = true;
                    child.receiveShadow = true;

                    if (child.material) {
                        const mats = Array.isArray(child.material) ? child.material : [child.material];
                        mats.forEach(mat => {
                            const matName  = (mat.name  || '').toLowerCase();
                            const meshName = (child.name || '').toLowerCase();

                            if (isBodyPanel(matName, meshName)) {
                                mat.roughness = 0.18;
                                mat.metalness = 0.85;
                                mat.userData.originalMap = mat.map || null;
                                paintMaterials.push(mat);
                            }
                        });
                    }
                }
            });

            console.log('[3D] Body paint materials detected:', paintMaterials.length);

            paintMaterials.forEach(mat => {
                mat.map = null;
                mat.color.setHex(initialColorHex);
                mat.needsUpdate = true;
            });

            carModel.scale.set(1.5, 1.5, 1.5);
            carModel.position.set(0, -0.6, 0);

            const box = new THREE.Box3().setFromObject(carModel);
            const center = box.getCenter(new THREE.Vector3());
            carModel.position.x += (carModel.position.x - center.x);
            carModel.position.z += (carModel.position.z - center.z);
            carModel.position.y += (-1.2 - box.min.y);

            let logText = "";
            carModel.traverse(child => {
                if (child.isMesh && child.material) {
                    const mats = Array.isArray(child.material) ? child.material : [child.material];
                    mats.forEach(mat => {
                        logText += `Mesh: ${child.name} | Mat: ${mat.name} | Color: ${mat.color.getHexString()} | Metal: ${mat.metalness} | Rough: ${mat.roughness} | Map: ${mat.map ? 'yes' : 'no'}\n`;
                    });
                }
            });
            const diagEl = document.createElement('pre');
            diagEl.id = 'debugMaterialsList';
            diagEl.style.display = 'none';
            diagEl.innerText = logText;
            document.body.appendChild(diagEl);

            scene.add(carModel);
        },
        undefined,
        (error) => {
            console.error('USD Loader Error:', error);
            loadingEl.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i> Không thể tải mô hình 3D.</span>';
        }
    );

    function animate() {
        requestAnimationFrame(animate);
        if (autoRotate && carModel) {
            carModel.rotation.y += 0.004;
        }
        controls.update();
        renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
    });

    document.querySelectorAll('.color-swatch').forEach(swatch => {
        swatch.addEventListener('click', () => {
            document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('active'));
            swatch.classList.add('active');
            const colorName = swatch.getAttribute('data-color');
            if (paintColorMap[colorName] !== undefined) {
                const targetColor = paintColorMap[colorName];
                
                paintMaterials.forEach(mat => {
                    mat.map = null;
                    mat.color.setHex(targetColor);
                    mat.roughness = 0.22;
                    mat.metalness = 0.8;
                    mat.needsUpdate = true;
                });
            }
        });
    });

    const rotateBtn = document.getElementById('btnRotateToggle');
    rotateBtn.addEventListener('click', () => {
        autoRotate = !autoRotate;
        if (autoRotate) {
            rotateBtn.innerHTML = '<i class="bi bi-pause-fill me-1"></i> Tự động xoay';
            rotateBtn.className = "btn btn-warning btn-sm fw-bold px-3 py-1.5 border-0 text-dark";
        } else {
            rotateBtn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Tự động xoay';
            rotateBtn.className = "btn btn-outline-warning btn-sm fw-bold px-3 py-1.5 text-warning";
        }
    });
</script>
