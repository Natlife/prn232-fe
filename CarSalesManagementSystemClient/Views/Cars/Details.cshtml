@model CarSalesManagementSystemClient.Models.CarViewModel
@{
    ViewData["Title"] = Model.CarName + " - Chi tiết xe";
    var displayImageUrl = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? "https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=600&q=80"
        : Model.ImageUrl;
}

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --car-detail-primary: #15171c;
        --car-detail-secondary: #24272e;
        --car-detail-accent: #f5b800;
        --car-detail-accent-hover: #ffca28;
        --car-detail-background: #f3f4f6;
        --car-detail-surface: #ffffff;
        --car-detail-border: #e5e7eb;
        --car-detail-text: #191b20;
        --car-detail-muted: #747983;
        --car-detail-success: #198754;
        --car-detail-danger: #dc3545;
        --car-detail-radius-lg: 26px;
        --car-detail-radius-md: 16px;
        --car-detail-shadow: 0 20px 55px rgba(17, 19, 24, 0.09);
    }

    .car-detail-page {
        min-height: 100vh;
        padding: 30px 0 76px;
        color: var(--car-detail-text);
        background: radial-gradient(circle at 94% 5%, rgba(245, 184, 0, 0.11), transparent 25%), var(--car-detail-background);
        font-family: 'Outfit', sans-serif;
    }

    .car-detail-container {
        width: 100%;
        max-width: 1440px;
        margin: 0 auto;
        padding-right: 26px;
        padding-left: 26px;
    }

    .car-detail-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 22px;
    }

    .car-detail-breadcrumb {
        margin: 0;
        padding: 0;
        background: transparent;
    }

        .car-detail-breadcrumb .breadcrumb-item {
            color: #92969e;
            font-size: 0.77rem;
            font-weight: 700;
        }

            .car-detail-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
                color: #b6b9bf;
            }

        .car-detail-breadcrumb a {
            color: var(--car-detail-muted);
            text-decoration: none;
            transition: color 0.2s ease;
        }

            .car-detail-breadcrumb a:hover {
                color: var(--car-detail-primary);
            }

        .car-detail-breadcrumb .active {
            color: #9a7300;
        }

    .car-detail-back {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 15px;
        color: #5f646d;
        background: #ffffff;
        border: 1px solid var(--car-detail-border);
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 800;
        text-decoration: none;
        box-shadow: 0 8px 20px rgba(17, 19, 24, 0.04);
        transition: all 0.22s ease;
    }

        .car-detail-back:hover {
            color: var(--car-detail-primary);
            border-color: #cfd2d7;
            transform: translateY(-2px);
        }

    .car-detail-hero {
        position: relative;
        min-height: 440px;
        display: flex;
        align-items: flex-end;
        margin-bottom: 26px;
        padding: 42px;
        border-radius: 30px;
        background: linear-gradient(90deg, rgba(8, 10, 14, 0.94) 0%, rgba(8, 10, 14, 0.7) 48%, rgba(8, 10, 14, 0.18) 100%), url('@displayImageUrl') center 55% / cover no-repeat;
        box-shadow: 0 25px 60px rgba(17, 19, 24, 0.18);
        overflow: hidden;
    }

        .car-detail-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 15% 20%, rgba(245, 184, 0, 0.16), transparent 30%);
            pointer-events: none;
        }

        .car-detail-hero::after {
            content: "DETAIL";
            position: absolute;
            top: -28px;
            right: 22px;
            color: rgba(255, 255, 255, 0.035);
            font-size: 9rem;
            font-weight: 900;
            letter-spacing: -0.08em;
            line-height: 1;
            pointer-events: none;
        }

    .car-detail-hero-content {
        position: relative;
        z-index: 2;
        max-width: 720px;
    }

    .car-detail-brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        color: var(--car-detail-accent);
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

        .car-detail-brand::before {
            content: "";
            width: 34px;
            height: 2px;
            background: var(--car-detail-accent);
        }

    .car-detail-title {
        margin: 0 0 17px;
        color: #ffffff;
        font-size: clamp(2.3rem, 5vw, 4.8rem);
        font-weight: 900;
        line-height: 1;
        letter-spacing: -0.055em;
    }

    .car-detail-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 13px;
        border: 1px solid transparent;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 800;
        backdrop-filter: blur(10px);
    }

    .car-detail-status-available {
        color: #d1fae5;
        background: rgba(25, 135, 84, 0.24);
        border-color: rgba(134, 239, 172, 0.25);
    }

    .car-detail-status-reserved {
        color: #fff3bf;
        background: rgba(245, 158, 11, 0.24);
        border-color: rgba(253, 230, 138, 0.28);
    }

    .car-detail-status-sold {
        color: #fecaca;
        background: rgba(220, 53, 69, 0.25);
        border-color: rgba(254, 202, 202, 0.25);
    }

    .car-detail-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(420px, 0.95fr);
        gap: 26px;
        align-items: start;
    }

    .car-detail-column {
        display: grid;
        gap: 24px;
    }

    .car-detail-card {
        background: var(--car-detail-surface);
        border: 1px solid var(--car-detail-border);
        border-radius: var(--car-detail-radius-lg);
        box-shadow: var(--car-detail-shadow);
        overflow: hidden;
    }

    .car-detail-image-card {
        position: relative;
        min-height: 390px;
        background: #e9ebee;
    }

    .car-detail-image {
        width: 100%;
        height: 100%;
        min-height: 390px;
        object-fit: cover;
        display: block;
        transition: transform 0.5s ease;
    }

    .car-detail-image-card:hover .car-detail-image {
        transform: scale(1.035);
    }

    .car-detail-image-label {
        position: absolute;
        left: 20px;
        bottom: 20px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 13px;
        color: #ffffff;
        background: rgba(17, 19, 24, 0.68);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 12px;
        font-size: 0.72rem;
        font-weight: 800;
        backdrop-filter: blur(10px);
    }

    .car-3d-card {
        padding: 24px;
    }

    .car-detail-section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 18px;
    }

    .car-detail-section-title-group {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .car-detail-section-icon {
        flex: 0 0 auto;
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--car-detail-primary);
        background: var(--car-detail-accent);
        border-radius: 13px;
        font-size: 1.05rem;
        box-shadow: 0 10px 24px rgba(245, 184, 0, 0.2);
    }

    .car-detail-section-title {
        margin: 0 0 3px;
        color: var(--car-detail-primary);
        font-size: 1rem;
        font-weight: 900;
    }

    .car-detail-section-subtitle {
        margin: 0;
        color: var(--car-detail-muted);
        font-size: 0.73rem;
    }

    .car-rotate-button {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 8px 12px;
        color: var(--car-detail-primary);
        background: var(--car-detail-accent);
        border: 1px solid var(--car-detail-accent);
        border-radius: 11px;
        font-size: 0.7rem;
        font-weight: 900;
        transition: all 0.2s ease;
    }

        .car-rotate-button:hover {
            color: var(--car-detail-primary);
            background: var(--car-detail-accent-hover);
            border-color: var(--car-detail-accent-hover);
            transform: translateY(-2px);
        }

    .canvas-container {
        position: relative;
        width: 100%;
        height: 430px;
        background: radial-gradient(circle at 50% 30%, #293140, #0c0f15 72%);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 20px;
        overflow: hidden;
    }

    #car3dCanvasContainer {
        width: 100%;
        height: 100%;
    }

    .car-color-panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-top: 20px;
        padding: 15px 16px;
        background: #f8f9fa;
        border: 1px solid var(--car-detail-border);
        border-radius: 14px;
    }

    .car-color-copy strong {
        display: block;
        color: var(--car-detail-primary);
        font-size: 0.76rem;
        font-weight: 900;
    }

    .car-color-copy span {
        color: var(--car-detail-muted);
        font-size: 0.69rem;
    }

    .car-color-list {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 9px;
    }

    .color-swatch {
        width: 30px;
        height: 30px;
        display: inline-block;
        margin: 0;
        border: 3px solid #ffffff;
        border-radius: 50%;
        box-shadow: 0 0 0 1px #cbd0d7;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .color-swatch:hover {
            transform: scale(1.12);
        }

        .color-swatch.active {
            box-shadow: 0 0 0 3px var(--car-detail-accent);
            transform: scale(1.12);
        }

    .car-info-card {
        padding: 28px;
    }

    .car-price-box {
        position: relative;
        margin-bottom: 24px;
        padding: 23px;
        color: #ffffff;
        background: radial-gradient(circle at 90% 10%, rgba(245, 184, 0, 0.16), transparent 30%), linear-gradient(135deg, var(--car-detail-primary), var(--car-detail-secondary));
        border-radius: 20px;
        overflow: hidden;
    }

    .car-price-label {
        display: block;
        margin-bottom: 7px;
        color: rgba(255, 255, 255, 0.55);
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .car-price-value {
        margin-bottom: 16px;
        color: var(--car-detail-accent);
        font-size: clamp(2rem, 4vw, 2.8rem);
        font-weight: 900;
        letter-spacing: -0.045em;
        line-height: 1;
    }

    .car-price-currency {
        font-size: 0.95rem;
        letter-spacing: 0;
    }

    .car-assurance-list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        padding-top: 15px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .car-assurance-item {
        display: flex;
        align-items: center;
        gap: 8px;
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.72rem;
    }

        .car-assurance-item i {
            color: var(--car-detail-accent);
        }

    .car-content-block {
        margin-bottom: 25px;
    }

    .car-content-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 11px;
        color: var(--car-detail-primary);
        font-size: 0.9rem;
        font-weight: 900;
    }

        .car-content-title i {
            color: #987100;
        }

    .car-description {
        margin: 0;
        color: var(--car-detail-muted);
        font-size: 0.86rem;
        line-height: 1.75;
    }

    .car-spec-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 25px;
    }

    .spec-item {
        min-height: 112px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 14px 9px;
        text-align: center;
        background: #f8f9fa;
        border: 1px solid var(--car-detail-border);
        border-radius: 14px;
        transition: all 0.25s ease;
    }

        .spec-item:hover {
            background: #ffffff;
            border-color: rgba(245, 184, 0, 0.55);
            box-shadow: 0 12px 25px rgba(17, 19, 24, 0.07);
            transform: translateY(-4px);
        }

        .spec-item i {
            margin-bottom: 9px;
            color: #a07800;
            font-size: 1.25rem;
        }

        .spec-item small {
            display: block;
            margin-bottom: 5px;
            color: #92969e;
            font-size: 0.61rem;
            font-weight: 800;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .spec-item span {
            color: var(--car-detail-primary);
            font-size: 0.76rem;
            font-weight: 900;
            word-break: break-word;
        }

    .car-tech-table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        overflow: hidden;
        border: 1px solid var(--car-detail-border);
        border-radius: 14px;
    }

        .car-tech-table td {
            padding: 13px 15px;
            border-bottom: 1px solid #eceef1;
            font-size: 0.78rem;
            vertical-align: top;
        }

        .car-tech-table tr:last-child td {
            border-bottom: 0;
        }

        .car-tech-table td:first-child {
            width: 35%;
            color: #6f747d;
            background: #f8f9fa;
            font-weight: 800;
        }

        .car-tech-table td:last-child {
            color: var(--car-detail-primary);
            background: #ffffff;
        }

    .car-add-cart-button {
        width: 100%;
        min-height: 56px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 20px;
        color: var(--car-detail-primary);
        background: var(--car-detail-accent);
        border: 1px solid var(--car-detail-accent);
        border-radius: 14px;
        font-size: 0.82rem;
        font-weight: 900;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        box-shadow: 0 14px 32px rgba(245, 184, 0, 0.22);
        transition: all 0.24s ease;
    }

        .car-add-cart-button:hover:not(:disabled) {
            color: var(--car-detail-primary);
            background: var(--car-detail-accent-hover);
            border-color: var(--car-detail-accent-hover);
            transform: translateY(-3px);
            box-shadow: 0 19px 40px rgba(245, 184, 0, 0.3);
        }

        .car-add-cart-button:disabled {
            cursor: not-allowed;
            opacity: 0.65;
        }

    .deposit-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 16px;
        background: rgba(5, 7, 10, 0.72);
        backdrop-filter: blur(8px);
    }

        .deposit-modal-overlay.active {
            display: flex;
        }

    .deposit-modal-box {
        position: relative;
        width: 100%;
        max-width: 480px;
        padding: 34px 30px;
        background: #ffffff;
        border: 1px solid var(--car-detail-border);
        border-radius: 24px;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.25);
        animation: slideUp 0.3s ease;
    }

    @@keyframes slideUp {
        from {
            transform: translateY(40px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .deposit-step {
        display: none;
    }

        .deposit-step.active {
            display: block;
        }

    .deposit-phone-badge {
        margin: 20px 0;
        padding: 18px 20px;
        text-align: center;
        background: linear-gradient(135deg, #fff8d6, #fde68a);
        border: 1px solid #f5c842;
        border-radius: 14px;
    }

        .deposit-phone-badge .phone-number {
            color: #805f00;
            font-size: 1.55rem;
            font-weight: 900;
            letter-spacing: 2px;
        }

    .deposit-info-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 10px;
        padding: 11px 14px;
        background: #f8f9fa;
        border: 1px solid var(--car-detail-border);
        border-radius: 11px;
        font-size: 0.78rem;
    }

        .deposit-info-row .label {
            color: var(--car-detail-muted);
        }

        .deposit-info-row .value {
            color: var(--car-detail-primary);
            font-weight: 800;
        }

    .captcha-input {
        width: 100%;
        padding: 14px;
        color: var(--car-detail-primary);
        background: #ffffff;
        border: 2px solid var(--car-detail-border);
        border-radius: 13px;
        outline: none;
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: 6px;
        text-align: center;
        text-transform: uppercase;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .captcha-input:focus {
            border-color: var(--car-detail-accent);
            box-shadow: 0 0 0 4px rgba(245, 184, 0, 0.14);
        }

    .btn-deposit-submit {
        width: 100%;
        margin-top: 16px;
        padding: 14px;
        color: var(--car-detail-primary);
        background: var(--car-detail-accent);
        border: 1px solid var(--car-detail-accent);
        border-radius: 13px;
        font-size: 0.85rem;
        font-weight: 900;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .btn-deposit-submit:hover:not(:disabled) {
            background: var(--car-detail-accent-hover);
            border-color: var(--car-detail-accent-hover);
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(245, 184, 0, 0.25);
        }

        .btn-deposit-submit:disabled {
            cursor: not-allowed;
            opacity: 0.6;
        }

    .deposit-success-icon {
        margin-bottom: 12px;
        font-size: 4rem;
        animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes popIn {
        from {
            transform: scale(0);
        }

        to {
            transform: scale(1);
        }
    }

    @@media (max-width: 1199.98px) {
        .car-detail-grid {
            grid-template-columns: minmax(0, 1fr) minmax(380px, 0.95fr);
        }

        .car-spec-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 991.98px) {
        .car-detail-grid {
            grid-template-columns: 1fr;
        }

        .car-detail-info-column {
            order: -1;
        }

        .car-detail-hero {
            min-height: 390px;
        }
    }

    @@media (max-width: 767.98px) {
        .car-detail-page {
            padding-top: 22px;
        }

        .car-detail-container {
            padding-right: 14px;
            padding-left: 14px;
        }

        .car-detail-topbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .car-detail-hero {
            min-height: 350px;
            padding: 28px 22px;
            border-radius: 22px;
            background: linear-gradient(to top, rgba(8, 10, 14, 0.94), rgba(8, 10, 14, 0.3)), url('@displayImageUrl') center / cover no-repeat;
        }

            .car-detail-hero::after {
                display: none;
            }

        .car-detail-card {
            border-radius: 20px;
        }

        .car-info-card,
        .car-3d-card {
            padding: 21px 18px;
        }

        .canvas-container {
            height: 350px;
        }

        .car-color-panel {
            align-items: flex-start;
            flex-direction: column;
        }

        .car-color-list {
            justify-content: flex-start;
        }
    }

    @@media (max-width: 575.98px) {
        .car-detail-title {
            font-size: 2.35rem;
        }

        .car-detail-image-card,
        .car-detail-image {
            min-height: 270px;
        }

        .car-detail-section-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .car-rotate-button {
            width: 100%;
        }

        .canvas-container {
            height: 300px;
        }

        .car-price-box {
            padding: 20px;
        }

        .car-assurance-list {
            grid-template-columns: 1fr;
        }

        .car-tech-table td {
            display: block;
            width: 100% !important;
        }

            .car-tech-table td:first-child {
                border-bottom: 0;
            }
    }

    @@media (prefers-reduced-motion: reduce) {
        .car-detail-back,
        .car-rotate-button,
        .car-add-cart-button,
        .color-swatch,
        .spec-item,
        .car-detail-image {
            transition: none;
        }

            .car-detail-back:hover,
            .car-rotate-button:hover,
            .car-add-cart-button:hover:not(:disabled),
            .spec-item:hover {
                transform: none;
            }
    }
</style>

<main class="car-detail-page">
    <div class="car-detail-container">
        <div class="car-detail-topbar">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb car-detail-breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Cars" asp-action="Index">Showroom</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.CarName</li>
                </ol>
            </nav>

            <a asp-action="Index" class="car-detail-back">
                <i class="bi bi-arrow-left"></i>
                Quay lại showroom
            </a>
        </div>

        <section class="car-detail-hero">
            <div class="car-detail-hero-content">
                <div class="car-detail-brand">@Model.Brand.BrandName</div>
                <h1 class="car-detail-title">@Model.CarName</h1>

                @if (Model.Status == "Available")
                {
                    <span class="car-detail-status car-detail-status-available">
                        <i class="bi bi-check-circle-fill"></i>
                        Sẵn sàng bàn giao
                    </span>
                }
                else if (Model.Status == "Reserved")
                {
                    <span class="car-detail-status car-detail-status-reserved">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        Đang được đặt cọc giữ xe
                    </span>
                }
                else if (Model.Status == "Sold")
                {
                    <span class="car-detail-status car-detail-status-sold">
                        <i class="bi bi-x-circle-fill"></i>
                        Đã bán
                    </span>
                }
            </div>
        </section>

        <div class="car-detail-grid">
            <div class="car-detail-column">
                <section class="car-detail-card car-detail-image-card">
                    <img src="@displayImageUrl" alt="@Model.CarName" class="car-detail-image">
                    <div class="car-detail-image-label">
                        <i class="bi bi-image"></i>
                        Hình ảnh thực tế
                    </div>
                </section>

                <section class="car-detail-card car-3d-card">
                    <div class="car-detail-section-heading">
                        <div class="car-detail-section-title-group">
                            <div class="car-detail-section-icon">
                                <i class="bi bi-box-3d"></i>
                            </div>
                            <div>
                                <h2 class="car-detail-section-title">Góc nhìn 3D tương tác</h2>
                                <p class="car-detail-section-subtitle">Kéo để xoay, cuộn để phóng to hoặc thu nhỏ</p>
                            </div>
                        </div>

                        <button id="btnRotateToggle" class="car-rotate-button">
                            <i class="bi bi-pause-fill"></i>
                            Tự động xoay
                        </button>
                    </div>

                    <div class="canvas-container">
                        <div id="car3dCanvasContainer"></div>
                    </div>

                    <div class="car-color-panel">
                        <div class="car-color-copy">
                            <strong>Thử màu sơn xe 3D</strong>
                            <span>Chọn màu để xem trực tiếp trên mô hình</span>
                        </div>

                        <div class="car-color-list">
                            <div class="color-swatch active" data-color="blue" style="background-color:#3b82f6;" title="Xanh dương"></div>
                            <div class="color-swatch" data-color="red" style="background-color:#ef4444;" title="Đỏ"></div>
                            <div class="color-swatch" data-color="white" style="background-color:#f3f4f6;" title="Trắng"></div>
                            <div class="color-swatch" data-color="black" style="background-color:#111827;" title="Đen"></div>
                            <div class="color-swatch" data-color="gray" style="background-color:#6b7280;" title="Xám"></div>
                            <div class="color-swatch" data-color="yellow" style="background-color:#facc15;" title="Vàng"></div>
                        </div>
                    </div>
                </section>
            </div>

            <div class="car-detail-column car-detail-info-column">
                <section class="car-detail-card car-info-card">
                    <div class="car-price-box">
                        <span class="car-price-label">Giá bán niêm yết</span>
                        <div class="car-price-value">
                            @Model.Price.ToString("N0")
                            <span class="car-price-currency">VNĐ</span>
                        </div>

                        <div class="car-assurance-list">
                            <div class="car-assurance-item">
                                <i class="bi bi-shield-check"></i>
                                Bảo hành chính hãng
                            </div>
                            <div class="car-assurance-item">
                                <i class="bi bi-patch-check"></i>
                                Cam kết chất lượng
                            </div>
                        </div>
                    </div>

                    <div class="car-content-block">
                        <h2 class="car-content-title">
                            <i class="bi bi-card-text"></i>
                            Giới thiệu mẫu xe
                        </h2>
                        <p class="car-description">
                            @(string.IsNullOrWhiteSpace(Model.Description)
                                ? "Chưa có mô tả chi tiết từ showroom cho mẫu xe này. Vui lòng liên hệ trực tiếp showroom của chúng tôi để được tư vấn kỹ hơn về các thông số kỹ thuật và ưu đãi đi kèm."
                                : Model.Description)
                        </p>
                    </div>

                    <div class="car-spec-grid">
                        <div class="spec-item">
                            <i class="bi bi-calendar-event"></i>
                            <small>Đời xe</small>
                            <span>@Model.Year</span>
                        </div>

                        <div class="spec-item">
                            <i class="bi bi-speedometer2"></i>
                            <small>Số km đã đi</small>
                            <span>@Model.Mileage.ToString("N0") km</span>
                        </div>

                        <div class="spec-item">
                            <i class="bi bi-gear-fill"></i>
                            <small>Hộp số</small>
                            <span>@(Model.Transmission == "Automatic" ? "Tự động" : "Số sàn")</span>
                        </div>

                        <div class="spec-item">
                            <i class="bi bi-fuel-pump-fill"></i>
                            <small>Nhiên liệu</small>
                            <span>@Model.FuelType</span>
                        </div>
                    </div>

                    <div class="car-content-block">
                        <h2 class="car-content-title">
                            <i class="bi bi-sliders"></i>
                            Thông số kỹ thuật
                        </h2>

                        <div class="table-responsive">
                            <table class="car-tech-table">
                                <tbody>
                                    <tr>
                                        <td>Model / Phiên bản</td>
                                        <td>@Model.Model</td>
                                    </tr>
                                    <tr>
                                        <td>Màu ngoại thất</td>
                                        <td>@Model.Color</td>
                                    </tr>
                                    <tr>
                                        <td>Xuất xứ hãng</td>
                                        <td>@Model.Brand.Country</td>
                                    </tr>
                                    <tr>
                                        <td>Thông tin hãng</td>
                                        <td>@Model.Brand.Description</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <button id="btnAddCarToCart"
                            class="car-add-cart-button"
                            data-carid="@Model.CarId">
                        <i class="bi bi-cart-plus-fill"></i>
                        <span>Thêm vào giỏ hàng</span>
                    </button>
                </section>
            </div>
        </div>
    </div>
</main>

<script>
    (function() {
        const container = document.getElementById('car3dCanvasContainer');
        if (!container) return;

        container.style.position = 'relative';
        const debugDiv = document.createElement('div');
        debugDiv.id = 'debugConsoleLogOverlay';
        debugDiv.style.position = 'absolute';
        debugDiv.style.bottom = '10px';
        debugDiv.style.left = '10px';
        debugDiv.style.right = '10px';
        debugDiv.style.maxHeight = '120px';
        debugDiv.style.overflowY = 'auto';
        debugDiv.style.background = 'rgba(0,0,0,0.85)';
        debugDiv.style.color = '#00ff00';
        debugDiv.style.fontFamily = 'monospace';
        debugDiv.style.fontSize = '11px';
        debugDiv.style.padding = '8px';
        debugDiv.style.borderRadius = '4px';
        debugDiv.style.zIndex = '9999';
        debugDiv.style.pointerEvents = 'none';
        debugDiv.style.display = 'none';
        debugDiv.innerHTML = '<strong>Console Errors:</strong><br>';
        container.appendChild(debugDiv);

        window.logToDebug = function(msg, type = 'info') {
            if (msg.includes('warning X4122') || msg.includes('double precision') || msg.includes('precision')) {
                return;
            }
            if (type === 'error') {
                debugDiv.style.display = 'block';
            }
            const span = document.createElement('span');
            span.style.color = type === 'error' ? '#ff3333' : (type === 'warn' ? '#ffcc00' : '#00ff00');
            span.innerText = `[${type.toUpperCase()}] ${msg}`;
            debugDiv.appendChild(span);
            debugDiv.appendChild(document.createElement('br'));
            debugDiv.scrollTop = debugDiv.scrollHeight;
        };

        const originalLog = console.log;
        const originalError = console.error;
        const originalWarn = console.warn;

        console.log = function(...args) {
            originalLog.apply(console, args);
            window.logToDebug(args.map(a => typeof a === 'object' ? JSON.stringify(a) : a).join(' '), 'info');
        };
        console.error = function(...args) {
            originalError.apply(console, args);
            window.logToDebug(args.map(a => typeof a === 'object' ? JSON.stringify(a) : a).join(' '), 'error');
        };
        console.warn = function(...args) {
            originalWarn.apply(console, args);
            window.logToDebug(args.map(a => typeof a === 'object' ? JSON.stringify(a) : a).join(' '), 'warn');
        };

        window.addEventListener('error', function(e) {
            window.logToDebug(`${e.message} at ${e.filename}:${e.lineno}`, 'error');
        });
    })();
</script>

@Html.Raw("<script type=\"importmap\">{\n  \"imports\": {\n    \"three\": \"https://cdn.jsdelivr.net/npm/three@latest/build/three.module.js\",\n    \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@latest/examples/jsm/\"\n  }\n}</script>")

<script type="module">
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
    import { USDLoader } from 'three/addons/loaders/USDLoader.js';
    import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';

    const container = document.getElementById('car3dCanvasContainer');
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x1e293b);

    const gridHelper = new THREE.GridHelper(30, 30, 0x475569, 0x334155);
    gridHelper.position.y = -1.2;
    scene.add(gridHelper);

    const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 100);
    camera.position.set(6, 3, 8);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.shadowMap.enabled = true;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.3;
    container.appendChild(renderer.domElement);

    const pmremGenerator = new THREE.PMREMGenerator(renderer);
    scene.environment = pmremGenerator.fromScene(new RoomEnvironment(renderer), 0.04).texture;

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.minDistance = 3;
    controls.maxDistance = 15;
    controls.maxPolarAngle = Math.PI / 2 - 0.05;

    const ambientLight = new THREE.AmbientLight(0xffffff, 1.2);
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xffffff, 2.0);
    dirLight.position.set(10, 20, 10);
    scene.add(dirLight);

    const light2 = new THREE.DirectionalLight(0x38bdf8, 1.2);
    light2.position.set(-10, 5, -10);
    scene.add(light2);

    const frontLight = new THREE.DirectionalLight(0xffffff, 1.5);
    frontLight.position.set(0, 5, 15);
    scene.add(frontLight);

    const paintColorMap = {
        'blue': 0x1e3a5f,
        'red': 0x8b0000,
        'white': 0xe8e8e8,
        'black': 0x141414,
        'gray': 0x5a6472,
        'yellow': 0xc8960c
    };

    let initialColorHex = paintColorMap['white'];
    const dbColor = "@(Model.Color?.ToLower() ?? "blue")";
    if (dbColor.includes('red') || dbColor.includes('đỏ')) initialColorHex = paintColorMap['red'];
    else if (dbColor.includes('white') || dbColor.includes('trắng')) initialColorHex = paintColorMap['white'];
    else if (dbColor.includes('black') || dbColor.includes('den')) initialColorHex = paintColorMap['black'];
    else if (dbColor.includes('gray') || dbColor.includes('xám') || dbColor.includes('ghi')) initialColorHex = paintColorMap['gray'];
    else if (dbColor.includes('yellow') || dbColor.includes('vàng')) initialColorHex = paintColorMap['yellow'];

    document.querySelectorAll('.color-swatch').forEach(swatch => {
        const colorName = swatch.getAttribute('data-color');
        if (paintColorMap[colorName] === initialColorHex) {
            document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('active'));
            swatch.classList.add('active');
        }
    });

    const paintMaterials = [];

    const loadingEl = document.createElement('div');
    loadingEl.style.position = 'absolute';
    loadingEl.style.top = '50%';
    loadingEl.style.left = '50%';
    loadingEl.style.transform = 'translate(-50%, -50%)';
    loadingEl.style.color = '#fff';
    loadingEl.style.fontFamily = 'sans-serif';
    loadingEl.style.fontWeight = 'bold';
    loadingEl.style.fontSize = '14px';
    loadingEl.innerHTML = '<div class="spinner-border text-warning me-2" role="status" style="width: 1.5rem; height: 1.5rem; vertical-align: middle;"></div> Đang tải mô hình 3D...';
    container.style.position = 'relative';
    container.appendChild(loadingEl);

    const loader = new USDLoader();
    let carModel = null;
    let autoRotate = true;

    loader.load(
        '/2020_Aston_Martin_DBS_GT_Zagato__www.vecarz.usdz',
        (usdz) => {
            if (loadingEl.parentNode) {
                loadingEl.parentNode.removeChild(loadingEl);
            }

            carModel = usdz;

            //
            //sarpaint
            //dbody, door, hood, bumper, mirror_c
            const BODY_MESH_KW = ['dbody', 'door', 'hood', 'bumper', 'mirror_c'];
            const PAINT_MAT_KW = ['sarpaint', 'paint', 'carpaint', 'car_paint', 'body_paint'];

            const isBodyPanel = (matName, meshName) =>
                PAINT_MAT_KW.some(k => matName.includes(k)) ||
                BODY_MESH_KW.some(k => meshName.includes(k));

            carModel.traverse((child) => {
                if (child.isMesh) {
                    child.castShadow = true;
                    child.receiveShadow = true;

                    if (child.material) {
                        const mats = Array.isArray(child.material) ? child.material : [child.material];
                        mats.forEach(mat => {
                            const matName = (mat.name || '').toLowerCase();
                            const meshName = (child.name || '').toLowerCase();

                            if (isBodyPanel(matName, meshName)) {
                                mat.roughness = 0.18;
                                mat.metalness = 0.85;
                                mat.userData.originalMap = mat.map || null;
                                paintMaterials.push(mat);
                            }
                        });
                    }
                }
            });

            console.log('[3D] Body paint materials detected:', paintMaterials.length);

            paintMaterials.forEach(mat => {
                mat.map = null;
                mat.color.setHex(initialColorHex);
                mat.needsUpdate = true;
            });

            carModel.scale.set(1.5, 1.5, 1.5);
            carModel.position.set(0, -0.6, 0);

            const box = new THREE.Box3().setFromObject(carModel);
            const center = box.getCenter(new THREE.Vector3());
            carModel.position.x += (carModel.position.x - center.x);
            carModel.position.z += (carModel.position.z - center.z);
            carModel.position.y += (-1.2 - box.min.y);

            let logText = "";
            carModel.traverse(child => {
                if (child.isMesh && child.material) {
                    const mats = Array.isArray(child.material) ? child.material : [child.material];
                    mats.forEach(mat => {
                        logText += `Mesh: ${child.name} | Mat: ${mat.name} | Color: ${mat.color.getHexString()} | Metal: ${mat.metalness} | Rough: ${mat.roughness} | Map: ${mat.map ? 'yes' : 'no'}\n`;
                    });
                }
            });
            const diagEl = document.createElement('pre');
            diagEl.id = 'debugMaterialsList';
            diagEl.style.display = 'none';
            diagEl.innerText = logText;
            document.body.appendChild(diagEl);

            scene.add(carModel);
        },
        undefined,
        (error) => {
            console.error('USD Loader Error:', error);
            loadingEl.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i> Không thể tải mô hình 3D.</span>';
        }
    );

    function animate() {
        requestAnimationFrame(animate);
        if (autoRotate && carModel) {
            carModel.rotation.y += 0.004;
        }
        controls.update();
        renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
    });

    document.querySelectorAll('.color-swatch').forEach(swatch => {
        swatch.addEventListener('click', () => {
            document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('active'));
            swatch.classList.add('active');
            const colorName = swatch.getAttribute('data-color');
            if (paintColorMap[colorName] !== undefined) {
                const targetColor = paintColorMap[colorName];

                paintMaterials.forEach(mat => {
                    mat.map = null;
                    mat.color.setHex(targetColor);
                    mat.roughness = 0.22;
                    mat.metalness = 0.8;
                    mat.needsUpdate = true;
                });
            }
        });
    });

    const rotateBtn = document.getElementById('btnRotateToggle');
    rotateBtn.addEventListener('click', () => {
        autoRotate = !autoRotate;
        if (autoRotate) {
            rotateBtn.innerHTML = '<i class="bi bi-pause-fill me-1"></i> Tự động xoay';
            rotateBtn.className = "car-rotate-button";
        } else {
            rotateBtn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Tự động xoay';
            rotateBtn.className = "car-rotate-button";
        }
    });

    // ===== Thêm xe vào giỏ hàng chung (captcha dùng chung theo hóa đơn master) =====
    const isAuthenticatedCar = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
    const btnAddCarToCart = document.getElementById('btnAddCarToCart');
    btnAddCarToCart?.addEventListener('click', async () => {
        if (!isAuthenticatedCar) {
            if (window.Swal) {
                const r = await window.Swal.fire({
                    title: 'Yêu cầu đăng nhập!',
                    text: 'Vui lòng đăng nhập để thêm xe vào giỏ hàng.',
                    icon: 'warning', showCancelButton: true,
                    confirmButtonColor: '#ffc107', cancelButtonColor: '#262626',
                    confirmButtonText: 'Đăng nhập', cancelButtonText: 'Hủy'
                });
                if (r.isConfirmed) window.location.href = '/Auth/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
            } else if (confirm('Vui lòng đăng nhập để thêm xe vào giỏ hàng. Đi đến trang đăng nhập?')) {
                window.location.href = '/Auth/Login';
            }
            return;
        }

        const carId = parseInt(btnAddCarToCart.dataset.carid);
        const original = btnAddCarToCart.innerHTML;
        btnAddCarToCart.disabled = true;
        btnAddCarToCart.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang thêm...';

        try {
            const body = new URLSearchParams({ itemType: 'Car', itemId: String(carId), quantity: '1' });
            const resp = await fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body.toString()
            });
            const res = await resp.json();
            btnAddCarToCart.disabled = false;
            btnAddCarToCart.innerHTML = original;

            if (res.success) {
                const badge = document.getElementById('navbarCartCount');
                if (badge && res.cartCount !== undefined) badge.textContent = res.cartCount;

                if (window.Swal) {
                    const r = await window.Swal.fire({
                        title: 'Đã thêm xe vào giỏ hàng!',
                        text: 'Bạn có muốn đến giỏ hàng để tiến hành thủ tục?',
                        icon: 'success', showCancelButton: true,
                        confirmButtonColor: '#ffc107', cancelButtonColor: '#262626',
                        confirmButtonText: 'Đến giỏ hàng', cancelButtonText: 'Tiếp tục xem xe'
                    });
                    if (r.isConfirmed) window.location.href = '/Cart';
                } else if (confirm('Đã thêm xe vào giỏ hàng. Đến giỏ hàng ngay?')) {
                    window.location.href = '/Cart';
                }
            } else {
                if (window.Swal) window.Swal.fire('Không thể thêm', res.message || 'Xe không khả dụng.', 'error');
                else alert(res.message || 'Không thể thêm xe vào giỏ hàng.');
            }
        } catch (err) {
            btnAddCarToCart.disabled = false;
            btnAddCarToCart.innerHTML = original;
            if (window.Swal) window.Swal.fire('Lỗi!', 'Đã xảy ra lỗi kết nối.', 'error');
            else alert('Đã xảy ra lỗi kết nối.');
        }
    });

</script>
