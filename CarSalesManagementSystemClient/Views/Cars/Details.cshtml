@model CarSalesManagementSystemClient.Models.CarViewModel
@{
    ViewData["Title"] = Model.CarName + " - Chi ti?t xe";
    var displayImageUrl = string.IsNullOrWhiteSpace(Model.ImageUrl) 
        ? "https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=600&q=80" 
        : Model.ImageUrl;
}

<!-- Google Fonts & Stylesheets -->
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    body {
        background-color: #f8f9fa;
    }
    .font-outfit {
        font-family: 'Outfit', sans-serif;
    }
    .detail-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        overflow: hidden;
    }
    .badge-status {
        font-size: 0.85rem;
        padding: 8px 16px;
        border-radius: 50px;
        font-weight: 600;
    }
    .price-tag {
        font-size: 2.2rem;
        font-weight: 800;
        color: #dc3545;
    }
    .spec-item {
        background-color: #fff;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 16px;
        transition: all 0.3s ease;
        text-align: center;
    }
    .spec-item:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
        border-color: #ffc107;
    }
    .btn-action-buy {
        background: linear-gradient(135deg, #28a745, #218838);
        color: white;
        border: none;
        font-weight: 700;
        padding: 16px;
        border-radius: 12px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .btn-action-buy:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(40,167,69,0.3);
        color: white;
    }
    .btn-action-deposit {
        background: linear-gradient(135deg, #ffc107, #e0a800);
        color: #1f2937;
        border: none;
        font-weight: 700;
        padding: 16px;
        border-radius: 12px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .btn-action-deposit:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255,193,7,0.3);
        color: #1f2937;
    }
    .canvas-container {
        position: relative;
        width: 100%;
        height: 400px;
        background: radial-gradient(circle, #1e293b, #0f172a);
        border-radius: 16px;
        overflow: hidden;
    }
    #car3dCanvasContainer {
        width: 100%;
        height: 100%;
    }
    .color-swatch {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        cursor: pointer;
        display: inline-block;
        margin-right: 10px;
        border: 2px solid #fff;
        box-shadow: 0 0 0 1px #cbd5e1;
        transition: all 0.2s ease;
    }
    .color-swatch.active {
        box-shadow: 0 0 0 2px #ffc107;
        transform: scale(1.15);
    }
    .specs-table td {
        padding: 12px 16px;
    }
    /* ?? Deposit Modal ??????????????????????????? */
    .deposit-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.65);
        backdrop-filter: blur(4px);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }
    .deposit-modal-overlay.active { display: flex; }
    .deposit-modal-box {
        background: #fff;
        border-radius: 20px;
        width: 100%;
        max-width: 480px;
        margin: 16px;
        padding: 36px 32px;
        box-shadow: 0 24px 60px rgba(0,0,0,0.2);
        animation: slideUp 0.3s ease;
        position: relative;
    }
    @@keyframes slideUp {
        from { transform: translateY(40px); opacity: 0; }
        to   { transform: translateY(0);    opacity: 1; }
    }
    .deposit-step { display: none; }
    .deposit-step.active { display: block; }
    .deposit-phone-badge {
        background: linear-gradient(135deg, #fef3c7, #fde68a);
        border: 2px solid #fbbf24;
        border-radius: 14px;
        padding: 18px 20px;
        margin: 20px 0;
        text-align: center;
    }
    .deposit-phone-badge .phone-number {
        font-size: 1.6rem;
        font-weight: 800;
        color: #92400e;
        letter-spacing: 2px;
    }
    .deposit-info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f8fafc;
        border-radius: 10px;
        padding: 10px 14px;
        margin-bottom: 10px;
        font-size: 14px;
    }
    .deposit-info-row .label { color: #64748b; }
    .deposit-info-row .value { font-weight: 700; color: #1e293b; }
    .captcha-input {
        font-size: 1.4rem;
        font-weight: 700;
        text-align: center;
        letter-spacing: 6px;
        text-transform: uppercase;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 14px;
        width: 100%;
        transition: border-color 0.2s;
    }
    .captcha-input:focus {
        outline: none;
        border-color: #fbbf24;
        box-shadow: 0 0 0 3px rgba(251,191,36,0.2);
    }
    .btn-deposit-submit {
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        color: #1f2937;
        border: none;
        border-radius: 12px;
        font-weight: 800;
        font-size: 1rem;
        padding: 14px;
        width: 100%;
        cursor: pointer;
        transition: all 0.2s;
        margin-top: 16px;
    }
    .btn-deposit-submit:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(251,191,36,0.4);
    }
    .btn-deposit-submit:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }
    .deposit-success-icon {
        font-size: 4rem;
        margin-bottom: 12px;
        animation: popIn 0.4s cubic-bezier(0.175,0.885,0.32,1.275);
    }
    @@keyframes popIn {
        from { transform: scale(0); } to { transform: scale(1); }
    }
</style>

