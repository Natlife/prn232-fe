@model IEnumerable<CarSalesManagementSystemClient.Models.PurchaseRequestHistoryViewModel>
@{
    ViewData["Title"] = "L?ch s? giao d?ch";
}

<div class="container py-5 font-outfit" style="min-height: 70vh;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark">Trang ch?</a></li>
            <li class="breadcrumb-item"><a asp-controller="Cars" asp-action="Index" class="text-decoration-none text-dark">Showroom</a></li>
            <li class="breadcrumb-item active text-warning fw-bold" aria-current="page">L?ch s? giao d?ch</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-extrabold text-dark m-0">L?ch s? giao d?ch c?a b?n</h2>
            <p class="text-muted mb-0">Theo d?i th?ng tin d?t c?c v? mua d?t xe t?i Group7</p>
        </div>
        <a asp-action="Index" class="btn btn-warning fw-bold px-4 py-2.5 rounded-3 shadow-sm border-0 text-dark">
            <i class="bi bi-car-front-fill me-1"></i> D?n Showroom xem th?m xe
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Transaction List -->
    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5 px-4 rounded-4" style="background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(10px);">
            <div class="mb-4">
                <span class="display-1 text-muted">??</span>
            </div>
            <h4 class="fw-bold text-dark mb-2">Chua c? giao d?ch n?o</h4>
            <p class="text-muted mx-auto mb-4" style="max-width: 480px;">B?n chua th?c hi?n b?t k? giao d?ch d?t c?c gi? xe ho?c mua d?t n?o tr?n h? th?ng c?a ch?ng t?i.</p>
            <div>
                <a asp-action="Index" class="btn btn-outline-dark fw-bold px-4 py-2 rounded-3">Kh?m ph? Showroom ngay</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="py-3 px-4" style="font-weight: 600; font-size: 14px;">M? GD</th>
                            <th class="py-3" style="font-weight: 600; font-size: 14px;">Xe</th>
                            <th class="py-3" style="font-weight: 600; font-size: 14px;">H?nh th?c</th>
                            <th class="py-3 text-end" style="font-weight: 600; font-size: 14px;">S? ti?n</th>
                            <th class="py-3" style="font-weight: 600; font-size: 14px; padding-left: 20px;">Tr?ng th?i</th>
                            <th class="py-3" style="font-weight: 600; font-size: 14px;">Ng?y giao d?ch</th>
                            <th class="py-3" style="font-weight: 600; font-size: 14px;">M? Captcha</th>
                            <th class="py-3 px-4 text-center" style="font-weight: 600; font-size: 14px;">Thao t?c</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model)
                        {
                            var isDeposit = request.DepositExpiry.HasValue;
                            var defaultCarImg = "https://images.unsplash.com/photo-1617788138017-80ad40651399?auto=format&fit=crop&w=150&q=80";
                            var carImg = string.IsNullOrEmpty(request.Car?.ImageUrl) ? defaultCarImg : request.Car.ImageUrl;

                            <tr>
                                <td class="py-3 px-4 fw-bold text-secondary">
                                    #@request.RequestId
                                </td>
                                <td class="py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@carImg" alt="@(request.Car?.CarName ?? "Xe")" 
                                             class="rounded-3 object-fit-cover shadow-sm" 
                                             style="width: 70px; height: 45px;" 
                                             onerror="this.src='@defaultCarImg'">
                                        <div>
                                            <a asp-action="Details" asp-route-id="@request.CarId" class="fw-bold text-dark text-decoration-none hover-text-warning">
                                                @(request.Car?.CarName ?? "Th?ng tin xe kh?ng kh? d?ng")
                                            </a>
                                            <div class="text-muted" style="font-size: 12px;">@request.Car?.Model - D?i @request.Car?.Year</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3">
                                    @if (isDeposit)
                                    {
                                        <span class="badge bg-info text-dark fw-bold px-2.5 py-1.5 rounded-2">
                                            <i class="bi bi-cash-stack me-1"></i> D?t c?c gi? xe
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary text-white fw-bold px-2.5 py-1.5 rounded-2">
                                            <i class="bi bi-cart-check-fill me-1"></i> Mua d?t
                                        </span>
                                    }
                                </td>
                                <td class="py-3 text-end fw-bold text-dark">
                                    @(request.DepositAmount?.ToString("N0") ?? "0") VND
                                </td>
                                <td class="py-3" style="padding-left: 20px;">
                                    @if (request.Status == "Deposited" || (request.Status == "Pending" && isDeposit))
                                    {
                                        <span class="badge bg-warning text-dark fw-bold px-2 py-1.5 rounded-pill">
                                            <i class="bi bi-clock-history me-1"></i> Dang gi? c?c
                                        </span>
                                    }
                                    else if (request.Status == "Completed")
                                    {
                                        <span class="badge bg-success text-white fw-bold px-2 py-1.5 rounded-pill">
                                            <i class="bi bi-check-circle-fill me-1"></i> Th?nh c?ng
                                        </span>
                                    }
                                    else if (request.Status == "DepositExpired" || (request.Status == "Rejected" && isDeposit))
                                    {
                                        <span class="badge bg-danger text-white fw-bold px-2 py-1.5 rounded-pill">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> H?t h?n c?c
                                        </span>
                                    }
                                    else if (request.Status == "Pending")
                                    {
                                        <span class="badge bg-secondary text-white fw-bold px-2 py-1.5 rounded-pill">
                                            <i class="bi bi-hourglass-split me-1"></i> Dang x? l?
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark text-white fw-bold px-2 py-1.5 rounded-pill">
                                            @request.Status
                                        </span>
                                    }
                                </td>
                                <td class="py-3 text-secondary" style="font-size: 13px;">
                                    <div>@request.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                    @if (isDeposit && (request.Status == "Deposited" || request.Status == "Pending"))
                                    {
                                        <div class="text-danger fw-bold" style="font-size: 11px;">
                                            H?n c?c: @request.DepositExpiry?.ToString("dd/MM/yyyy")
                                        </div>
                                    }
                                </td>
                                <td class="py-3 font-monospace fw-bold text-uppercase text-secondary" style="font-size: 13px;">
                                    @(request.CaptchaCode ?? "N/A")
                                </td>
                                <td class="py-3 px-4 text-center">
                                    <button class="btn btn-sm btn-outline-dark fw-bold rounded-2 px-2.5" onclick="showTxDetails('@request.RequestId', '@(isDeposit ? "D?t c?c xe" : "Mua d?t xe")', '@(request.Car?.CarName)', '@(request.DepositAmount?.ToString("N0"))', '@request.Status', '@request.CreatedAt.ToString("dd/MM/yyyy HH:mm")', '@request.CaptchaCode')">
                                        <i class="bi bi-eye"></i> Chi ti?t
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Details Modal -->
<div class="modal fade font-outfit" id="txDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white border-0 py-3">
                <h5 class="modal-title fw-bold"><i class="bi text-warning bi-receipt me-2"></i>Chi ti?t giao d?ch</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <span id="mdIcon" class="display-3">??</span>
                    <h4 class="fw-bold text-dark mt-2 mb-1" id="mdCarName">Toyota Camry</h4>
                    <p class="text-muted mb-0" id="mdRequestId">M? giao d?ch: #12</p>
                </div>
                
                <hr class="opacity-25 my-3">
                
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary">Lo?i h?nh giao d?ch</span>
                    <span class="fw-bold text-dark" id="mdType">Mua d?t xe</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary">Tr?ng th?i</span>
                    <span class="fw-bold" id="mdStatus">Ho?n t?t</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary">Ng?y th?c hi?n</span>
                    <span class="fw-bold text-dark" id="mdDate">03/06/2026</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary">M? b?o m?t x?c th?c</span>
                    <span class="fw-bold font-monospace text-uppercase text-secondary" id="mdCaptcha">ABCXYZ</span>
                </div>
                
                <hr class="opacity-25 my-3">
                
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-dark" style="font-size: 16px;">S? ti?n giao d?ch</span>
                    <span class="fw-extrabold text-danger fs-5" id="mdAmount">1.350.000.000 VND</span>
                </div>
                
                <div class="alert alert-secondary mt-3 mb-0" style="font-size: 13px; border-radius: 10px;">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    N?u c? b?t k? th?c m?c n?o v? giao d?ch n?y, qu? kh?ch vui l?ng li?n h? Hotline h? tr?: <strong>0987 173 229</strong> d? du?c tr? gi?p s?m nh?t.
                </div>
            </div>
            <div class="modal-footer border-0 bg-light justify-content-center">
                <button type="button" class="btn btn-dark fw-bold px-4 py-2 rounded-3" data-bs-dismiss="modal">D?ng c?a s?</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showTxDetails(id, type, car, amount, status, date, captcha) {
            document.getElementById('mdRequestId').textContent = 'M? giao d?ch: #' + id;
            document.getElementById('mdType').textContent = type;
            document.getElementById('mdCarName').textContent = car || 'Kh?ng x?c d?nh';
            document.getElementById('mdAmount').textContent = amount + ' VND';
            document.getElementById('mdDate').textContent = date;
            document.getElementById('mdCaptcha').textContent = captcha || 'N/A';
            
            const statusEl = document.getElementById('mdStatus');
            statusEl.textContent = status;
            
            if (status === 'Deposited' || (status === 'Pending' && type.includes('c?c'))) {
                statusEl.className = 'fw-bold text-warning';
                document.getElementById('mdIcon').textContent = '??';
            } else if (status === 'Completed') {
                statusEl.className = 'fw-bold text-success';
                document.getElementById('mdIcon').textContent = '?';
            } else if (status === 'DepositExpired' || (status === 'Rejected' && type.includes('c?c'))) {
                statusEl.className = 'fw-bold text-danger';
                document.getElementById('mdIcon').textContent = '?';
            } else {
                statusEl.className = 'fw-bold text-secondary';
                document.getElementById('mdIcon').textContent = '??';
            }

            const myModal = new bootstrap.Modal(document.getElementById('txDetailsModal'));
            myModal.show();
        }
    </script>
}

<!-- Premium Styles -->
<style>
    .font-outfit {
        font-family: 'Outfit', sans-serif;
    }
    .fw-extrabold {
        font-weight: 800;
    }
    .badge-status {
        font-size: 12px;
        padding: 6px 12px;
        border-radius: 6px;
    }
    .specs-table td {
        padding: 12px 16px;
        font-size: 14px;
    }
</style>
