@model IEnumerable<CarSalesManagementSystemClient.Models.PurchaseRequestHistoryViewModel>

@{
    ViewData["Title"] = "Lịch sử giao dịch";
}

<style>
    :root {
        --history-primary: #17191e;
        --history-secondary: #252830;
        --history-accent: #f5b800;
        --history-accent-hover: #ffca28;
        --history-background: #f4f5f7;
        --history-surface: #ffffff;
        --history-border: #e5e7eb;
        --history-text: #1b1d22;
        --history-muted: #747983;
        --history-success: #198754;
        --history-danger: #dc3545;
        --history-warning: #f59e0b;
        --history-info: #0ea5e9;
        --history-radius-lg: 24px;
        --history-radius-md: 14px;
        --history-shadow: 0 18px 45px rgba(17, 19, 24, 0.08);
    }

    .transaction-history-page {
        min-height: 100vh;
        padding: 34px 0 72px;
        background: radial-gradient( circle at 95% 5%, rgba(245, 184, 0, 0.11), transparent 24% ), var(--history-background);
    }

    .transaction-history-container {
        width: 100%;
        max-width: 1480px;
        margin: 0 auto;
        padding-right: 28px;
        padding-left: 28px;
    }

    /* Breadcrumb */

    .transaction-breadcrumb {
        margin-bottom: 22px;
    }

        .transaction-breadcrumb .breadcrumb {
            margin-bottom: 0;
            padding: 0;
            background-color: transparent;
        }

        .transaction-breadcrumb .breadcrumb-item {
            color: #92969e;
            font-size: 0.78rem;
            font-weight: 700;
        }

            .transaction-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
                color: #b6b9bf;
            }

        .transaction-breadcrumb a {
            color: var(--history-muted);
            text-decoration: none;
            transition: color 0.2s ease;
        }

            .transaction-breadcrumb a:hover {
                color: var(--history-primary);
            }

        .transaction-breadcrumb .active {
            color: #987100;
        }

    /* Header */

    .transaction-page-header {
        position: relative;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 28px;
        margin-bottom: 26px;
        padding: 30px 34px;
        color: #ffffff;
        background: radial-gradient( circle at 91% 10%, rgba(245, 184, 0, 0.18), transparent 30% ), linear-gradient( 135deg, var(--history-primary), var(--history-secondary) );
        border-radius: var(--history-radius-lg);
        box-shadow: 0 20px 48px rgba(17, 19, 24, 0.16);
        overflow: hidden;
    }

        .transaction-page-header::after {
            content: "HISTORY";
            position: absolute;
            top: -32px;
            right: 22px;
            color: rgba(255, 255, 255, 0.035);
            font-size: 8rem;
            font-weight: 900;
            line-height: 1;
            letter-spacing: -0.08em;
            pointer-events: none;
        }

    .transaction-header-content,
    .transaction-header-action {
        position: relative;
        z-index: 2;
    }

    .transaction-header-label {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 10px;
        color: var(--history-accent);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.17em;
        text-transform: uppercase;
    }

        .transaction-header-label::before {
            content: "";
            width: 30px;
            height: 2px;
            background-color: var(--history-accent);
        }

    .transaction-page-title {
        margin: 0 0 9px;
        font-size: clamp(1.7rem, 3vw, 2.45rem);
        font-weight: 900;
        line-height: 1.15;
        letter-spacing: -0.04em;
    }

    .transaction-page-description {
        max-width: 680px;
        margin: 0;
        color: rgba(255, 255, 255, 0.62);
        font-size: 0.9rem;
        line-height: 1.65;
    }

    .transaction-showroom-button {
        min-height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 18px;
        color: var(--history-primary);
        background-color: var(--history-accent);
        border: 1px solid var(--history-accent);
        border-radius: 13px;
        font-size: 0.76rem;
        font-weight: 900;
        text-decoration: none;
        white-space: nowrap;
        box-shadow: 0 13px 30px rgba(245, 184, 0, 0.21);
        transition: transform 0.22s ease, background-color 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
    }

        .transaction-showroom-button:hover {
            color: var(--history-primary);
            background-color: var(--history-accent-hover);
            border-color: var(--history-accent-hover);
            transform: translateY(-2px);
            box-shadow: 0 17px 35px rgba(245, 184, 0, 0.28);
        }

    /* Alert */

    .transaction-alert {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        margin-bottom: 21px;
        padding: 14px 16px;
        color: #991b1b;
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 14px;
        font-size: 0.86rem;
        line-height: 1.55;
        box-shadow: 0 8px 25px rgba(17, 19, 24, 0.05);
    }

        .transaction-alert i {
            flex-shrink: 0;
            margin-top: 2px;
            color: var(--history-danger);
        }

        .transaction-alert .btn-close {
            margin-left: auto;
            padding: 3px;
            font-size: 0.68rem;
        }

    /* Empty state */

    .transaction-empty {
        padding: 82px 28px;
        text-align: center;
        background-color: var(--history-surface);
        border: 1px solid var(--history-border);
        border-radius: var(--history-radius-lg);
        box-shadow: var(--history-shadow);
    }

    .transaction-empty-icon {
        width: 92px;
        height: 92px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 23px;
        color: #937000;
        background-color: rgba(245, 184, 0, 0.12);
        border: 1px solid rgba(245, 184, 0, 0.23);
        border-radius: 27px;
        font-size: 2.25rem;
    }

    .transaction-empty-title {
        margin-bottom: 9px;
        color: var(--history-primary);
        font-size: 1.2rem;
        font-weight: 900;
    }

    .transaction-empty-description {
        max-width: 500px;
        margin: 0 auto 24px;
        color: var(--history-muted);
        font-size: 0.87rem;
        line-height: 1.7;
    }

    .transaction-empty-button {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        color: #ffffff;
        background-color: var(--history-primary);
        border: 1px solid var(--history-primary);
        border-radius: 12px;
        font-size: 0.76rem;
        font-weight: 800;
        text-decoration: none;
        transition: transform 0.22s ease, background-color 0.22s ease, box-shadow 0.22s ease;
    }

        .transaction-empty-button:hover {
            color: #ffffff;
            background-color: #282b32;
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(17, 19, 24, 0.18);
        }

    /* Transaction panel */

    .transaction-panel {
        overflow: hidden;
        background-color: var(--history-surface);
        border: 1px solid var(--history-border);
        border-radius: var(--history-radius-lg);
        box-shadow: var(--history-shadow);
    }

    .transaction-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 21px 25px;
        border-bottom: 1px solid var(--history-border);
    }

    .transaction-panel-heading {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .transaction-panel-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--history-primary);
        background-color: rgba(245, 184, 0, 0.13);
        border: 1px solid rgba(245, 184, 0, 0.22);
        border-radius: 13px;
        font-size: 1.08rem;
    }

    .transaction-panel-title {
        margin: 0 0 3px;
        color: var(--history-primary);
        font-size: 1rem;
        font-weight: 900;
    }

    .transaction-panel-subtitle {
        margin: 0;
        color: var(--history-muted);
        font-size: 0.74rem;
    }

    .transaction-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 32px;
        padding: 6px 13px;
        color: #805f00;
        background-color: #fff8d6;
        border: 1px solid #fde68a;
        border-radius: 999px;
        font-size: 0.73rem;
        font-weight: 800;
        white-space: nowrap;
    }

    /* Table */

    .transaction-table {
        margin-bottom: 0;
    }

        .transaction-table thead th {
            padding: 15px 16px;
            color: #777c85;
            background-color: #f8f9fa;
            border-bottom: 1px solid var(--history-border);
            font-size: 0.67rem;
            font-weight: 900;
            letter-spacing: 0.045em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .transaction-table tbody td {
            padding: 16px;
            color: #555a63;
            background-color: #ffffff;
            border-bottom: 1px solid #eff0f2;
            font-size: 0.78rem;
            vertical-align: middle;
        }

        .transaction-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .transaction-table tbody tr:hover td {
            background-color: #fbfbfc;
        }

    .transaction-id {
        color: #727780;
        font-size: 0.78rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .transaction-car {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 245px;
    }

    .transaction-car-image {
        flex: 0 0 auto;
        width: 76px;
        height: 52px;
        object-fit: cover;
        border: 1px solid var(--history-border);
        border-radius: 12px;
        box-shadow: 0 7px 17px rgba(17, 19, 24, 0.08);
    }

    .transaction-car-name {
        display: inline-block;
        margin-bottom: 4px;
        color: var(--history-primary);
        font-size: 0.84rem;
        font-weight: 900;
        text-decoration: none;
        transition: color 0.2s ease;
    }

        .transaction-car-name:hover {
            color: #a07800;
        }

    .transaction-car-meta {
        color: #92969e;
        font-size: 0.7rem;
        line-height: 1.45;
    }

    .transaction-type,
    .transaction-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border: 1px solid transparent;
        border-radius: 999px;
        font-size: 0.68rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .transaction-type-deposit {
        color: #075985;
        background-color: #e0f2fe;
        border-color: #bae6fd;
    }

    .transaction-type-buy {
        color: #3730a3;
        background-color: #e0e7ff;
        border-color: #c7d2fe;
    }

    .transaction-status-deposited {
        color: #8a6500;
        background-color: #fff8d6;
        border-color: #fde68a;
    }

    .transaction-status-completed {
        color: #166534;
        background-color: #dcfce7;
        border-color: #bbf7d0;
    }

    .transaction-status-expired {
        color: #991b1b;
        background-color: #fee2e2;
        border-color: #fecaca;
    }

    .transaction-status-pending {
        color: #52525b;
        background-color: #f1f2f4;
        border-color: #dedfe3;
    }

    .transaction-status-other {
        color: #ffffff;
        background-color: var(--history-primary);
        border-color: var(--history-primary);
    }

    .transaction-amount {
        color: var(--history-primary);
        font-size: 0.8rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .transaction-date {
        color: #666b74;
        font-size: 0.74rem;
        white-space: nowrap;
    }

    .transaction-expiry {
        margin-top: 4px;
        color: var(--history-danger);
        font-size: 0.67rem;
        font-weight: 800;
    }

    .transaction-captcha {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 82px;
        padding: 7px 10px;
        color: #50545c;
        background-color: #f5f6f7;
        border: 1px solid var(--history-border);
        border-radius: 9px;
        font-family: monospace;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .transaction-detail-button {
        min-height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 8px 11px;
        color: var(--history-primary);
        background-color: #ffffff;
        border: 1px solid var(--history-border);
        border-radius: 10px;
        font-size: 0.7rem;
        font-weight: 800;
        white-space: nowrap;
        transition: transform 0.2s ease, color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .transaction-detail-button:hover {
            color: var(--history-primary);
            background-color: var(--history-accent);
            border-color: var(--history-accent);
            transform: translateY(-2px);
            box-shadow: 0 9px 20px rgba(245, 184, 0, 0.19);
        }

    /* Modal */

    .transaction-modal .modal-dialog {
        max-width: 540px;
    }

    .transaction-modal .modal-content {
        overflow: hidden;
        background-color: var(--history-surface);
        border: 0;
        border-radius: 22px;
        box-shadow: 0 30px 80px rgba(17, 19, 24, 0.25);
    }

    .transaction-modal-header {
        position: relative;
        padding: 21px 24px;
        color: #ffffff;
        background: radial-gradient( circle at 90% 10%, rgba(245, 184, 0, 0.17), transparent 35% ), linear-gradient( 135deg, var(--history-primary), var(--history-secondary) );
        border: 0;
    }

    .transaction-modal-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        font-size: 1rem;
        font-weight: 900;
    }

        .transaction-modal-title i {
            color: var(--history-accent);
        }

    .transaction-modal-body {
        padding: 27px;
    }

    .transaction-modal-summary {
        margin-bottom: 22px;
        text-align: center;
    }

    .transaction-modal-icon {
        width: 76px;
        height: 76px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        color: #927000;
        background-color: rgba(245, 184, 0, 0.13);
        border: 1px solid rgba(245, 184, 0, 0.22);
        border-radius: 22px;
        font-size: 1.85rem;
    }

    .transaction-modal-car-name {
        margin-bottom: 5px;
        color: var(--history-primary);
        font-size: 1.2rem;
        font-weight: 900;
    }

    .transaction-modal-request-id {
        margin: 0;
        color: var(--history-muted);
        font-size: 0.78rem;
    }

    .transaction-modal-details {
        overflow: hidden;
        margin-bottom: 18px;
        border: 1px solid var(--history-border);
        border-radius: 15px;
    }

    .transaction-modal-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 13px 15px;
        border-bottom: 1px solid #eff0f2;
    }

        .transaction-modal-row:last-child {
            border-bottom: 0;
        }

    .transaction-modal-row-label {
        color: var(--history-muted);
        font-size: 0.77rem;
    }

    .transaction-modal-row-value {
        color: var(--history-primary);
        font-size: 0.78rem;
        font-weight: 800;
        text-align: right;
    }

    .transaction-modal-captcha {
        padding: 5px 8px;
        background-color: #f4f5f7;
        border-radius: 7px;
        font-family: monospace;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .transaction-modal-amount {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
        padding: 17px;
        background-color: #fffaf0;
        border: 1px solid #fde68a;
        border-radius: 15px;
    }

    .transaction-modal-amount-label {
        color: var(--history-primary);
        font-size: 0.82rem;
        font-weight: 800;
    }

    .transaction-modal-amount-value {
        color: #b42318;
        font-size: 1.08rem;
        font-weight: 900;
        text-align: right;
    }

    .transaction-modal-help {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin: 0;
        padding: 14px 15px;
        color: #565b64;
        background-color: #f5f6f7;
        border: 1px solid var(--history-border);
        border-radius: 13px;
        font-size: 0.75rem;
        line-height: 1.55;
    }

        .transaction-modal-help i {
            flex-shrink: 0;
            margin-top: 2px;
            color: #8d6a00;
        }

    .transaction-modal-footer {
        justify-content: center;
        padding: 16px 24px 22px;
        background-color: #ffffff;
        border: 0;
    }

    .transaction-modal-close {
        min-height: 43px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 10px 22px;
        color: #ffffff;
        background-color: var(--history-primary);
        border: 1px solid var(--history-primary);
        border-radius: 11px;
        font-size: 0.75rem;
        font-weight: 800;
    }

    /* Responsive */

    @@media (max-width: 1199.98px) {
        .transaction-history-container {
            padding-right: 22px;
            padding-left: 22px;
        }
    }

    @@media (max-width: 991.98px) {
        .transaction-page-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @@media (max-width: 767.98px) {
        .transaction-history-page {
            padding-top: 24px;
        }

        .transaction-history-container {
            padding-right: 14px;
            padding-left: 14px;
        }

        .transaction-page-header {
            padding: 24px 21px;
            border-radius: 20px;
        }

            .transaction-page-header::after {
                display: none;
            }

        .transaction-header-action,
        .transaction-showroom-button {
            width: 100%;
        }

        .transaction-panel {
            border-radius: 20px;
        }

        .transaction-panel-header {
            padding: 18px;
        }

        .transaction-table thead {
            display: none;
        }

        .transaction-table,
        .transaction-table tbody,
        .transaction-table tr,
        .transaction-table td {
            display: block;
            width: 100%;
        }

            .transaction-table tbody tr {
                padding: 18px;
                border-bottom: 1px solid var(--history-border);
            }

                .transaction-table tbody tr:last-child {
                    border-bottom: 0;
                }

            .transaction-table tbody td {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 18px;
                padding: 8px 0;
                border: 0;
                text-align: right;
            }

                .transaction-table tbody td::before {
                    content: attr(data-label);
                    flex: 0 0 108px;
                    color: #8b9098;
                    font-size: 0.66rem;
                    font-weight: 900;
                    letter-spacing: 0.04em;
                    text-align: left;
                    text-transform: uppercase;
                }

            .transaction-table tbody tr:hover td {
                background-color: transparent;
            }

        .transaction-car {
            justify-content: flex-end;
            min-width: 0;
        }

        .transaction-detail-button {
            margin-left: auto;
        }
    }

    @@media (max-width: 575.98px) {
        .transaction-page-title {
            font-size: 1.55rem;
        }

        .transaction-page-description {
            font-size: 0.82rem;
        }

        .transaction-panel-icon {
            display: none;
        }

        .transaction-panel-title {
            font-size: 0.92rem;
        }

        .transaction-table tbody td {
            align-items: flex-start;
        }

            .transaction-table tbody td::before {
                flex-basis: 88px;
            }

        .transaction-car-image {
            width: 68px;
            height: 48px;
        }

        .transaction-car-name {
            font-size: 0.79rem;
        }

        .transaction-modal-body {
            padding: 22px 18px;
        }

        .transaction-modal-row {
            align-items: flex-start;
        }

        .transaction-modal-amount {
            align-items: flex-start;
            flex-direction: column;
            gap: 7px;
        }

        .transaction-modal-amount-value {
            text-align: left;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .transaction-showroom-button,
        .transaction-empty-button,
        .transaction-detail-button {
            transition: none;
        }

            .transaction-showroom-button:hover,
            .transaction-empty-button:hover,
            .transaction-detail-button:hover {
                transform: none;
            }
    }
</style>

<main class="transaction-history-page">
    <div class="transaction-history-container">

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb"
             class="transaction-breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index">
                        Trang chủ
                    </a>
                </li>

                <li class="breadcrumb-item">
                    <a asp-controller="Cars" asp-action="Index">
                        Showroom
                    </a>
                </li>

                <li class="breadcrumb-item active"
                    aria-current="page">
                    Lịch sử giao dịch
                </li>
            </ol>
        </nav>

        <!-- Header -->
        <header class="transaction-page-header">
            <div class="transaction-header-content">
                <div class="transaction-header-label">
                    Transaction history
                </div>

                <h1 class="transaction-page-title">
                    Lịch sử giao dịch của bạn
                </h1>

                <p class="transaction-page-description">
                    Theo dõi thông tin đặt cọc và mua đứt xe tại Group7.
                </p>
            </div>

            <div class="transaction-header-action">
                <a asp-action="Index"
                   class="transaction-showroom-button">
                    <i class="bi bi-car-front-fill"></i>
                    Đến Showroom xem thêm xe
                </a>
            </div>
        </header>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="transaction-alert alert-dismissible fade show"
                 role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>

                <span>@TempData["ErrorMessage"]</span>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

        <!-- Transaction List -->
        @if (Model == null || !Model.Any())
        {
            <section class="transaction-empty">
                <div class="transaction-empty-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                <h2 class="transaction-empty-title">
                    Chưa có giao dịch nào
                </h2>

                <p class="transaction-empty-description">
                    Bạn chưa thực hiện bất kỳ giao dịch đặt cọc giữ xe hoặc
                    mua đứt nào trên hệ thống của chúng tôi.
                </p>

                <a asp-action="Index"
                   class="transaction-empty-button">
                    <i class="bi bi-car-front-fill"></i>
                    Khám phá Showroom ngay
                </a>
            </section>
        }
        else
        {
            <section class="transaction-panel">
                <div class="transaction-panel-header">
                    <div class="transaction-panel-heading">
                        <div class="transaction-panel-icon">
                            <i class="bi bi-receipt-cutoff"></i>
                        </div>

                        <div>
                            <h2 class="transaction-panel-title">
                                Danh sách giao dịch
                            </h2>

                            <p class="transaction-panel-subtitle">
                                Các yêu cầu đặt cọc và mua xe của bạn
                            </p>
                        </div>
                    </div>

                    <span class="transaction-count">
                        @Model.Count() giao dịch
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table transaction-table">
                        <thead>
                            <tr>
                                <th>Mã GD</th>
                                <th>Xe</th>
                                <th>Hình thức</th>
                                <th class="text-end">Số tiền</th>
                                <th>Trạng thái</th>
                                <th>Ngày giao dịch</th>
                                <th>Mã Captcha</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var request in Model)
                            {
                                var isDeposit = request.DepositExpiry.HasValue;
                                var defaultCarImg = "https://images.unsplash.com/photo-1617788138017-80ad40651399?auto=format&fit=crop&w=150&q=80";
                                var carImg = string.IsNullOrEmpty(request.Car?.ImageUrl)
                                    ? defaultCarImg
                                    : request.Car.ImageUrl;

                                <tr>
                                    <td data-label="Mã GD">
                                        <span class="transaction-id">
                                            #@request.RequestId
                                        </span>
                                    </td>

                                    <td data-label="Xe">
                                        <div class="transaction-car">
                                            <img src="@carImg"
                                                 alt="@(request.Car?.CarName ?? "Xe")"
                                                 class="transaction-car-image"
                                                 onerror="this.onerror=null; this.src='@defaultCarImg';" />

                                            <div>
                                                <a asp-action="Details"
                                                   asp-route-id="@request.CarId"
                                                   class="transaction-car-name">
                                                    @(request.Car?.CarName ?? "Thông tin xe không khả dụng")
                                                </a>

                                                <div class="transaction-car-meta">
                                                    @request.Car?.Model - Đời @request.Car?.Year
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td data-label="Hình thức">
                                        @if (isDeposit)
                                        {
                                            <span class="transaction-type transaction-type-deposit">
                                                <i class="bi bi-cash-stack"></i>
                                                Đặt cọc giữ xe
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="transaction-type transaction-type-buy">
                                                <i class="bi bi-cart-check-fill"></i>
                                                Mua đứt
                                            </span>
                                        }
                                    </td>

                                    <td data-label="Số tiền"
                                        class="text-end">
                                        <span class="transaction-amount">
                                            @(request.DepositAmount?.ToString("N0") ?? "0") VNĐ
                                        </span>
                                    </td>

                                    <td data-label="Trạng thái">
                                        @if (request.Status == "Deposited"
                                            || (request.Status == "Pending" && isDeposit))
                                        {
                                            <span class="transaction-status transaction-status-deposited">
                                                <i class="bi bi-clock-history"></i>
                                                Đang giữ cọc
                                            </span>
                                        }
                                        else if (request.Status == "Completed")
                                        {
                                            <span class="transaction-status transaction-status-completed">
                                                <i class="bi bi-check-circle-fill"></i>
                                                Thành công
                                            </span>
                                        }
                                        else if (request.Status == "DepositExpired"
                                            || (request.Status == "Rejected" && isDeposit))
                                        {
                                            <span class="transaction-status transaction-status-expired">
                                                <i class="bi bi-exclamation-triangle-fill"></i>
                                                Hết hạn cọc
                                            </span>
                                        }
                                        else if (request.Status == "Pending")
                                        {
                                            <span class="transaction-status transaction-status-pending">
                                                <i class="bi bi-hourglass-split"></i>
                                                Đang xử lý
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="transaction-status transaction-status-other">
                                                @request.Status
                                            </span>
                                        }
                                    </td>

                                    <td data-label="Ngày giao dịch">
                                        <div class="transaction-date">
                                            @request.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </div>

                                        @if (isDeposit
                                            && (request.Status == "Deposited"
                                                || request.Status == "Pending"))
                                        {
                                            <div class="transaction-expiry">
                                                Hạn cọc:
                                                @request.DepositExpiry?.ToString("dd/MM/yyyy")
                                            </div>
                                        }
                                    </td>

                                    <td data-label="Mã Captcha">
                                        <span class="transaction-captcha">
                                            @(request.CaptchaCode ?? "N/A")
                                        </span>
                                    </td>

                                    <td data-label="Thao tác"
                                        class="text-center">
                                        <button type="button"
                                                class="transaction-detail-button"
                                                onclick="showTxDetails('@request.RequestId', '@(isDeposit ? "Đặt cọc xe" : "Mua đứt xe")', '@(request.Car?.CarName)', '@(request.DepositAmount?.ToString("N0"))', '@request.Status', '@request.CreatedAt.ToString("dd/MM/yyyy HH:mm")', '@request.CaptchaCode')">
                                            <i class="bi bi-eye"></i>
                                            Chi tiết
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </div>
</main>

<!-- Details Modal -->
<div class="modal fade transaction-modal"
     id="txDetailsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header transaction-modal-header">
                <h2 class="transaction-modal-title">
                    <i class="bi bi-receipt"></i>
                    Chi tiết giao dịch
                </h2>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body transaction-modal-body">
                <div class="transaction-modal-summary">
                    <div id="mdIcon"
                         class="transaction-modal-icon">
                        <i class="bi bi-receipt"></i>
                    </div>

                    <h3 id="mdCarName"
                        class="transaction-modal-car-name">
                        Toyota Camry
                    </h3>

                    <p id="mdRequestId"
                       class="transaction-modal-request-id">
                        Mã giao dịch: #12
                    </p>
                </div>

                <div class="transaction-modal-details">
                    <div class="transaction-modal-row">
                        <span class="transaction-modal-row-label">
                            Loại hình giao dịch
                        </span>

                        <span id="mdType"
                              class="transaction-modal-row-value">
                            Mua đứt xe
                        </span>
                    </div>

                    <div class="transaction-modal-row">
                        <span class="transaction-modal-row-label">
                            Trạng thái
                        </span>

                        <span id="mdStatus"
                              class="transaction-modal-row-value">
                            Hoàn tất
                        </span>
                    </div>

                    <div class="transaction-modal-row">
                        <span class="transaction-modal-row-label">
                            Ngày thực hiện
                        </span>

                        <span id="mdDate"
                              class="transaction-modal-row-value">
                            03/06/2026
                        </span>
                    </div>

                    <div class="transaction-modal-row">
                        <span class="transaction-modal-row-label">
                            Mã bảo mật xác thực
                        </span>

                        <span id="mdCaptcha"
                              class="transaction-modal-row-value transaction-modal-captcha">
                            ABCXYZ
                        </span>
                    </div>
                </div>

                <div class="transaction-modal-amount">
                    <span class="transaction-modal-amount-label">
                        Số tiền giao dịch
                    </span>

                    <span id="mdAmount"
                          class="transaction-modal-amount-value">
                        1.350.000.000 VNĐ
                    </span>
                </div>

                <p class="transaction-modal-help">
                    <i class="bi bi-info-circle-fill"></i>

                    <span>
                        Nếu có bất kỳ thắc mắc nào về giao dịch này, quý khách
                        vui lòng liên hệ Hotline hỗ trợ:
                        <strong>0987 173 229</strong>
                        để được trợ giúp sớm nhất.
                    </span>
                </p>
            </div>

            <div class="modal-footer transaction-modal-footer">
                <button type="button"
                        class="transaction-modal-close"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i>
                    Đóng cửa sổ
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showTxDetails(id, type, car, amount, status, date, captcha) {
            document.getElementById('mdRequestId').textContent =
                'Mã giao dịch: #' + id;

            document.getElementById('mdType').textContent = type;

            document.getElementById('mdCarName').textContent =
                car || 'Không xác định';

            document.getElementById('mdAmount').textContent =
                amount + ' VNĐ';

            document.getElementById('mdDate').textContent = date;

            document.getElementById('mdCaptcha').textContent =
                captcha || 'N/A';

            const statusEl = document.getElementById('mdStatus');
            const iconEl = document.getElementById('mdIcon');

            statusEl.textContent = status;

            if (
                status === 'Deposited'
                || (status === 'Pending' && type.includes('cọc'))
            ) {
                statusEl.className =
                    'transaction-modal-row-value text-warning';

                iconEl.innerHTML =
                    '<i class="bi bi-clock-history"></i>';
            } else if (status === 'Completed') {
                statusEl.className =
                    'transaction-modal-row-value text-success';

                iconEl.innerHTML =
                    '<i class="bi bi-check-circle-fill"></i>';
            } else if (
                status === 'DepositExpired'
                || (status === 'Rejected' && type.includes('cọc'))
            ) {
                statusEl.className =
                    'transaction-modal-row-value text-danger';

                iconEl.innerHTML =
                    '<i class="bi bi-exclamation-triangle-fill"></i>';
            } else {
                statusEl.className =
                    'transaction-modal-row-value text-secondary';

                iconEl.innerHTML =
                    '<i class="bi bi-hourglass-split"></i>';
            }

            const myModal = new bootstrap.Modal(
                document.getElementById('txDetailsModal')
            );

            myModal.show();
        }
    </script>
}
