@model CarSalesManagementSystemClient.Models.PagedResultViewModel<CarSalesManagementSystemClient.Models.CarViewModel>
@{
    ViewData["Title"] = "Showroom Ô tô";
    var filter = ViewBag.Filter as CarSalesManagementSystemClient.Models.CarSearchViewModel ?? new CarSalesManagementSystemClient.Models.CarSearchViewModel();
    var brands = ViewBag.Brands as IEnumerable<CarSalesManagementSystemClient.Models.CarBrandViewModel> ?? new List<CarSalesManagementSystemClient.Models.CarBrandViewModel>();
}

<div class="container py-5">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="fw-bold text-dark border-start border-warning border-4 ps-3 m-0" style="font-family: 'Outfit', sans-serif;">
                SHOWROOM Ô TÔ
            </h1>
            <p class="text-secondary m-0 ps-3">Khám phá các mẫu xe đẳng cấp, sẵn sàng bàn giao</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <nav aria-label="breadcrumb" class="d-inline-block">
                <ol class="breadcrumb bg-transparent m-0 p-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark">Trang chủ</a></li>
                    <li class="breadcrumb-item active text-danger fw-bold" aria-current="page">Showroom</li>
                </ol>
            </nav>
        </div>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.ErrorMessage
        </div>
    }

    <div class="row">
        <!-- LEFT COLUMN: Advanced Filters -->
        <div class="col-lg-3 col-md-4 mb-4">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="m-0 fw-bold d-flex align-items-center">
                        <i class="bi bi-funnel-fill me-2 text-warning"></i> BỘ LỌC TÌM KIẾM
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form method="get" asp-controller="Cars" asp-action="Index" id="filterForm">
                        <input type="hidden" name="PageNumber" value="1" />
                        <input type="hidden" name="PageSize" value="@filter.PageSize" />

                        <!-- Search keyword -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark mb-2">Từ khóa tìm kiếm</label>
                            <div class="input-group mb-2">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-search text-secondary"></i></span>
                                <input type="text" name="SearchTerm" class="form-control bg-light border-0 py-2" placeholder="Tên xe, model..." value="@filter.SearchTerm" />
                            </div>
                            <button type="button" class="btn btn-outline-warning w-100 py-2 fw-bold text-dark d-flex align-items-center justify-content-center border-warning hover-dark-shadow" data-bs-toggle="modal" data-bs-target="#imageSearchModal" style="border-width: 2px;">
                                <i class="bi bi-camera-fill me-2 text-warning fs-5"></i> TÌM XE QUA ẢNH (AI)
                            </button>
                        </div>

                        <!-- Brand filter -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark mb-2">Hãng xe (Hãng sản xuất)</label>
                            <select name="BrandId" class="form-select bg-light border-0 py-2">
                                <option value="">Tất cả các hãng</option>
                                @foreach (var brand in brands)
                                {
                                    if (filter.BrandId == brand.BrandId)
                                    {
                                        <option value="@brand.BrandId" selected>@brand.BrandName</option>
                                    }
                                    else
                                    {
                                        <option value="@brand.BrandId">@brand.BrandName</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Price filter -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark mb-2">Khoảng giá (VND)</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="number" name="MinPrice" class="form-control bg-light border-0 py-2" placeholder="Giá tối thiểu" value="@(filter.MinPrice.HasValue ? filter.MinPrice.Value.ToString("F0") : "")" />
                                </div>
                                <div class="col-6">
                                    <input type="number" name="MaxPrice" class="form-control bg-light border-0 py-2" placeholder="Giá tối đa" value="@(filter.MaxPrice.HasValue ? filter.MaxPrice.Value.ToString("F0") : "")" />
                                </div>
                            </div>
                            <div class="mt-2 text-secondary" style="font-size: 12px;">
                                Ví dụ: 500,000,000 đến 1,500,000,000
                            </div>
                        </div>

                        <!-- Transmission filter -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark mb-2">Hộp số</label>
                            <div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="Transmission" id="transmissionAll" value="" @(string.IsNullOrEmpty(filter.Transmission) ? "checked" : "")>
                                    <label class="form-check-label text-secondary" for="transmissionAll">Tất cả</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="Transmission" id="transmissionAuto" value="Automatic" @(filter.Transmission == "Automatic" ? "checked" : "")>
                                    <label class="form-check-label text-secondary" for="transmissionAuto">Số tự động (Automatic)</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="Transmission" id="transmissionManual" value="Manual" @(filter.Transmission == "Manual" ? "checked" : "")>
                                    <label class="form-check-label text-secondary" for="transmissionManual">Số sàn (Manual)</label>
                                </div>
                            </div>
                        </div>

                        <!-- FuelType filter -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark mb-2">Loại nhiên liệu</label>
                            <select name="FuelType" class="form-select bg-light border-0 py-2">
                                <option value="">Tất cả các loại</option>
                                <option value="Gasoline" selected="@(filter.FuelType == "Gasoline")">Xăng (Gasoline)</option>
                                <option value="Diesel" selected="@(filter.FuelType == "Diesel")">Dầu (Diesel)</option>
                                <option value="Electric" selected="@(filter.FuelType == "Electric")">Điện (Electric)</option>
                                <option value="Hybrid" selected="@(filter.FuelType == "Hybrid")">Hybrid</option>
                            </select>
                        </div>

                        <!-- Sort option -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark mb-2">Sắp xếp theo</label>
                            <select name="SortBy" class="form-select bg-light border-0 py-2">
                                <option value="" selected="@(string.IsNullOrEmpty(filter.SortBy))">Mới nhất</option>
                                <option value="PriceAsc" selected="@(filter.SortBy == "PriceAsc")">Giá tăng dần</option>
                                <option value="PriceDesc" selected="@(filter.SortBy == "PriceDesc")">Giá giảm dần</option>
                                <option value="YearDesc" selected="@(filter.SortBy == "YearDesc")">Đời xe mới nhất</option>
                                <option value="MileageAsc" selected="@(filter.SortBy == "MileageAsc")">Số km đi ít nhất</option>
                            </select>
                        </div>

                        <!-- Submit and Reset Buttons -->
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-warning py-2 fw-bold border-0 text-dark" style="background-color: #ffc107;">
                                <i class="bi bi-search me-1"></i> ÁP DỤNG BỘ LỌC
                            </button>
                            <a asp-controller="Cars" asp-action="Index" class="btn btn-light py-2 fw-bold text-secondary">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> THIẾT LẬP LẠI
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Car List Grid with Pagination -->
        <div class="col-lg-9 col-md-8">
            <!-- Sort and Total count top bar -->
            <div class="d-flex justify-content-between align-items-center bg-white p-3 shadow-sm rounded-3 mb-4">
                <div>
                    <span class="text-secondary">Tìm thấy <b class="text-dark">@Model.TotalItems</b> chiếc xe</span>
                </div>
                <div class="d-flex align-items-center">
                    <span class="text-secondary me-2 d-none d-md-inline" style="font-size: 14px;">Trang @Model.PageNumber / @Model.TotalPages</span>
                    <div class="btn-group" role="group">
                        <button class="btn btn-sm btn-outline-secondary active"><i class="bi bi-grid-3x3-gap-fill"></i></button>
                    </div>
                </div>
            </div>

            <!-- Car Grid -->
            @if (Model.Items == null || !Model.Items.Any())
            {
                <div class="text-center py-5 bg-white shadow-sm rounded-3">
                    <i class="bi bi-car-front text-secondary" style="font-size: 5rem;"></i>
                    <h4 class="mt-3 fw-bold text-dark">Không tìm thấy chiếc xe nào!</h4>
                    <p class="text-secondary">Vui lòng điều chỉnh hoặc thử xóa bớt các bộ lọc tìm kiếm ở cột bên trái.</p>
                    <a asp-controller="Cars" asp-action="Index" class="btn btn-warning fw-bold border-0 px-4 py-2 mt-2 text-dark" style="background-color: #ffc107;">Xem tất cả xe</a>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var car in Model.Items)
                    {
                        var displayImageUrl = string.IsNullOrWhiteSpace(car.ImageUrl) 
                            ? "https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=600&q=80" 
                            : car.ImageUrl;
                            
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden car-card">
                                <!-- Car Image and Status Badge -->
                                <div class="position-relative overflow-hidden" style="height: 200px;">
                                    <img src="@displayImageUrl" alt="@car.CarName" class="w-100 h-100 object-fit-cover car-image transition-transform duration-300">
                                    
                                    @if (car.Status == "Available")
                                    {
                                        <span class="position-absolute top-0 start-0 m-3 badge bg-success fs-7 px-3 py-2 shadow-sm">Sẵn sàng bán</span>
                                    }
                                    else if (car.Status == "Reserved")
                                    {
                                        <span class="position-absolute top-0 start-0 m-3 badge bg-warning fs-7 px-3 py-2 text-dark shadow-sm">Đã đặt cọc</span>
                                    }
                                    else if (car.Status == "Sold")
                                    {
                                        <span class="position-absolute top-0 start-0 m-3 badge bg-danger fs-7 px-3 py-2 shadow-sm">Đã bán</span>
                                    }
                                </div>

                                <!-- Car Info Body -->
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <small class="text-secondary fw-bold uppercase" style="letter-spacing: 1px;">@car.Brand.BrandName</small>
                                            <h5 class="card-title fw-bold text-dark mb-0 mt-1">@car.CarName</h5>
                                        </div>
                                    </div>
                                    
                                    <p class="text-muted mb-3" style="font-size: 13px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 38px;">
                                        @(string.IsNullOrWhiteSpace(car.Description) ? "Chưa có mô tả chi tiết cho mẫu xe này từ showroom." : car.Description)
                                    </p>

                                    <!-- Specs Badges -->
                                    <div class="row g-2 mb-4 mt-auto">
                                        <div class="col-6">
                                            <div class="bg-light rounded p-2 text-center" style="font-size: 12px;">
                                                <i class="bi bi-calendar-event text-danger me-1"></i> <span class="fw-bold text-dark">@car.Year</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="bg-light rounded p-2 text-center" style="font-size: 12px;">
                                                <i class="bi bi-speedometer2 text-danger me-1"></i> <span class="fw-bold text-dark">@car.Mileage.ToString("N0") km</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="bg-light rounded p-2 text-center" style="font-size: 12px;">
                                                <i class="bi bi-gear-fill text-danger me-1"></i> <span class="fw-bold text-dark">@(car.Transmission == "Automatic" ? "Số tự động" : "Số sàn")</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="bg-light rounded p-2 text-center" style="font-size: 12px;">
                                                <i class="bi bi-fuel-pump-fill text-danger me-1"></i> <span class="fw-bold text-dark">@car.FuelType</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Price and Actions -->
                                    <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                                        <div>
                                            <small class="text-secondary d-block" style="font-size: 11px;">GIÁ CHỈ TỪ</small>
                                            <span class="fs-5 fw-bold text-danger">@car.Price.ToString("N0") đ</span>
                                        </div>
                                        <div>
                                            <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.CarId" class="btn btn-warning btn-sm fw-bold px-3 py-2 border-0 text-dark" style="background-color: #ffc107;">
                                                Chi tiết <i class="bi bi-arrow-right-short"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination Controls -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation" class="mt-5">
                        <ul class="pagination justify-content-center">
                            <!-- Previous page -->
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link border-0 shadow-sm rounded-circle mx-1 d-flex align-items-center justify-content-center" 
                                   style="width: 40px; height: 40px;"
                                   href="@Url.Action("Index", "Cars", new {
                                       PageNumber = Model.PageNumber - 1,
                                       BrandId = filter.BrandId,
                                       MinPrice = filter.MinPrice,
                                       MaxPrice = filter.MaxPrice,
                                       Transmission = filter.Transmission,
                                       FuelType = filter.FuelType,
                                       SearchTerm = filter.SearchTerm,
                                       SortBy = filter.SortBy
                                   })" aria-label="Previous">
                                    <i class="bi bi-chevron-left text-dark"></i>
                                </a>
                            </li>

                            <!-- Page Numbers -->
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                    @if (Model.PageNumber == i)
                                    {
                                        <span class="page-link border-0 shadow-sm rounded-circle mx-1 d-flex align-items-center justify-content-center text-white bg-warning" 
                                              style="width: 40px; height: 40px; font-weight: bold;">@i</span>
                                    }
                                    else
                                    {
                                        <a class="page-link border-0 shadow-sm rounded-circle mx-1 d-flex align-items-center justify-content-center text-dark" 
                                           style="width: 40px; height: 40px;"
                                           href="@Url.Action("Index", "Cars", new {
                                               PageNumber = i,
                                               BrandId = filter.BrandId,
                                               MinPrice = filter.MinPrice,
                                               MaxPrice = filter.MaxPrice,
                                               Transmission = filter.Transmission,
                                               FuelType = filter.FuelType,
                                               SearchTerm = filter.SearchTerm,
                                               SortBy = filter.SortBy
                                           })">@i</a>
                                    }
                                </li>
                            }

                            <!-- Next page -->
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link border-0 shadow-sm rounded-circle mx-1 d-flex align-items-center justify-content-center" 
                                   style="width: 40px; height: 40px;"
                                   href="@Url.Action("Index", "Cars", new {
                                       PageNumber = Model.PageNumber + 1,
                                       BrandId = filter.BrandId,
                                       MinPrice = filter.MinPrice,
                                       MaxPrice = filter.MaxPrice,
                                       Transmission = filter.Transmission,
                                       FuelType = filter.FuelType,
                                       SearchTerm = filter.SearchTerm,
                                       SortBy = filter.SortBy
                                   })" aria-label="Next">
                                    <i class="bi bi-chevron-right text-dark"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

<style>
    .car-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .car-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
    }
    .car-image {
        transition: transform 0.3s ease;
    }
    .car-card:hover .car-image {
        transform: scale(1.08);
    }
    .object-fit-cover {
        object-fit: cover;
    }
    .page-link:hover {
        background-color: #f8f9fa;
        color: #ffc107 !important;
    }
    .page-item.active .page-link {
        background-color: #ffc107 !important;
        border-color: #ffc107 !important;
    }
    .hover-dark-shadow:hover {
        box-shadow: 0 4px 12px rgba(255, 193, 7, 0.2);
        background-color: #ffc107 !important;
        color: #000 !important;
    }
    .transition-all {
        transition: all 0.2s ease-in-out;
    }
    #dropZone.dragover {
        background-color: #e9ecef !important;
        border-color: #ffc107 !important;
    }
    .cursor-pointer {
        cursor: pointer;
    }
    .object-fit-cover {
        object-fit: cover;
    }
</style>

<!-- Image Search Modal -->
<div class="modal fade" id="imageSearchModal" tabindex="-1" aria-labelledby="imageSearchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header bg-dark text-white py-3">
                <h5 class="modal-title fw-bold" id="imageSearchModalLabel">
                    <i class="bi bi-cpu-fill text-warning me-2"></i> TÌM XE BẰNG CÔNG NGHỆ NHẬN DIỆN AI
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <div class="mb-3 text-end">
                        <button type="button" class="btn btn-sm btn-outline-warning text-dark fw-bold border-warning px-3" id="btnSyncVectorDb">
                            <i class="bi bi-arrow-repeat me-1 animate-spin"></i> ĐỒNG BỘ VECTOR DB
                        </button>
                    </div>
                }

                <div class="row">
                    <!-- Image upload column -->
                    <div class="col-md-6 mb-3 mb-md-0">
                        <div id="dropZone" class="border border-2 border-dashed rounded-3 p-4 text-center d-flex flex-column align-items-center justify-content-center bg-light transition-all cursor-pointer" style="min-height: 280px; border-color: #dee2e6 !important;">
                            <i class="bi bi-cloud-arrow-up-fill text-secondary mb-3" style="font-size: 3rem;"></i>
                            <h6 class="fw-bold mb-1 text-dark">Kéo thả ảnh ô tô vào đây</h6>
                            <p class="text-secondary mb-3" style="font-size: 12px;">Hỗ trợ định dạng JPG, PNG, WEBP</p>
                            <input type="file" id="imageInput" accept="image/*" class="d-none" />
                            <button type="button" class="btn btn-warning btn-sm fw-bold border-0 text-dark px-4 py-2" onclick="document.getElementById('imageInput').click();">Chọn ảnh từ máy</button>
                        </div>
                        <div id="imagePreviewContainer" class="d-none position-relative rounded-3 overflow-hidden border" style="height: 280px;">
                            <img id="imagePreview" class="w-100 h-100 object-fit-cover" />
                            <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2 rounded-circle d-flex align-items-center justify-content-center shadow" id="btnRemoveImage" style="width: 32px; height: 32px;">
                                <i class="bi bi-x-lg fs-6"></i>
                            </button>
                        </div>
                    </div>

                    <!-- AI Result column -->
                    <div class="col-md-6">
                        <div id="aiStateInitial" class="h-100 d-flex flex-column align-items-center justify-content-center text-center p-3">
                            <i class="bi bi-file-earmark-image-fill text-muted mb-2" style="font-size: 2.5rem;"></i>
                            <h6 class="fw-bold text-dark">Chưa có hình ảnh phân tích</h6>
                            <p class="text-secondary" style="font-size: 13px;">Hãy upload một bức ảnh xe ô tô. AI của chúng tôi sẽ tự động nhận diện thương hiệu, dòng xe và gợi ý các mẫu xe phù hợp đang có trong showroom.</p>
                        </div>

                        <div id="aiStateLoading" class="d-none h-100 d-flex flex-column align-items-center justify-content-center text-center p-3">
                            <div class="spinner-border text-warning mb-3" role="status" style="width: 3rem; height: 3rem;">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <h6 class="fw-bold text-dark">Đang phân tích hình ảnh với AI...</h6>
                            <p class="text-secondary" style="font-size: 13px;">Hệ thống đang chạy mô hình Deep Learning ViT để phân loại mẫu xe và thực hiện truy vấn Vector DB.</p>
                        </div>

                        <div id="aiStateResult" class="d-none h-100 d-flex flex-column">
                            <div class="alert alert-success border-0 bg-success bg-opacity-10 py-3 px-3 mb-3">
                                <h6 class="alert-heading fw-bold text-success mb-1" style="font-size: 14px;">
                                    <i class="bi bi-check-circle-fill me-1"></i> NHẬN DIỆN THÀNH CÔNG
                                </h6>
                                <p class="mb-0 text-dark" style="font-size: 13px;">
                                    Mẫu xe: <strong id="detectedModel" class="text-danger">--</strong> 
                                    <span class="text-secondary ms-1">(Độ chính xác: <span id="detectionConfidence">0</span>%)</span>
                                </p>
                            </div>
                            
                            <h6 class="fw-bold text-dark mb-2" style="font-size: 14px;">Kết quả phù hợp tại Showroom:</h6>
                            <div id="matchingCarsList" class="flex-grow-1 overflow-auto pe-1" style="max-height: 200px;">
                                <!-- Matches injected here -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm fw-bold px-3" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        const dropZone = $('#dropZone');
        const imageInput = $('#imageInput');
        const previewContainer = $('#imagePreviewContainer');
        const previewImg = $('#imagePreview');
        const btnRemove = $('#btnRemoveImage');

        // Drag and drop events
        dropZone.on('dragover', function (e) {
            e.preventDefault();
            dropZone.addClass('dragover');
        });

        dropZone.on('dragleave', function () {
            dropZone.removeClass('dragover');
        });

        dropZone.on('drop', function (e) {
            e.preventDefault();
            dropZone.removeClass('dragover');
            const files = e.originalEvent.dataTransfer.files;
            if (files.length > 0) {
                handleFile(files[0]);
            }
        });

        dropZone.on('click', function () {
            imageInput.click();
        });

        imageInput.on('change', function () {
            if (this.files.length > 0) {
                handleFile(this.files[0]);
            }
        });

        btnRemove.on('click', function (e) {
            e.stopPropagation();
            resetUploadState();
        });

        // Trigger vector synchronization from UI
        $('#btnSyncVectorDb').on('click', function () {
            const btn = $(this);
            btn.prop('disabled', true);
            
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Đang đồng bộ...',
                    text: 'Hệ thống đang đồng bộ dữ liệu xe từ SQL Server vào Vector DB / Elasticsearch',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
            }

            $.ajax({
                url: '/Cars/SyncVectorDb',
                type: 'POST',
                success: function (res) {
                    btn.prop('disabled', false);
                    if (res.success) {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: res.message
                            });
                        } else {
                            alert(res.message);
                        }
                    } else {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi đồng bộ',
                                text: res.message
                            });
                        } else {
                            alert(res.message);
                        }
                    }
                },
                error: function () {
                    btn.prop('disabled', false);
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi kết nối',
                            text: 'Không thể kết nối đến máy chủ.'
                        });
                    } else {
                        alert('Không thể kết nối đến máy chủ.');
                    }
                }
            });
        });

        function handleFile(file) {
            if (!file.type.startsWith('image/')) {
                alert('Vui lòng chỉ upload file hình ảnh.');
                return;
            }

            // Show preview
            const reader = new FileReader();
            reader.onload = function (e) {
                previewImg.attr('src', e.target.result);
                dropZone.addClass('d-none');
                previewContainer.removeClass('d-none');
            };
            reader.readAsDataURL(file);

            // Upload and analyze
            uploadAndAnalyze(file);
        }

        function uploadAndAnalyze(file) {
            // Update UI State to loading
            $('#aiStateInitial').addClass('d-none');
            $('#aiStateResult').addClass('d-none');
            $('#aiStateLoading').removeClass('d-none');

            const formData = new FormData();
            formData.append('file', file);

            $.ajax({
                url: '/Cars/DetectImage',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    $('#aiStateLoading').addClass('d-none');
                    if (res.success && res.data) {
                        const result = res.data;
                        $('#detectedModel').text(result.predictedLabel);
                        $('#detectionConfidence').text(Math.round(result.confidence * 100));

                        // Populate matching cars
                        const carList = $('#matchingCarsList');
                        carList.empty();

                        if (result.matchedCars && result.matchedCars.length > 0) {
                            result.matchedCars.forEach(car => {
                                const brandName = car.brand ? car.brand.brandName : 'Showroom';
                                const imageUrl = car.imageUrl || 'https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=400&q=80';
                                const priceText = Number(car.price).toLocaleString('vi-VN') + ' đ';
                                const mileageText = Number(car.mileage).toLocaleString('vi-VN') + ' km';
                                
                                const carItem = `
                                    <div class="card mb-2 border-0 shadow-sm bg-white overflow-hidden" style="border-radius: 8px;">
                                        <div class="row g-0">
                                            <div class="col-4" style="height: 90px;">
                                                <img src="${imageUrl}" class="w-100 h-100 object-fit-cover" alt="${car.carName}" />
                                            </div>
                                            <div class="col-8">
                                                <div class="card-body p-2 d-flex flex-column h-100 justify-content-between">
                                                    <div>
                                                        <h6 class="fw-bold mb-0 text-dark" style="font-size: 13px; display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden;">${car.carName}</h6>
                                                        <small class="text-secondary" style="font-size: 11px;">Hãng: ${brandName} | Đời: ${car.year}</small>
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <span class="fw-bold text-danger" style="font-size: 13px;">${priceText}</span>
                                                        <a href="/Cars/Details/${car.carId}" class="btn btn-warning btn-sm py-0 px-2 fw-bold text-dark" style="font-size: 11px; height: 20px; line-height: 20px; background-color: #ffc107; border: 0;">Xem</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                `;
                                carList.append(carItem);
                            });
                        } else {
                            carList.html(`
                                <div class="text-center py-4 bg-light rounded border border-dashed">
                                    <i class="bi bi-emoji-frown text-secondary fs-2 mb-1 d-block"></i>
                                    <p class="text-secondary mb-0" style="font-size: 12px;">Không tìm thấy xe nào khớp tại showroom.</p>
                                    <small class="text-muted" style="font-size: 11px;">Vector DB chưa được đồng bộ hoặc mẫu xe này hết hàng.</small>
                                </div>
                            `);
                        }

                        $('#aiStateResult').removeClass('d-none');
                    } else {
                        $('#aiStateInitial').removeClass('d-none');
                        alert(res.message || 'Lỗi khi nhận dạng hình ảnh.');
                    }
                },
                error: function () {
                    $('#aiStateLoading').addClass('d-none');
                    $('#aiStateInitial').removeClass('d-none');
                    alert('Lỗi kết nối mạng hoặc server không phản hồi.');
                }
            });
        }

        function resetUploadState() {
            imageInput.val('');
            previewImg.attr('src', '');
            previewContainer.addClass('d-none');
            dropZone.removeClass('d-none');
            
            $('#aiStateResult').addClass('d-none');
            $('#aiStateLoading').addClass('d-none');
            $('#aiStateInitial').removeClass('d-none');
        }
    });
</script>

