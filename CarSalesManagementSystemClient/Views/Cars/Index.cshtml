@model CarSalesManagementSystemClient.Models.PagedResultViewModel<CarSalesManagementSystemClient.Models.CarViewModel>

@{
    ViewData["Title"] = "Showroom Ô tô";

    var filter =
        ViewBag.Filter as CarSalesManagementSystemClient.Models.CarSearchViewModel
        ?? new CarSalesManagementSystemClient.Models.CarSearchViewModel();

    var brands =
        ViewBag.Brands as IEnumerable<CarSalesManagementSystemClient.Models.CarBrandViewModel>
        ?? new List<CarSalesManagementSystemClient.Models.CarBrandViewModel>();
}

<style>
    :root {
        --showroom-primary: #17191e;
        --showroom-secondary: #252830;
        --showroom-accent: #f5b800;
        --showroom-accent-hover: #ffca28;
        --showroom-background: #f4f5f7;
        --showroom-surface: #ffffff;
        --showroom-border: #e5e7eb;
        --showroom-text: #1b1d22;
        --showroom-muted: #747983;
        --showroom-danger: #dc3545;
        --showroom-success: #198754;
        --showroom-radius-lg: 24px;
        --showroom-radius-md: 14px;
        --showroom-shadow: 0 18px 45px rgba(17, 19, 24, 0.08);
    }

    .showroom-page {
        min-height: 100vh;
        padding: 34px 0 72px;
        background: radial-gradient( circle at 94% 5%, rgba(245, 184, 0, 0.11), transparent 25% ), var(--showroom-background);
    }

    .showroom-container {
        width: 100%;
        max-width: 1480px;
        margin: 0 auto;
        padding-right: 28px;
        padding-left: 28px;
    }

    /* Header */

    .showroom-header {
        position: relative;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 28px;
        margin-bottom: 26px;
        padding: 31px 35px;
        color: #ffffff;
        background: radial-gradient( circle at 90% 10%, rgba(245, 184, 0, 0.19), transparent 31% ), linear-gradient( 135deg, var(--showroom-primary), var(--showroom-secondary) );
        border-radius: var(--showroom-radius-lg);
        box-shadow: 0 20px 48px rgba(17, 19, 24, 0.16);
        overflow: hidden;
    }

        .showroom-header::after {
            content: "SHOWROOM";
            position: absolute;
            top: -34px;
            right: 22px;
            color: rgba(255, 255, 255, 0.035);
            font-size: 8rem;
            font-weight: 900;
            line-height: 1;
            letter-spacing: -0.08em;
            pointer-events: none;
        }

    .showroom-header-content,
    .showroom-breadcrumb {
        position: relative;
        z-index: 2;
    }

    .showroom-header-label {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 10px;
        color: var(--showroom-accent);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

        .showroom-header-label::before {
            content: "";
            width: 31px;
            height: 2px;
            background-color: var(--showroom-accent);
        }

    .showroom-title {
        margin: 0 0 9px;
        font-size: clamp(1.8rem, 3vw, 2.55rem);
        font-weight: 900;
        line-height: 1.12;
        letter-spacing: -0.045em;
        text-transform: uppercase;
    }

    .showroom-description {
        max-width: 680px;
        margin: 0;
        color: rgba(255, 255, 255, 0.63);
        font-size: 0.91rem;
        line-height: 1.65;
    }

    .showroom-breadcrumb .breadcrumb {
        justify-content: flex-end;
        margin-bottom: 0;
        padding: 10px 14px;
        background-color: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.11);
        border-radius: 12px;
        backdrop-filter: blur(8px);
    }

    .showroom-breadcrumb .breadcrumb-item {
        color: rgba(255, 255, 255, 0.62);
        font-size: 0.75rem;
        font-weight: 700;
    }

        .showroom-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
            color: rgba(255, 255, 255, 0.35);
        }

    .showroom-breadcrumb a {
        color: rgba(255, 255, 255, 0.76);
        text-decoration: none;
    }

        .showroom-breadcrumb a:hover,
        .showroom-breadcrumb .active {
            color: var(--showroom-accent);
        }

    /* Error */

    .showroom-alert {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        margin-bottom: 21px;
        padding: 14px 16px;
        color: #991b1b;
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 14px;
        font-size: 0.86rem;
        line-height: 1.55;
        box-shadow: 0 8px 25px rgba(17, 19, 24, 0.05);
    }

        .showroom-alert i {
            flex-shrink: 0;
            margin-top: 2px;
            color: var(--showroom-danger);
        }

    /* Layout */

    .showroom-layout {
        display: grid;
        grid-template-columns: 300px minmax(0, 1fr);
        gap: 24px;
        align-items: start;
    }

    /* Filter panel */

    .showroom-filter-panel {
        position: sticky;
        top: 92px;
        overflow: hidden;
        background-color: var(--showroom-surface);
        border: 1px solid var(--showroom-border);
        border-radius: var(--showroom-radius-lg);
        box-shadow: var(--showroom-shadow);
    }

    .showroom-filter-header {
        position: relative;
        padding: 23px 24px;
        color: #ffffff;
        background: radial-gradient( circle at 85% 15%, rgba(245, 184, 0, 0.18), transparent 35% ), linear-gradient( 135deg, var(--showroom-primary), var(--showroom-secondary) );
    }

    .showroom-filter-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 5px;
        font-size: 0.95rem;
        font-weight: 900;
        text-transform: uppercase;
    }

        .showroom-filter-title i {
            color: var(--showroom-accent);
        }

    .showroom-filter-subtitle {
        margin: 0;
        color: rgba(255, 255, 255, 0.58);
        font-size: 0.71rem;
        line-height: 1.5;
    }

    .showroom-filter-body {
        padding: 23px;
    }

    .showroom-filter-group {
        margin-bottom: 22px;
    }

        .showroom-filter-group:last-of-type {
            margin-bottom: 0;
        }

    .showroom-filter-label {
        display: block;
        margin-bottom: 9px;
        color: #3d4148;
        font-size: 0.75rem;
        font-weight: 900;
    }

    .showroom-input-wrapper {
        position: relative;
    }

    .showroom-input-icon {
        position: absolute;
        z-index: 2;
        top: 50%;
        left: 14px;
        color: #969ba4;
        font-size: 0.9rem;
        transform: translateY(-50%);
        pointer-events: none;
        transition: color 0.2s ease;
    }

    .showroom-control,
    .showroom-select {
        width: 100%;
        min-height: 48px;
        color: var(--showroom-text);
        background-color: #f8f9fa;
        border: 1px solid var(--showroom-border);
        border-radius: 13px;
        outline: none;
        font-size: 0.82rem;
        transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .showroom-control {
        padding: 11px 14px 11px 42px;
    }

    .showroom-select {
        padding: 11px 40px 11px 42px;
    }

    .showroom-control::placeholder {
        color: #a6aab1;
    }

    .showroom-control:hover,
    .showroom-select:hover {
        border-color: #cdd0d6;
    }

    .showroom-control:focus,
    .showroom-select:focus {
        background-color: #ffffff;
        border-color: var(--showroom-accent);
        box-shadow: 0 0 0 4px rgba(245, 184, 0, 0.13);
    }

    .showroom-input-wrapper:focus-within .showroom-input-icon {
        color: #987100;
    }

    .showroom-price-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 9px;
    }

        .showroom-price-grid .showroom-control {
            padding-left: 13px;
        }

    .showroom-filter-note {
        margin: 8px 0 0;
        color: #999da5;
        font-size: 0.68rem;
        line-height: 1.45;
    }

    .showroom-radio-list {
        display: grid;
        gap: 9px;
    }

    .showroom-radio-item {
        position: relative;
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 10px 11px;
        background-color: #f8f9fa;
        border: 1px solid var(--showroom-border);
        border-radius: 11px;
        cursor: pointer;
    }

        .showroom-radio-item .form-check-input {
            flex-shrink: 0;
            margin: 0;
            border-color: #b9bdc4;
            box-shadow: none;
        }

            .showroom-radio-item .form-check-input:checked {
                background-color: var(--showroom-accent);
                border-color: var(--showroom-accent);
            }

    .showroom-radio-label {
        color: #61666f;
        font-size: 0.74rem;
        cursor: pointer;
    }

    .showroom-ai-button {
        width: 100%;
        min-height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 10px;
        padding: 10px 13px;
        color: var(--showroom-primary);
        background-color: #ffffff;
        border: 1px solid var(--showroom-accent);
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        transition: transform 0.22s ease, background-color 0.22s ease, box-shadow 0.22s ease;
    }

        .showroom-ai-button i {
            color: #9b7400;
            font-size: 1rem;
        }

        .showroom-ai-button:hover {
            color: var(--showroom-primary);
            background-color: var(--showroom-accent);
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(245, 184, 0, 0.21);
        }

    .showroom-filter-actions {
        display: grid;
        gap: 9px;
        margin-top: 24px;
    }

    .showroom-filter-button {
        min-height: 47px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 14px;
        border-radius: 12px;
        font-size: 0.72rem;
        font-weight: 900;
        text-decoration: none;
        text-transform: uppercase;
        transition: transform 0.22s ease, color 0.22s ease, background-color 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
    }

    .showroom-filter-submit {
        color: var(--showroom-primary);
        background-color: var(--showroom-accent);
        border: 1px solid var(--showroom-accent);
        box-shadow: 0 12px 27px rgba(245, 184, 0, 0.19);
    }

        .showroom-filter-submit:hover {
            color: var(--showroom-primary);
            background-color: var(--showroom-accent-hover);
            border-color: var(--showroom-accent-hover);
            transform: translateY(-2px);
            box-shadow: 0 16px 32px rgba(245, 184, 0, 0.26);
        }

    .showroom-filter-reset {
        color: #676c75;
        background-color: #ffffff;
        border: 1px solid var(--showroom-border);
    }

        .showroom-filter-reset:hover {
            color: var(--showroom-primary);
            background-color: #f7f8f9;
            border-color: #cfd2d7;
            transform: translateY(-2px);
        }

    /* Content */

    .showroom-content {
        min-width: 0;
    }

    .showroom-result-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 21px;
        padding: 17px 20px;
        background-color: var(--showroom-surface);
        border: 1px solid var(--showroom-border);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(17, 19, 24, 0.055);
    }

    .showroom-result-count {
        color: var(--showroom-muted);
        font-size: 0.82rem;
    }

        .showroom-result-count strong {
            color: var(--showroom-primary);
            font-size: 1rem;
            font-weight: 900;
        }

    .showroom-page-info {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--showroom-muted);
        font-size: 0.75rem;
    }

    .showroom-grid-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--showroom-primary);
        background-color: rgba(245, 184, 0, 0.13);
        border: 1px solid rgba(245, 184, 0, 0.22);
        border-radius: 10px;
    }

    /* Empty results */

    .showroom-empty {
        padding: 82px 28px;
        text-align: center;
        background-color: var(--showroom-surface);
        border: 1px solid var(--showroom-border);
        border-radius: var(--showroom-radius-lg);
        box-shadow: var(--showroom-shadow);
    }

    .showroom-empty-icon {
        width: 92px;
        height: 92px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 22px;
        color: #927000;
        background-color: rgba(245, 184, 0, 0.11);
        border: 1px solid rgba(245, 184, 0, 0.21);
        border-radius: 27px;
        font-size: 2.2rem;
    }

    .showroom-empty-title {
        margin-bottom: 8px;
        color: var(--showroom-primary);
        font-size: 1.16rem;
        font-weight: 900;
    }

    .showroom-empty-description {
        max-width: 520px;
        margin: 0 auto 22px;
        color: var(--showroom-muted);
        font-size: 0.85rem;
        line-height: 1.7;
    }

    .showroom-empty-button {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        color: var(--showroom-primary);
        background-color: var(--showroom-accent);
        border: 1px solid var(--showroom-accent);
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 900;
        text-decoration: none;
    }

    /* Car grid */

    .showroom-car-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
    }

    .showroom-car-card {
        position: relative;
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        background-color: var(--showroom-surface);
        border: 1px solid var(--showroom-border);
        border-radius: 19px;
        box-shadow: 0 13px 35px rgba(17, 19, 24, 0.07);
        transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
    }

        .showroom-car-card:hover {
            border-color: rgba(245, 184, 0, 0.5);
            transform: translateY(-7px);
            box-shadow: 0 22px 45px rgba(17, 19, 24, 0.13);
        }

    .showroom-car-image-wrapper {
        position: relative;
        height: 215px;
        overflow: hidden;
        background-color: #e9ebee;
    }

        .showroom-car-image-wrapper::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( to top, rgba(17, 19, 24, 0.32), transparent 45% );
            pointer-events: none;
        }

    .showroom-car-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.45s ease;
    }

    .showroom-car-card:hover .showroom-car-image {
        transform: scale(1.07);
    }

    .showroom-car-status {
        position: absolute;
        z-index: 2;
        top: 14px;
        left: 14px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border: 1px solid transparent;
        border-radius: 999px;
        font-size: 0.67rem;
        font-weight: 900;
        backdrop-filter: blur(8px);
    }

        .showroom-car-status::before {
            content: "";
            width: 6px;
            height: 6px;
            background-color: currentColor;
            border-radius: 50%;
        }

    .showroom-car-status-available {
        color: #166534;
        background-color: rgba(220, 252, 231, 0.94);
        border-color: rgba(187, 247, 208, 0.95);
    }

    .showroom-car-status-reserved {
        color: #805f00;
        background-color: rgba(255, 248, 214, 0.94);
        border-color: rgba(253, 230, 138, 0.95);
    }

    .showroom-car-status-sold {
        color: #991b1b;
        background-color: rgba(254, 226, 226, 0.94);
        border-color: rgba(254, 202, 202, 0.95);
    }

    .showroom-car-body {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: 21px;
    }

    .showroom-car-brand {
        display: block;
        margin-bottom: 6px;
        color: #9a7300;
        font-size: 0.67rem;
        font-weight: 900;
        letter-spacing: 0.09em;
        text-transform: uppercase;
    }

    .showroom-car-name {
        margin-bottom: 10px;
        color: var(--showroom-primary);
        font-size: 1.05rem;
        font-weight: 900;
        line-height: 1.3;
    }

    .showroom-car-description {
        display: -webkit-box;
        min-height: 39px;
        margin-bottom: 17px;
        overflow: hidden;
        color: var(--showroom-muted);
        font-size: 0.75rem;
        line-height: 1.55;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .showroom-spec-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-top: auto;
        margin-bottom: 19px;
    }

    .showroom-spec {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
        padding: 10px;
        background-color: #f7f8f9;
        border: 1px solid #eff0f2;
        border-radius: 11px;
    }

        .showroom-spec i {
            flex-shrink: 0;
            color: #9a7300;
            font-size: 0.86rem;
        }

        .showroom-spec span {
            overflow: hidden;
            color: #555a63;
            font-size: 0.68rem;
            font-weight: 800;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .showroom-car-footer {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 13px;
        padding-top: 17px;
        border-top: 1px solid var(--showroom-border);
    }

    .showroom-price-label {
        display: block;
        margin-bottom: 3px;
        color: #92969e;
        font-size: 0.62rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .showroom-price {
        color: #b42318;
        font-size: 1.05rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .showroom-details-button {
        min-height: 39px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 9px 13px;
        color: var(--showroom-primary);
        background-color: var(--showroom-accent);
        border: 1px solid var(--showroom-accent);
        border-radius: 11px;
        font-size: 0.7rem;
        font-weight: 900;
        text-decoration: none;
        white-space: nowrap;
        transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
    }

        .showroom-details-button:hover {
            color: var(--showroom-primary);
            background-color: var(--showroom-accent-hover);
            transform: translateY(-2px);
            box-shadow: 0 9px 20px rgba(245, 184, 0, 0.22);
        }

    /* Pagination */

    .showroom-pagination {
        display: flex;
        justify-content: center;
        gap: 7px;
        margin: 34px 0 0;
        padding: 0;
        list-style: none;
    }

    .showroom-page-link {
        width: 41px;
        height: 41px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #565b64;
        background-color: #ffffff;
        border: 1px solid var(--showroom-border);
        border-radius: 12px;
        font-size: 0.76rem;
        font-weight: 800;
        text-decoration: none;
        box-shadow: 0 8px 20px rgba(17, 19, 24, 0.055);
        transition: transform 0.2s ease, color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
    }

        .showroom-page-link:hover {
            color: var(--showroom-primary);
            background-color: #fff8d6;
            border-color: #fde68a;
            transform: translateY(-2px);
        }

    .showroom-page-item.active .showroom-page-link {
        color: var(--showroom-primary);
        background-color: var(--showroom-accent);
        border-color: var(--showroom-accent);
    }

    .showroom-page-item.disabled {
        pointer-events: none;
        opacity: 0.45;
    }

    /* AI modal */

    .image-search-modal .modal-dialog {
        max-width: 930px;
    }

    .image-search-modal .modal-content {
        overflow: hidden;
        border: 0;
        border-radius: 22px;
        box-shadow: 0 32px 90px rgba(17, 19, 24, 0.28);
    }

    .image-search-modal-header {
        padding: 21px 24px;
        color: #ffffff;
        background: radial-gradient( circle at 90% 10%, rgba(245, 184, 0, 0.18), transparent 35% ), linear-gradient( 135deg, var(--showroom-primary), var(--showroom-secondary) );
        border: 0;
    }

    .image-search-modal-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        font-size: 0.98rem;
        font-weight: 900;
    }

        .image-search-modal-title i {
            color: var(--showroom-accent);
        }

    .image-search-modal-body {
        padding: 25px;
        background-color: #f7f8f9;
    }

    .vector-sync-wrapper {
        margin-bottom: 16px;
        text-align: right;
    }

    .vector-sync-button {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 8px 12px;
        color: var(--showroom-primary);
        background-color: #ffffff;
        border: 1px solid var(--showroom-accent);
        border-radius: 10px;
        font-size: 0.69rem;
        font-weight: 900;
    }

    .ai-search-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .ai-search-panel {
        min-width: 0;
        min-height: 320px;
        padding: 18px;
        background-color: #ffffff;
        border: 1px solid var(--showroom-border);
        border-radius: 17px;
    }

    #dropZone {
        min-height: 282px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        padding: 28px;
        text-align: center;
        background: linear-gradient( 135deg, #fbfbfc, #f3f4f6 );
        border: 2px dashed #d6d9df;
        border-radius: 14px;
        cursor: pointer;
        transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    }

        #dropZone:hover,
        #dropZone.dragover {
            background-color: #fffaf0;
            border-color: var(--showroom-accent);
            transform: translateY(-2px);
        }

    .ai-upload-icon {
        width: 68px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
        color: #927000;
        background-color: rgba(245, 184, 0, 0.13);
        border-radius: 20px;
        font-size: 1.75rem;
    }

    .ai-upload-title {
        margin-bottom: 6px;
        color: var(--showroom-primary);
        font-size: 0.9rem;
        font-weight: 900;
    }

    .ai-upload-description {
        margin-bottom: 17px;
        color: var(--showroom-muted);
        font-size: 0.72rem;
    }

    .ai-upload-button {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 15px;
        color: var(--showroom-primary);
        background-color: var(--showroom-accent);
        border: 1px solid var(--showroom-accent);
        border-radius: 10px;
        font-size: 0.7rem;
        font-weight: 900;
    }

    #imagePreviewContainer {
        position: relative;
        height: 282px;
        overflow: hidden;
        border: 1px solid var(--showroom-border);
        border-radius: 14px;
    }

    #imagePreview {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    #btnRemoveImage {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        color: #ffffff;
        background-color: rgba(185, 28, 28, 0.92);
        border: 0;
        border-radius: 11px;
        box-shadow: 0 8px 20px rgba(17, 19, 24, 0.18);
    }

    .ai-state {
        min-height: 282px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        padding: 22px;
        text-align: center;
    }

    .ai-state-icon {
        width: 68px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 15px;
        color: #8d929a;
        background-color: #f3f4f6;
        border-radius: 20px;
        font-size: 1.65rem;
    }

    .ai-state-title {
        margin-bottom: 7px;
        color: var(--showroom-primary);
        font-size: 0.9rem;
        font-weight: 900;
    }

    .ai-state-description {
        max-width: 330px;
        margin: 0;
        color: var(--showroom-muted);
        font-size: 0.73rem;
        line-height: 1.6;
    }

    .ai-loading-spinner {
        width: 45px;
        height: 45px;
        margin-bottom: 18px;
        color: var(--showroom-accent);
    }

    #aiStateResult {
        min-height: 282px;
    }

    .ai-result-success {
        margin-bottom: 15px;
        padding: 13px 14px;
        color: #166534;
        background-color: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 12px;
    }

    .ai-result-success-title {
        margin-bottom: 5px;
        font-size: 0.76rem;
        font-weight: 900;
    }

    .ai-result-success-text {
        margin: 0;
        color: #454a52;
        font-size: 0.73rem;
    }

    .ai-match-heading {
        margin-bottom: 9px;
        color: var(--showroom-primary);
        font-size: 0.77rem;
        font-weight: 900;
    }

    #matchingCarsList {
        max-height: 210px;
        overflow-y: auto;
        padding-right: 4px;
    }

    .image-search-modal-footer {
        justify-content: center;
        padding: 14px 24px 20px;
        background-color: #f7f8f9;
        border: 0;
    }

    .image-search-close {
        min-height: 41px;
        padding: 9px 21px;
        color: #ffffff;
        background-color: var(--showroom-primary);
        border: 1px solid var(--showroom-primary);
        border-radius: 11px;
        font-size: 0.72rem;
        font-weight: 900;
    }

    .object-fit-cover {
        object-fit: cover;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    /* Responsive */

    @@media (max-width: 1199.98px) {
        .showroom-container {
            padding-right: 22px;
            padding-left: 22px;
        }

        .showroom-layout {
            grid-template-columns: 280px minmax(0, 1fr);
        }

        .showroom-car-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 991.98px) {
        .showroom-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .showroom-breadcrumb .breadcrumb {
            justify-content: flex-start;
        }

        .showroom-layout {
            grid-template-columns: 1fr;
        }

        .showroom-filter-panel {
            position: static;
        }

        .showroom-filter-body form {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .showroom-filter-group {
            margin-bottom: 0;
        }

        .showroom-filter-actions {
            grid-column: 1 / -1;
            grid-template-columns: 1fr 1fr;
            margin-top: 2px;
        }
    }

    @@media (max-width: 767.98px) {
        .showroom-page {
            padding-top: 24px;
        }

        .showroom-container {
            padding-right: 14px;
            padding-left: 14px;
        }

        .showroom-header {
            padding: 24px 21px;
            border-radius: 20px;
        }

            .showroom-header::after {
                display: none;
            }

        .showroom-car-grid {
            grid-template-columns: 1fr;
        }

        .showroom-car-image-wrapper {
            height: 245px;
        }

        .ai-search-grid {
            grid-template-columns: 1fr;
        }

        .ai-search-panel {
            min-height: auto;
        }
    }

    @@media (max-width: 575.98px) {
        .showroom-title {
            font-size: 1.55rem;
        }

        .showroom-description {
            font-size: 0.82rem;
        }

        .showroom-filter-body form {
            grid-template-columns: 1fr;
        }

        .showroom-filter-actions {
            grid-column: auto;
            grid-template-columns: 1fr;
        }

        .showroom-result-bar {
            align-items: flex-start;
            flex-direction: column;
        }

        .showroom-car-image-wrapper {
            height: 215px;
        }

        .showroom-car-footer {
            align-items: stretch;
            flex-direction: column;
        }

        .showroom-details-button {
            width: 100%;
        }

        .showroom-pagination {
            gap: 5px;
        }

        .showroom-page-link {
            width: 37px;
            height: 37px;
        }

        .image-search-modal-body {
            padding: 17px;
        }

        .ai-search-panel {
            padding: 13px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .showroom-car-card,
        .showroom-car-image,
        .showroom-details-button,
        .showroom-filter-button,
        .showroom-ai-button,
        .showroom-page-link {
            transition: none;
        }

            .showroom-car-card:hover,
            .showroom-details-button:hover,
            .showroom-filter-button:hover,
            .showroom-ai-button:hover,
            .showroom-page-link:hover {
                transform: none;
            }
    }
</style>

<main class="showroom-page">
    <div class="showroom-container">

        <!-- Header -->
        <header class="showroom-header">
            <div class="showroom-header-content">
                <div class="showroom-header-label">
                    Group7 ECO DRIVE
                </div>

                <h1 class="showroom-title">
                    Showroom Ô tô
                </h1>

                <p class="showroom-description">
                    Khám phá các mẫu xe đẳng cấp, sẵn sàng bàn giao và lựa chọn
                    chiếc xe phù hợp với nhu cầu của bạn.
                </p>
            </div>

            <nav aria-label="breadcrumb"
                 class="showroom-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">
                            Trang chủ
                        </a>
                    </li>

                    <li class="breadcrumb-item active"
                        aria-current="page">
                        Showroom
                    </li>
                </ol>
            </nav>
        </header>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="showroom-alert"
                 role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@ViewBag.ErrorMessage</span>
            </div>
        }

        <div class="showroom-layout">

            <!-- Search filters -->
            <aside class="showroom-filter-panel">
                <div class="showroom-filter-header">
                    <h2 class="showroom-filter-title">
                        <i class="bi bi-sliders"></i>
                        Bộ lọc tìm kiếm
                    </h2>

                    <p class="showroom-filter-subtitle">
                        Thu hẹp kết quả theo nhu cầu của bạn
                    </p>
                </div>

                <div class="showroom-filter-body">
                    <form method="get"
                          asp-controller="Cars"
                          asp-action="Index"
                          id="filterForm">

                        <input type="hidden"
                               name="PageNumber"
                               value="1" />

                        <input type="hidden"
                               name="PageSize"
                               value="@filter.PageSize" />

                        <!-- Search keyword -->
                        <div class="showroom-filter-group">
                            <label for="showroomSearchTerm"
                                   class="showroom-filter-label">
                                Từ khóa tìm kiếm
                            </label>

                            <div class="showroom-input-wrapper">
                                <i class="bi bi-search showroom-input-icon"></i>

                                <input id="showroomSearchTerm"
                                       type="text"
                                       name="SearchTerm"
                                       class="showroom-control"
                                       placeholder="Tên xe, model..."
                                       value="@filter.SearchTerm" />
                            </div>

                            <button type="button"
                                    class="showroom-ai-button"
                                    data-bs-toggle="modal"
                                    data-bs-target="#imageSearchModal">
                                <i class="bi bi-camera-fill"></i>
                                Tìm xe qua ảnh AI
                            </button>
                        </div>

                        <!-- Brand filter -->
                        <div class="showroom-filter-group">
                            <label for="showroomBrand"
                                   class="showroom-filter-label">
                                Hãng xe
                            </label>

                            <div class="showroom-input-wrapper">
                                <i class="bi bi-building showroom-input-icon"></i>

                                <select id="showroomBrand"
                                        name="BrandId"
                                        class="showroom-select">
                                    <option value="">
                                        Tất cả các hãng
                                    </option>

                                    @foreach (var brand in brands)
                                    {
                                        if (filter.BrandId == brand.BrandId)
                                        {
                                            <option value="@brand.BrandId"
                                                    selected>
                                                @brand.BrandName
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@brand.BrandId">
                                                @brand.BrandName
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Price filter -->
                        <div class="showroom-filter-group">
                            <label class="showroom-filter-label">
                                Khoảng giá (VNĐ)
                            </label>

                            <div class="showroom-price-grid">
                                <input type="number"
                                       name="MinPrice"
                                       class="showroom-control"
                                       placeholder="Tối thiểu"
                                       value="@(filter.MinPrice.HasValue ? filter.MinPrice.Value.ToString("F0") : "")" />

                                <input type="number"
                                       name="MaxPrice"
                                       class="showroom-control"
                                       placeholder="Tối đa"
                                       value="@(filter.MaxPrice.HasValue ? filter.MaxPrice.Value.ToString("F0") : "")" />
                            </div>

                            <p class="showroom-filter-note">
                                Ví dụ: 500.000.000 đến 1.500.000.000
                            </p>
                        </div>

                        <!-- Transmission filter -->
                        <div class="showroom-filter-group">
                            <span class="showroom-filter-label">
                                Hộp số
                            </span>

                            <div class="showroom-radio-list">
                                <label for="transmissionAll"
                                       class="showroom-radio-item">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="Transmission"
                                           id="transmissionAll"
                                           value=""
                                    @(string.IsNullOrEmpty(filter.Transmission) ? "checked" : "") />

                                    <span class="showroom-radio-label">
                                        Tất cả
                                    </span>
                                </label>

                                <label for="transmissionAuto"
                                       class="showroom-radio-item">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="Transmission"
                                           id="transmissionAuto"
                                           value="Automatic"
                                    @(filter.Transmission == "Automatic" ? "checked" : "") />

                                    <span class="showroom-radio-label">
                                        Số tự động (Automatic)
                                    </span>
                                </label>

                                <label for="transmissionManual"
                                       class="showroom-radio-item">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="Transmission"
                                           id="transmissionManual"
                                           value="Manual"
                                    @(filter.Transmission == "Manual" ? "checked" : "") />

                                    <span class="showroom-radio-label">
                                        Số sàn (Manual)
                                    </span>
                                </label>
                            </div>
                        </div>

                        <!-- Fuel type -->
                        <div class="showroom-filter-group">
                            <label for="showroomFuelType"
                                   class="showroom-filter-label">
                                Loại nhiên liệu
                            </label>

                            <div class="showroom-input-wrapper">
                                <i class="bi bi-fuel-pump showroom-input-icon"></i>

                                <select id="showroomFuelType"
                                        name="FuelType"
                                        class="showroom-select">
                                    <option value="">
                                        Tất cả các loại
                                    </option>

                                    <option value="Gasoline"
                                            selected="@(filter.FuelType == "Gasoline")">
                                        Xăng (Gasoline)
                                    </option>

                                    <option value="Diesel"
                                            selected="@(filter.FuelType == "Diesel")">
                                        Dầu (Diesel)
                                    </option>

                                    <option value="Electric"
                                            selected="@(filter.FuelType == "Electric")">
                                        Điện (Electric)
                                    </option>

                                    <option value="Hybrid"
                                            selected="@(filter.FuelType == "Hybrid")">
                                        Hybrid
                                    </option>
                                </select>
                            </div>
                        </div>

                        <!-- Sort -->
                        <div class="showroom-filter-group">
                            <label for="showroomSortBy"
                                   class="showroom-filter-label">
                                Sắp xếp theo
                            </label>

                            <div class="showroom-input-wrapper">
                                <i class="bi bi-sort-down showroom-input-icon"></i>

                                <select id="showroomSortBy"
                                        name="SortBy"
                                        class="showroom-select">
                                    <option value=""
                                            selected="@(string.IsNullOrEmpty(filter.SortBy))">
                                        Mới nhất
                                    </option>

                                    <option value="PriceAsc"
                                            selected="@(filter.SortBy == "PriceAsc")">
                                        Giá tăng dần
                                    </option>

                                    <option value="PriceDesc"
                                            selected="@(filter.SortBy == "PriceDesc")">
                                        Giá giảm dần
                                    </option>

                                    <option value="YearDesc"
                                            selected="@(filter.SortBy == "YearDesc")">
                                        Đời xe mới nhất
                                    </option>

                                    <option value="MileageAsc"
                                            selected="@(filter.SortBy == "MileageAsc")">
                                        Số km đi ít nhất
                                    </option>
                                </select>
                            </div>
                        </div>

                        <div class="showroom-filter-actions">
                            <button type="submit"
                                    class="showroom-filter-button showroom-filter-submit">
                                <i class="bi bi-search"></i>
                                Áp dụng bộ lọc
                            </button>

                            <a asp-controller="Cars"
                               asp-action="Index"
                               class="showroom-filter-button showroom-filter-reset">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                Thiết lập lại
                            </a>
                        </div>
                    </form>
                </div>
            </aside>

            <!-- Car results -->
            <section class="showroom-content">
                <div class="showroom-result-bar">
                    <div class="showroom-result-count">
                        Tìm thấy
                        <strong>@Model.TotalItems</strong>
                        chiếc xe
                    </div>

                    <div class="showroom-page-info">
                        <span>
                            Trang @Model.PageNumber / @Model.TotalPages
                        </span>

                        <span class="showroom-grid-icon">
                            <i class="bi bi-grid-3x3-gap-fill"></i>
                        </span>
                    </div>
                </div>

                @if (Model.Items == null || !Model.Items.Any())
                {
                    <div class="showroom-empty">
                        <div class="showroom-empty-icon">
                            <i class="bi bi-car-front-fill"></i>
                        </div>

                        <h2 class="showroom-empty-title">
                            Không tìm thấy chiếc xe nào
                        </h2>

                        <p class="showroom-empty-description">
                            Vui lòng điều chỉnh hoặc xóa bớt các bộ lọc tìm kiếm
                            để xem thêm những mẫu xe đang có tại showroom.
                        </p>

                        <a asp-controller="Cars"
                           asp-action="Index"
                           class="showroom-empty-button">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            Xem tất cả xe
                        </a>
                    </div>
                }
                else
                {
                    <div class="showroom-car-grid">
                        @foreach (var car in Model.Items)
                        {
                            var displayImageUrl =
                                string.IsNullOrWhiteSpace(car.ImageUrl)
                                ? "https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=600&q=80"
                                : car.ImageUrl;

                            <article class="showroom-car-card">
                                <div class="showroom-car-image-wrapper">
                                    <img src="@displayImageUrl"
                                         alt="@car.CarName"
                                         class="showroom-car-image" />

                                    @if (car.Status == "Available")
                                    {
                                        <span class="showroom-car-status showroom-car-status-available">
                                            Sẵn sàng bán
                                        </span>
                                    }
                                    else if (car.Status == "Reserved")
                                    {
                                        <span class="showroom-car-status showroom-car-status-reserved">
                                            Đã đặt cọc
                                        </span>
                                    }
                                    else if (car.Status == "Sold")
                                    {
                                        <span class="showroom-car-status showroom-car-status-sold">
                                            Đã bán
                                        </span>
                                    }
                                </div>

                                <div class="showroom-car-body">
                                    <span class="showroom-car-brand">
                                        @car.Brand.BrandName
                                    </span>

                                    <h2 class="showroom-car-name">
                                        @car.CarName
                                    </h2>

                                    <p class="showroom-car-description">
                                        @(string.IsNullOrWhiteSpace(car.Description)
                                            ? "Chưa có mô tả chi tiết cho mẫu xe này từ showroom."
                                            : car.Description)
                                    </p>

                                    <div class="showroom-spec-grid">
                                        <div class="showroom-spec">
                                            <i class="bi bi-calendar-event"></i>
                                            <span>@car.Year</span>
                                        </div>

                                        <div class="showroom-spec">
                                            <i class="bi bi-speedometer2"></i>
                                            <span>@car.Mileage.ToString("N0") km</span>
                                        </div>

                                        <div class="showroom-spec">
                                            <i class="bi bi-gear-fill"></i>

                                            <span>
                                                @(car.Transmission == "Automatic"
                                                    ? "Số tự động"
                                                    : "Số sàn")
                                            </span>
                                        </div>

                                        <div class="showroom-spec">
                                            <i class="bi bi-fuel-pump-fill"></i>
                                            <span>@car.FuelType</span>
                                        </div>
                                    </div>

                                    <div class="showroom-car-footer">
                                        <div>
                                            <span class="showroom-price-label">
                                                Giá chỉ từ
                                            </span>

                                            <span class="showroom-price">
                                                @car.Price.ToString("N0") đ
                                            </span>
                                        </div>

                                        <a asp-controller="Cars"
                                           asp-action="Details"
                                           asp-route-id="@car.CarId"
                                           class="showroom-details-button">
                                            Chi tiết
                                            <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation">
                            <ul class="showroom-pagination">

                                <!-- Previous page -->
                                <li class="showroom-page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                    <a class="showroom-page-link"
                                       href="@Url.Action("Index", "Cars", new
                                       {
                                           PageNumber = Model.PageNumber - 1,
                                           BrandId = filter.BrandId,
                                           MinPrice = filter.MinPrice,
                                           MaxPrice = filter.MaxPrice,
                                           Transmission = filter.Transmission,
                                           FuelType = filter.FuelType,
                                           SearchTerm = filter.SearchTerm,
                                           SortBy = filter.SortBy
                                       })"
                                       aria-label="Previous">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>

                                <!-- Page numbers -->
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="showroom-page-item @(Model.PageNumber == i ? "active" : "")">
                                        @if (Model.PageNumber == i)
                                        {
                                            <span class="showroom-page-link">
                                                @i
                                            </span>
                                        }
                                        else
                                        {
                                            <a class="showroom-page-link"
                                               href="@Url.Action("Index", "Cars", new
                                               {
                                                   PageNumber = i,
                                                   BrandId = filter.BrandId,
                                                   MinPrice = filter.MinPrice,
                                                   MaxPrice = filter.MaxPrice,
                                                   Transmission = filter.Transmission,
                                                   FuelType = filter.FuelType,
                                                   SearchTerm = filter.SearchTerm,
                                                   SortBy = filter.SortBy
                                               })">
                                                @i
                                            </a>
                                        }
                                    </li>
                                }

                                <!-- Next page -->
                                <li class="showroom-page-item @(Model.HasNextPage ? "" : "disabled")">
                                    <a class="showroom-page-link"
                                       href="@Url.Action("Index", "Cars", new
                                       {
                                           PageNumber = Model.PageNumber + 1,
                                           BrandId = filter.BrandId,
                                           MinPrice = filter.MinPrice,
                                           MaxPrice = filter.MaxPrice,
                                           Transmission = filter.Transmission,
                                           FuelType = filter.FuelType,
                                           SearchTerm = filter.SearchTerm,
                                           SortBy = filter.SortBy
                                       })"
                                       aria-label="Next">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                }
            </section>
        </div>
    </div>
</main>

<!-- Image Search Modal -->
<div class="modal fade image-search-modal"
     id="imageSearchModal"
     tabindex="-1"
     aria-labelledby="imageSearchModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header image-search-modal-header">
                <h2 class="image-search-modal-title"
                    id="imageSearchModalLabel">
                    <i class="bi bi-cpu-fill"></i>
                    Tìm xe bằng công nghệ nhận diện AI
                </h2>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body image-search-modal-body">
                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <div class="vector-sync-wrapper">
                        <button type="button"
                                class="vector-sync-button"
                                id="btnSyncVectorDb">
                            <i class="bi bi-arrow-repeat animate-spin"></i>
                            Đồng bộ Vector DB
                        </button>
                    </div>
                }

                <div class="ai-search-grid">

                    <!-- Upload panel -->
                    <section class="ai-search-panel">
                        <div id="dropZone">
                            <div class="ai-upload-icon">
                                <i class="bi bi-cloud-arrow-up-fill"></i>
                            </div>

                            <h3 class="ai-upload-title">
                                Kéo thả ảnh ô tô vào đây
                            </h3>

                            <p class="ai-upload-description">
                                Hỗ trợ định dạng JPG, PNG và WEBP
                            </p>

                            <input type="file"
                                   id="imageInput"
                                   accept="image/*"
                                   class="d-none" />

                            <button type="button"
                                    class="ai-upload-button"
                                    onclick="document.getElementById('imageInput').click();">
                                <i class="bi bi-folder2-open"></i>
                                Chọn ảnh từ máy
                            </button>
                        </div>

                        <div id="imagePreviewContainer"
                             class="d-none">
                            <img id="imagePreview"
                                 alt="Ảnh xe cần nhận diện" />

                            <button type="button"
                                    id="btnRemoveImage"
                                    aria-label="Xóa ảnh">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </section>

                    <!-- AI result panel -->
                    <section class="ai-search-panel">
                        <div id="aiStateInitial"
                             class="ai-state">
                            <div class="ai-state-icon">
                                <i class="bi bi-file-earmark-image-fill"></i>
                            </div>

                            <h3 class="ai-state-title">
                                Chưa có hình ảnh phân tích
                            </h3>

                            <p class="ai-state-description">
                                Hãy tải lên một bức ảnh xe ô tô. AI sẽ nhận diện
                                thương hiệu, dòng xe và gợi ý các mẫu phù hợp
                                đang có trong showroom.
                            </p>
                        </div>

                        <div id="aiStateLoading"
                             class="ai-state d-none">
                            <div class="spinner-border ai-loading-spinner"
                                 role="status">
                                <span class="visually-hidden">
                                    Loading...
                                </span>
                            </div>

                            <h3 class="ai-state-title">
                                Đang phân tích hình ảnh với AI
                            </h3>

                            <p class="ai-state-description">
                                Hệ thống đang chạy mô hình Deep Learning ViT
                                và thực hiện truy vấn Vector DB.
                            </p>
                        </div>

                        <div id="aiStateResult"
                             class="d-none">
                            <div class="ai-result-success">
                                <h3 class="ai-result-success-title">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Nhận diện thành công
                                </h3>

                                <p class="ai-result-success-text">
                                    Mẫu xe:
                                    <strong id="detectedModel"
                                            class="text-danger">
                                        --
                                    </strong>

                                    <span class="text-secondary ms-1">
                                        (Độ chính xác:
                                        <span id="detectionConfidence">0</span>%)
                                    </span>
                                </p>
                            </div>

                            <h3 class="ai-match-heading">
                                Kết quả phù hợp tại Showroom
                            </h3>

                            <div id="matchingCarsList">
                                <!-- Matches injected here -->
                            </div>
                        </div>
                    </section>
                </div>
            </div>

            <div class="modal-footer image-search-modal-footer">
                <button type="button"
                        class="image-search-close"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>
                    Đóng
                </button>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    $(document).ready(function() {
        const dropZone = $('#dropZone');
        const imageInput = $('#imageInput');
        const previewContainer = $('#imagePreviewContainer');
        const previewImg = $('#imagePreview');
        const btnRemove = $('#btnRemoveImage');

        // Drag and drop events
        dropZone.on('dragover', function(e) {
            e.preventDefault();
            dropZone.addClass('dragover');
        });

        dropZone.on('dragleave', function() {
            dropZone.removeClass('dragover');
        });

        dropZone.on('drop', function(e) {
            e.preventDefault();
            dropZone.removeClass('dragover');
            const files = e.originalEvent.dataTransfer.files;
            if (files.length > 0) {
                handleFile(files[0]);
            }
        });

        dropZone.on('click', function() {
            imageInput.click();
        });

        imageInput.on('change', function() {
            if (this.files.length > 0) {
                handleFile(this.files[0]);
            }
        });

        btnRemove.on('click', function(e) {
            e.stopPropagation();
            resetUploadState();
        });

        // Trigger vector synchronization from UI
        $('#btnSyncVectorDb').on('click', function() {
            const btn = $(this);
            btn.prop('disabled', true);

            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Đang đồng bộ...',
                    text: 'Hệ thống đang đồng bộ dữ liệu xe từ SQL Server vào Vector DB / Elasticsearch',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
            }

            $.ajax({
                url: '/Cars/SyncVectorDb',
                type: 'POST',
                success: function(res) {
                    btn.prop('disabled', false);
                    if (res.success) {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: res.message
                            });
                        } else {
                            alert(res.message);
                        }
                    } else {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi đồng bộ',
                                text: res.message
                            });
                        } else {
                            alert(res.message);
                        }
                    }
                },
                error: function() {
                    btn.prop('disabled', false);
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi kết nối',
                            text: 'Không thể kết nối đến máy chủ.'
                        });
                    } else {
                        alert('Không thể kết nối đến máy chủ.');
                    }
                }
            });
        });

        function handleFile(file) {
            if (!file.type.startsWith('image/')) {
                alert('Vui lòng chỉ upload file hình ảnh.');
                return;
            }

            // Show preview
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImg.attr('src', e.target.result);
                dropZone.addClass('d-none');
                previewContainer.removeClass('d-none');
            };
            reader.readAsDataURL(file);

            // Upload and analyze
            uploadAndAnalyze(file);
        }

        function uploadAndAnalyze(file) {
            // Update UI State to loading
            $('#aiStateInitial').addClass('d-none');
            $('#aiStateResult').addClass('d-none');
            $('#aiStateLoading').removeClass('d-none');

            const formData = new FormData();
            formData.append('file', file);

            $.ajax({
                url: '/Cars/DetectImage',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    $('#aiStateLoading').addClass('d-none');
                    if (res.success && res.data) {
                        const result = res.data;
                        $('#detectedModel').text(result.predictedLabel);
                        $('#detectionConfidence').text(Math.round(result.confidence * 100));

                        // Populate matching cars
                        const carList = $('#matchingCarsList');
                        carList.empty();

                        if (result.matchedCars && result.matchedCars.length > 0) {
                            result.matchedCars.forEach(car => {
                                const brandName = car.brand ? car.brand.brandName : 'Showroom';
                                const imageUrl = car.imageUrl || 'https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=400&q=80';
                                const priceText = Number(car.price).toLocaleString('vi-VN') + ' đ';
                                const mileageText = Number(car.mileage).toLocaleString('vi-VN') + ' km';

                                const carItem = `
                                        <div class="card mb-2 border-0 shadow-sm bg-white overflow-hidden" style="border-radius: 8px;">
                                            <div class="row g-0">
                                                <div class="col-4" style="height: 90px;">
                                                    <img src="${imageUrl}" class="w-100 h-100 object-fit-cover" alt="${car.carName}" />
                                                </div>
                                                <div class="col-8">
                                                    <div class="card-body p-2 d-flex flex-column h-100 justify-content-between">
                                                        <div>
                                                            <h6 class="fw-bold mb-0 text-dark" style="font-size: 13px; display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden;">${car.carName}</h6>
                                                            <small class="text-secondary" style="font-size: 11px;">Hãng: ${brandName} | Đời: ${car.year}</small>
                                                        </div>
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <span class="fw-bold text-danger" style="font-size: 13px;">${priceText}</span>
                                                            <a href="/Cars/Details/${car.carId}" class="btn btn-warning btn-sm py-0 px-2 fw-bold text-dark" style="font-size: 11px; height: 20px; line-height: 20px; background-color: #ffc107; border: 0;">Xem</a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    `;
                                carList.append(carItem);
                            });
                        } else {
                            carList.html(`
                                    <div class="text-center py-4 bg-light rounded border border-dashed">
                                        <i class="bi bi-emoji-frown text-secondary fs-2 mb-1 d-block"></i>
                                        <p class="text-secondary mb-0" style="font-size: 12px;">Không tìm thấy xe nào khớp tại showroom.</p>
                                        <small class="text-muted" style="font-size: 11px;">Vector DB chưa được đồng bộ hoặc mẫu xe này hết hàng.</small>
                                    </div>
                                `);
                        }

                        $('#aiStateResult').removeClass('d-none');
                    } else {
                        $('#aiStateInitial').removeClass('d-none');
                        alert(res.message || 'Lỗi khi nhận dạng hình ảnh.');
                    }
                },
                error: function() {
                    $('#aiStateLoading').addClass('d-none');
                    $('#aiStateInitial').removeClass('d-none');
                    alert('Lỗi kết nối mạng hoặc server không phản hồi.');
                }
            });
        }

        function resetUploadState() {
            imageInput.val('');
            previewImg.attr('src', '');
            previewContainer.addClass('d-none');
            dropZone.removeClass('d-none');

            $('#aiStateResult').addClass('d-none');
            $('#aiStateLoading').addClass('d-none');
            $('#aiStateInitial').removeClass('d-none');
        }
    });
</script>

