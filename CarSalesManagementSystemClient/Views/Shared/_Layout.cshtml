<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Group7</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/CarSalesManagementSystemClient.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
            :root {
                --layout-primary: #15171c;
                --layout-secondary: #24272e;
                --layout-accent: #f5b800;
                --layout-accent-hover: #ffca28;
                --layout-background: #f4f5f7;
                --layout-surface: #ffffff;
                --layout-border: #e5e7eb;
                --layout-text: #181a1f;
                --layout-muted: #747983;
                --layout-danger: #dc3545;
                --layout-radius: 16px;
                --layout-shadow: 0 16px 40px rgba(17, 19, 24, 0.09);
            }

            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }

            html {
                min-height: 100%;
                scroll-behavior: smooth;
            }

            body {
                min-height: 100vh;
                margin: 0;
                color: var(--layout-text);
                background-color: var(--layout-background);
                font-family: "Outfit", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
                overflow-x: hidden;
            }

            a,
            button,
            input,
            select,
            textarea {
                font-family: inherit;
            }

            /* =========================
                                   TOP BAR
                                ========================== */

            .site-topbar {
                position: relative;
                z-index: 1060;
                color: rgba(255, 255, 255, 0.76);
                background-color: #0c0e12;
                border-bottom: 1px solid rgba(255, 255, 255, 0.07);
            }

            .site-topbar-inner {
                min-height: 38px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 18px;
            }

            .site-welcome {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 0.7rem;
                font-weight: 600;
            }

                .site-welcome::before {
                    content: "";
                    width: 7px;
                    height: 7px;
                    background-color: var(--layout-accent);
                    border-radius: 50%;
                    box-shadow: 0 0 0 4px rgba(245, 184, 0, 0.12);
                }

                .site-welcome strong {
                    color: var(--layout-accent);
                    font-weight: 900;
                }

            .site-account-menu {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: 12px;
                font-size: 0.68rem;
                font-weight: 700;
            }

            .site-topbar-link {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                color: rgba(255, 255, 255, 0.76);
                text-decoration: none;
                transition: color 0.2s ease;
            }

                .site-topbar-link:hover {
                    color: var(--layout-accent);
                }

            .site-admin-link {
                color: var(--layout-accent);
                font-weight: 900;
            }

            .site-account-divider {
                color: rgba(255, 255, 255, 0.28);
            }

            .site-user-greeting {
                color: rgba(255, 255, 255, 0.67);
                white-space: nowrap;
            }

                .site-user-greeting strong {
                    color: #ffffff;
                    font-weight: 900;
                }

            .site-cart-link {
                position: relative;
                width: 31px;
                height: 31px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                color: #ffffff;
                background-color: rgba(255, 255, 255, 0.055);
                border: 1px solid rgba(255, 255, 255, 0.075);
                border-radius: 9px;
                text-decoration: none;
                transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
            }

                .site-cart-link:hover {
                    color: var(--layout-primary);
                    background-color: var(--layout-accent);
                    border-color: var(--layout-accent);
                }

            #navbarCartCount {
                position: absolute;
                top: -6px;
                right: -7px;
                min-width: 18px;
                height: 18px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 2px 5px;
                color: #ffffff;
                background-color: var(--layout-danger);
                border: 2px solid #0c0e12;
                border-radius: 999px;
                font-size: 0.52rem;
                font-weight: 900;
                line-height: 1;
            }

            /* =========================
                                   MAIN HEADER
                                ========================== */

            .site-header-shell {
                position: sticky;
                z-index: 1040;
                top: 0;
                box-shadow: 0 12px 34px rgba(17, 19, 24, 0.11);
            }

            .site-brandbar {
                color: #ffffff;
                background: radial-gradient( circle at 85% 10%, rgba(245, 184, 0, 0.13), transparent 28% ), linear-gradient( 135deg, var(--layout-primary), var(--layout-secondary) );
                border-bottom: 1px solid rgba(255, 255, 255, 0.07);
            }

            .site-brandbar-inner {
                min-height: 82px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 25px;
            }

            .site-brand-link {
                display: inline-flex;
                align-items: center;
                gap: 13px;
                color: #ffffff;
                text-decoration: none;
            }

                .site-brand-link:hover {
                    color: #ffffff;
                }

            .site-brand-icon {
                width: 52px;
                height: 52px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--layout-primary);
                background-color: var(--layout-accent);
                border-radius: 16px;
                font-size: 1.45rem;
                box-shadow: 0 12px 27px rgba(245, 184, 0, 0.2);
                transform: rotate(-3deg);
            }

            .site-brand-copy {
                line-height: 1;
            }

            .site-brand-name {
                display: block;
                color: #ffffff;
                font-size: 1.45rem;
                font-weight: 950;
                letter-spacing: -0.05em;
                text-transform: uppercase;
            }

                .site-brand-name span {
                    color: var(--layout-accent);
                }

            .site-brand-subtitle {
                display: block;
                margin-top: 7px;
                color: #848a95;
                font-size: 0.58rem;
                font-weight: 900;
                letter-spacing: 0.22em;
                text-transform: uppercase;
            }

            .site-brand-promise {
                display: flex;
                align-items: center;
                gap: 10px;
                color: rgba(255, 255, 255, 0.58);
                font-size: 0.7rem;
                font-weight: 700;
            }

                .site-brand-promise i {
                    color: var(--layout-accent);
                }

            /* =========================
                                   NAVIGATION
                                ========================== */

            .site-navbar {
                min-height: 54px;
                padding: 0;
                background-color: var(--layout-accent);
            }

                .site-navbar .navbar-toggler {
                    width: 43px;
                    height: 43px;
                    margin: 7px 0;
                    padding: 0;
                    background-color: rgba(255, 255, 255, 0.52);
                    border: 1px solid rgba(17, 19, 24, 0.18);
                    border-radius: 11px;
                    box-shadow: none;
                }

                    .site-navbar .navbar-toggler:focus {
                        box-shadow: 0 0 0 4px rgba(17, 19, 24, 0.1);
                    }

            .site-nav-list {
                align-items: stretch;
                margin: 0;
            }

            .site-nav-item {
                position: relative;
                display: flex;
                align-items: stretch;
            }

            .site-nav-link {
                min-height: 54px;
                display: flex;
                align-items: center;
                gap: 6px;
                padding: 0 17px !important;
                color: var(--layout-primary) !important;
                font-size: 0.7rem;
                font-weight: 900;
                letter-spacing: 0.025em;
                text-transform: uppercase;
                transition: color 0.2s ease, background-color 0.2s ease;
            }

                .site-nav-link:hover {
                    color: #ffffff !important;
                    background-color: rgba(17, 19, 24, 0.12);
                }

            .site-nav-item.active {
                background-color: var(--layout-primary);
            }

                .site-nav-item.active .site-nav-link {
                    color: var(--layout-accent) !important;
                }

                .site-nav-item.active::after {
                    content: "";
                    position: absolute;
                    right: 14px;
                    bottom: 0;
                    left: 14px;
                    height: 3px;
                    background-color: var(--layout-accent);
                    border-radius: 999px 999px 0 0;
                }

            .site-navbar .dropdown-toggle::after {
                display: none;
            }

            .site-nav-dropdown {
                min-width: 220px;
                margin: 0;
                padding: 8px;
                background-color: #ffffff;
                border: 1px solid var(--layout-border);
                border-radius: 0 0 14px 14px;
                box-shadow: 0 18px 40px rgba(17, 19, 24, 0.16);
            }

                .site-nav-dropdown .dropdown-item {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    padding: 11px 12px;
                    color: #4b5059;
                    border-radius: 9px;
                    font-size: 0.7rem;
                    font-weight: 900;
                    text-transform: uppercase;
                }

                    .site-nav-dropdown .dropdown-item:hover {
                        color: var(--layout-primary);
                        background-color: #fff8d6;
                    }

                .site-nav-dropdown .dropdown-divider {
                    margin: 7px 0;
                    border-color: var(--layout-border);
                }

            /* =========================
                                   PAGE CONTENT
                                ========================== */

            .site-main {
                min-height: 52vh;
            }

            /* =========================
                                   FLOATING CONTACT
                                ========================== */

            .floating-buttons {
                position: fixed;
                z-index: 1035;
                right: 18px;
                bottom: 22px;
                width: 220px;
                max-width: calc(100vw - 36px);
                display: flex;
                flex-direction: column;
                align-items: stretch;
                gap: 9px;
            }

            .floating-contact {
                width: 100% !important;
                min-width: 0 !important;
                min-height: 42px;
                display: flex !important;
                align-items: center;
                justify-content: flex-start;
                gap: 9px;
                padding: 9px 14px;
                color: #ffffff;
                border: 0;
                border-radius: 999px;
                font-size: 0.7rem;
                font-weight: 900;
                text-decoration: none;
                white-space: nowrap;
                box-shadow: 0 12px 29px rgba(17, 19, 24, 0.17);
                transition: transform 0.22s ease, box-shadow 0.22s ease;
            }

                .floating-contact i {
                    flex: 0 0 auto;
                    width: 17px;
                    text-align: center;
                }

                .floating-contact:hover {
                    color: #ffffff;
                    transform: translateX(-4px);
                    box-shadow: 0 17px 34px rgba(17, 19, 24, 0.22);
                }

            .floating-contact-zalo {
                color: var(--layout-primary);
                background-color: var(--layout-accent);
            }

                .floating-contact-zalo:hover {
                    color: var(--layout-primary);
                }

            .floating-contact-facebook {
                background-color: #1877f2;
            }

            .floating-contact-hotline {
                background-color: #dc3545;
            }

            /* =========================
                                   FOOTER
                                ========================== */

            .site-footer {
                position: relative;
                margin-top: 65px;
                padding: 62px 0 23px;
                color: rgba(255, 255, 255, 0.7);
                background: radial-gradient( circle at 10% 5%, rgba(245, 184, 0, 0.09), transparent 26% ), linear-gradient( 145deg, #181a1f, #0c0e12 );
                overflow: hidden;
            }

                .site-footer::before {
                    content: "";
                    position: absolute;
                    top: 0;
                    right: 0;
                    left: 0;
                    height: 4px;
                    background: linear-gradient( 90deg, var(--layout-accent), rgba(245, 184, 0, 0.18), var(--layout-accent) );
                }

            .site-footer-brand {
                display: inline-flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 18px;
                color: #ffffff;
                text-decoration: none;
            }

                .site-footer-brand:hover {
                    color: #ffffff;
                }

            .site-footer-brand-icon {
                width: 46px;
                height: 46px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--layout-primary);
                background-color: var(--layout-accent);
                border-radius: 14px;
                font-size: 1.2rem;
            }

            .site-footer-brand-name {
                display: block;
                color: #ffffff;
                font-size: 1.18rem;
                font-weight: 950;
                line-height: 1;
                letter-spacing: -0.04em;
                text-transform: uppercase;
            }

                .site-footer-brand-name span {
                    color: var(--layout-accent);
                }

            .site-footer-brand-subtitle {
                display: block;
                margin-top: 6px;
                color: #787f8b;
                font-size: 0.56rem;
                font-weight: 900;
                letter-spacing: 0.2em;
                text-transform: uppercase;
            }

            .site-footer-description {
                max-width: 440px;
                margin-bottom: 22px;
                color: #8d939e;
                font-size: 0.78rem;
                line-height: 1.75;
            }

            .site-social-list {
                display: flex;
                gap: 9px;
            }

            .site-social-button {
                width: 38px;
                height: 38px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #ffffff;
                background-color: rgba(255, 255, 255, 0.06);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 11px;
                font-size: 0.9rem;
            }

            .site-footer-heading {
                margin-bottom: 19px;
                color: #ffffff;
                font-size: 0.9rem;
                font-weight: 900;
            }

            .site-footer-contact-list,
            .site-footer-link-list {
                margin: 0;
                padding: 0;
                list-style: none;
            }

            .site-footer-contact-item {
                display: flex;
                align-items: flex-start;
                gap: 11px;
                margin-bottom: 15px;
                color: #8f96a1;
                font-size: 0.75rem;
                line-height: 1.55;
            }

                .site-footer-contact-item i {
                    flex-shrink: 0;
                    margin-top: 2px;
                    color: var(--layout-accent);
                    font-size: 0.9rem;
                }

            .site-footer-link {
                display: flex;
                align-items: center;
                gap: 7px;
                margin-bottom: 11px;
                color: #8f96a1;
                font-size: 0.75rem;
                text-decoration: none;
                transition: color 0.2s ease, transform 0.2s ease;
            }

                .site-footer-link:hover {
                    color: var(--layout-accent);
                    transform: translateX(3px);
                }

                .site-footer-link i {
                    color: var(--layout-accent);
                    font-size: 0.65rem;
                }

            .site-map {
                width: 100%;
                height: 205px;
                overflow: hidden;
                border: 1px solid rgba(255, 255, 255, 0.09);
                border-radius: 15px;
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
            }

                .site-map iframe {
                    width: 100%;
                    height: 100%;
                    border: 0;
                }

            .site-footer-bottom {
                margin-top: 34px;
                padding-top: 21px;
                color: #686f7a;
                border-top: 1px solid rgba(255, 255, 255, 0.08);
                font-size: 0.68rem;
                text-align: center;
            }

            /* =========================
                                   AUTH MODALS
                                ========================== */

            .site-auth-modal .modal-dialog {
                max-width: 500px;
            }

            .site-auth-modal .modal-content {
                overflow: hidden;
                background-color: var(--layout-surface);
                border: 0;
                border-radius: 22px;
                box-shadow: 0 30px 80px rgba(17, 19, 24, 0.26);
            }

            .site-auth-modal-header {
                position: relative;
                padding: 23px 25px;
                color: #ffffff;
                background: radial-gradient( circle at 90% 10%, rgba(245, 184, 0, 0.18), transparent 35% ), linear-gradient( 135deg, var(--layout-primary), var(--layout-secondary) );
                border: 0;
            }

            .site-auth-modal-title {
                display: flex;
                align-items: center;
                gap: 10px;
                margin: 0;
                font-size: 1rem;
                font-weight: 900;
            }

                .site-auth-modal-title i {
                    color: var(--layout-accent);
                }

            .site-auth-modal-body {
                padding: 26px;
            }

            .site-auth-description {
                margin-bottom: 22px;
                color: var(--layout-muted);
                font-size: 0.79rem;
                line-height: 1.65;
            }

            .site-auth-error {
                margin-bottom: 18px;
                padding: 12px 14px;
                color: #991b1b;
                background-color: #fef2f2;
                border: 1px solid #fecaca;
                border-radius: 12px;
                font-size: 0.76rem;
            }

            .site-auth-group {
                margin-bottom: 17px;
            }

            .site-auth-label {
                display: block;
                margin-bottom: 8px;
                color: #3e4249;
                font-size: 0.72rem;
                font-weight: 900;
            }

            .site-auth-input-wrapper {
                position: relative;
            }

            .site-auth-input-icon {
                position: absolute;
                z-index: 2;
                top: 50%;
                left: 14px;
                color: #989ca4;
                font-size: 0.88rem;
                transform: translateY(-50%);
                pointer-events: none;
            }

            .site-auth-input {
                width: 100%;
                min-height: 49px;
                padding: 11px 13px 11px 42px;
                color: var(--layout-text);
                background-color: #f8f9fa;
                border: 1px solid var(--layout-border);
                border-radius: 13px;
                outline: none;
                font-size: 0.82rem;
                transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
            }

                .site-auth-input:focus {
                    background-color: #ffffff;
                    border-color: var(--layout-accent);
                    box-shadow: 0 0 0 4px rgba(245, 184, 0, 0.13);
                }

            .site-auth-password {
                display: grid;
                grid-template-columns: minmax(0, 1fr) auto;
            }

                .site-auth-password .site-auth-input {
                    border-radius: 13px 0 0 13px;
                }

            .site-password-toggle {
                min-width: 58px;
                color: #646972;
                background-color: #ffffff;
                border: 1px solid var(--layout-border);
                border-left: 0;
                border-radius: 0 13px 13px 0;
                font-size: 0.68rem;
                font-weight: 900;
            }

            .site-auth-actions {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 15px;
                margin-top: 22px;
            }

            .site-forgot-link {
                color: #8d6a00;
                font-size: 0.72rem;
                font-weight: 800;
                text-decoration: none;
            }

                .site-forgot-link:hover {
                    color: var(--layout-primary);
                }

            .site-auth-submit {
                min-height: 44px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                padding: 10px 18px;
                color: var(--layout-primary);
                background-color: var(--layout-accent);
                border: 1px solid var(--layout-accent);
                border-radius: 12px;
                font-size: 0.72rem;
                font-weight: 900;
                box-shadow: 0 11px 25px rgba(245, 184, 0, 0.18);
            }

                .site-auth-submit:hover {
                    color: var(--layout-primary);
                    background-color: var(--layout-accent-hover);
                }

            .site-auth-submit-full {
                width: 100%;
            }

            .site-auth-modal-footer {
                justify-content: center;
                padding: 17px 24px 21px;
                background-color: #f7f8f9;
                border: 0;
                font-size: 0.72rem;
            }

            .site-auth-switch-link {
                color: #8d6a00;
                font-weight: 900;
                text-decoration: none;
            }

                .site-auth-switch-link:hover {
                    color: var(--layout-primary);
                }

            /* =========================
                                   RESPONSIVE
                                ========================== */

            @@media (max-width: 1199.98px) {
                .site-nav-link {
                    padding-right: 13px !important;
                    padding-left: 13px !important;
                    font-size: 0.65rem;
                }
            }

            @@media (max-width: 991.98px) {
                .site-brand-promise {
                    display: none;
                }

                .site-navbar {
                    padding: 0 12px;
                }

                    .site-navbar .navbar-collapse {
                        margin: 0 -12px;
                        padding: 8px 12px 14px;
                        background-color: var(--layout-accent);
                        border-top: 1px solid rgba(17, 19, 24, 0.1);
                    }

                .site-nav-list {
                    align-items: stretch;
                }

                .site-nav-item {
                    display: block;
                    margin-bottom: 3px;
                }

                .site-nav-link {
                    min-height: 45px;
                    padding: 0 13px !important;
                    border-radius: 10px;
                }

                .site-nav-item.active {
                    border-radius: 10px;
                }

                    .site-nav-item.active::after {
                        display: none;
                    }

                .site-nav-dropdown {
                    margin: 4px 0 7px;
                    border-radius: 12px;
                }
            }

            @@media (max-width: 767.98px) {
                .site-topbar-inner {
                    min-height: 42px;
                }

                .site-welcome {
                    display: none;
                }

                .site-account-menu {
                    width: 100%;
                    justify-content: flex-end;
                }

                .site-user-greeting {
                    display: none;
                }

                .site-brandbar-inner {
                    min-height: 72px;
                }

                .site-brand-icon {
                    width: 45px;
                    height: 45px;
                    border-radius: 13px;
                    font-size: 1.2rem;
                }

                .site-brand-name {
                    font-size: 1.23rem;
                }

                .floating-buttons {
                    right: 12px;
                    bottom: 15px;
                    width: 45px;
                    max-width: 45px;
                }

                .floating-contact {
                    width: 45px !important;
                    height: 45px;
                    min-height: 45px;
                    justify-content: center;
                    padding: 0;
                    border-radius: 14px;
                    font-size: 0.95rem;
                }

                    .floating-contact span {
                        display: none;
                    }

                .site-footer {
                    padding-top: 48px;
                }
            }

            @@media (max-width: 575.98px) {
                .site-account-menu {
                    gap: 9px;
                }

                .site-orders-link span,
                .site-admin-link span,
                .site-logout-link span {
                    display: none;
                }

                .site-brandbar-inner {
                    padding-right: 5px;
                    padding-left: 5px;
                }

                .site-auth-modal-body {
                    padding: 22px 18px;
                }

                .site-auth-actions {
                    align-items: stretch;
                    flex-direction: column;
                }

                .site-auth-submit {
                    width: 100%;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                html {
                    scroll-behavior: auto;
                }

                .site-topbar-link,
                .site-cart-link,
