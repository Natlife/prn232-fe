@model IEnumerable<CarSalesManagementSystemClient.Models.CarViewModel>
@{
    ViewData["Title"] = "Trang chủ - Group7 ECO DRIVE";
}

<style>
    /* Home Styles */
    .hero-banner-home {
        position: relative;
        height: 80vh;
        min-height: 600px;
        background: url('https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?q=80&w=2000&auto=format&fit=crop') no-repeat center center;
        background-size: cover;
    }
    .hero-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: rgba(0, 0, 0, 0.65);
    }
    .hero-content {
        position: relative;
        z-index: 2;
    }
    .section-title {
        font-family: 'Arial Black', sans-serif;
        letter-spacing: -1px;
    }
    .btn-hero {
        transition: all 0.3s ease;
    }
    .btn-hero:hover {
        transform: translateY(-5px) scale(1.05);
        box-shadow: 0 15px 25px rgba(255, 193, 7, 0.4) !important;
        background-color: #ffca2c;
        color: #000 !important;
    }
    
    .feature-icon-home {
        width: 70px;
        height: 70px;
        background-color: #ffc107;
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 20px;
        transition: all 0.3s ease;
    }
    .feature-box:hover .feature-icon-home {
        transform: translateY(-10px);
        box-shadow: 0 10px 20px rgba(255, 193, 7, 0.3);
    }

    /* Car Card styling reused from Cars/Index */
    .car-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .car-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.15)!important;
    }
    .car-image {
        transition: transform 0.5s ease;
    }
    .car-card:hover .car-image {
        transform: scale(1.1);
    }
    .fs-7 { font-size: 0.85rem; }
</style>

<!-- Hero Banner -->
<div class="hero-banner-home d-flex align-items-center justify-content-center text-center text-white">
    <div class="hero-overlay"></div>
    <div class="hero-content container">
        <h6 class="text-warning fw-bold text-uppercase mb-3" style="letter-spacing: 3px;">Kỷ nguyên di chuyển mới</h6>
        <h1 class="display-3 fw-bold text-uppercase mb-4 section-title">GROUP7 <span class="text-warning">ECO DRIVE</span></h1>
        <p class="fs-4 mb-5 text-light fw-light mx-auto" style="max-width: 800px;">
            Hệ thống phân phối xe ô tô đẳng cấp, mang đến trải nghiệm lái xe hoàn hảo cùng dịch vụ hậu mãi chuẩn quốc tế.
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a asp-controller="Cars" asp-action="Index" class="btn btn-hero btn-warning btn-lg px-5 py-3 rounded-pill fw-bold text-dark text-uppercase shadow-lg mb-2" style="letter-spacing: 1px;">
                <i class="bi bi-car-front me-2"></i> Mua Xe Ngay
            </a>
        </div>
    </div>
</div>

<!-- Dịch vụ nổi bật -->
<div class="py-5" style="background-color: #ffffff;">
    <div class="container my-5">
        <div class="text-center mb-5 pb-2">
            <h6 class="text-danger fw-bold text-uppercase mb-2" style="letter-spacing: 2px;">Tại sao chọn chúng tôi</h6>
            <h2 class="display-6 fw-bold section-title text-dark">DỊCH VỤ VƯỢT TRỘI</h2>
            <div style="width: 80px; height: 4px; background-color: #dc3545; margin: 15px auto 0;"></div>
        </div>
        
        <div class="row text-center pt-3">
            <div class="col-md-4 mb-4">
                <div class="feature-box px-3">
                    <div class="feature-icon-home shadow-sm">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h4 class="fw-bold mb-3 fs-5">Bảo Hành Chính Hãng</h4>
                    <p class="text-secondary small">Cam kết bảo hành lên đến 5 năm hoặc 150.000km, mang lại sự an tâm tuyệt đối.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-box px-3">
                    <div class="feature-icon-home shadow-sm" style="background-color: #dc3545;">
                        <i class="bi bi-tools"></i>
                    </div>
                    <h4 class="fw-bold mb-3 fs-5">Bảo Dưỡng Chuyên Nghiệp</h4>
                    <p class="text-secondary small">Hệ thống xưởng dịch vụ hiện đại, kỹ thuật viên được đào tạo chuyên sâu từ hãng.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-box px-3">
                    <div class="feature-icon-home shadow-sm" style="background-color: #198754;">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>
                    <h4 class="fw-bold mb-3 fs-5">Hệ Thống Rộng Khắp</h4>
                    <p class="text-secondary small">Giao xe tận nhà và hỗ trợ cứu hộ 24/7 trên toàn quốc một cách nhanh chóng.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Sản phẩm nổi bật (Featured Cars) -->
<div class="py-5" style="background-color: #eef4f8;">
    <div class="container my-5">
        <div class="d-flex justify-content-between align-items-end mb-5 pb-2">
            <div>
                <h6 class="text-danger fw-bold text-uppercase mb-2" style="letter-spacing: 2px;">Khám phá ngay</h6>
                <h2 class="display-6 fw-bold section-title text-dark m-0">SẢN PHẨM NỔI BẬT</h2>
                <div style="width: 80px; height: 4px; background-color: #ffc107; margin-top: 15px;"></div>
            </div>
            <div class="d-none d-md-block">
                <a asp-controller="Cars" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4 fw-bold">Xem tất cả <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 bg-white shadow-sm rounded-3">
                <i class="bi bi-car-front text-secondary" style="font-size: 5rem;"></i>
                <h4 class="mt-3 fw-bold text-dark">Hệ thống đang cập nhật sản phẩm</h4>
                <p class="text-secondary">Vui lòng quay lại sau để trải nghiệm những mẫu xe mới nhất.</p>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var car in Model)
                {
                    var displayImageUrl = string.IsNullOrWhiteSpace(car.ImageUrl) 
                        ? "https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=600&q=80" 
                        : car.ImageUrl;
                        
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden car-card">
                            <!-- Car Image and Status Badge -->
                            <div class="position-relative overflow-hidden" style="height: 220px;">
                                <img src="@displayImageUrl" alt="@car.CarName" class="w-100 h-100 object-fit-cover car-image transition-transform duration-300">
                                
                                @if (car.Status == "Available")
                                {
                                    <span class="position-absolute top-0 start-0 m-3 badge bg-success fs-7 px-3 py-2 shadow-sm">Sẵn sàng bán</span>
                                }
                                else if (car.Status == "Reserved")
                                {
                                    <span class="position-absolute top-0 start-0 m-3 badge bg-warning fs-7 px-3 py-2 text-dark shadow-sm">Đã đặt cọc</span>
                                }
                            </div>

                            <!-- Car Info Body -->
                            <div class="card-body p-4 d-flex flex-column bg-white">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <small class="text-secondary fw-bold text-uppercase" style="letter-spacing: 1px;">@(car.Brand?.BrandName ?? "Khác")</small>
                                        <h5 class="card-title fw-bold text-dark mb-0 mt-1">@car.CarName</h5>
                                    </div>
                                </div>
                                
                                <p class="text-muted mb-3" style="font-size: 13.5px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 40px;">
                                    @(string.IsNullOrWhiteSpace(car.Description) ? "Mẫu xe đẳng cấp với trang bị hiện đại và khả năng vận hành vượt trội." : car.Description)
                                </p>

                                <!-- Specs Badges -->
                                <div class="row g-2 mb-4 mt-auto">
                                    <div class="col-6">
                                        <div class="bg-light rounded p-2 text-center" style="font-size: 12px;">
                                            <i class="bi bi-calendar-event text-danger me-1"></i> <span class="fw-bold text-dark">@car.Year</span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="bg-light rounded p-2 text-center" style="font-size: 12px;">
                                            <i class="bi bi-speedometer2 text-danger me-1"></i> <span class="fw-bold text-dark">@car.Mileage.ToString("N0") km</span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="bg-light rounded p-2 text-center" style="font-size: 12px;">
                                            <i class="bi bi-gear-fill text-danger me-1"></i> <span class="fw-bold text-dark">@(car.Transmission == "Automatic" ? "Số tự động" : "Số sàn")</span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="bg-light rounded p-2 text-center" style="font-size: 12px;">
                                            <i class="bi bi-fuel-pump-fill text-danger me-1"></i> <span class="fw-bold text-dark">@car.FuelType</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Price and Actions -->
                                <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-secondary d-block" style="font-size: 11px;">GIÁ BÁN</small>
                                        <span class="fs-5 fw-bold text-danger">@car.Price.ToString("N0") đ</span>
                                    </div>
                                    <div>
                                        <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.CarId" class="btn btn-warning btn-sm fw-bold px-3 py-2 border-0 text-dark" style="background-color: #ffc107;">
                                            Chi tiết <i class="bi bi-arrow-right-short"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            
            <!-- Mobile View All Button -->
            <div class="text-center mt-5 d-md-none">
                <a asp-controller="Cars" asp-action="Index" class="btn btn-outline-dark rounded-pill px-5 fw-bold">Xem tất cả xe <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        }
    </div>
</div>

<!-- CTA Section -->
<div class="py-5" style="background-color: #2b2b2c; background-image: url('https://images.unsplash.com/photo-1580273916550-e323be2ae537?q=80&w=1500'); background-blend-mode: overlay; background-size: cover; background-position: center;">
    <div class="container text-center text-white py-5">
        <h2 class="display-5 fw-bold mb-4 section-title">BẠN ĐÃ SẴN SÀNG TRẢI NGHIỆM?</h2>
        <p class="fs-5 mb-5 fw-light mx-auto" style="max-width: 600px;">Liên hệ ngay hôm nay để nhận báo giá chi tiết, đăng ký lái thử và được tư vấn trực tiếp từ chuyên gia của chúng tôi.</p>
        <a asp-controller="Home" asp-action="Contact" class="btn btn-danger btn-lg px-5 py-3 rounded-pill fw-bold text-uppercase shadow-lg" style="letter-spacing: 1px;">
            <i class="bi bi-telephone-fill me-2"></i> Liên Hệ Nhận Tư Vấn
        </a>
    </div>
</div>
