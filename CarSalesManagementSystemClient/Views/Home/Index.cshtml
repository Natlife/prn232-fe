@model IEnumerable<CarSalesManagementSystemClient.Models.CarViewModel>

@{
    ViewData["Title"] = "Trang chủ - Group7 ECO DRIVE";
}

<style>
    :root {
        --home-dark: #0c0d10;
        --home-dark-soft: #17191e;
        --home-surface: #ffffff;
        --home-background: #f4f5f7;
        --home-border: #e7e9ed;
        --home-text: #16181d;
        --home-muted: #717680;
        --home-accent: #f4b900;
        --home-accent-hover: #dca600;
        --home-danger: #dc3545;
        --home-success: #198754;
        --home-radius-xl: 30px;
        --home-radius-lg: 22px;
        --home-radius-md: 16px;
        --home-shadow: 0 24px 60px rgba(12, 13, 16, 0.10);
    }

    .home-page {
        overflow: hidden;
        color: var(--home-text);
        background-color: var(--home-background);
    }

    /* =========================
           HERO
        ========================== */

    .home-hero {
        position: relative;
        min-height: 720px;
        display: flex;
        align-items: center;
        background: linear-gradient( 90deg, rgba(7, 8, 11, 0.96) 0%, rgba(7, 8, 11, 0.86) 46%, rgba(7, 8, 11, 0.28) 100% ), url('https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?q=80&w=2000&auto=format&fit=crop') center center / cover no-repeat;
    }

        .home-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient( circle at 15% 35%, rgba(244, 185, 0, 0.16), transparent 27% );
            pointer-events: none;
        }

        .home-hero::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 160px;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.48), transparent);
            pointer-events: none;
        }

    .home-hero-content {
        position: relative;
        z-index: 2;
        max-width: 820px;
        padding-top: 70px;
        padding-bottom: 90px;
    }

    .home-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
        color: var(--home-accent);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.23em;
        text-transform: uppercase;
    }

        .home-eyebrow::before {
            content: "";
            width: 42px;
            height: 2px;
            background-color: currentColor;
        }

    .home-title {
        max-width: 760px;
        margin-bottom: 26px;
        color: #ffffff;
        font-size: clamp(3.1rem, 7vw, 6.3rem);
        font-weight: 900;
        line-height: 0.96;
        letter-spacing: -0.062em;
        text-transform: uppercase;
    }

        .home-title span {
            display: block;
            color: var(--home-accent);
        }

    .home-description {
        max-width: 680px;
        margin-bottom: 38px;
        color: rgba(255, 255, 255, 0.72);
        font-size: 1.12rem;
        line-height: 1.85;
    }

    .home-primary-button {
        min-height: 56px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 0 28px;
        color: var(--home-dark);
        background-color: var(--home-accent);
        border: 1px solid var(--home-accent);
        border-radius: 14px;
        font-size: 0.9rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-decoration: none;
        text-transform: uppercase;
        box-shadow: 0 16px 34px rgba(244, 185, 0, 0.24);
        transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
    }

        .home-primary-button:hover {
            color: var(--home-dark);
            background-color: #ffc928;
            border-color: #ffc928;
            transform: translateY(-4px);
            box-shadow: 0 20px 42px rgba(244, 185, 0, 0.34);
        }

    /* =========================
           COMMON SECTION HEADER
        ========================== */

    .home-section {
        padding: 100px 0;
    }

    .home-section-heading {
        margin-bottom: 52px;
    }

    .home-section-label {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        color: var(--home-danger);
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

        .home-section-label::before {
            content: "";
            width: 30px;
            height: 2px;
            background-color: currentColor;
        }

    .home-section-title {
        margin-bottom: 0;
        color: var(--home-text);
        font-size: clamp(2rem, 4vw, 3.4rem);
        font-weight: 900;
        line-height: 1.08;
        letter-spacing: -0.048em;
        text-transform: uppercase;
    }

    .home-section-subtitle {
        max-width: 630px;
        margin: 18px auto 0;
        color: var(--home-muted);
        line-height: 1.75;
    }

    /* =========================
           FEATURES
        ========================== */

    .home-features {
        position: relative;
        z-index: 5;
        margin-top: -62px;
        padding-bottom: 88px;
    }

    .feature-panel {
        padding: 16px;
        background-color: rgba(255, 255, 255, 0.97);
        border: 1px solid rgba(255, 255, 255, 0.75);
        border-radius: var(--home-radius-xl);
        box-shadow: var(--home-shadow);
        backdrop-filter: blur(15px);
    }

    .feature-card {
        position: relative;
        height: 100%;
        min-height: 292px;
        padding: 36px 30px;
        background-color: var(--home-surface);
        border: 1px solid transparent;
        border-radius: var(--home-radius-lg);
        overflow: hidden;
        transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

        .feature-card::after {
            content: "";
            position: absolute;
            left: 30px;
            right: 30px;
            bottom: 0;
            height: 3px;
            background-color: var(--home-accent);
            border-radius: 10px 10px 0 0;
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s ease;
        }

        .feature-card:hover {
            z-index: 2;
            transform: translateY(-8px);
            border-color: var(--home-border);
            box-shadow: 0 22px 44px rgba(12, 13, 16, 0.11);
        }

            .feature-card:hover::after {
                transform: scaleX(1);
            }

    .feature-number {
        position: absolute;
        top: 22px;
        right: 26px;
        color: #f0f1f3;
        font-size: 3.5rem;
        font-weight: 900;
        line-height: 1;
        letter-spacing: -0.08em;
        transition: color 0.3s ease;
    }

    .feature-card:hover .feature-number {
        color: rgba(244, 185, 0, 0.14);
    }

    .feature-icon {
        position: relative;
        z-index: 2;
        width: 66px;
        height: 66px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 30px;
        color: var(--home-dark);
        background-color: var(--home-accent);
        border-radius: 18px;
        font-size: 1.55rem;
        box-shadow: 0 12px 26px rgba(244, 185, 0, 0.23);
        transition: transform 0.3s ease, border-radius 0.3s ease;
    }

    .feature-card.feature-card-danger .feature-icon {
        color: #ffffff;
        background-color: var(--home-danger);
        box-shadow: 0 12px 26px rgba(220, 53, 69, 0.20);
    }

    .feature-card.feature-card-success .feature-icon {
        color: #ffffff;
        background-color: var(--home-success);
        box-shadow: 0 12px 26px rgba(25, 135, 84, 0.20);
    }

    .feature-card:hover .feature-icon {
        transform: rotate(-5deg) scale(1.05);
        border-radius: 50%;
    }

    .feature-title {
        position: relative;
        z-index: 2;
        margin-bottom: 12px;
        color: var(--home-text);
        font-size: 1.22rem;
        font-weight: 800;
    }

    .feature-description {
        position: relative;
        z-index: 2;
        margin-bottom: 0;
        color: var(--home-muted);
        font-size: 0.95rem;
        line-height: 1.75;
    }

    /* =========================
           FEATURED CARS
        ========================== */

    .featured-cars-section {
        padding: 100px 0;
        background-color: var(--home-background);
    }

    .featured-heading-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 48px;
    }

    .view-all-button {
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 0 20px;
        color: var(--home-text);
        background-color: transparent;
        border: 1px solid #cfd2d8;
        border-radius: 13px;
        font-size: 0.88rem;
        font-weight: 800;
        text-decoration: none;
        transition: color 0.3s ease, background-color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
    }

        .view-all-button:hover {
            color: #ffffff;
            background-color: var(--home-dark);
            border-color: var(--home-dark);
            transform: translateY(-3px);
        }

    .empty-cars {
        padding: 72px 28px;
        text-align: center;
        background-color: var(--home-surface);
        border: 1px solid var(--home-border);
        border-radius: var(--home-radius-xl);
        box-shadow: 0 16px 40px rgba(12, 13, 16, 0.06);
    }

    .empty-cars-icon {
        width: 92px;
        height: 92px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
        color: var(--home-muted);
        background-color: var(--home-background);
        border-radius: 24px;
        font-size: 2.8rem;
    }

    .car-card {
        position: relative;
        height: 100%;
        background-color: var(--home-surface);
        border: 1px solid var(--home-border);
        border-radius: var(--home-radius-lg);
        box-shadow: 0 14px 34px rgba(12, 13, 16, 0.06);
        overflow: hidden;
        transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
    }

        .car-card:hover {
            transform: translateY(-10px);
            border-color: rgba(244, 185, 0, 0.55);
            box-shadow: 0 26px 55px rgba(12, 13, 16, 0.13);
        }

    .car-image-wrapper {
        position: relative;
        height: 245px;
        overflow: hidden;
        background-color: #e9eaed;
    }

    .car-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.65s ease;
    }

    .car-card:hover .car-image {
        transform: scale(1.07);
    }

    .car-image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(8, 9, 12, 0.50), transparent 50%);
        pointer-events: none;
    }

    .car-status {
        position: absolute;
        top: 18px;
        left: 18px;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 800;
        line-height: 1;
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.14);
    }

        .car-status::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: currentColor;
        }

        .car-status.available {
            color: #147a4b;
            background-color: #e7f6ee;
        }

        .car-status.reserved {
            color: #806000;
            background-color: #fff3c4;
        }

    .car-card-body {
        display: flex;
        flex-direction: column;
        height: calc(100% - 245px);
        padding: 26px;
    }

    .car-brand {
        display: block;
        margin-bottom: 7px;
        color: var(--home-danger);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.15em;
        text-transform: uppercase;
    }

    .car-name {
        margin-bottom: 12px;
        color: var(--home-text);
        font-size: 1.26rem;
        font-weight: 850;
        line-height: 1.35;
    }

    .car-description {
        display: -webkit-box;
        height: 45px;
        margin-bottom: 22px;
        color: var(--home-muted);
        font-size: 0.89rem;
        line-height: 1.6;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        overflow: hidden;
    }

    .car-spec-grid {
        margin-top: auto;
        margin-bottom: 22px;
    }

    .car-spec {
        height: 100%;
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 11px 12px;
        background-color: var(--home-background);
        border: 1px solid #eceef1;
        border-radius: 12px;
        color: var(--home-text);
        font-size: 0.78rem;
        font-weight: 700;
    }

        .car-spec i {
            flex: 0 0 auto;
            color: var(--home-danger);
            font-size: 0.92rem;
        }

    .car-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding-top: 20px;
        border-top: 1px solid var(--home-border);
    }

    .car-price-label {
        display: block;
        margin-bottom: 4px;
        color: var(--home-muted);
        font-size: 0.68rem;
        font-weight: 750;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .car-price {
        color: var(--home-danger);
        font-size: 1.18rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .car-detail-button {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 0 15px;
        color: var(--home-dark);
        background-color: var(--home-accent);
        border: 1px solid var(--home-accent);
        border-radius: 11px;
        font-size: 0.81rem;
        font-weight: 850;
        text-decoration: none;
        white-space: nowrap;
        transition: transform 0.3s ease, background-color 0.3s ease, box-shadow 0.3s ease;
    }

        .car-detail-button:hover {
            color: var(--home-dark);
            background-color: #ffc928;
            transform: translateY(-3px);
            box-shadow: 0 10px 22px rgba(244, 185, 0, 0.25);
        }

    /* =========================
           CTA
        ========================== */

    .home-cta {
        position: relative;
        padding: 120px 0;
        background: linear-gradient( 90deg, rgba(8, 9, 12, 0.95), rgba(8, 9, 12, 0.76) ), url('https://images.unsplash.com/photo-1580273916550-e323be2ae537?q=80&w=1500') center center / cover no-repeat;
    }

        .home-cta::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient( circle at 82% 30%, rgba(244, 185, 0, 0.16), transparent 26% );
            pointer-events: none;
        }

    .home-cta-content {
        position: relative;
        z-index: 2;
        max-width: 760px;
    }

    .home-cta-title {
        margin-bottom: 22px;
        color: #ffffff;
        font-size: clamp(2.2rem, 5vw, 4.2rem);
        font-weight: 900;
        line-height: 1.06;
        letter-spacing: -0.052em;
        text-transform: uppercase;
    }

    .home-cta-description {
        max-width: 650px;
        margin-bottom: 34px;
        color: rgba(255, 255, 255, 0.68);
        font-size: 1.04rem;
        line-height: 1.8;
    }

    .home-cta-button {
        min-height: 56px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 0 26px;
        color: #ffffff;
        background-color: var(--home-danger);
        border: 1px solid var(--home-danger);
        border-radius: 14px;
        font-size: 0.88rem;
        font-weight: 850;
        letter-spacing: 0.04em;
        text-decoration: none;
        text-transform: uppercase;
        box-shadow: 0 16px 34px rgba(220, 53, 69, 0.24);
        transition: transform 0.3s ease, background-color 0.3s ease, box-shadow 0.3s ease;
    }

        .home-cta-button:hover {
            color: #ffffff;
            background-color: #c82e3e;
            border-color: #c82e3e;
            transform: translateY(-4px);
            box-shadow: 0 20px 42px rgba(220, 53, 69, 0.32);
        }

    /* =========================
           RESPONSIVE
        ========================== */

    @@media (max-width: 991.98px) {
        .home-hero {
            min-height: 650px;
            background-position: 62% center;
        }

        .home-hero-content {
            max-width: 700px;
        }

        .home-features {
            margin-top: -45px;
            padding-bottom: 70px;
        }

        .feature-panel {
            padding: 12px;
        }

        .feature-card {
            min-height: 265px;
        }

        .home-section,
        .featured-cars-section {
            padding: 80px 0;
        }

        .car-image-wrapper {
            height: 230px;
        }

        .car-card-body {
            height: calc(100% - 230px);
        }
    }

    @@media (max-width: 767.98px) {
        .home-hero {
            min-height: 590px;
            text-align: center;
            background: linear-gradient( rgba(7, 8, 11, 0.86), rgba(7, 8, 11, 0.91) ), url('https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?q=80&w=2000&auto=format&fit=crop') 67% center / cover no-repeat;
        }

        .home-hero-content {
            margin: 0 auto;
            padding-top: 55px;
            padding-bottom: 80px;
        }

        .home-eyebrow {
            justify-content: center;
        }

        .home-description {
            margin-right: auto;
            margin-left: auto;
            font-size: 1rem;
            line-height: 1.7;
        }

        .home-features {
            margin-top: -30px;
            padding-bottom: 58px;
        }

        .feature-panel {
            border-radius: 23px;
        }

        .feature-card {
            min-height: auto;
            padding: 30px 26px;
        }

        .featured-heading-row {
            display: block;
            margin-bottom: 38px;
            text-align: center;
        }

            .featured-heading-row .home-section-label {
                justify-content: center;
            }

            .featured-heading-row .home-section-subtitle {
                margin-right: auto;
                margin-left: auto;
            }

        .home-section,
        .featured-cars-section {
            padding: 70px 0;
        }

        .home-cta {
            padding: 90px 0;
            text-align: center;
        }

        .home-cta-content,
        .home-cta-description {
            margin-right: auto;
            margin-left: auto;
        }
    }

    @@media (max-width: 575.98px) {
        .home-hero {
            min-height: 550px;
        }

        .home-title {
            font-size: 2.75rem;
        }

        .home-primary-button,
        .home-cta-button {
            width: 100%;
        }

        .home-section-title {
            font-size: 2rem;
        }

        .car-image-wrapper {
            height: 220px;
        }

        .car-card-body {
            height: calc(100% - 220px);
            padding: 22px;
        }

        .car-footer {
            align-items: flex-end;
        }

        .car-price {
            font-size: 1.03rem;
        }

        .car-detail-button {
            padding: 0 12px;
        }

        .home-cta-title {
            font-size: 2.25rem;
        }
    }
</style>

<div class="home-page">

    <!-- Hero Banner -->
    <section class="home-hero">
        <div class="container">
            <div class="home-hero-content">
                <div class="home-eyebrow">
                    Kỷ nguyên di chuyển mới
                </div>

                <h1 class="home-title">
                    GROUP7
                    <span>ECO DRIVE</span>
                </h1>

                <p class="home-description">
                    Hệ thống phân phối xe ô tô đẳng cấp, mang đến trải nghiệm lái xe
                    hoàn hảo cùng dịch vụ hậu mãi chuẩn quốc tế.
                </p>

                <a asp-controller="Cars"
                   asp-action="Index"
                   class="home-primary-button">
                    <i class="bi bi-car-front"></i>
                    Mua Xe Ngay
                </a>
            </div>
        </div>
    </section>

    <!-- Dịch vụ nổi bật -->
    <section class="home-features">
        <div class="container">
            <div class="feature-panel">
                <div class="row g-3">

                    <div class="col-lg-4">
                        <article class="feature-card">
                            <span class="feature-number">01</span>

                            <div class="feature-icon">
                                <i class="bi bi-shield-check"></i>
                            </div>

                            <h2 class="feature-title">
                                Bảo Hành Chính Hãng
                            </h2>

                            <p class="feature-description">
                                Cam kết bảo hành lên đến 5 năm hoặc 150.000km,
                                mang lại sự an tâm tuyệt đối.
                            </p>
                        </article>
                    </div>

                    <div class="col-lg-4">
                        <article class="feature-card feature-card-danger">
                            <span class="feature-number">02</span>

                            <div class="feature-icon">
                                <i class="bi bi-tools"></i>
                            </div>

                            <h2 class="feature-title">
                                Bảo Dưỡng Chuyên Nghiệp
                            </h2>

                            <p class="feature-description">
                                Hệ thống xưởng dịch vụ hiện đại, kỹ thuật viên
                                được đào tạo chuyên sâu từ hãng.
                            </p>
                        </article>
                    </div>

                    <div class="col-lg-4">
                        <article class="feature-card feature-card-success">
                            <span class="feature-number">03</span>

                            <div class="feature-icon">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>

                            <h2 class="feature-title">
                                Hệ Thống Rộng Khắp
                            </h2>

                            <p class="feature-description">
                                Giao xe tận nhà và hỗ trợ cứu hộ 24/7 trên toàn quốc
                                một cách nhanh chóng.
                            </p>
                        </article>
                    </div>

                </div>
            </div>
        </div>
    </section>

    <!-- Sản phẩm nổi bật -->
    <section class="featured-cars-section">
        <div class="container">

            <div class="featured-heading-row">
                <div>
                    <div class="home-section-label">
                        Khám phá ngay
                    </div>

                    <h2 class="home-section-title">
                        Sản phẩm nổi bật
                    </h2>

                    <p class="home-section-subtitle">
                        Khám phá những mẫu xe đang được phân phối tại
                        Group7 ECO DRIVE.
                    </p>
                </div>

                <div class="d-none d-md-block">
                    <a asp-controller="Cars"
                       asp-action="Index"
                       class="view-all-button">
                        Xem tất cả
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="empty-cars">
                    <div class="empty-cars-icon">
                        <i class="bi bi-car-front"></i>
                    </div>

                    <h3 class="fw-bold text-dark mb-3">
                        Hệ thống đang cập nhật sản phẩm
                    </h3>

                    <p class="text-secondary mb-0">
                        Vui lòng quay lại sau để trải nghiệm những mẫu xe mới nhất.
                    </p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

                    @foreach (var car in Model)
                    {
                        var displayImageUrl = string.IsNullOrWhiteSpace(car.ImageUrl)
                            ? "https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=600&q=80"
                            : car.ImageUrl;

                        <div class="col">
                            <article class="car-card">

                                <!-- Car Image and Status Badge -->
                                <div class="car-image-wrapper">
                                    <img src="@displayImageUrl"
                                         alt="@car.CarName"
                                         class="car-image" />

                                    <div class="car-image-overlay"></div>

                                    @if (car.Status == "Available")
                                    {
                                        <span class="car-status available">
                                            Sẵn sàng bán
                                        </span>
                                    }
                                    else if (car.Status == "Reserved")
                                    {
                                        <span class="car-status reserved">
                                            Đã đặt cọc
                                        </span>
                                    }
                                </div>

                                <!-- Car Info Body -->
                                <div class="car-card-body">

                                    <span class="car-brand">
                                        @(car.Brand?.BrandName ?? "Khác")
                                    </span>

                                    <h3 class="car-name">
                                        @car.CarName
                                    </h3>

                                    <p class="car-description">
                                        @(string.IsNullOrWhiteSpace(car.Description)
                                            ? "Mẫu xe đẳng cấp với trang bị hiện đại và khả năng vận hành vượt trội."
                                            : car.Description)
                                    </p>

                                    <!-- Specs -->
                                    <div class="row g-2 car-spec-grid">
                                        <div class="col-6">
                                            <div class="car-spec">
                                                <i class="bi bi-calendar-event"></i>
                                                <span>@car.Year</span>
                                            </div>
                                        </div>

                                        <div class="col-6">
                                            <div class="car-spec">
                                                <i class="bi bi-speedometer2"></i>
                                                <span>@car.Mileage.ToString("N0") km</span>
                                            </div>
                                        </div>

                                        <div class="col-6">
                                            <div class="car-spec">
                                                <i class="bi bi-gear-fill"></i>
                                                <span>
                                                    @(car.Transmission == "Automatic"
                                                        ? "Số tự động"
                                                        : "Số sàn")
                                                </span>
                                            </div>
                                        </div>

                                        <div class="col-6">
                                            <div class="car-spec">
                                                <i class="bi bi-fuel-pump-fill"></i>
                                                <span>@car.FuelType</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Price and Actions -->
                                    <div class="car-footer">
                                        <div>
                                            <span class="car-price-label">
                                                Giá bán
                                            </span>

                                            <span class="car-price">
                                                @car.Price.ToString("N0") đ
                                            </span>
                                        </div>

                                        <a asp-controller="Cars"
                                           asp-action="Details"
                                           asp-route-id="@car.CarId"
                                           class="car-detail-button">
                                            Chi tiết
                                            <i class="bi bi-arrow-right-short"></i>
                                        </a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    }

                </div>

                <!-- Mobile View All Button -->
                <div class="text-center mt-5 d-md-none">
                    <a asp-controller="Cars"
                       asp-action="Index"
                       class="view-all-button">
                        Xem tất cả xe
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            }

        </div>
    </section>

    <!-- CTA Section -->
    <section class="home-cta">
        <div class="container">
            <div class="home-cta-content">
                <div class="home-eyebrow">
                    Group7 ECO DRIVE
                </div>

                <h2 class="home-cta-title">
                    Bạn đã sẵn sàng trải nghiệm?
                </h2>

                <p class="home-cta-description">
                    Liên hệ ngay hôm nay để nhận báo giá chi tiết, đăng ký lái thử
                    và được tư vấn trực tiếp từ chuyên gia của chúng tôi.
                </p>

                <a asp-controller="Home"
                   asp-action="Contact"
                   class="home-cta-button">
                    <i class="bi bi-telephone-fill"></i>
                    Liên Hệ Nhận Tư Vấn
                </a>
            </div>
        </div>
    </section>

</div>
