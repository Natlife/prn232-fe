@{
    ViewData["Title"] = "Giới thiệu - Group7 ECO DRIVE";
}

<style>
    /* Custom Styles for About Page */
    .hero-banner {
        position: relative;
        height: 70vh;
        min-height: 500px;
        background: url('https://images.unsplash.com/photo-1552519507-da3b142c6e3d?q=80&w=2000') no-repeat center center;
        background-size: cover;
    }
    .hero-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: rgba(0, 0, 0, 0.6);
    }
    .hero-content {
        position: relative;
        z-index: 2;
    }
    
    .btn-hero {
        transition: all 0.3s ease;
    }
    .btn-hero:hover {
        transform: translateY(-5px) scale(1.05);
        box-shadow: 0 15px 25px rgba(255, 193, 7, 0.4) !important;
        background-color: #ffca2c;
        color: #000 !important;
    }
    
    .section-title {
        font-family: 'Arial Black', sans-serif;
        letter-spacing: -1px;
    }
    
    .text-indent {
        text-indent: 2.5rem;
    }

    .feature-icon-box {
        width: 80px;
        height: 80px;
        background-color: #f8f9fa;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        color: #ffc107; /* Warning yellow matching the nav */
        font-size: 2.5rem;
        transition: all 0.3s ease;
    }
    
    .feature-card:hover .feature-icon-box {
        background-color: #ffc107;
        color: #fff;
        transform: translateY(-10px);
        box-shadow: 0 10px 20px rgba(255, 193, 7, 0.3);
    }

    .product-showcase {
        background-color: #f8f9fa;
        padding: 80px 0;
    }

    .product-img {
        border-radius: 10px;
        box-shadow: 0 15px 30px rgba(0,0,0,0.1);
        transition: transform 0.5s ease;
    }
    .product-img:hover {
        transform: scale(1.03);
    }

    .number-highlight {
        color: #dc3545; /* Danger red matching the project style */
        font-weight: 900;
        font-size: 1.5rem;
    }

    .testimonial-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        transition: all 0.3s ease;
    }
    .testimonial-card:hover {
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }
</style>

<!-- Hero Banner -->
<div class="hero-banner d-flex align-items-center justify-content-center text-center text-white">
    <div class="hero-overlay"></div>
    <div class="hero-content container">
        <h1 class="display-3 fw-bold text-uppercase mb-3 section-title">Group<span class="text-warning">7</span> ECO DRIVE</h1>
        <p class="fs-4 mb-5 text-light fw-light">Tiên phong giải pháp di chuyển thông minh tại Việt Nam.</p>
        <a asp-controller="Cars" asp-action="Index" class="btn btn-hero btn-warning btn-lg px-5 py-3 rounded-pill fw-bold text-dark text-uppercase shadow-lg" style="letter-spacing: 1px;">
            <i class="bi bi-cart3 me-2"></i> Khám phá ngay
        </a>
    </div>
</div>

<!-- Welcome Section -->
<div class="bg-white py-5">
    <div class="container my-4">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-5 mb-lg-0 pe-lg-5">
                <h6 class="text-danger fw-bold text-uppercase mb-2" style="letter-spacing: 2px;">Về chúng tôi</h6>
                <h2 class="display-5 fw-bold mb-4 section-title text-dark">GROUP7 <span class="text-warning">ECO DRIVE</span></h2>
                <div style="width: 80px; height: 5px; background-color: #dc3545; margin-bottom: 30px;"></div>
                <p class="text-secondary lh-lg mb-4 fs-5 text-indent" style="text-align: justify;">
                    Với sứ mệnh mang đến những trải nghiệm lái xe tuyệt vời và an toàn nhất, <strong>Group7 ECO DRIVE</strong> tự hào là đơn vị phân phối ô tô và phụ tùng chính hãng hàng đầu. Trải qua quá trình hình thành và phát triển, chúng tôi không ngừng cập nhật xu hướng công nghệ mới, đa dạng hóa các dòng xe từ thể thao, gia đình đến xe điện thân thiện với môi trường.
                </p>
                <p class="text-secondary lh-lg fs-5 text-indent" style="text-align: justify;">
                    Sự uy tín, tận tâm và chuyên nghiệp chính là nền tảng giúp chúng tôi xây dựng niềm tin vững chắc và đồng hành lâu dài cùng quý khách hàng trên mọi cung đường.
                </p>
            </div>
            <div class="col-lg-6 text-center">
                <img src="https://images.unsplash.com/photo-1542362567-b07e54358753?q=80&w=1000" class="img-fluid rounded shadow-lg" alt="Showroom Group7">
            </div>
    </div>
</div>

<!-- Features Section -->
<div class="py-5" style="background-color: #eef4f8;">
    <div class="container my-4">
        <div class="row">
            <div class="col-md-3 col-sm-6 mb-4 feature-card">
                <div class="feature-icon-box shadow-sm">
                    <i class="bi bi-truck"></i>
                </div>
                <h4 class="fw-bold mb-3 text-uppercase fs-5">Giao xe tận nơi</h4>
                <p class="text-secondary small pe-3">Hỗ trợ giao xe tận nhà trên toàn quốc, thủ tục nhanh gọn, an toàn.</p>
            </div>
            <div class="col-md-3 col-sm-6 mb-4 feature-card">
                <div class="feature-icon-box shadow-sm">
                    <i class="bi bi-facebook"></i>
                </div>
                <h4 class="fw-bold mb-3 text-uppercase fs-5">Đặt Hàng</h4>
                <p class="text-secondary small pe-3">Chúng tôi chỉ nhận đặt hàng qua facebook Đinh Nhật Quân.</p>
            </div>
            <div class="col-md-3 col-sm-6 mb-4 feature-card">
                <div class="feature-icon-box shadow-sm">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <h4 class="fw-bold mb-3 text-uppercase fs-5">Địa Chỉ</h4>
                <p class="text-secondary small pe-3">Trường đại học FPT khu công nghệ cao Hòa Lạc.</p>
            </div>
            <div class="col-md-3 col-sm-6 mb-4 feature-card">
                <div class="feature-icon-box shadow-sm">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h4 class="fw-bold mb-3 text-uppercase fs-5">Bảo hành chính hãng</h4>
                <p class="text-secondary small pe-3">Cam kết bảo hành dài hạn cùng dịch vụ hậu mãi chu đáo, uy tín.</p>
            </div>
        </div>
    </div>
</div>

<!-- Product Showcase Section -->
<div class="bg-white py-5">
    <div class="product-showcase bg-transparent py-4">
        <div class="container text-center mb-5">
            <h6 class="text-danger fw-bold text-uppercase mb-2" style="letter-spacing: 2px;">Dòng xe nổi bật</h6>
            <h2 class="display-5 fw-bold section-title text-dark">KHÁM PHÁ CÁC MẪU XE ĐỈNH CAO</h2>
            <div style="width: 80px; height: 5px; background-color: #dc3545; margin: 20px auto 0;"></div>
        </div>

    <!-- Product 1 -->
    <div class="container mb-5 pb-4">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0 pe-lg-5">
                <img src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?q=80&w=1000" class="img-fluid product-img w-100" alt="Xe Thể Thao">
            </div>
            <div class="col-lg-6">
                <h3 class="fw-bold mb-3"><span class="number-highlight me-2">01.</span> SIÊU XE THỂ THAO</h3>
                <p class="text-secondary fs-5 mb-4 lh-lg text-indent" style="text-align: justify;">
                    Thiết kế khí động học hoàn hảo, động cơ V8 mạnh mẽ. Đem lại cảm giác tăng tốc từ 0 lên 100km/h chỉ trong 3.5 giây. Trải nghiệm tốc độ đỉnh cao kết hợp với không gian nội thất sang trọng.
                </p>
                <a asp-controller="Cars" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4">
                    Xem Chi Tiết <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>

        <!-- Product 2 -->
        <div class="container mb-5 pb-4">
            <div class="row align-items-center flex-row-reverse">
                <div class="col-lg-6 mb-4 mb-lg-0 ps-lg-5">
                    <img src="https://images.unsplash.com/photo-1533473359331-0135ef1b58bf?q=80&w=1000" class="img-fluid product-img w-100" alt="Xe Gia Đình">
                </div>
                <div class="col-lg-6 text-lg-end">
                <h3 class="fw-bold mb-3"><span class="number-highlight me-2">02.</span> SUV GIA ĐÌNH CAO CẤP</h3>
                <p class="text-secondary fs-5 mb-4 lh-lg text-indent" style="text-align: justify;">
                    Sự kết hợp hoàn hảo giữa không gian rộng rãi (7 chỗ ngồi) và công nghệ an toàn chủ động tiên tiến. Lựa chọn tuyệt vời cho những chuyến dã ngoại cùng gia đình với cốp xe cực lớn và tính năng giải trí đa dạng.
                </p>
                <a asp-controller="Cars" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4">
                    <i class="bi bi-arrow-left me-2"></i> Xem Chi Tiết
                </a>
            </div>
        </div>
        </div>
    </div>
</div>

<!-- Thank You Section -->
<div class="container-fluid p-0 border-top border-bottom">
    <div class="row g-0">
        <div class="col-md-6">
            <img src="https://images.unsplash.com/photo-1560958089-b8a1929cea89?q=80&w=1000" class="img-fluid w-100 h-100" style="object-fit: cover; min-height: 400px;" alt="Cảm ơn quý khách">
        </div>
        <div class="col-md-6 text-white d-flex align-items-center p-5" style="background-color: #2b2b2c;">
            <div>
                <h6 class="text-secondary fw-bold text-uppercase mb-2" style="letter-spacing: 2px;">GROUP7 ECO DRIVE</h6>
                <h2 class="display-6 fw-bold mb-5 section-title">CẢM ƠN QUÝ KHÁCH ĐÃ QUAN TÂM SẢN PHẨM</h2>
                
                <div class="row mt-4">
                    <div class="col-sm-5 mb-4">
                        <h6 class="text-uppercase text-white fw-bold mb-3 fs-5">Số điện thoại</h6>
                        <div class="border border-secondary d-inline-block px-3 py-2 text-white fs-5">0359 492 991</div>
                    </div>
                    <div class="col-sm-4 mb-4">
                        <h6 class="text-uppercase text-white fw-bold mb-3 fs-5">Facebook</h6>
                        <div class="text-white mt-2 text-uppercase">Đinh Nhật Quân</div>
                    </div>
                    <div class="col-sm-3 mb-4">
                        <h6 class="text-uppercase text-white fw-bold mb-3 fs-5">Tiktok</h6>
                        <div class="text-white mt-2 text-uppercase">Đinh Nhật Quân</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

