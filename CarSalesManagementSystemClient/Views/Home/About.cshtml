                    <div class="d-flex align-items-center justify-content-center">
                        <div class="bg-danger rounded-circle text-white d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-weight: bold;">MH</div>
                        <div class="ms-3 text-start">
                            <h6 class="fw-bold m-0">Minh Hoàng</h6>
                            <small class="text-muted">Khách hàng TP.HCM</small>
                        </div>
                    </div>
                </div>
