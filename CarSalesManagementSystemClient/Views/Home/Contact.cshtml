                            </div>

                            <h2 class="contact-card-title">Gửi Email</h2>

                            <p class="contact-card-description">
                                dinhnhatquan0311@gmail.com
                            </p>
                        </div>
                    </div>

                    <!-- Address -->
                    <div class="col-lg-4">
                        <div class="contact-card">
                            <span class="contact-card-number">02</span>

                            <div class="contact-icon">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>

                            <h2 class="contact-card-title">Đến Văn Phòng</h2>

                            <p class="contact-card-description">
                                Trường Đại học FPT<br />
                                Khu Công nghệ cao Hòa Lạc
                            </p>
                        </div>
                    </div>

                    <!-- Phone -->
                    <div class="col-lg-4">
                        <div class="contact-card">
                            <span class="contact-card-number">03</span>

                            <div class="contact-icon">
                                <i class="bi bi-telephone-fill"></i>
                            </div>

                            <h2 class="contact-card-title">Gọi Cho Chúng Tôi</h2>

                            <p class="contact-card-description">
                                (+84) 035 949 2991
                            </p>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>

    <!-- Gallery -->
    <section class="contact-gallery">
        <div class="container">
            <div class="section-heading text-center">
                <div class="section-label">
                    Our showroom
                </div>

                <h2 class="section-title">
                    Không gian trưng bày
                </h2>

                <p class="section-description">
                    Khám phá không gian hiện đại cùng những mẫu xe nổi bật tại
                    Group7 ECO DRIVE.
                </p>
            </div>

            <div class="row g-4">

                <div class="col-lg-7">
                    <div class="gallery-card">
                        <img src="https://images.unsplash.com/photo-1552519507-da3b142c6e3d?q=80&w=1000"
                             class="gallery-image"
                             alt="Showroom" />

                        <div class="gallery-content">
                            <span class="gallery-index">01 / SHOWROOM</span>
                            <h3 class="gallery-name">
                                Không gian trưng bày hiện đại
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="row g-4">

                        <div class="col-12">
                            <div class="gallery-card gallery-card-small">
                                <img src="https://images.unsplash.com/photo-1542362567-b07e54358753?q=80&w=1000"
                                     class="gallery-image"
                                     alt="Luxury Car" />

                                <div class="gallery-content">
                                    <span class="gallery-index">02 / VEHICLE</span>
                                    <h3 class="gallery-name">
                                        Những mẫu xe cao cấp
                                    </h3>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="gallery-card gallery-card-small">
