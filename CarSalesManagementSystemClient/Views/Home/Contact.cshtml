            </div>
        </div>
    </section>

    <!-- Social Connection -->
    <section class="connect-section">
        <div class="container">
            <div class="connect-panel">
                <div class="connect-content text-center">
                    <div class="section-label">
                        Stay connected
                    </div>

                    <h2 class="connect-title">
                        Let's Connect
                    </h2>

                    <p class="connect-description">
                        Kết nối với Group7 ECO DRIVE để nhận tư vấn và cập nhật
                        những thông tin mới nhất.
                    </p>

                    <div class="social-list">
                        <a href="javascript:void(0);"
                           class="social-btn"
                           title="Facebook"
                           aria-label="Facebook">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="javascript:void(0);"
                           class="social-btn"
                           title="TikTok"
                           aria-label="TikTok">
                            <i class="bi bi-tiktok"></i>
                        </a>

                        <a href="mailto:group7@gmail.com"
                           class="social-btn"
                           title="Email"
                           aria-label="Email">
                            <i class="bi bi-envelope-fill"></i>
                        </a>

                        <a href="tel:0359492991"
                           class="social-btn"
                           title="Phone"
                           aria-label="Phone">
                            <i class="bi bi-telephone-fill"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

</div>