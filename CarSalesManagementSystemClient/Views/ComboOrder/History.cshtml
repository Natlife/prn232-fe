@model List<CarSalesManagementSystemClient.Models.ComboOrderViewModel>
@using System.Text.Json
@{
    ViewData["Title"] = "Lịch sử đơn combo";
    var ordersJson = JsonSerializer.Serialize(Model ?? new List<CarSalesManagementSystemClient.Models.ComboOrderViewModel>());
}

<style>
    .combo-history-card {
        border: none;
        border-radius: 24px;
        box-shadow: 0 20px 42px rgba(15, 23, 42, 0.08);
    }

    .combo-status-pill {
        padding: 10px 14px;
        border-radius: 999px;
        font-weight: 700;
    }
</style>

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Lịch sử đơn combo</h2>
            <p class="text-muted mb-0">Theo dõi trạng thái đặt cọc, mua đứt và xác thực 2 lần captcha của từng đơn combo.</p>
        </div>
        <a href="/" class="btn btn-outline-dark fw-semibold"><i class="bi bi-arrow-left me-2"></i>Quay lại mua sắm</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <div class="display-4 text-muted mb-3"><i class="bi bi-inbox"></i></div>
            <h5 class="fw-bold">Chưa có đơn combo nào</h5>
            <p class="text-muted">Khi bạn tạo đơn combo từ chatbot hoặc đặt thủ công, thông tin sẽ hiện ở đây.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var order in Model)
            {
                var safeItems = order.Items ?? new List<CarSalesManagementSystemClient.Models.ComboOrderItemViewModel>();
                var statusClass = order.Status switch
                {
                    "Pending" => "bg-warning-subtle text-warning-emphasis",
                    "Deposited" => "bg-info-subtle text-info-emphasis",
                    "Completed" => "bg-success-subtle text-success-emphasis",
                    "Cancelled" => "bg-danger-subtle text-danger-emphasis",
                    "DepositExpired" => "bg-dark-subtle text-dark-emphasis",
                    _ => "bg-secondary-subtle text-secondary-emphasis"
                };
                var statusText = order.Status switch
                {
                    "Pending" => "Chờ xác thực",
                    "Deposited" => "Đã đặt cọc",
                    "Completed" => "Hoàn tất",
                    "Cancelled" => "Đã hủy",
                    "DepositExpired" => "Hết hạn giữ combo",
                    _ => order.Status
                };
                var purchaseBadge = order.PurchaseType == "Deposit" ? "bg-warning-subtle text-dark" : "bg-success-subtle text-success-emphasis";
                var payableAmount = order.Status == "Deposited"
                    ? Math.Max(0, order.TotalAmount - (order.DepositAmount ?? 0))
                    : (order.PurchaseType == "Deposit" ? (order.DepositAmount ?? 0) : order.TotalAmount);

                <div class="col-12">
                    <div class="card combo-history-card">
                        <div class="card-body p-4">
                            <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                                <div>
                                    <div class="fw-bold fs-5 text-dark">Đơn #@order.ComboOrderId</div>
                                    <div class="text-muted small">Tạo lúc @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                                <div class="d-flex gap-2 flex-wrap">
                                    <span class="badge @purchaseBadge combo-status-pill">@(order.PurchaseType == "Deposit" ? "Đặt cọc" : "Mua đứt")</span>
                                    <span class="badge @statusClass combo-status-pill">@statusText</span>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-lg-8">
                                    <div class="fw-semibold text-dark mb-2">Sản phẩm trong đơn</div>
                                    <div class="table-responsive">
                                        <table class="table align-middle mb-0">
                                            <tbody>
                                                @foreach (var item in safeItems)
                                                {
                                                    <tr>
                                                        <td>
                                                            <div class="fw-semibold">@item.ItemName</div>
                                                            <div class="small text-muted">@item.ItemType</div>
                                                        </td>
                                                        <td class="text-center">x@item.Quantity</td>
                                                        <td class="text-end">@item.SubTotal.ToString("N0") VND</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="small text-muted mb-1">Tổng giá trị</div>
                                    <div class="fw-bold text-danger mb-3">@order.TotalAmount.ToString("N0") VND</div>

                                    <div class="small text-muted mb-1">Số tiền cần xử lý hiện tại</div>
                                    <div class="fw-semibold mb-3">@payableAmount.ToString("N0") VND</div>

                                    <div class="small text-muted mb-1">Captcha</div>
                                    <div class="fw-semibold mb-3">Nhận trực tiếp từ admin</div>

                                    <button type="button"
                                            class="btn btn-dark w-100 view-order-btn"
                                            data-order-id="@order.ComboOrderId">
                                        Xem chi tiết và xử lý
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="comboHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h4 class="modal-title fw-bold" id="historyOrderTitle">Chi tiết đơn combo</h4>
                    <div class="text-muted small" id="historyOrderSubTitle"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="fw-semibold mb-2">Danh sách sản phẩm</div>
                        <div id="historyItemsContainer" class="border rounded-4 p-3 bg-light-subtle"></div>
                    </div>
                    <div class="col-lg-5">
                        <div class="border rounded-4 p-3 mb-3">
                            <div class="small text-muted">Loại giao dịch</div>
                            <div class="fw-bold mb-2" id="historyPurchaseType"></div>
                            <div class="small text-muted">Trạng thái</div>
                            <div class="fw-bold mb-2" id="historyStatus"></div>
                            <div class="small text-muted">Số tiền cần xử lý hiện tại</div>
                            <div class="fw-bold text-danger mb-2" id="historyPayable"></div>
                            <div class="small text-muted">Hạn giữ combo</div>
                            <div class="fw-bold" id="historyExpiry">Không áp dụng</div>
                        </div>

                        <div id="historyVerifyBox" class="border rounded-4 p-3">
                            <label for="historyCaptchaInput" class="form-label fw-semibold" id="historyCaptchaLabel">Nhập captcha</label>
                            <input id="historyCaptchaInput" type="text" class="form-control text-uppercase mb-2" maxlength="20" />
                            <div id="historyCaptchaHint" class="small text-muted mb-2"></div>
                            <div id="historyCaptchaError" class="text-danger small d-none mb-2"></div>
                            <button type="button" id="btnHistoryVerify" class="btn btn-warning w-100 fw-bold">Xác thực đơn combo</button>
                        </div>
                        <div id="historyDoneBox" class="alert alert-success d-none mb-0">
                            Đơn combo này không cần xác thực thêm ở thời điểm hiện tại.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const comboOrders = @Html.Raw(ordersJson);
        let activeHistoryOrder = null;

        function readProp(source, camelKey, pascalKey) {
            return source?.[camelKey] ?? source?.[pascalKey];
        }

        function renderHistoryItems(items) {
            if (!items || !items.length) {
                return '<div class="text-muted">Không có sản phẩm.</div>';
            }

            return items.map(item => `
                <div class="d-flex justify-content-between align-items-start border-bottom py-2">
                    <div>
                        <div class="fw-semibold">${readProp(item, 'itemName', 'ItemName')}</div>
                        <div class="small text-muted">${readProp(item, 'itemType', 'ItemType')} - SL ${readProp(item, 'quantity', 'Quantity')}</div>
                    </div>
                    <div class="fw-bold text-danger">${Number(readProp(item, 'subTotal', 'SubTotal') || 0).toLocaleString('vi-VN')} VND</div>
                </div>
            `).join('');
        }

        function formatVnd(value) {
            return Number(value || 0).toLocaleString("vi-VN") + " VND";
        }

        function formatStatus(status) {
            switch (status) {
                case "Pending": return "Chờ xác thực";
                case "Deposited": return "Đã đặt cọc";
                case "Completed": return "Hoàn tất";
                case "Cancelled": return "Đã hủy";
                case "DepositExpired": return "Hết hạn giữ combo";
                default: return status || "";
            }
        }

        $(function () {
            $(".view-order-btn").on("click", function () {
                const orderId = Number($(this).data("order-id"));
                activeHistoryOrder = comboOrders.find(x => Number(readProp(x, 'comboOrderId', 'ComboOrderId')) === orderId);
                if (!activeHistoryOrder) return;

                const purchaseType = readProp(activeHistoryOrder, 'purchaseType', 'PurchaseType');
                const status = readProp(activeHistoryOrder, 'status', 'Status');
                const depositAmount = Number(readProp(activeHistoryOrder, 'depositAmount', 'DepositAmount') || 0);
                const totalAmount = Number(readProp(activeHistoryOrder, 'totalAmount', 'TotalAmount') || 0);
                const depositExpiresAt = readProp(activeHistoryOrder, 'depositExpiresAt', 'DepositExpiresAt');
                const payable = status === "Deposited" ? Math.max(0, totalAmount - depositAmount) : (purchaseType === "Deposit" ? depositAmount : totalAmount);

                $("#historyOrderTitle").text(`Đơn combo #${readProp(activeHistoryOrder, 'comboOrderId', 'ComboOrderId')}`);
                $("#historyOrderSubTitle").text(`Khách hàng: ${readProp(activeHistoryOrder, 'customerName', 'CustomerName')} - ${readProp(activeHistoryOrder, 'customerPhone', 'CustomerPhone')}`);
                $("#historyItemsContainer").html(renderHistoryItems(readProp(activeHistoryOrder, 'items', 'Items')));
                $("#historyPurchaseType").text(purchaseType === "Deposit" ? "Đặt cọc combo" : "Mua đứt combo");
                $("#historyStatus").text(formatStatus(status));
                $("#historyPayable").text(formatVnd(payable));
                $("#historyExpiry").text(depositExpiresAt ? new Date(depositExpiresAt).toLocaleString("vi-VN") : "Không áp dụng");
                $("#historyCaptchaInput").val("");
                $("#historyCaptchaError").addClass("d-none").text("");

                const canVerifyDeposit = purchaseType === "Deposit" && status === "Pending";
                const canVerifyBuyoutAfterDeposit = purchaseType === "Deposit" && status === "Deposited";
                const canVerifyDirectBuyout = purchaseType === "Buyout" && status === "Pending";
                const canVerify = canVerifyDeposit || canVerifyBuyoutAfterDeposit || canVerifyDirectBuyout;

                if (canVerifyDeposit) {
                    $("#historyCaptchaLabel").text("Nhập captcha đặt cọc lần 1");
                    $("#historyCaptchaHint").text("Admin sẽ cung cấp captcha lần 1 để giữ combo trong 7 ngày.");
                    $("#btnHistoryVerify").text("Xác thực đặt cọc");
                } else if (canVerifyBuyoutAfterDeposit) {
                    $("#historyCaptchaLabel").text("Nhập captcha mua đứt lần 2");
                    $("#historyCaptchaHint").text("Captcha lần 2 phải khác captcha đặt cọc lần 1 và do admin tạo mới.");
                    $("#btnHistoryVerify").text("Xác thực mua đứt");
                } else if (canVerifyDirectBuyout) {
                    $("#historyCaptchaLabel").text("Nhập captcha mua đứt");
                    $("#historyCaptchaHint").text("Admin sẽ cung cấp captcha để hoàn tất thanh toán toàn bộ đơn combo.");
                    $("#btnHistoryVerify").text("Xác thực mua đứt");
                }

                $("#historyVerifyBox").toggleClass("d-none", !canVerify);
                $("#historyDoneBox").toggleClass("d-none", canVerify);

                bootstrap.Modal.getOrCreateInstance(document.getElementById("comboHistoryModal")).show();
            });

            $("#historyCaptchaInput").on("input", function () {
                this.value = this.value.toUpperCase();
            });

            $("#btnHistoryVerify").on("click", async function () {
                if (!activeHistoryOrder) return;

                const captchaCode = $("#historyCaptchaInput").val().trim().toUpperCase();
                if (!captchaCode) {
                    $("#historyCaptchaError").removeClass("d-none").text("Vui lòng nhập captcha.");
                    return;
                }

                const btn = $(this);
                btn.prop("disabled", true).text("Đang xác thực...");
                $("#historyCaptchaError").addClass("d-none").text("");

                try {
                    const response = await fetch(`/ComboOrder/VerifyCaptcha?id=${readProp(activeHistoryOrder, 'comboOrderId', 'ComboOrderId')}`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ captchaCode })
                    });
                    const result = await response.json();
                    if (!result.success) {
                        $("#historyCaptchaError").removeClass("d-none").text(result.message || "Không thể xác thực captcha.");
                        return;
                    }

                    window.location.reload();
                } catch (err) {
                    $("#historyCaptchaError").removeClass("d-none").text("Không thể kết nối tới máy chủ.");
                } finally {
                    btn.prop("disabled", false).text("Xác thực đơn combo");
                }
            });
        });
    </script>
}
