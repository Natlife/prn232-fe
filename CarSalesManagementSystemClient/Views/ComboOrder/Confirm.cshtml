@model CarSalesManagementSystemClient.Models.ComboOrderPreviewViewModel
@{
    ViewData["Title"] = "Xac nhan don combo";
    var isAuthenticated = ViewBag.IsAuthenticated as bool? ?? false;
    var draftToken = ViewBag.DraftToken as string ?? string.Empty;
    var purchaseType = (ViewBag.PurchaseType as string ?? "Buyout").Equals("Deposit", StringComparison.OrdinalIgnoreCase)
        ? "Deposit"
        : "Buyout";
    var payableAmount = purchaseType == "Deposit"
        ? Math.Round(Model.TotalAmount * 0.05m, 0)
        : Model.TotalAmount;
    var purchaseTypeLabel = purchaseType == "Deposit" ? "Dat coc combo" : "Mua dut combo";
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Xac nhan don combo</h2>
            <p class="text-muted mb-0">Kiem tra lai san pham, tao don, lien he admin va nhap captcha de hoan tat giao dich.</p>
        </div>
        <span class="badge @(purchaseType == "Deposit" ? "bg-warning text-dark" : "bg-success") px-3 py-2 rounded-pill">
            @purchaseTypeLabel
        </span>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-dark text-white py-3 rounded-top-4">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-bag-check me-2"></i>Danh sach san pham</h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.Items.Any())
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr class="text-muted small">
                                        <th>San pham</th>
                                        <th class="text-center">SL</th>
                                        <th class="text-end">Don gia</th>
                                        <th class="text-end">Thanh tien</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold text-dark">@item.Name</div>
                                                <div class="small text-muted">@item.ItemType</div>
                                            </td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-end">@item.UnitPrice.ToString("N0") VND</td>
                                            <td class="text-end fw-bold text-danger">@item.SubTotal.ToString("N0") VND</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">Khong co san pham nao trong combo.</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-warning py-3 rounded-top-4">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-receipt me-2"></i>Thong tin giao dich</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tong gia tri combo</span>
                        <span class="fw-bold text-dark">@Model.TotalAmount.ToString("N0") VND</span>
                    </div>
                    <div class="d-flex justify-content-between mb-4">
                        <span class="text-muted">So tien can thanh toan</span>
                        <span class="fw-bold text-danger">@(payableAmount.ToString("N0")) VND</span>
                    </div>

                    @if (purchaseType == "Deposit")
                    {
                        <div class="alert alert-warning rounded-4 border-0">
                            Dat coc combo se tam ghi nhan 5% tong gia tri don. Sau khi admin tao captcha va ban xac thuc thanh cong, he thong moi chot don.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success rounded-4 border-0">
                            Mua dut combo yeu cau xac nhan thanh toan day du. Sau khi admin tao captcha va ban nhap dung ma, don se hoan tat.
                        </div>
                    }

                    @if (isAuthenticated)
                    {
                        <form id="comboOrderConfirmForm">
                            <input type="hidden" id="draftToken" value="@draftToken" />
                            <input type="hidden" id="purchaseType" value="@purchaseType" />

                            <div class="mb-3">
                                <label for="customerPhone" class="form-label fw-semibold">So dien thoai</label>
                                <input type="tel" class="form-control" id="customerPhone" required maxlength="20" />
                            </div>
                            <div class="mb-3">
                                <label for="shippingAddress" class="form-label fw-semibold">Dia chi giao nhan / lien he</label>
                                <input type="text" class="form-control" id="shippingAddress" required maxlength="255" />
                            </div>
                            <div class="mb-3">
                                <label for="orderNote" class="form-label fw-semibold">Ghi chu</label>
                                <textarea class="form-control" id="orderNote" rows="3" maxlength="1000"></textarea>
                            </div>
                            <button type="submit" id="btnSubmitOrder" class="btn btn-warning w-100 fw-bold py-3">
                                @(purchaseType == "Deposit" ? "Tao don dat coc combo" : "Tao don mua dut combo")
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <div class="display-5 text-muted mb-3"><i class="bi bi-lock-fill"></i></div>
                            <h5 class="fw-bold">Can dang nhap de tiep tuc</h5>
                            <p class="text-muted">Vui long dang nhap truoc khi tao don combo va xac thuc captcha.</p>
                            <button class="btn btn-primary fw-bold px-4" data-bs-toggle="modal" data-bs-target="#loginModal">Dang nhap</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="comboOrderFlowModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-body p-4">
                <div id="comboPendingState">
                    <div class="text-center mb-3">
                        <div class="display-4 text-warning"><i class="bi bi-shield-lock-fill"></i></div>
                        <h4 class="fw-bold mt-3">Don combo da duoc tao</h4>
                        <p class="text-muted mb-0">
                            Ma don <strong>#<span id="comboOrderIdText"></span></strong> da duoc ghi nhan.
                            Hay lien he admin, thanh toan, sau do nhap captcha de hoan tat.
                        </p>
                    </div>
                    <div class="bg-light rounded-4 p-3 mb-3">
                        <div class="small text-muted mb-1">Loai giao dich</div>
                        <div class="fw-bold" id="comboPurchaseTypeText"></div>
                        <div class="small text-muted mt-3 mb-1">So tien can xac nhan</div>
                        <div class="fw-bold text-danger" id="comboPayableText"></div>
                    </div>
                    <div class="mb-3">
                        <label for="comboOrderCaptchaInput" class="form-label fw-semibold">Nhap captcha tu admin</label>
                        <input id="comboOrderCaptchaInput" type="text" class="form-control text-uppercase" maxlength="20" />
                        <div id="captchaError" class="text-danger small mt-2 d-none"></div>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="button" id="btnVerifyCaptcha" class="btn btn-warning fw-bold">Xac thuc captcha</button>
                        <a href="/ComboOrder/History" class="btn btn-outline-dark">Theo doi trong lich su don combo</a>
                    </div>
                </div>

                <div id="comboSuccessState" class="d-none text-center">
                    <div class="display-3 text-success mb-3"><i class="bi bi-check-circle-fill"></i></div>
                    <h4 class="fw-bold">Xac thuc thanh cong</h4>
                    <p class="text-muted">
                        Don combo <strong>#<span id="finalComboOrderIdText"></span></strong> da duoc cap nhat thanh cong.
                        Ban co the xem lai trang thai trong lich su don combo.
                    </p>
                    <div class="d-grid gap-2">
                        <a href="/ComboOrder/History" class="btn btn-primary">Xem lich su don combo</a>
                        <a href="/" class="btn btn-light border">Ve trang chu</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const draftItems = [];
            @foreach (var item in Model.Items)
            {
                @:draftItems.push({ itemType: "@item.ItemType", referenceId: @item.ReferenceId, quantity: @item.Quantity });
            }

            let currentOrderId = 0;
            const payableAmount = @payableAmount;
            const purchaseType = "@purchaseType";

            $("#comboOrderConfirmForm").on("submit", async function (e) {
                e.preventDefault();

                const btn = $("#btnSubmitOrder");
                btn.prop("disabled", true).text("Dang tao don...");

                const payload = {
                    customerPhone: $("#customerPhone").val(),
                    purchaseType: purchaseType,
                    shippingAddress: $("#shippingAddress").val(),
                    note: $("#orderNote").val(),
                    chatSessionId: localStorage.getItem("chat_session_id") || "",
                    items: draftItems
                };

                try {
                    const response = await fetch("/ComboOrder/PlaceOrder", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(payload)
                    });

                    const result = await response.json();
                    if (!result.success) {
                        alert(result.message || "Khong the tao don combo.");
                        btn.prop("disabled", false).text(purchaseType === "Deposit" ? "Tao don dat coc combo" : "Tao don mua dut combo");
                        return;
                    }

                    currentOrderId = result.orderId || 0;
                    $("#comboOrderIdText").text(currentOrderId);
                    $("#finalComboOrderIdText").text(currentOrderId);
                    $("#comboPurchaseTypeText").text(purchaseType === "Deposit" ? "Dat coc combo" : "Mua dut combo");
                    $("#comboPayableText").text(Number(payableAmount).toLocaleString("vi-VN") + " VND");
                    $("#comboOrderCaptchaInput").val("");
                    $("#captchaError").addClass("d-none").text("");
                    $("#comboPendingState").removeClass("d-none");
                    $("#comboSuccessState").addClass("d-none");

                    const modal = new bootstrap.Modal(document.getElementById("comboOrderFlowModal"));
                    modal.show();
                    localStorage.removeItem("draft_combo_cart");
                } catch (err) {
                    alert("Khong the ket noi toi may chu.");
                } finally {
                    btn.prop("disabled", false).text(purchaseType === "Deposit" ? "Tao don dat coc combo" : "Tao don mua dut combo");
                }
            });

            $("#comboOrderCaptchaInput").on("input", function () {
                this.value = this.value.toUpperCase();
            });

            $("#btnVerifyCaptcha").on("click", async function () {
                const captchaCode = $("#comboOrderCaptchaInput").val().trim().toUpperCase();
                if (!captchaCode) {
                    $("#captchaError").removeClass("d-none").text("Vui long nhap captcha do admin cung cap.");
                    return;
                }

                const btn = $(this);
                btn.prop("disabled", true).text("Dang xac thuc...");
                $("#captchaError").addClass("d-none").text("");

                try {
                    const response = await fetch(`/ComboOrder/VerifyCaptcha?id=${currentOrderId}`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ captchaCode })
                    });

                    const result = await response.json();
                    if (!result.success) {
                        $("#captchaError").removeClass("d-none").text(result.message || "Khong the xac thuc captcha.");
                        return;
                    }

                    $("#comboPendingState").addClass("d-none");
                    $("#comboSuccessState").removeClass("d-none");
                } catch (err) {
                    $("#captchaError").removeClass("d-none").text("Khong the ket noi toi may chu.");
                } finally {
                    btn.prop("disabled", false).text("Xac thuc captcha");
                }
            });
        });
    </script>
}
