@model CarSalesManagementSystemClient.Models.ComboOrderPreviewViewModel
@{
    ViewData["Title"] = "Xác nhận đơn combo";
    var isAuthenticated = ViewBag.IsAuthenticated as bool? ?? false;
    var draftToken = ViewBag.DraftToken as string ?? string.Empty;
    var preferredType = (ViewBag.PreferredType as string ?? "Buyout").Equals("Deposit", StringComparison.OrdinalIgnoreCase)
        ? "Deposit"
        : "Buyout";
}

<style>
    .combo-shell {
        background:
            radial-gradient(circle at top right, rgba(245, 158, 11, 0.14), transparent 26%),
            linear-gradient(180deg, #fffdf7 0%, #f8fafc 100%);
        border-radius: 32px;
        padding: 32px;
    }

    .combo-panel {
        border: none;
        border-radius: 28px;
        box-shadow: 0 24px 50px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    .combo-panel-header {
        background: linear-gradient(135deg, #111827, #334155);
        color: #fff;
        padding: 18px 24px;
    }

    .combo-summary-card {
        border-radius: 24px;
        border: 1px solid rgba(148, 163, 184, 0.18);
        background: #ffffff;
        box-shadow: 0 24px 48px rgba(15, 23, 42, 0.08);
    }

    .combo-item-row {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) auto auto auto;
        gap: 12px;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid #e5e7eb;
    }

    .combo-item-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .combo-item-meta {
        min-width: 0;
    }

    .combo-item-name {
        font-weight: 700;
        color: #0f172a;
    }

    .combo-item-type {
        font-size: 0.82rem;
        color: #64748b;
    }

    .combo-item-price {
        font-weight: 600;
        color: #475569;
        text-align: right;
        min-width: 110px;
    }

    .combo-item-subtotal {
        font-weight: 800;
        color: #b91c1c;
        text-align: right;
        min-width: 120px;
    }

    .combo-qty-group {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        padding: 6px 10px;
        background: #fff;
    }

    .combo-qty-btn {
        width: 28px;
        height: 28px;
        border: none;
        border-radius: 50%;
        background: #f8fafc;
        color: #0f172a;
        font-weight: 700;
    }

    .combo-qty-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .combo-remove-btn {
        border: none;
        background: transparent;
        color: #dc2626;
        font-weight: 700;
        padding: 0;
    }

    .combo-choice-btn {
        width: 100%;
        text-align: left;
        border-radius: 22px;
        padding: 18px;
        border: 1px solid #e2e8f0;
        background: #fff;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .combo-choice-btn.active-deposit {
        border-color: rgba(245, 158, 11, 0.55);
        box-shadow: 0 14px 28px rgba(245, 158, 11, 0.18);
        background: linear-gradient(180deg, #fffaf0 0%, #fff 100%);
    }

    .combo-choice-btn.active-buyout {
        border-color: rgba(34, 197, 94, 0.45);
        box-shadow: 0 14px 28px rgba(34, 197, 94, 0.14);
        background: linear-gradient(180deg, #f0fdf4 0%, #fff 100%);
    }

    .combo-choice-btn:hover {
        transform: translateY(-2px);
    }

    .combo-state-box {
        border-radius: 18px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
    }

    .combo-inline-error {
        display: none;
    }

    .combo-inline-error.show {
        display: block;
    }

    .combo-disabled-overlay {
        border-radius: 18px;
        border: 1px dashed #cbd5e1;
        background: #f8fafc;
        color: #64748b;
        padding: 18px;
    }

    .combo-hotline-box {
        border-radius: 18px;
        background: linear-gradient(135deg, #fff7ed 0%, #fffbeb 100%);
        border: 1px solid rgba(245, 158, 11, 0.28);
    }

    .combo-hotline-number {
        font-size: 1.2rem;
        font-weight: 800;
        color: #b45309;
        letter-spacing: 0.04em;
        text-decoration: none;
    }

    @@media (max-width: 767.98px) {
        .combo-shell {
            padding: 18px;
            border-radius: 24px;
        }

        .combo-item-row {
            grid-template-columns: 1fr;
        }

        .combo-item-price,
        .combo-item-subtotal {
            text-align: left;
            min-width: 0;
        }
    }
</style>

<div class="container py-5">
    <div class="combo-shell">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <p class="text-uppercase small fw-bold text-warning mb-2">Combo Checkout</p>
                <h2 class="fw-bold text-dark mb-1">Xác nhận đơn combo</h2>
                <p class="text-muted mb-0">Bạn có thể chỉnh số lượng, bỏ bớt sản phẩm và chọn lại hình thức giao dịch trước khi tạo đơn.</p>
            </div>
            <a href="/" class="btn btn-outline-dark rounded-pill px-4">
                <i class="bi bi-arrow-left me-2"></i>Quay lại mua sắm
            </a>
        </div>

        <div class="row g-4">
            <div class="col-xl-7">
                <div class="combo-panel">
                    <div class="combo-panel-header">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2"></i>Sản phẩm trong combo</h5>
                    </div>
                    <div class="card-body p-4">
                        <div id="comboItemsContainer"></div>
                        <div id="comboEmptyState" class="combo-disabled-overlay d-none mt-3">
                            <div class="fw-bold mb-1">Combo hiện không còn sản phẩm nào</div>
                            <div>Hãy quay lại chatbot hoặc trang sản phẩm để chọn lại đơn hàng.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-5">
                <div class="combo-summary-card h-100">
                    <div class="card-body p-4 p-lg-5">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                            <div>
                                <p class="small text-uppercase text-muted fw-bold mb-2">Giao dịch</p>
                                <h4 class="fw-bold mb-1">Chọn cách xử lý đơn</h4>
                                <p class="text-muted mb-0">Luồng combo sẽ giữ nguyên logic captcha nhưng gọn và rõ hơn cho người dùng.</p>
                            </div>
                        </div>

                        <div class="combo-state-box p-3 mb-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Tổng giá trị combo</span>
                                <span class="fw-bold text-dark" id="summaryTotalText">0 VND</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Tiền đặt cọc 5%</span>
                                <span class="fw-bold text-warning" id="summaryDepositText">0 VND</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Số sản phẩm</span>
                                <span class="fw-semibold" id="summaryItemCountText">0 mục</span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <button type="button" id="btnChooseDeposit" class="combo-choice-btn">
                                    <div class="d-flex justify-content-between align-items-center gap-3">
                                        <span class="fw-bold">Đặt cọc combo</span>
                                        <span class="fw-bold text-warning" id="depositChoiceAmount">0 VND</span>
                                    </div>
                                    <div class="small text-muted mt-2">Xác thực captcha lần 1 để giữ combo trong 7 ngày, sau đó nhập captcha lần 2 để mua đứt phần còn lại.</div>
                                </button>
                            </div>
                            <div class="col-12">
                                <button type="button" id="btnChooseBuyout" class="combo-choice-btn">
                                    <div class="d-flex justify-content-between align-items-center gap-3">
                                        <span class="fw-bold">Mua đứt combo</span>
                                        <span class="fw-bold text-success" id="buyoutChoiceAmount">0 VND</span>
                                    </div>
                                    <div class="small text-muted mt-2">Admin tạo một captcha để xác nhận thanh toán toàn bộ đơn combo.</div>
                                </button>
                            </div>
                        </div>

                        <div id="selectedActionInfo" class="alert rounded-4 border-0 mb-4"></div>
                        <div id="comboFormError" class="alert alert-danger rounded-4 combo-inline-error mb-4"></div>

                        @if (isAuthenticated)
                        {
                            <form id="comboOrderConfirmForm">
                                <input type="hidden" id="draftToken" value="@draftToken" />
                                <input type="hidden" id="selectedPurchaseType" value="@preferredType" />

                                <div class="mb-3">
                                    <label for="customerPhone" class="form-label fw-semibold">Số điện thoại</label>
                                    <input type="tel" class="form-control form-control-lg" id="customerPhone" required maxlength="20" />
                                </div>
                                <div class="mb-3">
                                    <label for="shippingAddress" class="form-label fw-semibold">Địa chỉ giao nhận / liên hệ</label>
                                    <input type="text" class="form-control" id="shippingAddress" maxlength="255" />
                                </div>
                                <div class="mb-4">
                                    <label for="orderNote" class="form-label fw-semibold">Ghi chú</label>
                                    <textarea class="form-control" id="orderNote" rows="3" maxlength="1000"></textarea>
                                </div>
                                <button type="submit" id="btnSubmitOrder" class="btn btn-dark w-100 fw-bold py-3 rounded-pill">
                                    Tạo đơn combo
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="combo-disabled-overlay">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="display-6 text-warning"><i class="bi bi-lock-fill"></i></div>
                                    <div class="fw-bold fs-5">Cần đăng nhập để tiếp tục</div>
                                </div>
                                <p class="mb-3">Vui lòng đăng nhập trước khi tạo đơn combo và xác thực captcha.</p>
                                <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#loginModal">Đăng nhập</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="comboOrderFlowModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-body p-4">
                <div id="comboPendingState">
                    <div class="text-center mb-3">
                        <div class="display-4 text-warning"><i class="bi bi-shield-lock-fill"></i></div>
                        <h4 class="fw-bold mt-3">Đơn combo đã được tạo</h4>
                        <p class="text-muted mb-0" id="comboPendingMessage"></p>
                    </div>
                    <div class="combo-state-box p-3 mb-3">
                        <div class="small text-muted mb-1">Mã đơn</div>
                        <div class="fw-bold mb-3" id="comboOrderIdText">#0</div>
                        <div class="small text-muted mb-1">Loại giao dịch</div>
                        <div class="fw-bold" id="comboPurchaseTypeText"></div>
                        <div class="small text-muted mt-3 mb-1">Số tiền cần xác nhận hiện tại</div>
                        <div class="fw-bold text-danger" id="comboPayableText"></div>
                    </div>
                    <div class="combo-hotline-box p-3 mb-3 text-center">
                        <div class="small text-uppercase text-muted fw-bold mb-1">Hotline admin xử lý đơn</div>
                        <a id="comboAdminPhoneLink" class="combo-hotline-number" href="tel:0987173229">0987 173 229</a>
                        <div class="small text-muted mt-2">Gọi ngay để nhận captcha và hoàn tất đơn combo nhanh hơn.</div>
                    </div>
                    <div class="mb-3">
                        <label for="comboOrderCaptchaInput" class="form-label fw-semibold" id="comboCaptchaLabel">Nhập captcha từ admin</label>
                        <input id="comboOrderCaptchaInput" type="text" class="form-control text-uppercase" maxlength="20" />
                        <div id="captchaError" class="text-danger small mt-2 d-none"></div>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="button" id="btnVerifyCaptcha" class="btn btn-warning fw-bold rounded-pill">Xác thực captcha</button>
                        <a href="/ComboOrder/History" class="btn btn-outline-dark rounded-pill">Theo dõi trong lịch sử đơn combo</a>
                    </div>
                </div>

                <div id="comboSuccessState" class="d-none text-center">
                    <div class="display-3 text-success mb-3"><i class="bi bi-check-circle-fill"></i></div>
                    <h4 class="fw-bold" id="comboSuccessTitle">Xác thực thành công</h4>
                    <p class="text-muted" id="comboSuccessMessage"></p>
                    <div id="comboSuccessExtra" class="combo-state-box p-3 mb-3 d-none">
                        <div class="small text-muted mb-1">Hạn giữ combo</div>
                        <div class="fw-bold" id="comboExpiryText"></div>
                        <div class="small text-muted mt-3 mb-1">Số tiền còn lại cần thanh toán</div>
                        <div class="fw-bold text-danger" id="comboRemainingText"></div>
                    </div>
                    <div class="d-grid gap-2">
                        <a href="/ComboOrder/History" class="btn btn-primary rounded-pill">Xem lịch sử đơn combo</a>
                        <a href="/" class="btn btn-light border rounded-pill">Về trang chủ</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const adminPhoneDisplay = "0987 173 229";
            const adminPhoneDial = "0987173229";
            const comboItems = [];
            @foreach (var item in Model.Items)
            {
                @:comboItems.push({
                @:    itemType: "@item.ItemType",
                @:    referenceId: @item.ReferenceId,
                @:    name: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Name))",
                @:    quantity: @item.Quantity,
                @:    unitPrice: @item.UnitPrice,
                @:    isCar: "@item.ItemType" === "Car"
                @:});
            }

            let selectedPurchaseType = "@preferredType";
            let currentOrderId = 0;
            let currentItems = comboItems.map(item => ({ ...item }));

            function formatVnd(value) {
                return Number(value || 0).toLocaleString("vi-VN") + " VND";
            }

            function showFormError(message) {
                $("#comboFormError").addClass("show").text(message || "Có lỗi xảy ra.");
            }

            function clearFormError() {
                $("#comboFormError").removeClass("show").text("");
            }

            function getItemCount() {
                return currentItems.reduce((sum, item) => sum + Number(item.quantity || 0), 0);
            }

            function getTotalAmount() {
                return currentItems.reduce((sum, item) => sum + (Number(item.quantity || 0) * Number(item.unitPrice || 0)), 0);
            }

            function getDepositAmount() {
                return Math.round(getTotalAmount() * 0.05);
            }

            function getOrderPayloadItems() {
                return currentItems
                    .filter(item => Number(item.quantity || 0) > 0)
                    .map(item => ({
                        itemType: item.itemType,
                        referenceId: item.referenceId,
                        quantity: Number(item.quantity || 0)
                    }));
            }

            function renderItems() {
                const container = $("#comboItemsContainer");
                const hasItems = currentItems.length > 0;

                $("#comboEmptyState").toggleClass("d-none", hasItems);
                container.empty();

                if (!hasItems) {
                    return;
                }

                currentItems.forEach((item, index) => {
                    const minusDisabled = Number(item.quantity) <= 1;
                    const plusDisabled = !!item.isCar;
                    const subtotal = Number(item.quantity || 0) * Number(item.unitPrice || 0);

                    container.append(`
                        <div class="combo-item-row" data-index="${index}">
                            <div class="combo-item-meta">
                                <div class="combo-item-name">${escapeHtml(item.name)}</div>
                                <div class="combo-item-type">${escapeHtml(item.itemType)}</div>
                            </div>
                            <div class="combo-item-price">${formatVnd(item.unitPrice)}</div>
                            <div>
                                <div class="combo-qty-group">
                                    <button type="button" class="combo-qty-btn btn-qty-minus" ${minusDisabled ? "disabled" : ""}>-</button>
                                    <span class="fw-bold">${item.quantity}</span>
                                    <button type="button" class="combo-qty-btn btn-qty-plus" ${plusDisabled ? "disabled" : ""}>+</button>
                                </div>
                                <button type="button" class="combo-remove-btn mt-2 btn-remove-item">Bỏ sản phẩm</button>
                            </div>
                            <div class="combo-item-subtotal">${formatVnd(subtotal)}</div>
                        </div>
                    `);
                });
            }

            function renderSummary() {
                const total = getTotalAmount();
                const deposit = getDepositAmount();
                const itemCount = getItemCount();
                const hasItems = currentItems.length > 0;

                $("#summaryTotalText").text(formatVnd(total));
                $("#summaryDepositText").text(formatVnd(deposit));
                $("#summaryItemCountText").text(`${itemCount} mục`);
                $("#depositChoiceAmount").text(formatVnd(deposit));
                $("#buyoutChoiceAmount").text(formatVnd(total));
                $("#btnSubmitOrder").prop("disabled", !hasItems);

                if (!hasItems) {
                    $("#selectedActionInfo")
                        .removeClass("alert-warning alert-success")
                        .addClass("alert-secondary")
                        .text("Combo trống nên hiện chưa thể tạo đơn.");
                    return;
                }

                updateSelectedType(selectedPurchaseType);
            }

            function updateSelectedType(type) {
                selectedPurchaseType = type;
                $("#selectedPurchaseType").val(type);

                $("#btnChooseDeposit")
                    .toggleClass("active-deposit", type === "Deposit")
                    .removeClass(type === "Deposit" ? "active-buyout" : "");
                $("#btnChooseBuyout")
                    .toggleClass("active-buyout", type === "Buyout")
                    .removeClass(type === "Buyout" ? "active-deposit" : "");

                const infoBox = $("#selectedActionInfo");
                infoBox.removeClass("alert-secondary alert-warning alert-success");

                if (type === "Deposit") {
                    infoBox.addClass("alert-warning")
                        .text("Bạn đang chọn đặt cọc combo. Sau khi xác thực captcha lần 1, combo sẽ được giữ trong 7 ngày.");
                } else {
                    infoBox.addClass("alert-success")
                        .text("Bạn đang chọn mua đứt combo. Đơn sẽ hoàn tất ngay sau khi nhập đúng captcha admin cung cấp.");
                }
            }

            function escapeHtml(value) {
                return String(value || "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            $("#comboItemsContainer").on("click", ".btn-qty-minus", function () {
                const index = Number($(this).closest(".combo-item-row").data("index"));
                const item = currentItems[index];
                if (!item || item.quantity <= 1) {
                    return;
                }

                item.quantity -= 1;
                clearFormError();
                renderItems();
                renderSummary();
            });

            $("#comboItemsContainer").on("click", ".btn-qty-plus", function () {
                const index = Number($(this).closest(".combo-item-row").data("index"));
                const item = currentItems[index];
                if (!item || item.isCar) {
                    return;
                }

                item.quantity += 1;
                clearFormError();
                renderItems();
                renderSummary();
            });

            $("#comboItemsContainer").on("click", ".btn-remove-item", function () {
                const index = Number($(this).closest(".combo-item-row").data("index"));
                currentItems.splice(index, 1);
                clearFormError();
                renderItems();
                renderSummary();
            });

            $("#btnChooseDeposit").on("click", function () { updateSelectedType("Deposit"); });
            $("#btnChooseBuyout").on("click", function () { updateSelectedType("Buyout"); });

            renderItems();
            renderSummary();

            $("#comboOrderConfirmForm").on("submit", async function (event) {
                event.preventDefault();
                clearFormError();

                const items = getOrderPayloadItems();
                if (!items.length) {
                    showFormError("Đơn combo đang trống. Vui lòng thêm lại sản phẩm trước khi tạo đơn.");
                    return;
                }

                const customerPhone = $("#customerPhone").val().trim();
                if (!customerPhone) {
                    showFormError("Vui lòng nhập số điện thoại liên hệ.");
                    return;
                }

                const button = $("#btnSubmitOrder");
                button.prop("disabled", true).text("Đang tạo đơn...");

                const payload = {
                    customerPhone,
                    purchaseType: selectedPurchaseType,
                    shippingAddress: $("#shippingAddress").val(),
                    note: $("#orderNote").val(),
                    chatSessionId: localStorage.getItem("chat_session_id") || "",
                    items
                };

                try {
                    const response = await fetch("/ComboOrder/PlaceOrder", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(payload)
                    });

                    const result = await response.json();
                    if (!result.success) {
                        showFormError(result.message || "Không thể tạo đơn combo.");
                        return;
                    }

                    currentOrderId = result.orderId || 0;
                    const totalAmount = getTotalAmount();
                    const depositAmount = getDepositAmount();

                    $("#comboOrderIdText").text(`#${currentOrderId}`);
                    $("#comboPurchaseTypeText").text(selectedPurchaseType === "Deposit" ? "Đặt cọc combo" : "Mua đứt combo");
                    $("#comboPayableText").text(selectedPurchaseType === "Deposit" ? formatVnd(depositAmount) : formatVnd(totalAmount));
                    $("#comboAdminPhoneLink").attr("href", `tel:${adminPhoneDial}`).text(adminPhoneDisplay);
                    $("#comboOrderCaptchaInput").val("");
                    $("#captchaError").addClass("d-none").text("");
                    $("#comboPendingState").removeClass("d-none");
                    $("#comboSuccessState").addClass("d-none");
                    $("#comboSuccessExtra").addClass("d-none");

                    if (selectedPurchaseType === "Deposit") {
                        $("#comboPendingMessage").text(`Mã đơn #${currentOrderId} đã được tạo. Gọi ${adminPhoneDisplay} để nhận captcha đặt cọc lần 1, sau khi xác thực xong combo sẽ được giữ trong 7 ngày.`);
                    } else {
                        $("#comboPendingMessage").text(`Mã đơn #${currentOrderId} đã được tạo. Gọi ${adminPhoneDisplay} để nhận captcha mua đứt và hoàn tất thanh toán toàn bộ đơn combo.`);
                    }

                    bootstrap.Modal.getOrCreateInstance(document.getElementById("comboOrderFlowModal")).show();
                    localStorage.removeItem("draft_combo_cart");
                } catch (error) {
                    showFormError("Không thể kết nối tới máy chủ.");
                } finally {
                    button.prop("disabled", currentItems.length === 0).text("Tạo đơn combo");
                }
            });

            $("#comboOrderCaptchaInput").on("input", function () {
                this.value = this.value.toUpperCase();
            });

            $("#btnVerifyCaptcha").on("click", async function () {
                const captchaCode = $("#comboOrderCaptchaInput").val().trim().toUpperCase();
                if (!captchaCode) {
                    $("#captchaError").removeClass("d-none").text("Vui lòng nhập captcha do admin cung cấp.");
                    return;
                }

                const totalAmount = getTotalAmount();
                const depositAmount = getDepositAmount();
                const button = $(this);
                button.prop("disabled", true).text("Đang xác thực...");
                $("#captchaError").addClass("d-none").text("");

                try {
                    const response = await fetch(`/ComboOrder/VerifyCaptcha?id=${currentOrderId}`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ captchaCode })
                    });

                    const result = await response.json();
                    if (!result.success) {
                        $("#captchaError").removeClass("d-none").text(result.message || "Không thể xác thực captcha.");
                        return;
                    }

                    const status = result.status || result.data?.status;
                    const expiry = result.depositExpiresAt || result.data?.depositExpiresAt;
                    const paidDeposit = result.depositAmount || result.data?.depositAmount || depositAmount;
                    const remaining = Math.max(0, totalAmount - Number(paidDeposit || 0));

                    $("#comboPendingState").addClass("d-none");
                    $("#comboSuccessState").removeClass("d-none");

                    if (status === "Deposited") {
                        $("#comboSuccessTitle").text("Đặt cọc thành công");
                        $("#comboSuccessMessage").text(`Đơn combo #${currentOrderId} đã đặt cọc thành công. Khi admin tạo captcha lần 2, bạn vào lịch sử đơn combo để mua đứt phần còn lại.`);
                        $("#comboSuccessExtra").removeClass("d-none");
                        $("#comboExpiryText").text(expiry ? new Date(expiry).toLocaleString("vi-VN") : "7 ngày");
                        $("#comboRemainingText").text(formatVnd(remaining));
                    } else {
                        $("#comboSuccessTitle").text("Mua đứt thành công");
                        $("#comboSuccessMessage").text(`Đơn combo #${currentOrderId} đã được hoàn tất thanh toán.`);
                        $("#comboSuccessExtra").addClass("d-none");
                    }
                } catch (error) {
                    $("#captchaError").removeClass("d-none").text("Không thể kết nối tới máy chủ.");
                } finally {
                    button.prop("disabled", false).text("Xác thực captcha");
                }
            });
        });
    </script>
}
