@model List<CarSalesManagementSystemClient.Models.ComboOrderViewModel>
@using System.Text.Json
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quan ly don combo";
    var ordersJson = JsonSerializer.Serialize(Model ?? new List<CarSalesManagementSystemClient.Models.ComboOrderViewModel>());
}

<div class="container-fluid py-5 px-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-box-seam me-2 text-warning"></i>Quan ly don combo</h2>
            <p class="text-muted mb-0">Admin theo doi don, xem chi tiet, tao captcha va cap ma cho khach sau khi da nhan tien.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-dark text-white py-3 px-4">
            <h5 class="mb-0 fw-bold">Tat ca don combo (@(Model?.Count ?? 0))</h5>
        </div>
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="p-5 text-center text-muted">Chua co don combo nao trong he thong.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Don</th>
                                <th>Khach hang</th>
                                <th>Loai giao dich</th>
                                <th>Trang thai</th>
                                <th>Tong gia tri</th>
                                <th>Captcha</th>
                                <th class="pe-4 text-end">Thao tac</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">#@order.ComboOrderId</div>
                                        <div class="small text-muted">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@order.CustomerName</div>
                                        <div class="small text-muted">@order.CustomerPhone</div>
                                    </td>
                                    <td>
                                        <span class="badge @(order.PurchaseType == "Deposit" ? "bg-warning text-dark" : "bg-success") px-3 py-2 rounded-pill">
                                            @(order.PurchaseType == "Deposit" ? "Dat coc" : "Mua dut")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary px-3 py-2 rounded-pill">@order.Status</span>
                                    </td>
                                    <td class="fw-bold text-danger">@order.TotalAmount.ToString("N0") VND</td>
                                    <td>
                                        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(order.CaptchaCode) ? "Chua co" : order.CaptchaCode)</div>
                                        <div class="small text-muted">@(order.CaptchaGeneratedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chua tao")</div>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <button type="button"
                                                class="btn btn-dark btn-sm admin-order-btn"
                                                data-order-id="@order.ComboOrderId">
                                            Chi tiet / Gen captcha
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="adminComboOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h4 class="modal-title fw-bold" id="adminOrderTitle">Chi tiet don combo</h4>
                    <div class="text-muted small" id="adminOrderSubTitle"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="fw-semibold mb-2">San pham trong don</div>
                        <div id="adminOrderItems" class="border rounded-4 p-3 bg-light-subtle"></div>
                        <div class="mt-3 border rounded-4 p-3">
                            <div class="small text-muted">Ghi chu</div>
                            <div id="adminOrderNote" class="fw-semibold">Khong co</div>
                            <div class="small text-muted mt-3">Dia chi</div>
                            <div id="adminOrderAddress" class="fw-semibold"></div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="border rounded-4 p-3 mb-3">
                            <div class="small text-muted">Loai giao dich</div>
                            <div class="fw-bold mb-2" id="adminPurchaseType"></div>
                            <div class="small text-muted">Trang thai hien tai</div>
                            <div class="fw-bold mb-2" id="adminOrderStatus"></div>
                            <div class="small text-muted">So tien can giao dich</div>
                            <div class="fw-bold text-danger mb-2" id="adminPayableAmount"></div>
                            <div class="small text-muted">Captcha hien tai</div>
                            <div class="fw-bold" id="adminCurrentCaptcha"></div>
                        </div>

                        <div class="border rounded-4 p-3">
                            <label for="adminCustomCaptcha" class="form-label fw-semibold">Nhap captcha rieng neu muon</label>
                            <input id="adminCustomCaptcha" type="text" class="form-control text-uppercase mb-2" maxlength="20" placeholder="De trong de he thong tu sinh" />
                            <div id="adminCaptchaFeedback" class="small d-none mb-2"></div>
                            <button type="button" id="btnAdminGenerateCaptcha" class="btn btn-warning w-100 fw-bold">
                                Gen captcha cho don nay
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const adminComboOrders = @Html.Raw(ordersJson);
        let activeAdminOrder = null;

        function readProp(source, camelKey, pascalKey) {
            return source?.[camelKey] ?? source?.[pascalKey];
        }

        function renderAdminItems(items) {
            if (!items || !items.length) {
                return '<div class="text-muted">Khong co san pham.</div>';
            }

            return items.map(item => `
                <div class="d-flex justify-content-between align-items-start border-bottom py-2">
                    <div>
                        <div class="fw-semibold">${readProp(item, 'itemName', 'ItemName')}</div>
                        <div class="small text-muted">${readProp(item, 'itemType', 'ItemType')} - SL ${readProp(item, 'quantity', 'Quantity')}</div>
                    </div>
                    <div class="fw-bold text-danger">${Number(readProp(item, 'subTotal', 'SubTotal') || 0).toLocaleString('vi-VN')} VND</div>
                </div>
            `).join('');
        }

        $(function () {
            $(".admin-order-btn").on("click", function () {
                const orderId = Number($(this).data("order-id"));
                activeAdminOrder = adminComboOrders.find(x => Number(readProp(x, 'comboOrderId', 'ComboOrderId')) === orderId);
                if (!activeAdminOrder) return;

                const payable = readProp(activeAdminOrder, 'depositAmount', 'DepositAmount')
                    || readProp(activeAdminOrder, 'totalAmount', 'TotalAmount')
                    || 0;
                const purchaseType = readProp(activeAdminOrder, 'purchaseType', 'PurchaseType');

                $("#adminOrderTitle").text(`Don combo #${readProp(activeAdminOrder, 'comboOrderId', 'ComboOrderId')}`);
                $("#adminOrderSubTitle").text(`${readProp(activeAdminOrder, 'customerName', 'CustomerName')} - ${readProp(activeAdminOrder, 'customerPhone', 'CustomerPhone')}`);
                $("#adminOrderItems").html(renderAdminItems(readProp(activeAdminOrder, 'items', 'Items')));
                $("#adminOrderNote").text(readProp(activeAdminOrder, 'note', 'Note') || "Khong co");
                $("#adminOrderAddress").text(readProp(activeAdminOrder, 'shippingAddress', 'ShippingAddress') || "Khong co");
                $("#adminPurchaseType").text(purchaseType === "Deposit" ? "Dat coc combo" : "Mua dut combo");
                $("#adminOrderStatus").text(readProp(activeAdminOrder, 'status', 'Status'));
                $("#adminPayableAmount").text(Number(payable).toLocaleString("vi-VN") + " VND");
                $("#adminCurrentCaptcha").text(readProp(activeAdminOrder, 'captchaCode', 'CaptchaCode') || "Chua co captcha");
                $("#adminCustomCaptcha").val("");
                $("#adminCaptchaFeedback").addClass("d-none").removeClass("text-danger text-success").text("");

                bootstrap.Modal.getOrCreateInstance(document.getElementById("adminComboOrderModal")).show();
            });

            $("#adminCustomCaptcha").on("input", function () {
                this.value = this.value.toUpperCase();
            });

            $("#btnAdminGenerateCaptcha").on("click", async function () {
                if (!activeAdminOrder) return;

                const btn = $(this);
                btn.prop("disabled", true).text("Dang tao captcha...");
                $("#adminCaptchaFeedback").addClass("d-none").removeClass("text-danger text-success").text("");

                try {
                    const response = await fetch(`/ComboOrder/GenerateCaptcha?id=${readProp(activeAdminOrder, 'comboOrderId', 'ComboOrderId')}`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ code: $("#adminCustomCaptcha").val().trim().toUpperCase() || null })
                    });
                    const result = await response.json();
                    if (!result.success) {
                        $("#adminCaptchaFeedback").removeClass("d-none").addClass("text-danger").text(result.message || "Khong the tao captcha.");
                        return;
                    }

                    $("#adminCurrentCaptcha").text(result.captchaCode || "Da tao");
                    $("#adminCaptchaFeedback").removeClass("d-none").addClass("text-success").text(result.message || "Da tao captcha.");
                    activeAdminOrder.captchaCode = result.captchaCode;
                    activeAdminOrder.CaptchaCode = result.captchaCode;
                } catch (err) {
                    $("#adminCaptchaFeedback").removeClass("d-none").addClass("text-danger").text("Khong the ket noi toi may chu.");
                } finally {
                    btn.prop("disabled", false).text("Gen captcha cho don nay");
                }
            });
        });
    </script>
}
