@model IEnumerable<CarSalesManagementSystemClient.Models.ComboOrderViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý đơn hàng Combo";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0 text-primary fw-bold">
                <i class="bi bi-box-seam me-2"></i>Quản lý Đơn hàng Combo
            </h4>
            <p class="text-muted mb-0 small">Phê duyệt đơn hàng combo, sinh mã Captcha xác thực và quản lý xuất kho sản phẩm</p>
        </div>
        <div>
            <span class="badge bg-primary fs-6">
                Tổng đơn combo: @Model.Count()
            </span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4 py-3 text-secondary" style="width: 110px;">Mã đơn</th>
                            <th class="py-3 text-secondary">Khách hàng</th>
                            <th class="py-3 text-secondary">Ngày đặt</th>
                            <th class="py-3 text-secondary">Hình thức</th>
                            <th class="py-3 text-secondary text-end" style="width: 160px;">Tổng tiền</th>
                            <th class="py-3 text-secondary text-center" style="width: 150px;">Trạng thái</th>
                            <th class="py-3 text-secondary text-center" style="width: 180px;">Mã Captcha</th>
                            <th class="px-4 py-3 text-secondary text-end" style="width: 250px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                    Chưa có đơn hàng combo nào được đặt.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var order in Model)
                            {
                                bool isDeposit = order.PurchaseType == "Deposit";
                                string? currentCaptcha = isDeposit ? order.CaptchaCode : order.FinalCaptchaCode;
                                bool isCaptchaUsed = isDeposit ? order.IsCaptchaUsed : order.IsFinalCaptchaUsed;

                                <tr>
                                    <td class="px-4 fw-bold text-primary">
                                        #CB-@order.ComboOrderId.ToString("D4")
                                    </td>
                                    <td>
                                        <div class="fw-bold">@order.CustomerName</div>
                                        <div class="small text-muted"><i class="bi bi-telephone-fill me-1"></i>@order.CustomerPhone</div>
                                    </td>
                                    <td class="text-secondary" style="font-size: 13px;">
                                        @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @if (isDeposit)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-cash-coin me-1"></i>Đặt cọc (5%)</span>
                                            <div class="small text-muted mt-1" style="font-size: 11px;">Cọc: @(order.DepositAmount?.ToString("N0") ?? "0") đ</div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark text-warning"><i class="bi bi-cart-check me-1"></i>Mua đứt (100%)</span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold text-dark">
                                        @order.TotalAmount.ToString("N0") đ
                                    </td>
                                    <td class="text-center">
                                        @if (order.Status == "Paid")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán</span>
                                        }
                                        else if (order.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Đã hủy</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (order.Status == "Paid" || order.Status == "Cancelled")
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else if (!string.IsNullOrEmpty(currentCaptcha))
                                        {
                                            <span class="badge bg-dark text-warning font-monospace fs-6 px-3 py-1.5 rounded-2">
                                                @currentCaptcha
                                            </span>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-primary py-1 px-2.5 rounded-pill" onclick="generateCaptcha(@order.ComboOrderId)">
                                                <i class="bi bi-cpu"></i> Sinh mã
                                            </button>
                                        }
                                    </td>
                                    <td class="px-4 text-end">
                                        <button class="btn btn-sm btn-outline-dark" onclick="viewDetails(@order.ComboOrderId)">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </button>
                                        
                                        @if (order.Status == "Pending")
                                        {
                                            if (!string.IsNullOrEmpty(currentCaptcha))
                                            {
                                                <button class="btn btn-sm btn-success ms-1" onclick="verifyCaptcha(@order.ComboOrderId)" title="Duyệt thanh toán">
                                                    <i class="bi bi-check2-circle"></i> Duyệt đơn
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-danger ms-1" onclick="cancelOrder(@order.ComboOrderId)" title="Hủy đơn">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chi tiết đơn hàng -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-dark text-white border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-box-seam me-2"></i>Chi Tiết Đơn Hàng Combo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="detailsModalBody">
                <!-- Data loaded dynamically -->
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ordersData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

        function viewDetails(orderId) {
            const order = ordersData.find(o => o.ComboOrderId === orderId);
            if (!order) return;

            let itemsHtml = "";
            order.Items.forEach(item => {
                let typeBadge = "";
                if (item.ItemType.toLowerCase() === 'car') typeBadge = '<span class="badge bg-primary-subtle text-primary border border-primary">Ô tô</span>';
                else if (item.ItemType.toLowerCase() === 'package') typeBadge = '<span class="badge bg-success-subtle text-success border border-success">Gói BD</span>';
                else if (item.ItemType.toLowerCase() === 'service') typeBadge = '<span class="badge bg-info-subtle text-info border border-info">Dịch vụ</span>';
                else typeBadge = '<span class="badge bg-warning-subtle text-warning border border-warning">Phụ tùng</span>';

                itemsHtml += `
                    <tr>
                        <td class="py-2.5">${typeBadge}</td>
                        <td class="py-2.5 fw-semibold">${item.ItemName}</td>
                        <td class="py-2.5 text-end">${item.UnitPrice.toLocaleString('vi-VN')} đ</td>
                        <td class="py-2.5 text-center">${item.Quantity}</td>
                        <td class="py-2.5 text-end fw-bold">${item.SubTotal.toLocaleString('vi-VN')} đ</td>
                    </tr>
                `;
            });

            const html = `
                <div class="row g-3 mb-4 border-bottom pb-3">
                    <div class="col-md-6">
                        <div class="text-secondary small">Mã đơn hàng:</div>
                        <div class="fw-bold fs-5 text-primary">#CB-${String(order.ComboOrderId).padStart(4, '0')}</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-secondary small">Ngày đặt hàng:</div>
                        <div class="fw-semibold">${new Date(order.CreatedAt).toLocaleString('vi-VN')}</div>
                    </div>
                    <div class="col-md-6 mt-3">
                        <div class="text-secondary small">Khách hàng:</div>
                        <div class="fw-semibold">${order.CustomerName} (${order.CustomerPhone})</div>
                    </div>
                    <div class="col-md-6 mt-3">
                        <div class="text-secondary small">Hình thức:</div>
                        <div class="fw-semibold">${order.PurchaseType === 'Deposit' ? 'Đặt cọc giữ xe (5%)' : 'Mua đứt toàn bộ (100%)'}</div>
                    </div>
                    ${order.ShippingAddress ? `
                    <div class="col-md-12 mt-3">
                        <div class="text-secondary small">Địa chỉ giao hàng:</div>
                        <div class="fw-semibold">${order.ShippingAddress}</div>
                    </div>
                    ` : ''}
                    ${order.Note ? `
                    <div class="col-md-12 mt-3">
                        <div class="text-secondary small">Ghi chú của khách:</div>
                        <div class="fw-semibold text-secondary fst-italic">${order.Note}</div>
                    </div>
                    ` : ''}
                </div>

                <h6 class="fw-bold mb-2">Danh sách sản phẩm trong combo:</h6>
                <div class="table-responsive rounded-3 border">
                    <table class="table table-hover align-middle mb-0" style="font-size: 14px;">
                        <thead class="table-light">
                            <tr>
                                <th>Loại</th>
                                <th>Tên sản phẩm</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-center">SL</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${itemsHtml}
                        </tbody>
                    </table>
                </div>

                <div class="row justify-content-end mt-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-secondary">Tổng tiền combo:</span>
                                <span class="fw-bold">${order.TotalAmount.toLocaleString('vi-VN')} đ</span>
                            </div>
                            ${order.PurchaseType === 'Deposit' ? `
                            <div class="d-flex justify-content-between pt-2 border-top">
                                <span class="fw-bold text-dark">Số tiền cọc:</span>
                                <span class="fw-bold text-danger">${order.DepositAmount.toLocaleString('vi-VN')} đ</span>
                            </div>
                            ` : ''}
                            <div class="d-flex justify-content-between pt-2 ${order.PurchaseType === 'Deposit' ? '' : 'border-top'}">
                                <span class="fw-bold text-dark">Trạng thái:</span>
                                <span class="fw-bold ${order.Status === 'Paid' ? 'text-success' : order.Status === 'Cancelled' ? 'text-danger' : 'text-warning'}">
                                    ${order.Status === 'Paid' ? 'Đã thanh toán' : order.Status === 'Cancelled' ? 'Đã hủy đơn' : 'Đang chờ duyệt'}
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            document.getElementById('detailsModalBody').innerHTML = html;
            const myModal = new bootstrap.Modal(document.getElementById('detailsModal'));
            myModal.show();
        }

        function generateCaptcha(orderId) {
            Swal.fire({
                title: 'Sinh mã xác thực Captcha?',
                text: "Hệ thống sẽ tự động tạo mã xác nhận thanh toán bảo mật cho đơn hàng combo này.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#ffc107',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý sinh mã',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/ComboOrder/GenerateCaptcha',
                        type: 'POST',
                        data: { id: orderId },
                        success: function(res) {
                            if (res.success) {
                                Swal.fire({
                                    title: 'Thành công',
                                    html: `Mã xác nhận bảo mật được tạo thành công:<br/><br/><strong class="fs-4 text-warning font-monospace bg-dark p-2 rounded d-inline-block">${res.captcha}</strong><br/><br/>Hãy gửi mã này cho khách hàng để xác minh khi nhận tiền cọc/đơn hàng.`,
                                    icon: 'success'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Thất bại', res.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
                        }
                    });
                }
            });
        }

        function verifyCaptcha(orderId) {
            Swal.fire({
                title: 'Nhập mã xác thực (Captcha)',
                input: 'text',
                inputLabel: 'Vui lòng nhập mã Captcha đã cung cấp cho khách hàng để phê duyệt thanh toán',
                inputPlaceholder: 'Nhập mã gồm 6 ký tự...',
                inputAttributes: {
                    maxlength: 20,
                    autocapitalize: 'off',
                    autocorrect: 'off'
                },
                showCancelButton: true,
                confirmButtonText: 'Phê duyệt',
                cancelButtonText: 'Đóng',
                confirmButtonColor: '#198754',
                showLoaderOnConfirm: true,
                preConfirm: (captchaCode) => {
                    if (!captchaCode) {
                        Swal.showValidationMessage('Vui lòng nhập mã Captcha');
                        return false;
                    }
                    return $.ajax({
                        url: '/ComboOrder/VerifyCaptcha',
                        type: 'POST',
                        data: { id: orderId, captchaCode: captchaCode }
                    }).then(response => {
                        if (!response.success) {
                            Swal.showValidationMessage(response.message);
                            return false;
                        }
                        return response;
                    }).catch(error => {
                        Swal.showValidationMessage('Không thể kết nối đến máy chủ.');
                        return false;
                    });
                },
                allowOutsideClick: () => !Swal.isLoading()
            }).then((result) => {
                if (result.isConfirmed && result.value && result.value.success) {
                    Swal.fire('Thành công!', result.value.message, 'success').then(() => {
                        location.reload();
                    });
                }
            });
        }

        function cancelOrder(orderId) {
            Swal.fire({
                title: 'Xác nhận hủy đơn hàng?',
                text: "Bạn có chắc chắn muốn hủy đơn hàng combo này không?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đúng, Hủy đơn hàng',
                cancelButtonText: 'Đóng'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/ComboOrder/CancelOrder',
                        type: 'POST',
                        data: { id: orderId },
                        success: function(res) {
                            if (res.success) {
                                Swal.fire('Thành công!', res.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Thất bại', res.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
