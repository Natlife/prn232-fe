@model List<CarSalesManagementSystemClient.Models.InvoiceListItemViewModel>
@{
    ViewData["Title"] = "Hóa đơn của tôi";
    string Money(decimal v) => v.ToString("N0") + " đ";
    string TypeLabel(string t) => t switch { "Car" => "Ô tô", "Part" => "Phụ tùng", "Service" => "Dịch vụ", "Combined" => "Gộp", _ => t };
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0"><i class="bi bi-receipt-cutoff me-2 text-warning"></i>Hóa đơn của tôi</h3>
        <a href="/Cars" class="btn btn-outline-secondary btn-sm fw-bold"><i class="bi bi-arrow-left me-1"></i>Tiếp tục mua sắm</a>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    <div class="alert alert-warning d-flex align-items-center" style="border-radius:12px;">
        <i class="bi bi-info-circle-fill me-2 fs-5"></i>
        <div style="font-size:14px;">
            Để xác nhận <strong>đặt cọc</strong> hoặc <strong>mua đứt</strong>, vui lòng liên hệ nhân viên showroom
            (hotline <strong>(+84) 0359492991</strong>) để nhận <strong>mã xác thực</strong>, sau đó nhập mã bên dưới.
            Cọc giữ chỗ tối đa <strong>2 tuần</strong>; quá hạn đơn tự hủy và <strong>không hoàn cọc</strong>.
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-inbox display-4 d-block mb-3"></i>
            Bạn chưa có hóa đơn nào.
        </div>
    }
    else
    {
        foreach (var inv in Model)
        {
            <div class="card mb-3 shadow-sm" style="border-radius:14px; border:none;">
                <div class="card-body">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold mb-1">
                                <span class="font-monospace">@inv.InvoiceNumber</span>
                                <span class="badge bg-secondary ms-1">@TypeLabel(inv.InvoiceType)</span>
                            </h5>
                            <div class="text-muted" style="font-size:13px;">Lập ngày @inv.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            <a href="/Invoices/Details/@inv.MasterInvoiceId" class="small text-decoration-none"><i class="bi bi-eye me-1"></i>Xem chi tiết</a>
                        </div>
                        <div class="text-end">
                            @if (inv.IsCancelled)
                            {
                                <span class="badge bg-danger">Đã hủy</span>
                            }
                            else if (inv.IsPaid)
                            {
                                <span class="badge bg-success">Đã thanh toán</span>
                            }
                            else if (inv.IsDeposited)
                            {
                                <span class="badge bg-info text-dark">Đã đặt cọc</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Chờ xác thực</span>
                            }
                            <div class="fw-bold fs-5 mt-1 text-danger">@Money(inv.TotalAmount)</div>
                        </div>
                    </div>

                    <hr class="my-2" />

                    <ul class="list-group list-group-flush mb-2">
                        @foreach (var line in inv.Lines)
                        {
                            <li class="list-group-item d-flex justify-content-between px-0 py-1" style="font-size:14px;">
                                <span>
                                    <span class="badge @(line.ItemType == "Car" ? "bg-warning text-dark" : line.ItemType == "Part" ? "bg-secondary" : "bg-info text-dark") me-1">@TypeLabel(line.ItemType)</span>
                                    @line.Description
                                </span>
                                <span class="fw-semibold">@Money(line.SubTotal)</span>
                            </li>
                        }
                    </ul>

                    @if (inv.IsDeposit && inv.DepositAmount.HasValue)
                    {
                        <div class="d-flex flex-wrap gap-3 mb-2" style="font-size:13px;">
                            <div>Tiền cọc: <strong>@Money(inv.DepositAmount.Value)</strong></div>
                            @if (inv.IsDeposited)
                            {
                                <div>Đã cọc: <strong class="text-success">@Money(inv.DepositPaidAmount ?? 0)</strong></div>
                                <div>Còn lại: <strong class="text-danger">@Money(inv.RemainingAmount)</strong></div>
                                @if (inv.DepositExpiresAt.HasValue)
                                {
                                    <div>Giữ chỗ đến: <strong>@inv.DepositExpiresAt.Value.ToString("dd/MM/yyyy HH:mm")</strong></div>
                                }
                            }
                        </div>
                    }

                    @if (inv.IsCancelled)
                    {
                        <div class="alert alert-danger py-2 mb-0" style="font-size:13px;">
                            @(!string.IsNullOrEmpty(inv.Notes) ? inv.Notes : "Hóa đơn đã bị hủy.")
                        </div>
                    }
                    else if (inv.NextAction == "deposit")
                    {
                        <div class="border rounded-3 p-3 bg-light">
                            @if (inv.DepositAmount.HasValue)
                            {
                                <div class="alert alert-warning py-2 mb-2" style="font-size:14px;">
                                    <i class="bi bi-bank me-1"></i>Vui lòng chuyển khoản <strong>đặt cọc: @Money(inv.DepositAmount.Value)</strong> rồi liên hệ nhân viên để nhận mã.
                                </div>
                            }
                            <label class="fw-semibold mb-1" style="font-size:14px;">Nhập mã xác thực <span class="text-primary">ĐẶT CỌC</span>:</label>
                            <div class="d-flex gap-2">
                                <input type="text" class="form-control text-uppercase captcha-box" data-id="@inv.MasterInvoiceId" maxlength="20" placeholder="VD: A1B2C3" style="max-width:200px; letter-spacing:3px; font-weight:700;">
                                <button class="btn btn-warning fw-bold text-dark btn-verify" data-id="@inv.MasterInvoiceId" data-stage="deposit">
                                    <i class="bi bi-cash-stack me-1"></i>Xác nhận đặt cọc
                                </button>
                            </div>
                        </div>
                    }
                    else if (inv.NextAction == "final")
                    {
                        <div class="border rounded-3 p-3 bg-light">
                            <label class="fw-semibold mb-1" style="font-size:14px;">
                                Nhập mã xác thực @(inv.IsDeposit ? "TẤT TOÁN (trả nốt " + Money(inv.RemainingAmount) + ")" : "MUA ĐỨT"):
                            </label>
                            <div class="d-flex gap-2">
                                <input type="text" class="form-control text-uppercase captcha-box" data-id="@inv.MasterInvoiceId" maxlength="20" placeholder="VD: A1B2C3" style="max-width:200px; letter-spacing:3px; font-weight:700;">
                                <button class="btn btn-success fw-bold btn-verify" data-id="@inv.MasterInvoiceId" data-stage="final">
                                    <i class="bi bi-check-circle me-1"></i>@(inv.IsDeposit ? "Tất toán" : "Xác nhận mua đứt")
                                </button>
                            </div>
                        </div>
                    }
                    else if (inv.IsPaid)
                    {
                        <div class="text-success fw-semibold" style="font-size:14px;"><i class="bi bi-check-circle-fill me-1"></i>Đã hoàn tất thanh toán @(inv.PaidAt.HasValue ? "ngày " + inv.PaidAt.Value.ToString("dd/MM/yyyy") : "").</div>
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
<script>
    document.querySelectorAll('.captcha-box').forEach(function (b) {
        b.addEventListener('input', function () { b.value = b.value.toUpperCase(); });
    });

    document.querySelectorAll('.btn-verify').forEach(function (btn) {
        btn.addEventListener('click', async function () {
            var id = btn.getAttribute('data-id');
            var stage = btn.getAttribute('data-stage');
            var input = document.querySelector('.captcha-box[data-id="' + id + '"]');
            var code = (input && input.value || '').trim();
            if (!code) {
                if (window.Swal) Swal.fire('Thiếu mã', 'Vui lòng nhập mã xác thực.', 'warning'); else alert('Vui lòng nhập mã xác thực.');
                return;
            }

            var original = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang xử lý...';

            try {
                var url = stage === 'deposit' ? '/Invoices/VerifyDeposit' : '/Invoices/VerifyFinal';
                var body = new URLSearchParams({ masterInvoiceId: id, captchaCode: code });
                var resp = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: body.toString()
                });
                var res = await resp.json();
                btn.disabled = false;
                btn.innerHTML = original;

                if (res.success) {
                    if (window.Swal) {
                        await Swal.fire('Thành công!', res.message, 'success');
                    } else {
                        alert(res.message);
                    }
                    window.location.reload();
                } else {
                    if (window.Swal) Swal.fire('Thất bại', res.message, 'error'); else alert(res.message);
                }
            } catch (err) {
                btn.disabled = false;
                btn.innerHTML = original;
                if (window.Swal) Swal.fire('Lỗi', 'Đã xảy ra lỗi kết nối.', 'error'); else alert('Đã xảy ra lỗi kết nối.');
            }
        });
    });
</script>
}
