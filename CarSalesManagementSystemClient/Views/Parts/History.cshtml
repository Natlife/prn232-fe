@model CarSalesManagementSystemClient.Models.PartViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Lịch sử biến động phụ tùng - " + Model.PartName;

    var transactions = ViewBag.Transactions
        as IEnumerable<CarSalesManagementSystemClient.Models.InventoryTransactionViewModel>
        ?? new List<CarSalesManagementSystemClient.Models.InventoryTransactionViewModel>();

    var transactionList = transactions.ToList();

    var displayImageUrl = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? "https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=900&q=85"
        : Model.ImageUrl;

    var today = DateTime.Today;
    var isExpired = Model.ExpiredAt.HasValue
        && Model.ExpiredAt.Value.Date < today;

    var isExpiringSoon = Model.ExpiredAt.HasValue
        && !isExpired
        && Model.ExpiredAt.Value.Date <= today.AddDays(30);

    var daysToExpiry = Model.ExpiredAt.HasValue
        ? (Model.ExpiredAt.Value.Date - today).Days
        : (int?)null;

    var isLowStock = Model.Quantity <= Model.MinStockLevel;

    var stockPercentage = Model.MaxStockLevel > 0
        ? (int)Math.Round((double)Model.Quantity / Model.MaxStockLevel * 100)
        : 0;

    stockPercentage = Math.Max(0, Math.Min(stockPercentage, 100));

    var importCount = transactionList.Count(x => x.TransactionType == "Import");
    var exportCount = transactionList.Count(x => x.TransactionType == "Export");
    var returnCount = transactionList.Count(x => x.TransactionType == "Return");
    var adjustmentCount = transactionList.Count(x => x.TransactionType == "Adjustment");
}

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

<div class="part-history-page">
    <div class="container-fluid px-3 px-lg-4 py-4 py-lg-5">

        <!-- Page header -->
        <header class="page-header">
            <div class="page-header__content">
                <a asp-action="Manage" class="back-link">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    <span>Quay lại quản lý phụ tùng</span>
                </a>

                <div class="page-heading">
                    <div>
                        <div class="eyebrow">Quản lý kho phụ tùng</div>
                        <h1>Lịch sử biến động kho</h1>
                        <p>
                            Theo dõi thông tin tồn kho và toàn bộ giao dịch nhập, xuất,
                            hoàn trả hoặc điều chỉnh của phụ tùng.
                        </p>
                    </div>

                    <div class="part-identity">
                        <span class="part-identity__code">@Model.PartCode</span>
                        <span class="part-identity__name">@Model.PartName</span>
                    </div>
                </div>
            </div>
        </header>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert-modern alert-modern--danger" role="alert">
                <div class="alert-modern__icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <div>
                    <strong>Không thể tải đầy đủ dữ liệu</strong>
                    <div>@ViewBag.ErrorMessage</div>
                </div>
            </div>
        }

        <!-- Quick statistics -->
        <section class="summary-grid" aria-label="Tổng quan biến động kho">
            <article class="summary-card">
                <div class="summary-card__icon summary-card__icon--primary">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <span class="summary-card__label">Tồn kho hiện tại</span>
                    <strong>@Model.Quantity <small>@Model.UnitOfMeasure</small></strong>
                </div>
            </article>

            <article class="summary-card">
                <div class="summary-card__icon summary-card__icon--success">
                    <i class="bi bi-arrow-down-left"></i>
                </div>
                <div>
                    <span class="summary-card__label">Lần nhập kho</span>
                    <strong>@importCount</strong>
                </div>
            </article>

            <article class="summary-card">
                <div class="summary-card__icon summary-card__icon--danger">
                    <i class="bi bi-arrow-up-right"></i>
                </div>
                <div>
                    <span class="summary-card__label">Lần xuất kho</span>
                    <strong>@exportCount</strong>
                </div>
            </article>

            <article class="summary-card">
                <div class="summary-card__icon summary-card__icon--neutral">
                    <i class="bi bi-arrow-repeat"></i>
                </div>
                <div>
                    <span class="summary-card__label">Hoàn / điều chỉnh</span>
                    <strong>@(returnCount + adjustmentCount)</strong>
                </div>
            </article>
        </section>

        <div class="content-grid">

            <!-- Product information -->
            <aside class="part-panel">
                <div class="part-card">
                    <div class="part-card__media">
                        <img src="@displayImageUrl"
                             alt="@Model.PartName"
                             loading="lazy"
                             onerror="this.src='https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=900&q=85';" />

                        <div class="part-card__media-overlay"></div>

                        <div class="part-card__media-content">
                            <span class="part-code">@Model.PartCode</span>
                            <h2>@Model.PartName</h2>
                            <span class="category-pill">
                                <i class="bi bi-tag"></i>
                                @(Model.Category?.CategoryName ?? "Chưa phân loại")
                            </span>
                        </div>
                    </div>

                    <div class="part-card__body">
                        <div class="section-title">
                            <div>
                                <span>Thông tin phụ tùng</span>
                                <small>Dữ liệu hiện tại trong hệ thống</small>
                            </div>
                            <i class="bi bi-info-circle"></i>
                        </div>

                        <div class="stock-status-box @(isLowStock ? "stock-status-box--warning" : "stock-status-box--healthy")">
                            <div class="stock-status-box__top">
                                <div>
                                    <span>Tồn kho</span>
                                    <strong>@Model.Quantity @Model.UnitOfMeasure</strong>
                                </div>

                                @if (isLowStock)
                                {
                                    <span class="status-chip status-chip--warning">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                        Sắp hết hàng
                                    </span>
                                }
                                else
                                {
                                    <span class="status-chip status-chip--success">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Ổn định
                                    </span>
                                }
                            </div>

                            <div class="stock-progress" role="progressbar"
                                 aria-valuenow="@stockPercentage"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                                <span style="width: @stockPercentage%"></span>
                            </div>

                            <div class="stock-status-box__limits">
                                <span>Tối thiểu: <strong>@Model.MinStockLevel</strong></span>
                                <span>Tối đa: <strong>@Model.MaxStockLevel</strong></span>
                            </div>
                        </div>

                        <dl class="detail-list">
                            <div class="detail-list__item">
                                <dt>
                                    <span class="detail-icon"><i class="bi bi-buildings"></i></span>
                                    Thương hiệu
                                </dt>
                                <dd>@(string.IsNullOrWhiteSpace(Model.Brand) ? "OEM / Không xác định" : Model.Brand)</dd>
                            </div>

                            <div class="detail-list__item">
                                <dt>
                                    <span class="detail-icon"><i class="bi bi-cash-stack"></i></span>
                                    Giá bán
                                </dt>
                                <dd class="price-value">@Model.Price.ToString("N0") đ</dd>
                            </div>

                            <div class="detail-list__item">
                                <dt>
                                    <span class="detail-icon"><i class="bi bi-geo-alt"></i></span>
                                    Vị trí kho
                                </dt>
                                <dd>@(string.IsNullOrWhiteSpace(Model.WarehouseLocation) ? "Chưa sắp xếp" : Model.WarehouseLocation)</dd>
                            </div>

                            <div class="detail-list__item">
                                <dt>
                                    <span class="detail-icon"><i class="bi bi-shield-check"></i></span>
                                    Bảo hành
                                </dt>
                                <dd>@Model.WarrantyMonths tháng</dd>
                            </div>

                            <div class="detail-list__item">
                                <dt>
                                    <span class="detail-icon"><i class="bi bi-calendar3"></i></span>
                                    Hạn sử dụng
                                </dt>
                                <dd>
                                    @if (!Model.ExpiredAt.HasValue)
                                    {
                                        <span class="status-chip status-chip--neutral">Không áp dụng</span>
                                    }
                                    else if (isExpired)
                                    {
                                        <span class="status-chip status-chip--danger">
                                            <i class="bi bi-x-circle-fill"></i>
                                            Đã hết hạn @Math.Abs(daysToExpiry ?? 0) ngày
                                        </span>
                                    }
                                    else if (isExpiringSoon)
                                    {
                                        <span class="status-chip status-chip--warning">
                                            <i class="bi bi-clock-fill"></i>
                                            Còn @daysToExpiry ngày
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="expiry-date">
                                            @Model.ExpiredAt.Value.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                </dd>
                            </div>

                            <div class="detail-list__item">
                                <dt>
                                    <span class="detail-icon"><i class="bi bi-toggle-on"></i></span>
                                    Trạng thái
                                </dt>
                                <dd>
                                    @if (Model.Status == "Available")
                                    {
                                        <span class="status-chip status-chip--success">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Đang kinh doanh
                                        </span>
                                    }
                                    else if (Model.Status == "OutOfStock" || Model.Status == "Out of Stock")
                                    {
                                        <span class="status-chip status-chip--warning">
                                            <i class="bi bi-box"></i>
                                            Tạm hết hàng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-chip status-chip--danger">
                                            <i class="bi bi-slash-circle-fill"></i>
                                            Ngưng kinh doanh
                                        </span>
                                    }
                                </dd>
                            </div>
                        </dl>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <div class="description-box">
                                <div class="description-box__title">
                                    <i class="bi bi-card-text"></i>
                                    Mô tả
                                </div>
                                <p>@Model.Description</p>
                            </div>
                        }
                    </div>
                </div>
            </aside>

            <!-- Transactions -->
            <main class="transaction-panel">
                <section class="transaction-card">
                    <div class="transaction-card__header">
                        <div>
                            <div class="section-kicker">Inventory ledger</div>
                            <h2>Nhật ký biến động kho</h2>
                            <p>@transactionList.Count giao dịch đã được ghi nhận cho phụ tùng này.</p>
                        </div>

                        <span class="record-count">
                            <i class="bi bi-clock-history"></i>
                            @transactionList.Count bản ghi
                        </span>
                    </div>

                    <div class="transaction-toolbar">
                        <label class="search-field" for="transactionSearch">
                            <i class="bi bi-search"></i>
                            <input id="transactionSearch"
                                   type="search"
                                   placeholder="Tìm theo người thực hiện hoặc ghi chú..."
                                   autocomplete="off"
                                   oninput="filterTransactions()" />
                        </label>

                        <select id="transactionTypeFilter"
                                class="type-filter"
                                onchange="filterTransactions()"
                                aria-label="Lọc theo loại giao dịch">
                            <option value="">Tất cả giao dịch</option>
                            <option value="Import">Nhập kho</option>
                            <option value="Export">Xuất kho</option>
                            <option value="Return">Hoàn hàng</option>
                            <option value="Adjustment">Điều chỉnh</option>
                        </select>
                    </div>

                    @if (!transactionList.Any())
                    {
                        <div class="empty-state">
                            <div class="empty-state__icon">
                                <i class="bi bi-inboxes"></i>
                            </div>
                            <h3>Chưa có biến động kho</h3>
                            <p>
                                Phụ tùng này chưa phát sinh giao dịch nhập, xuất,
                                hoàn hàng hoặc điều chỉnh tồn kho.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive transaction-table-wrapper">
                            <table class="transaction-table">
                                <thead>
                                    <tr>
                                        <th>Thời gian</th>
                                        <th>Loại giao dịch</th>
                                        <th class="text-center">Số lượng</th>
                                        <th>Người thực hiện</th>
                                        <th>Ghi chú</th>
                                    </tr>
                                </thead>
                                <tbody id="transactionTableBody">
                                    @foreach (var tx in transactionList)
                                    {
                                        var isPositive = tx.TransactionType == "Import"
                                            || tx.TransactionType == "Return";

                                        var quantityValue = Math.Abs(tx.Quantity);

                                        var searchableText = string.Join(" ",
                                            tx.TransactionType,
                                            tx.StaffName,
                                            tx.Notes
                                        ).ToLowerInvariant();

                                        <tr class="transaction-row"
                                            data-type="@tx.TransactionType"
                                            data-search="@searchableText">
                                            <td>
                                                <div class="date-cell">
                                                    <span class="date-cell__icon">
                                                        <i class="bi bi-calendar-event"></i>
                                                    </span>
                                                    <span>@tx.TransactionDate</span>
                                                </div>
                                            </td>
                                            <td>
                                                @if (tx.TransactionType == "Import")
                                                {
                                                    <span class="transaction-type transaction-type--import">
                                                        <i class="bi bi-arrow-down-left"></i>
                                                        Nhập kho
                                                    </span>
                                                }
                                                else if (tx.TransactionType == "Export")
                                                {
                                                    <span class="transaction-type transaction-type--export">
                                                        <i class="bi bi-arrow-up-right"></i>
                                                        Xuất kho
                                                    </span>
                                                }
                                                else if (tx.TransactionType == "Return")
                                                {
                                                    <span class="transaction-type transaction-type--return">
                                                        <i class="bi bi-arrow-counterclockwise"></i>
                                                        Hoàn hàng
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="transaction-type transaction-type--adjustment">
                                                        <i class="bi bi-sliders"></i>
                                                        Điều chỉnh
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <span class="quantity-chip @(isPositive ? "quantity-chip--positive" : "quantity-chip--negative")">
                                                    @(isPositive ? "+" : "−")@quantityValue
                                                </span>
                                            </td>
                                            <td>
                                                <div class="user-cell">
                                                    <span class="user-avatar">
                                                        <i class="bi bi-person"></i>
                                                    </span>
                                                    <span>@(string.IsNullOrWhiteSpace(tx.StaffName) ? "Không xác định" : tx.StaffName)</span>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="note-cell">
                                                    @(string.IsNullOrWhiteSpace(tx.Notes) ? "Không có ghi chú" : tx.Notes)
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div id="transactionEmptyFilter" class="filter-empty-state d-none">
                            <i class="bi bi-search"></i>
                            <strong>Không tìm thấy giao dịch phù hợp</strong>
                            <span>Thử thay đổi từ khóa hoặc loại giao dịch.</span>
                            <button type="button" onclick="resetTransactionFilters()">Xóa bộ lọc</button>
                        </div>
                    }
                </section>
            </main>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function normalizeSearchText(value) {
            return (value || "")
                .toLocaleLowerCase("vi-VN")
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "");
        }

        function filterTransactions() {
            const searchInput = document.getElementById("transactionSearch");
            const typeFilter = document.getElementById("transactionTypeFilter");
            const rows = document.querySelectorAll(".transaction-row");
            const emptyState = document.getElementById("transactionEmptyFilter");

            if (!searchInput || !typeFilter || rows.length === 0) {
                return;
            }

            const searchValue = normalizeSearchText(searchInput.value.trim());
            const typeValue = typeFilter.value;
            let visibleCount = 0;

            rows.forEach((row) => {
                const rowSearch = normalizeSearchText(row.dataset.search);
                const rowType = row.dataset.type;

                const matchesSearch = !searchValue || rowSearch.includes(searchValue);
                const matchesType = !typeValue || rowType === typeValue;
                const isVisible = matchesSearch && matchesType;

                row.classList.toggle("d-none", !isVisible);

                if (isVisible) {
                    visibleCount++;
                }
            });

            if (emptyState) {
                emptyState.classList.toggle("d-none", visibleCount > 0);
            }
        }

        function resetTransactionFilters() {
            const searchInput = document.getElementById("transactionSearch");
            const typeFilter = document.getElementById("transactionTypeFilter");

            if (searchInput) {
                searchInput.value = "";
            }

            if (typeFilter) {
                typeFilter.value = "";
            }

            filterTransactions();
        }
    </script>
}


<style>
    :root {
        --history-bg: #f3f4f6;
        --history-surface: #ffffff;
        --history-surface-soft: #f8f9fa;
        --history-text: #181a1f;
        --history-muted: #747983;
        --history-border: #e5e7eb;
        --history-primary: #17191e;
        --history-primary-soft: #f0f1f3;
        --history-accent: #f5b800;
        --history-accent-soft: #fff8d6;
        --history-success: #198754;
        --history-success-soft: #effbf4;
        --history-danger: #dc3545;
        --history-danger-soft: #fff2f3;
        --history-warning: #9a7000;
        --history-warning-soft: #fff9df;
        --history-info: #0f6f9f;
        --history-info-soft: #eef8fd;
        --history-neutral-soft: #f1f2f4;
        --history-radius-xl: 24px;
        --history-radius-lg: 17px;
        --history-radius-md: 12px;
        --history-shadow: 0 18px 48px rgba(17, 19, 24, 0.08);
        --history-shadow-soft: 0 10px 28px rgba(17, 19, 24, 0.055);
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    .part-history-page {
        min-height: 100vh;
        color: var(--history-text);
        background: radial-gradient( circle at 96% 3%, rgba(245, 184, 0, 0.11), transparent 28rem ), radial-gradient( circle at 2% 85%, rgba(17, 19, 24, 0.035), transparent 30rem ), var(--history-bg);
        font-family: "Outfit", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

        .part-history-page a,
        .part-history-page button,
        .part-history-page input,
        .part-history-page select {
            font-family: inherit;
        }

    /* =========================
           PAGE HEADER
        ========================== */

    .page-header {
        margin-bottom: 22px;
    }

    .page-header__content {
        position: relative;
        padding: 30px 32px;
        color: #ffffff;
        background: radial-gradient( circle at 88% 8%, rgba(245, 184, 0, 0.2), transparent 31% ), linear-gradient( 135deg, #111318, #292c33 );
        border: 1px solid rgba(255, 255, 255, 0.055);
        border-radius: var(--history-radius-xl);
        box-shadow: 0 22px 54px rgba(17, 19, 24, 0.17);
        overflow: hidden;
    }

        .page-header__content::after {
            content: "HISTORY";
            position: absolute;
            top: -37px;
            right: 25px;
            color: rgba(255, 255, 255, 0.035);
            font-size: clamp(5rem, 10vw, 8rem);
            font-weight: 900;
            line-height: 1;
            letter-spacing: -0.08em;
            pointer-events: none;
        }

    .back-link,
    .page-heading {
        position: relative;
        z-index: 2;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 22px;
        padding: 8px 11px;
        color: rgba(255, 255, 255, 0.72);
        background-color: rgba(255, 255, 255, 0.055);
        border: 1px solid rgba(255, 255, 255, 0.09);
        border-radius: 10px;
        font-size: 0.71rem;
        font-weight: 800;
        text-decoration: none;
        transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    }

        .back-link:hover {
            color: var(--history-primary);
            background-color: var(--history-accent);
            border-color: var(--history-accent);
            transform: translateX(-3px);
        }

    .page-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 25px;
    }

    .eyebrow,
    .section-kicker {
        margin-bottom: 7px;
        color: var(--history-accent);
        font-size: 0.65rem;
        font-weight: 900;
        letter-spacing: 0.17em;
        text-transform: uppercase;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
    }

        .eyebrow::before {
            content: "";
            width: 28px;
            height: 2px;
            background-color: var(--history-accent);
        }

    .page-heading h1 {
        margin: 0;
        color: #ffffff;
        font-size: clamp(1.9rem, 3.3vw, 2.7rem);
        font-weight: 950;
        line-height: 1.12;
        letter-spacing: -0.045em;
    }

    .page-heading p {
        max-width: 720px;
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.84rem;
        line-height: 1.7;
    }

    .part-identity {
        min-width: 235px;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        padding-left: 25px;
        border-left: 1px solid rgba(255, 255, 255, 0.13);
    }

    .part-identity__code {
        display: inline-flex;
        padding: 7px 10px;
        color: var(--history-accent);
        background-color: rgba(245, 184, 0, 0.09);
        border: 1px solid rgba(245, 184, 0, 0.18);
        border-radius: 9px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.04em;
    }

    .part-identity__name {
        max-width: 300px;
        margin-top: 8px;
        overflow: hidden;
        color: #ffffff;
        font-size: 0.87rem;
        font-weight: 800;
        text-align: right;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* =========================
           ALERT
        ========================== */

    .alert-modern {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 22px;
        padding: 15px 17px;
        border: 1px solid transparent;
        border-radius: var(--history-radius-lg);
        font-size: 0.77rem;
        line-height: 1.6;
        box-shadow: var(--history-shadow-soft);
    }

    .alert-modern--danger {
        color: #991b1b;
        background-color: var(--history-danger-soft);
        border-color: #fecaca;
    }

