@model CarSalesManagementSystemClient.Models.PartViewModel

@{
    ViewData["Title"] = Model.PartName + " - Chi tiết phụ tùng";

    var relatedParts =
        ViewBag.RelatedParts as IEnumerable<CarSalesManagementSystemClient.Models.PartViewModel>
        ?? new List<CarSalesManagementSystemClient.Models.PartViewModel>();

    var rawImg = Model.ImageUrl ?? "";

    var imagesList = rawImg
        .Split(
            ',',
            StringSplitOptions.RemoveEmptyEntries
            | StringSplitOptions.TrimEntries
        )
        .ToList();

    if (!imagesList.Any())
    {
        imagesList.Add(
            "https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=800&q=80"
        );
    }

    var displayImageUrl = imagesList[0];
    var isAvailable = Model.Status == "Available" && Model.Quantity > 0;
}

<style>
    :root {
        --part-detail-primary: #17191e;
        --part-detail-secondary: #252830;
        --part-detail-accent: #f5b800;
        --part-detail-accent-hover: #ffca28;
        --part-detail-background: #f4f5f7;
        --part-detail-surface: #ffffff;
        --part-detail-border: #e5e7eb;
        --part-detail-text: #1b1d22;
        --part-detail-muted: #747983;
        --part-detail-danger: #dc3545;
        --part-detail-success: #198754;
        --part-detail-info: #0ea5e9;
        --part-detail-radius-lg: 24px;
        --part-detail-radius-md: 14px;
        --part-detail-shadow: 0 18px 46px rgba(17, 19, 24, 0.08);
    }

    .part-detail-page {
        min-height: 100vh;
        padding: 28px 0 78px;
        background: radial-gradient( circle at 94% 5%, rgba(245, 184, 0, 0.11), transparent 25% ), var(--part-detail-background);
    }

    .part-detail-container {
        width: 100%;
        max-width: 1320px;
        margin: 0 auto;
        padding-right: 24px;
        padding-left: 24px;
    }

    /* Breadcrumb */

    .part-breadcrumb {
        margin-bottom: 22px;
    }

        .part-breadcrumb .breadcrumb {
            margin: 0;
            padding: 11px 15px;
            background-color: var(--part-detail-surface);
            border: 1px solid var(--part-detail-border);
            border-radius: 13px;
            box-shadow: 0 8px 24px rgba(17, 19, 24, 0.045);
        }

        .part-breadcrumb .breadcrumb-item {
            color: #92969e;
            font-size: 0.73rem;
            font-weight: 800;
        }

            .part-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
                color: #b4b8bf;
            }

    .part-breadcrumb-link {
        color: var(--part-detail-muted);
        text-decoration: none;
        transition: color 0.2s ease;
    }

        .part-breadcrumb-link:hover {
            color: #927000;
        }

    .part-breadcrumb .active {
        max-width: 360px;
        overflow: hidden;
        color: #8e6b00;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Main product */

    .part-product-shell {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
        gap: 26px;
        margin-bottom: 30px;
        align-items: stretch;
    }

    .part-gallery-card,
    .part-info-card {
        background-color: var(--part-detail-surface);
        border: 1px solid var(--part-detail-border);
        border-radius: var(--part-detail-radius-lg);
        box-shadow: var(--part-detail-shadow);
    }

    /* Gallery */

    .part-gallery-card {
        padding: 18px;
    }

    .part-main-image-wrapper {
        position: relative;
        height: 465px;
        overflow: hidden;
        background: linear-gradient( 135deg, #eceef1, #dfe2e6 );
        border-radius: 18px;
    }

    .product-main-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.45s ease;
    }

    .part-main-image-wrapper:hover .product-main-img {
        transform: scale(1.055);
    }

    .part-category-badge {
        position: absolute;
        z-index: 3;
        top: 15px;
        left: 15px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 11px;
        color: var(--part-detail-accent);
        background-color: rgba(17, 19, 24, 0.9);
        border: 1px solid rgba(245, 184, 0, 0.2);
        border-radius: 999px;
        font-size: 0.67rem;
        font-weight: 900;
        backdrop-filter: blur(8px);
    }

    .out-of-stock-overlay {
        position: absolute;
        z-index: 2;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: rgba(17, 19, 24, 0.62);
        backdrop-filter: blur(2px);
    }

    .out-of-stock-text {
        padding: 13px 20px;
        color: #ffffff;
        background-color: rgba(220, 53, 69, 0.88);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 13px;
        font-size: 1.15rem;
        font-weight: 950;
        letter-spacing: 0.16em;
        box-shadow: 0 14px 34px rgba(17, 19, 24, 0.24);
    }

    .thumb-strip {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 9px;
        margin-top: 14px;
    }

    .thumb {
        width: 68px;
        height: 68px;
        padding: 3px;
        overflow: hidden;
        background-color: #ffffff;
        border: 2px solid transparent;
        border-radius: 12px;
        cursor: pointer;
        transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

        .thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 8px;
        }

        .thumb:hover {
            transform: translateY(-2px);
        }

        .thumb.active {
            border-color: var(--part-detail-accent);
            box-shadow: 0 0 0 4px rgba(245, 184, 0, 0.12);
        }

    /* Information */

    .part-info-card {
        position: relative;
        padding: 30px;
        overflow: hidden;
    }

        .part-info-card::after {
            content: "PART";
            position: absolute;
            top: -32px;
            right: 14px;
            color: rgba(17, 19, 24, 0.025);
            font-size: 7rem;
            font-weight: 950;
            line-height: 1;
            pointer-events: none;
        }

    .part-info-content {
        position: relative;
        z-index: 2;
    }

    .part-chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 15px;
    }

    .part-info-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 10px;
        color: #805f00;
        background-color: #fff8d6;
        border: 1px solid #fde68a;
        border-radius: 999px;
        font-size: 0.66rem;
        font-weight: 900;
    }

    .part-info-chip-brand {
        color: #166534;
        background-color: #ecfdf3;
        border-color: #bbf7d0;
    }

    .product-title {
        margin: 0 0 11px;
        color: var(--part-detail-primary);
        font-size: clamp(1.7rem, 3vw, 2.35rem);
        font-weight: 950;
        line-height: 1.25;
        letter-spacing: -0.04em;
    }

    .part-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        margin-bottom: 22px;
    }

    .part-code {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 10px;
        color: #5f646d;
        background-color: #f4f5f7;
        border: 1px solid var(--part-detail-border);
        border-radius: 9px;
        font-family: monospace;
        font-size: 0.71rem;
        font-weight: 800;
    }

    .star-rating {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        color: var(--part-detail-accent);
        font-size: 0.78rem;
    }

        .star-rating span {
            margin-left: 6px;
            color: var(--part-detail-muted);
            font-size: 0.68rem;
            font-weight: 700;
        }

    .part-price-card {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
        padding: 20px;
        background: linear-gradient( 135deg, #fffaf0, #fffdf8 );
        border: 1px solid #fde68a;
        border-radius: 16px;
    }

    .price-label {
        display: block;
        margin-bottom: 4px;
        color: #8d929a;
        font-size: 0.64rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .price-value {
        display: block;
        color: #b42318;
        font-size: clamp(1.75rem, 3.2vw, 2.4rem);
        font-weight: 950;
        line-height: 1;
        white-space: nowrap;
    }

    .price-currency {
        font-size: 1rem;
    }

    .part-price-note {
        max-width: 210px;
        color: #8c9199;
        font-size: 0.68rem;
        line-height: 1.5;
        text-align: right;
    }

    .stock-block {
        margin-bottom: 20px;
    }

    .stock-status {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 13px 15px;
        border: 1px solid transparent;
        border-radius: 13px;
        font-size: 0.76rem;
        font-weight: 800;
    }

    .stock-in {
        color: #166534;
        background-color: #f0fdf4;
        border-color: #bbf7d0;
    }

    .stock-out {
        color: #9a3412;
        background-color: #fff7ed;
        border-color: #fed7aa;
    }

    .stock-inactive {
        color: #6b21a8;
        background-color: #faf5ff;
        border-color: #e9d5ff;
    }

    /* Purchase actions */

    .cart-actions {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 11px;
        margin-bottom: 11px;
    }

    .qty-selector {
        display: grid;
        grid-template-columns: 42px 56px 42px;
        overflow: hidden;
        background-color: #ffffff;
        border: 1px solid var(--part-detail-border);
        border-radius: 13px;
    }

    .qty-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        color: #5d626a;
        background-color: #f8f9fa;
        border: 0;
        font-size: 0.9rem;
        transition: color 0.2s ease, background-color 0.2s ease;
    }

        .qty-btn:hover {
            color: var(--part-detail-primary);
            background-color: #fff8d6;
        }

    .qty-input {
        width: 100%;
        min-height: 51px;
        padding: 0;
        color: var(--part-detail-primary);
        background-color: #ffffff;
        border: 0;
        outline: none;
        font-size: 0.84rem;
        font-weight: 900;
        text-align: center;
    }

    .btn-add-cart,
    .btn-buy-now {
        min-height: 51px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 11px 18px;
        border-radius: 13px;
        font-size: 0.75rem;
        font-weight: 900;
        text-decoration: none;
        transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-add-cart {
        color: var(--part-detail-primary);
        background-color: var(--part-detail-accent);
        border: 1px solid var(--part-detail-accent);
        box-shadow: 0 12px 28px rgba(245, 184, 0, 0.19);
    }

        .btn-add-cart:hover:not(:disabled) {
            color: var(--part-detail-primary);
            background-color: var(--part-detail-accent-hover);
            border-color: var(--part-detail-accent-hover);
            transform: translateY(-2px);
            box-shadow: 0 16px 33px rgba(245, 184, 0, 0.26);
        }

        .btn-add-cart:disabled,
        .btn-add-cart.disabled-btn {
            color: #ffffff;
            background-color: #8d929b;
            border-color: #8d929b;
            cursor: not-allowed;
            box-shadow: none;
        }

    .btn-buy-now {
        width: 100%;
        margin-bottom: 20px;
        color: #ffffff;
        background-color: var(--part-detail-primary);
        border: 1px solid var(--part-detail-primary);
    }

        .btn-buy-now:hover {
            color: var(--part-detail-primary);
            background-color: var(--part-detail-accent);
            border-color: var(--part-detail-accent);
            transform: translateY(-2px);
            box-shadow: 0 13px 29px rgba(17, 19, 24, 0.17);
        }

    .feature-pills {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 9px;
    }

    .pill {
        display: flex;
        align-items: center;
        gap: 7px;
        min-width: 0;
        padding: 11px 12px;
        color: #5b6069;
        background-color: #f8f9fa;
        border: 1px solid var(--part-detail-border);
        border-radius: 11px;
        font-size: 0.69rem;
        font-weight: 800;
    }

    /* Tabs */

    .detail-tabs-card {
        margin-bottom: 34px;
        overflow: hidden;
        background-color: var(--part-detail-surface);
        border: 1px solid var(--part-detail-border);
        border-radius: var(--part-detail-radius-lg);
        box-shadow: var(--part-detail-shadow);
    }

    .detail-nav-tabs {
        display: flex;
        flex-wrap: nowrap;
        padding: 0 18px;
        overflow-x: auto;
        background: linear-gradient( 135deg, var(--part-detail-primary), var(--part-detail-secondary) );
        border: 0;
        scrollbar-width: thin;
    }

        .detail-nav-tabs .nav-item {
            flex: 0 0 auto;
        }

        .detail-nav-tabs .nav-link {
            min-height: 59px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 14px 17px;
            color: #a1a6af;
            background-color: transparent;
            border: 0;
            border-bottom: 3px solid transparent;
            border-radius: 0;
            font-size: 0.72rem;
            font-weight: 900;
            white-space: nowrap;
        }

            .detail-nav-tabs .nav-link:hover {
                color: #ffffff;
            }

            .detail-nav-tabs .nav-link.active {
                color: var(--part-detail-accent);
                background-color: transparent;
                border-bottom-color: var(--part-detail-accent);
            }

    .detail-tab-content {
        padding: 28px;
    }

    .part-description-content {
        margin: 0;
        color: #4e535c;
        font-size: 0.83rem;
        line-height: 1.85;
    }

    .part-empty-description {
        margin: 0;
        color: var(--part-detail-muted);
        font-size: 0.8rem;
        font-style: italic;
    }

    /* Specifications */

    .spec-table {
        margin-bottom: 0;
        overflow: hidden;
        border: 1px solid var(--part-detail-border);
        border-radius: 13px;
    }

        .spec-table th,
        .spec-table td {
            padding: 13px 16px;
            border-color: #eff0f2;
            font-size: 0.77rem;
            vertical-align: middle;
        }

    .spec-label {
        width: 34%;
        color: #555a63;
        background-color: #f8f9fa;
        font-weight: 900;
    }

    .spec-table code {
        padding: 5px 8px;
        color: #5c616a;
        background-color: #f0f1f3;
        border-radius: 7px;
        font-size: 0.72rem;
    }

    /* Delivery */

    .delivery-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .delivery-option-card {
        height: 100%;
        padding: 22px 18px;
        text-align: center;
        background-color: #f8f9fa;
        border: 1px solid var(--part-detail-border);
        border-radius: 15px;
        transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

        .delivery-option-card:hover {
            border-color: var(--part-detail-accent);
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(17, 19, 24, 0.08);
        }

    .delivery-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 13px;
        color: #8d6a00;
        background-color: rgba(245, 184, 0, 0.13);
        border-radius: 15px;
        font-size: 1.25rem;
    }

    .delivery-title {
        margin-bottom: 6px;
        color: var(--part-detail-primary);
        font-size: 0.82rem;
        font-weight: 950;
    }

    .delivery-description {
        min-height: 39px;
        margin-bottom: 7px;
        color: var(--part-detail-muted);
        font-size: 0.7rem;
        line-height: 1.55;
    }

    .delivery-price {
        font-size: 0.72rem;
        font-weight: 900;
    }

    /* Compatibility */

    .compatibility-panel {
        padding: 23px;
        background-color: #f8f9fa;
        border: 1px solid var(--part-detail-border);
        border-radius: 16px;
    }

    .compatibility-heading {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 7px;
        color: var(--part-detail-primary);
        font-size: 1rem;
        font-weight: 950;
        text-transform: uppercase;
    }

    .compatibility-heading-icon {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #8d6a00;
        background-color: rgba(245, 184, 0, 0.13);
        border-radius: 12px;
        font-size: 1rem;
    }

    .compatibility-description {
        margin-bottom: 18px;
        color: var(--part-detail-muted);
        font-size: 0.76rem;
        line-height: 1.65;
    }

    .compatibility-form {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 210px;
        gap: 10px;
        max-width: 700px;
    }

    .compatibility-input-wrapper {
        position: relative;
    }

    .compatibility-input-icon {
        position: absolute;
        z-index: 2;
        top: 50%;
        left: 14px;
        color: #969ba4;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .compatibility-input {
        width: 100%;
        min-height: 49px;
        padding: 11px 13px 11px 42px;
        color: var(--part-detail-primary);
        background-color: #ffffff;
        border: 1px solid var(--part-detail-border);
        border-radius: 12px;
        outline: none;
        font-size: 0.82rem;
        font-weight: 800;
        text-transform: uppercase;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .compatibility-input:focus {
            border-color: var(--part-detail-accent);
            box-shadow: 0 0 0 4px rgba(245, 184, 0, 0.13);
        }

    .compatibility-button {
        min-height: 49px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 10px 14px;
        color: var(--part-detail-primary);
        background-color: var(--part-detail-accent);
        border: 1px solid var(--part-detail-accent);
        border-radius: 12px;
        font-size: 0.71rem;
        font-weight: 900;
    }

    #compatibilityResult {
        margin-top: 18px;
    }

        #compatibilityResult .card {
            border-radius: 13px !important;
        }

        #compatibilityResult .card-body {
            padding: 15px !important;
        }

    /* Related */

    .related-section {
        padding-top: 4px;
    }

    .section-title-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 19px;
    }

    .section-title-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--part-detail-primary);
        background-color: var(--part-detail-accent);
        border-radius: 13px;
        font-size: 1rem;
        box-shadow: 0 9px 22px rgba(245, 184, 0, 0.18);
    }

    .section-title {
        margin: 0 0 3px;
        color: var(--part-detail-primary);
        font-size: 1.12rem;
        font-weight: 950;
    }

    .section-subtitle {
        margin: 0;
        color: var(--part-detail-muted);
        font-size: 0.72rem;
    }

    .related-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
    }

    .related-card {
        overflow: hidden;
        background-color: var(--part-detail-surface);
        border: 1px solid var(--part-detail-border);
        border-radius: 17px;
        box-shadow: 0 12px 32px rgba(17, 19, 24, 0.065);
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

        .related-card:hover {
            border-color: rgba(245, 184, 0, 0.48);
            transform: translateY(-6px);
            box-shadow: 0 19px 40px rgba(17, 19, 24, 0.12);
        }

    .related-link {
        display: block;
        color: inherit;
        text-decoration: none;
    }

    .related-img-wrap {
        height: 165px;
        overflow: hidden;
        background-color: #e9ebee;
    }

        .related-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.35s ease;
        }

    .related-card:hover .related-img-wrap img {
        transform: scale(1.07);
    }

    .related-body {
        padding: 16px;
    }

    .related-brand {
        display: block;
        margin-bottom: 5px;
        color: #967000;
        font-size: 0.61rem;
        font-weight: 900;
        letter-spacing: 0.07em;
        text-transform: uppercase;
    }

    .related-name {
        min-height: 39px;
        margin: 0 0 12px;
        overflow: hidden;
        color: var(--part-detail-primary);
        font-size: 0.8rem;
        font-weight: 950;
        line-height: 1.45;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .related-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding-top: 12px;
        border-top: 1px solid var(--part-detail-border);
    }

    .related-price {
        color: #b42318;
        font-size: 0.78rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .related-status {
        display: inline-flex;
        padding: 5px 8px;
        border: 1px solid transparent;
        border-radius: 999px;
        font-size: 0.58rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .related-status-available {
        color: #166534;
        background-color: #dcfce7;
        border-color: #bbf7d0;
    }

    .related-status-empty {
        color: #52525b;
        background-color: #f1f2f4;
        border-color: #dedfe3;
    }

    /* Responsive */

    @@media (max-width: 1199.98px) {
        .part-detail-container {
            padding-right: 20px;
            padding-left: 20px;
        }

        .part-product-shell {
            grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        }

        .part-main-image-wrapper {
            height: 420px;
        }

        .related-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 991.98px) {
        .part-product-shell {
            grid-template-columns: 1fr;
        }

        .part-main-image-wrapper {
            height: 520px;
        }

        .related-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767.98px) {
        .part-detail-page {
            padding-top: 20px;
        }

        .part-detail-container {
            padding-right: 13px;
            padding-left: 13px;
        }

        .part-gallery-card,
        .part-info-card,
        .detail-tabs-card {
            border-radius: 20px;
        }

        .part-main-image-wrapper {
            height: 400px;
        }

        .part-info-card {
            padding: 23px;
        }

        .part-price-card {
            align-items: flex-start;
            flex-direction: column;
        }

        .part-price-note {
            max-width: none;
            text-align: left;
        }

        .detail-tab-content {
            padding: 22px 18px;
        }

        .delivery-grid {
            grid-template-columns: 1fr;
        }

        .compatibility-form {
            grid-template-columns: 1fr;
        }

        .compatibility-button {
            width: 100%;
        }
    }

    @@media (max-width: 575.98px) {
        .part-breadcrumb .active {
            max-width: 150px;
        }

        .part-main-image-wrapper {
            height: 300px;
        }

        .product-title {
            font-size: 1.45rem;
        }

        .part-meta {
            align-items: flex-start;
            flex-direction: column;
        }

        .cart-actions {
            grid-template-columns: 1fr;
        }

        .qty-selector {
            grid-template-columns: 1fr 62px 1fr;
        }

        .qty-btn,
        .qty-input {
            min-height: 48px;
        }

        .feature-pills {
            grid-template-columns: 1fr;
        }

        .related-grid {
            grid-template-columns: 1fr;
        }

        .related-img-wrap {
            height: 205px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .product-main-img,
        .thumb,
        .btn-add-cart,
        .btn-buy-now,
        .delivery-option-card,
        .related-card,
        .related-img-wrap img {
            transition: none;
        }

            .thumb:hover,
            .btn-add-cart:hover,
            .btn-buy-now:hover,
            .delivery-option-card:hover,
            .related-card:hover {
                transform: none;
            }
    }
</style>

<main class="part-detail-page">
    <div class="part-detail-container">

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb"
             class="part-breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="part-breadcrumb-link">
                        Trang chủ
                    </a>
                </li>

                <li class="breadcrumb-item">
                    <a asp-controller="Parts"
                       asp-action="Index"
                       class="part-breadcrumb-link">
                        Phụ tùng
                    </a>
                </li>

                <li class="breadcrumb-item active"
                    aria-current="page">
                    @Model.PartName
                </li>
            </ol>
        </nav>

        <!-- Main product -->
        <section class="part-product-shell">

            <!-- Gallery -->
            <div class="part-gallery-card">
                <div class="part-main-image-wrapper">
                    <img id="mainImage"
                         src="@displayImageUrl"
                         alt="@Model.PartName"
                         class="product-main-img"
                         onerror="this.src='https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=800&q=80'" />

                    @if (!isAvailable)
                    {
                        <div class="out-of-stock-overlay">
                            <span class="out-of-stock-text">
                                HẾT HÀNG
                            </span>
                        </div>
                    }

                    <span class="part-category-badge">
                        <i class="bi bi-tag-fill"></i>
                        @Model.Category?.CategoryName
                    </span>
                </div>

                <div class="thumb-strip">
                    @for (int i = 0; i < imagesList.Count; i++)
                    {
                        var imgUrl = imagesList[i];
                        var activeClass = i == 0 ? "active" : "";

                        <div class="thumb @activeClass"
                             onclick="setMainImage('@imgUrl', this)">
                            <img src="@imgUrl"
                                 alt="thumb @(i + 1)"
                                 onerror="this.src='https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=600&q=80'" />
                        </div>
                    }
                </div>
            </div>

            <!-- Product information -->
            <div class="part-info-card">
                <div class="part-info-content">
                    <div class="part-chip-row">
                        <span class="part-info-chip">
                            <i class="bi bi-grid-fill"></i>
                            @(Model.Category?.CategoryName ?? "Phụ tùng")
                        </span>

                        <span class="part-info-chip part-info-chip-brand">
                            <i class="bi bi-shield-check"></i>
                            @(Model.Brand ?? "Chính hãng")
                        </span>
                    </div>

                    <h1 class="product-title">
                        @Model.PartName
                    </h1>

                    <div class="part-meta">
                        <code class="part-code">
                            <i class="bi bi-upc"></i>
                            @Model.PartCode
                        </code>

                        <div class="star-rating">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-half"></i>
                            <span>(4.5 / 5.0)</span>
                        </div>
                    </div>

                    <div class="part-price-card">
                        <div>
                            <span class="price-label">
                                Giá bán
                            </span>

                            <span class="price-value">
                                @Model.Price.ToString("N0")
                                <span class="price-currency">đ</span>
                            </span>
                        </div>

                        <div class="part-price-note">
                            Giá niêm yết hiện tại, chưa bao gồm các chi phí
                            giao hàng hoặc lắp đặt phát sinh.
                        </div>
                    </div>

                    <div class="stock-block">
                        @if (isAvailable)
                        {
                            <div class="stock-status stock-in">
                                <i class="bi bi-check-circle-fill"></i>

                                <span>
                                    Còn hàng —
                                    <strong>@Model.Quantity</strong>
                                    sản phẩm trong kho
                                </span>
                            </div>
                        }
                        else if (Model.Status == "Out of Stock")
                        {
                            <div class="stock-status stock-out">
                                <i class="bi bi-x-circle-fill"></i>
                                <span>Tạm hết hàng</span>
                            </div>
                        }
                        else
                        {
                            <div class="stock-status stock-inactive">
                                <i class="bi bi-slash-circle-fill"></i>
                                <span>Ngưng kinh doanh</span>
                            </div>
                        }
                    </div>

                    @if (isAvailable)
                    {
                        <div class="cart-actions">
                            <div class="qty-selector">
                                <button type="button"
                                        class="qty-btn"
                                        id="qtyMinus"
                                        onclick="changeQty(-1)"
                                        aria-label="Giảm số lượng">
                                    <i class="bi bi-dash-lg"></i>
                                </button>

                                <input type="number"
                                       id="qtyInput"
                                       class="qty-input"
                                       value="1"
                                       min="1"
                                       max="@Model.Quantity"
                                       readonly />

                                <button type="button"
                                        class="qty-btn"
                                        id="qtyPlus"
                                        onclick="changeQty(1)"
                                        aria-label="Tăng số lượng">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>

                            <button type="button"
                                    class="btn-add-cart"
                                    id="btnAddToCart"
                                    onclick="addToCartDetail(@Model.PartId, @Model.Quantity)">
                                <i class="bi bi-cart-plus-fill"></i>
                                Thêm vào giỏ hàng
                            </button>
                        </div>

                    }
                    else
                    {
                        <div class="mb-4">
                            <button type="button"
                                    class="btn-add-cart disabled-btn w-100"
                                    disabled>
                                <i class="bi bi-x-circle"></i>
                                Sản phẩm không có sẵn
                            </button>
                        </div>
                    }

                    <div class="feature-pills">
                        <span class="pill">
                            <i class="bi bi-shield-fill-check text-success"></i>
                            Chính hãng 100%
                        </span>

                        <span class="pill">
                            <i class="bi bi-arrow-return-left text-warning"></i>
                            Đổi trả 7 ngày
                        </span>

                        <span class="pill">
                            <i class="bi bi-truck text-info"></i>
                            Giao hàng toàn quốc
                        </span>

                        <span class="pill">
                            <i class="bi bi-headset text-danger"></i>
                            Hỗ trợ 24/7
                        </span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Details tabs -->
        <section class="detail-tabs-card">
            <ul class="nav nav-tabs detail-nav-tabs"
                id="detailTabs"
                role="tablist">

                <li class="nav-item"
                    role="presentation">
                    <button class="nav-link active"
                            id="desc-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#desc"
                            type="button">
                        <i class="bi bi-card-text"></i>
                        Mô tả sản phẩm
                    </button>
                </li>

                <li class="nav-item"
                    role="presentation">
                    <button class="nav-link"
                            id="spec-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#spec"
                            type="button">
                        <i class="bi bi-list-check"></i>
                        Thông số kỹ thuật
                    </button>
                </li>

                <li class="nav-item"
                    role="presentation">
                    <button class="nav-link"
                            id="delivery-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#delivery"
                            type="button">
                        <i class="bi bi-truck"></i>
                        Vận chuyển & Lắp đặt
                    </button>
                </li>

                <li class="nav-item"
                    role="presentation">
                    <button class="nav-link"
                            id="compatibility-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#compatibility"
                            type="button">
                        <i class="bi bi-shield-check"></i>
                        Kiểm tra tương thích
                    </button>
                </li>
            </ul>

            <div class="tab-content detail-tab-content"
                 id="detailTabContent">

                <!-- Description -->
                <div class="tab-pane fade show active"
                     id="desc"
                     role="tabpanel">

                    @if (string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="part-empty-description">
                            Chưa có mô tả chi tiết cho sản phẩm này.
                            Vui lòng liên hệ cửa hàng để biết thêm thông tin.
                        </p>
                    }
                    else
                    {
                        <p class="part-description-content">
                            @Model.Description
                        </p>
                    }
                </div>

                <!-- Specifications -->
                <div class="tab-pane fade"
                     id="spec"
                     role="tabpanel">

                    <div class="table-responsive">
                        <table class="table table-hover spec-table">
                            <tbody>
                                <tr>
                                    <th scope="row"
                                        class="spec-label">
                                        Mã phụ tùng
                                    </th>

                                    <td>
                                        <code>@Model.PartCode</code>
                                    </td>
                                </tr>

                                <tr>
                                    <th scope="row"
                                        class="spec-label">
                                        Thương hiệu
                                    </th>

                                    <td>@(Model.Brand ?? "—")</td>
                                </tr>

                                <tr>
                                    <th scope="row"
                                        class="spec-label">
                                        Danh mục
                                    </th>

                                    <td>
                                        @(Model.Category?.CategoryName ?? "—")
                                    </td>
                                </tr>

                                <tr>
                                    <th scope="row"
                                        class="spec-label">
                                        Tồn kho
                                    </th>

                                    <td>
                                        @if (Model.Quantity > 0)
                                        {
                                            <span class="text-success fw-bold">
                                                @Model.Quantity sản phẩm
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-danger fw-bold">
                                                Hết hàng
                                            </span>
                                        }
                                    </td>
                                </tr>

                                <tr>
                                    <th scope="row"
                                        class="spec-label">
                                        Trạng thái
                                    </th>

                                    <td>
                                        @switch (Model.Status)
                                        {
                                            case "Available":
                                                <span class="badge bg-success px-3 py-2">
                                                    Đang bán
                                                </span>
                                                break;

                                            case "Out of Stock":
                                                <span class="badge bg-warning text-dark px-3 py-2">
                                                    Hết hàng
                                                </span>
                                                break;

                                            case "Inactive":
                                                <span class="badge bg-secondary px-3 py-2">
                                                    Ngưng bán
                                                </span>
                                                break;

                                            default:
                                                <span class="badge bg-secondary px-3 py-2">
                                                    @Model.Status
                                                </span>
                                                break;
                                        }
                                    </td>
                                </tr>

                                <tr>
                                    <th scope="row"
                                        class="spec-label">
                                        Ngày cập nhật
                                    </th>

                                    <td>
                                        @Model.CreatedAt.ToString("dd/MM/yyyy")
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Delivery -->
                <div class="tab-pane fade"
                     id="delivery"
                     role="tabpanel">

                    <div class="delivery-grid">
                        <article class="delivery-option-card">
                            <div class="delivery-icon">
                                <i class="bi bi-shop"></i>
                            </div>

                            <h3 class="delivery-title">
                                Nhận tại cửa hàng
                            </h3>

                            <p class="delivery-description">
                                Đến trực tiếp showroom nhận hàng.
                            </p>

                            <span class="delivery-price text-success">
                                Miễn phí
                            </span>
                        </article>

                        <article class="delivery-option-card">
                            <div class="delivery-icon">
                                <i class="bi bi-truck"></i>
                            </div>

                            <h3 class="delivery-title">
                                Giao hàng tận nơi
                            </h3>

                            <p class="delivery-description">
                                Ship đến địa chỉ của bạn.
                            </p>

                            <span class="delivery-price text-warning">
                                + 30.000 đ
                            </span>
                        </article>

                        <article class="delivery-option-card">
                            <div class="delivery-icon">
                                <i class="bi bi-tools"></i>
                            </div>

                            <h3 class="delivery-title">
                                Lắp đặt tại garage
                            </h3>

                            <p class="delivery-description">
                                Giao và lắp đặt tại garage của bạn.
                            </p>

                            <span class="delivery-price text-danger">
                                + 50.000 đ
                            </span>
                        </article>
                    </div>
                </div>

                <!-- Compatibility -->
                <div class="tab-pane fade"
                     id="compatibility"
                     role="tabpanel">

                    <div class="compatibility-panel">
                        <h3 class="compatibility-heading">
                            <span class="compatibility-heading-icon">
                                <i class="bi bi-patch-question-fill"></i>
                            </span>
                            Kiểm tra phù hợp xe
                        </h3>

                        <p class="compatibility-description">
                            Nhập biển số xe của bạn đã đăng ký trên hệ thống
                            để kiểm tra phụ tùng này có phù hợp hay không.
                        </p>

                        <div class="compatibility-form">
                            <div class="compatibility-input-wrapper">
                                <i class="bi bi-credit-card-2-front compatibility-input-icon"></i>

                                <input type="text"
                                       id="licensePlateInput"
                                       class="compatibility-input"
                                       placeholder="Ví dụ: 30G-888.88" />
                            </div>

                            <button type="button"
                                    class="compatibility-button"
                                    onclick="performCompatibilityCheck()">
                                <i class="bi bi-shield-check"></i>
                                Kiểm tra ngay
                            </button>
                        </div>

                        <div id="compatibilityResult"
                             class="d-none">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body d-flex align-items-center">
                                    <div class="result-icon me-3"></div>

                                    <div>
                                        <h4 class="fw-bold mb-1 result-title"></h4>
                                        <p class="text-secondary mb-0 result-msg"></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Related parts -->
        @if (relatedParts.Any())
        {
            <section class="related-section">
                <div class="section-title-row">
                    <div class="section-title-icon">
                        <i class="bi bi-grid-fill"></i>
                    </div>

                    <div>
                        <h2 class="section-title">
                            Phụ tùng cùng danh mục
                        </h2>

                        <p class="section-subtitle">
                            Một số sản phẩm khác có thể phù hợp với nhu cầu của bạn
                        </p>
                    </div>
                </div>

                <div class="related-grid">
                    @foreach (var rp in relatedParts)
                    {
                        var rpImg =
                            string.IsNullOrWhiteSpace(rp.ImageUrl)
                            ? "https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=600&q=80"
                            : rp.ImageUrl;

                        <article class="related-card">
                            <a asp-controller="Parts"
                               asp-action="Details"
                               asp-route-id="@rp.PartId"
                               class="related-link">

                                <div class="related-img-wrap">
                                    <img src="@rpImg"
                                         alt="@rp.PartName"
                                         onerror="this.src='https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=600&q=80'" />
                                </div>

                                <div class="related-body">
                                    <span class="related-brand">
                                        @rp.Brand
                                    </span>

                                    <h3 class="related-name">
                                        @rp.PartName
                                    </h3>

                                    <div class="related-footer">
                                        <span class="related-price">
                                            @rp.Price.ToString("N0") đ
                                        </span>

                                        @if (rp.Quantity > 0)
                                        {
                                            <span class="related-status related-status-available">
                                                Còn hàng
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="related-status related-status-empty">
                                                Hết hàng
                                            </span>
                                        }
                                    </div>
                                </div>
                            </a>
                        </article>
                    }
                </div>
            </section>
        }

    </div>
</main>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Compatibility check using backend API
        function performCompatibilityCheck() {
            const licensePlate = document.getElementById('licensePlateInput').value.trim();
            if (!licensePlate) {
                Swal.fire('Nhắc nhở', 'Vui lòng nhập biển số xe.', 'warning');
                return;
            }
            const partCode = '@Model.PartCode';
            const resultDiv = document.getElementById('compatibilityResult');
            const resultIcon = resultDiv.querySelector('.result-icon');
            const resultTitle = resultDiv.querySelector('.result-title');
            const resultMsg = resultDiv.querySelector('.result-msg');

            resultDiv.classList.add('d-none');

            fetch(`/Parts/CheckCompatibility?licensePlate=${encodeURIComponent(licensePlate)}&partCode=${encodeURIComponent(partCode)}`, {
                method: 'POST'
            })
                .then(res => {
                    if (!res.ok) {
                        return res.json().then(err => { throw new Error(err.message || 'Lỗi kiểm tra tương thích'); });
                    }
                    return res.json();
                })
                .then(data => {
                    resultDiv.classList.remove('d-none');
                    if (data.isCompatible) {
                        resultDiv.querySelector('.card').className = 'card border-start border-success border-4 shadow-sm rounded-3';
                        resultIcon.innerHTML = '<i class="bi bi-check-circle-fill text-success fs-2"></i>';
                        resultTitle.textContent = 'Phụ tùng tương thích';
                        resultTitle.className = 'fw-bold mb-1 text-success';
                    } else {
                        resultDiv.querySelector('.card').className = 'card border-start border-danger border-4 shadow-sm rounded-3';
                        resultIcon.innerHTML = '<i class="bi bi-x-circle-fill text-danger fs-2"></i>';
                        resultTitle.textContent = 'Phụ tùng không tương thích';
                        resultTitle.className = 'fw-bold mb-1 text-danger';
                    }
                    resultMsg.textContent = data.message;
                })
                .catch(err => {
                    resultDiv.classList.remove('d-none');
                    resultDiv.querySelector('.card').className = 'card border-start border-warning border-4 shadow-sm rounded-3';
                    resultIcon.innerHTML = '<i class="bi bi-exclamation-triangle-fill text-warning fs-2"></i>';
                    resultTitle.textContent = 'Lỗi hệ thống';
                    resultTitle.className = 'fw-bold mb-1 text-warning';
                    resultMsg.textContent = err.message;
                });
        }

        // Thumbnail switcher
        function setMainImage(src, thumbEl) {
            document.getElementById('mainImage').src = src;
            document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
            thumbEl.classList.add('active');
        }

        // Quantity control
        function changeQty(delta) {
            var input = document.getElementById('qtyInput');
            var val = parseInt(input.value) + delta;
            var max = parseInt(input.max);
            if (val < 1) val = 1;
            if (val > max) val = max;
            input.value = val;
        }

        // Add to cart using qty input value
        function addToCartDetail(partId, maxQty) {
            var isAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
            if (!isAuthenticated) {
                Swal.fire({
                    title: 'Yêu cầu đăng nhập!',
                    text: 'Vui lòng đăng nhập để thêm phụ tùng vào giỏ hàng.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ffc107',
                    cancelButtonColor: '#262626',
                    confirmButtonText: 'Đăng nhập',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        var myModal = new bootstrap.Modal(document.getElementById('loginModal'));
                        myModal.show();
                    }
                });
                return;
            }

            var qty = parseInt(document.getElementById('qtyInput').value);
            if (qty < 1 || qty > maxQty) {
                Swal.fire('Số lượng không hợp lệ', `Vui lòng chọn từ 1 đến ${maxQty}`, 'warning');
                return;
            }

            var btn = document.getElementById('btnAddToCart');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang thêm...';

            $.ajax({
                url: '@Url.Action("AddToCart", "Cart")',
                type: 'POST',
                data: { itemType: 'Part', itemId: partId, quantity: qty },
                success: function(res) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-cart-plus-fill me-2"></i> Thêm vào giỏ hàng';
                    if (res.success) {
                        updateNavbarCartCount(res.cartCount);
                        Swal.fire({
                            title: 'Đã thêm vào giỏ hàng!',
                            text: 'Bạn có muốn đi đến giỏ hàng chung để thanh toán?',
                            icon: 'success',
                            showCancelButton: true,
                            confirmButtonColor: '#ffc107',
                            cancelButtonColor: '#262626',
                            confirmButtonText: 'Đi đến giỏ hàng',
                            cancelButtonText: 'Tiếp tục mua sắm'
                        }).then((navResult) => {
                            if (navResult.isConfirmed) {
                                window.location.href = '@Url.Action("Index", "Cart")';
                            }
                        });
                    } else {
                        Swal.fire('Thất bại!', res.message, 'error');
                    }
                },
                error: function() {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-cart-plus-fill me-2"></i> Thêm vào giỏ hàng';
                    Swal.fire('Lỗi!', 'Đã xảy ra lỗi kết nối.', 'error');
                }
            });
        }

        function updateNavbarCartCount(count) {
            var badge = $('#navbarCartCount');
            if (badge.length) {
                badge.text(count);
                count > 0 ? badge.removeClass('d-none') : badge.addClass('d-none');
            }
        }
    </script>
}
