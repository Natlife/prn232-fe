@section Scripts {
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let currentPartImages = []; // List of uploaded image URLs for part edit modal

        $(document).ready(function() {
            // Restore saved active tab on page reload
            const savedTab = localStorage.getItem('partsActiveTab');
            if (savedTab) {
                const tabBtn = document.querySelector(`button[data-bs-target="${savedTab}"]`);
                if (tabBtn) {
                    const tabObj = bootstrap.Tab.getOrCreateInstance(tabBtn);
                    tabObj.show();
                }
            }

            // Save active tab on tab click
            $('button[data-bs-toggle="tab"]').on('shown.bs.tab', function(e) {
                const target = $(e.target).attr('data-bs-target');
                if (target) {
                    localStorage.setItem('partsActiveTab', target);
                }
            });
        });

        function filterPartsTable() {
            const term = $('#searchTerm').val().toLowerCase().trim();
            const cat = $('#filterCategory').val();

            $('#partsMainTable tbody tr').each(function() {
                const name = $(this).find('.part-name-cell').text().toLowerCase();
                const code = $(this).find('.part-code-cell').text().toLowerCase();
                const partCat = $(this).find('td:nth-child(3)').text().trim();

                const matchSearch = !term || name.includes(term) || code.includes(term);
                const matchCat = !cat || partCat.includes(cat);

                if (matchSearch && matchCat) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }

        // ========================================================
        // MULTI-IMAGE FILE UPLOAD FOR PART EDIT MODAL
        // ========================================================
        function handlePartImagesUpload(input) {
            if (!input.files || input.files.length === 0) return;

            const formData = new FormData();
            for (let i = 0; i < input.files.length; i++) {
                formData.append('files', input.files[i]);
            }

            Swal.fire({
                title: 'Đang tải hình ảnh lên...',
                text: 'Vui lòng chờ trong giây lát',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            $.ajax({
                url: '/Parts/UploadMultipleImages',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    Swal.close();
                    if (res.success && res.imageUrls) {
                        res.imageUrls.forEach(url => {
                            if (!currentPartImages.includes(url)) {
                                currentPartImages.push(url);
                            }
                        });
                        renderPartImagePreviews();
                        Swal.fire('Thành công', 'Đã tải lên ' + res.imageUrls.length + ' hình ảnh.', 'success');
                    } else {
                        Swal.fire('Thất bại', res.message || 'Lỗi tải ảnh', 'error');
                    }
                },
                error: function() {
                    Swal.close();
                    Swal.fire('Lỗi', 'Không thể tải tập tin lên máy chủ.', 'error');
                }
            });
        }

        function renderPartImagePreviews() {
            const container = $('#partImagePreviewList');
            container.empty();

            currentPartImages.forEach((url, idx) => {
                const box = $(`
                            <div class="img-preview-box">
                                <img src="${url}" alt="Preview ${idx + 1}" />
                                <button type="button" class="btn-remove-img" title="Xóa ảnh" onclick="removePartImageAt(${idx})">✕</button>
                            </div>
                        `);
                container.append(box);
            });

            $('#imageUrl').val(currentPartImages.join(','));
        }

        function removePartImageAt(index) {
            currentPartImages.splice(index, 1);
            renderPartImagePreviews();
        }

        // Open edit modal for Part
        function openEditModal(partId) {
            $('#modalError').addClass('d-none');
            $('#partForm')[0].reset();
            currentPartImages = [];
            renderPartImagePreviews();

            $.ajax({
                url: `/Parts/GetPartJson/${partId}`,
                type: 'GET',
                success: function(part) {
                    $('#partId').val(part.partId);
                    $('#partName').val(part.partName);
                    $('#partCode').val(part.partCode);
                    $('#categoryId').val(part.categoryId);
                    $('#brand').val(part.brand);
                    $('#price').val(part.price);
                    $('#currentQuantity').val(part.currentQuantity || part.quantity || 0);
                    $('#minStockLevel').val(part.minStockLevel || 5);
                    $('#maxStockLevel').val(part.maxStockLevel || 100);
                    $('#unitOfMeasure').val(part.unitOfMeasure || 'Cái');
                    $('#warehouseLocation').val(part.warehouseLocation || '');
                    $('#description').val(part.description || '');

                    // Parse existing ImageUrl (comma-separated)
                    if (part.imageUrl) {
                        currentPartImages = part.imageUrl.split(',').map(s => s.trim()).filter(s => s.length > 0);
                    } else {
                        currentPartImages = [];
                    }
                    renderPartImagePreviews();

                    const partModal = new bootstrap.Modal(document.getElementById('partModal'));
                    partModal.show();
                },
                error: function() {
                    Swal.fire('Lỗi', 'Không thể tải thông tin phụ tùng.', 'error');
                }
            });
        }

        // Save Part form
        $('#partForm').on('submit', function(e) {
            e.preventDefault();
            const btn = $('#btnSubmitPart');
            btn.prop('disabled', true).text('Đang lưu...');

            const payload = {
                PartId: parseInt($('#partId').val()),
                PartName: $('#partName').val().trim(),
                PartCode: $('#partCode').val().trim(),
                CategoryId: parseInt($('#categoryId').val()),
                Brand: $('#brand').val().trim(),
                Price: parseFloat($('#price').val()),
                CurrentQuantity: parseInt($('#currentQuantity').val()),
                MinStockLevel: parseInt($('#minStockLevel').val()),
                MaxStockLevel: parseInt($('#maxStockLevel').val()),
                UnitOfMeasure: $('#unitOfMeasure').val().trim(),
                WarehouseLocation: $('#warehouseLocation').val().trim(),
                ImageUrl: $('#imageUrl').val().trim(),
                Description: $('#description').val().trim()
            };

            $.ajax({
                url: '/Parts/Save',
                type: 'POST',
                data: payload,
                success: function(res) {
                    btn.prop('disabled', false).text('Lưu thông tin');
                    if (res.success) {
                        Swal.fire('Thành công!', res.message, 'success').then(() => location.reload());
                    } else {
                        $('#modalError').html(res.message).removeClass('d-none');
                    }
                },
                error: function() {
                    btn.prop('disabled', false).text('Lưu thông tin');
                    Swal.fire('Lỗi!', 'Lỗi kết nối máy chủ.', 'error');
                }
            });
        });

        // ========================================================
        // INVENTORY RECEIPT FLOWS & SINGLE IMAGE UPLOAD FROM LAPTOP
        // ========================================================
        let allSuppliersList = [];
        let supplierOptionsHtml = '<option value="">-- Chọn nhà cung cấp * --</option>';
        let categoryFilterOptionsHtml = '<option value="">-- Tất cả danh mục --</option>';
        let categoryOptionsHtml = '<option value="">-- Chọn danh mục * --</option>';

                @foreach (var cat in categories)
            {
                <text>categoryOptionsHtml += `<option value="@cat.CategoryId">@cat.CategoryName</option>`;</text>
        }

            function clearReceiptDate(btn) {
                const input = btn.closest('.input-group').querySelector('.receipt-expired');
                if (input) input.value = '';
            }

        function openInventoryReceiptModal() {
            const modal = new bootstrap.Modal(document.getElementById('inventoryReceiptModal'));
            modal.show();

            Swal.fire({
                title: 'Đang tải dữ liệu...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            fetch('http://localhost:5084/api/Suppliers')
                .then(res => res.json())
                .then(suppliers => {
                    allSuppliersList = suppliers;
                    supplierOptionsHtml = '<option value="">-- Chọn nhà cung cấp * --</option>';
                    allSuppliersList.forEach(s => {
                        if (s.status === 'Active') {
                            supplierOptionsHtml += `<option value="${s.supplierId}">${s.supplierName}</option>`;
                        }
                    });

                    return fetch('http://localhost:5084/api/Parts');
                })
                .then(res => res.json())
                .then(parts => {
                    allPartsCache = parts.value || parts;
                    Swal.close();
                    document.getElementById('receiptNotes').value = '';
                    document.getElementById('receiptItemsTableBody').innerHTML = '';
                    addReceiptItemRow();
                })
                .catch(err => {
                    Swal.close();
                    Swal.fire('Lỗi', 'Không thể tải dữ liệu: ' + err.message, 'error');
                });
        }

        function populateSearchDatalist(row) {
            const input = row.querySelector('.search-part-input');
            if (!input) return;
            const datalistId = input.getAttribute('list');
            const datalist = document.getElementById(datalistId);
            const parts = row.partsCache || allPartsCache || [];
            let html = '';
            parts.forEach(p => {
                if (p.status !== 'Inactive') {
                    html += `<option value="${p.partCode} - ${p.partName}">${p.partName} (Mã: ${p.partCode} | Tồn: ${p.quantity})</option>`;
                }
            });
            if (datalist) datalist.innerHTML = html;
        }

        function onPartInputFromList(inputEl) {
            const row = inputEl.closest('.receipt-item-row');
            const hiddenValInput = row.querySelector('.receipt-part-select-val');
            const val = inputEl.value.trim();
            const parts = row.partsCache || allPartsCache || [];

            const matched = parts.find(p => (p.partCode + ' - ' + p.partName) === val || p.partCode.toLowerCase() === val.toLowerCase());
            if (matched) {
                hiddenValInput.value = matched.partId;
                const priceInput = row.querySelector('.receipt-price');
                if (priceInput && (!priceInput.value || priceInput.value == 0)) {
                    priceInput.value = matched.price;
                }
            } else {
                hiddenValInput.value = '';
            }
        }

        function addReceiptItemRow() {
            const tbody = document.getElementById('receiptItemsTableBody');
            const currentIndex = tbody.querySelectorAll('.receipt-item-row').length;

            const tr = document.createElement('tr');
            tr.className = 'receipt-item-row';
            tr.setAttribute('data-index', currentIndex);
            tr.partsCache = allPartsCache;

            tr.innerHTML = `
                        <td class="align-top pt-3">
                            <div class="d-flex flex-column gap-2">
                                <button type="button" class="btn btn-xs btn-outline-primary fw-bold active btn-existing-mode text-nowrap" onclick="setRowMode(this, false)">
                                    <i class="bi bi-list-check me-1"></i> Chọn sẵn
                                </button>
                                <button type="button" class="btn btn-xs btn-outline-success fw-bold btn-new-mode text-nowrap" onclick="setRowMode(this, true)">
                                    <i class="bi bi-plus-circle me-1"></i> Phụ tùng mới
                                </button>
                            </div>
                            <input type="hidden" class="row-is-new-part" value="false" />
                        </td>
                        <td>
                            <!-- Chọn phụ tùng có sẵn -->
                            <div class="existing-part-container position-relative">
                                <label class="fw-bold mb-1" style="font-size: 11px;">Tên hoặc mã phụ tùng *</label>
                                <input type="text" class="form-control form-control-sm search-part-input" list="clientDatalist_${currentIndex}" placeholder="Gõ tên hoặc mã phụ tùng cần nhập..." oninput="onPartInputFromList(this)" />
                                <datalist id="clientDatalist_${currentIndex}"></datalist>
                                <input type="hidden" class="receipt-part-select-val" />
                            </div>

                            <!-- Tạo phụ tùng mới -->
                            <div class="new-part-container d-none border rounded p-3 bg-light shadow-xs mt-2" style="font-size: 11px; border-left: 3px solid #198754 !important;">
                                <div class="row g-2">
                                    <div class="col-md-12">
                                        <label class="fw-bold mb-1 text-success"><i class="bi bi-building me-1"></i> Nhà cung cấp *</label>
                                        <select class="form-select form-select-sm new-part-supplier">
                                            ${supplierOptionsHtml}
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="fw-bold mb-1">Tên phụ tùng mới *</label>
                                        <input type="text" class="form-control form-control-sm new-part-name" placeholder="Ví dụ: Lọc dầu Engine Max" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="fw-bold mb-1">Mã phụ tùng mới *</label>
                                        <input type="text" class="form-control form-control-sm new-part-code" placeholder="Ví dụ: PT-LOCDAU-01" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="fw-bold mb-1">Danh mục *</label>
                                        <select class="form-select form-select-sm new-part-category">
                                            ${categoryOptionsHtml}
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="fw-bold mb-1">Thương hiệu</label>
                                        <input type="text" class="form-control form-control-sm new-part-brand" placeholder="Toyota, Bosch..." />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="fw-bold mb-1">Giá bán ra (VNĐ) *</label>
                                        <input type="number" class="form-control form-control-sm new-part-price-sell" placeholder="0" min="0" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="fw-bold mb-1">Đơn vị tính</label>
                                        <input type="text" class="form-control form-control-sm new-part-uom" value="Cái" />
                                    </div>

                                    <div class="col-md-12 bg-white p-2 border rounded mt-2">
                                        <label class="fw-bold mb-1 text-primary d-flex align-items-center gap-1">
                                            <i class="bi bi-upload"></i> Tải hình ảnh phụ tùng từ laptop
                                        </label>
                                        <input type="file" class="form-control form-control-sm new-part-image-file" accept="image/*" onchange="uploadRowPartImage(this)" />
                                        <input type="hidden" class="new-part-image-url" />
                                        <div class="new-part-image-preview mt-2 d-none">
                                            <img src="" class="rounded border object-fit-cover" style="width:60px; height:60px;" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="align-top pt-3">
                            <input type="number" class="form-control form-control-sm receipt-qty" min="1" value="1" required />
                        </td>
                        <td class="align-top pt-3">
                            <input type="number" class="form-control form-control-sm receipt-price" min="0" placeholder="0" required />
                        </td>
                        <td class="align-top pt-3">
                            <div class="input-group input-group-sm">
                                <input type="date" class="form-control receipt-expired" />
                                <button type="button" class="btn btn-outline-secondary px-2" title="Xóa ngày" onclick="clearReceiptDate(this)">✕</button>
                            </div>
                        </td>
                        <td class="text-center align-top pt-3">
                            <button type="button" class="btn btn-link text-danger p-0" onclick="removeReceiptRow(this)"><i class="bi bi-trash-fill fs-5"></i></button>
                        </td>
                    `;

            tbody.appendChild(tr);
            populateSearchDatalist(tr);
        }

        // Upload image from laptop for single row in inventory receipt
        function uploadRowPartImage(input) {
            if (!input.files || input.files.length === 0) return;
            const file = input.files[0];
            const formData = new FormData();
            formData.append('file', file);

            const row = input.closest('.receipt-item-row');
            const hiddenUrl = row.querySelector('.new-part-image-url');
            const previewDiv = row.querySelector('.new-part-image-preview');
            const previewImg = previewDiv.querySelector('img');

            $.ajax({
                url: '/Parts/UploadImage',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    if (res.success && res.imageUrl) {
                        hiddenUrl.value = res.imageUrl;
                        previewImg.src = res.imageUrl;
                        previewDiv.classList.remove('d-none');
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể tải ảnh lên', 'error');
                    }
                },
                error: function() {
                    Swal.fire('Lỗi', 'Lỗi tải ảnh từ máy tính.', 'error');
                }
            });
        }

        function setRowMode(btn, isNew) {
            const row = btn.closest('.receipt-item-row');
            row.querySelector('.btn-existing-mode').classList.toggle('active', !isNew);
            row.querySelector('.btn-new-mode').classList.toggle('active', isNew);
            row.querySelector('.row-is-new-part').value = isNew;

            if (isNew) {
                row.querySelector('.existing-part-container').classList.add('d-none');
                row.querySelector('.new-part-container').classList.remove('d-none');
            } else {
                row.querySelector('.existing-part-container').classList.remove('d-none');
                row.querySelector('.new-part-container').classList.add('d-none');
            }
        }

        function removeReceiptRow(btn) {
            const tbody = document.getElementById('receiptItemsTableBody');
            if (tbody.querySelectorAll('.receipt-item-row').length > 1) {
                btn.closest('.receipt-item-row').remove();
            } else {
                Swal.fire('Nhắc nhở', 'Phải có ít nhất 1 dòng nhập kho.', 'warning');
            }
        }

        function submitInventoryReceipt() {
            const notes = $('#receiptNotes').val().trim();
            const rows = document.querySelectorAll('.receipt-item-row');
            const items = [];

            for (let row of rows) {
                const isNewPart = row.querySelector('.row-is-new-part').value === 'true';
                const quantity = parseInt(row.querySelector('.receipt-qty').value);
                const importPrice = parseFloat(row.querySelector('.receipt-price').value);
                const expiredVal = row.querySelector('.receipt-expired').value;

                if (isNaN(quantity) || quantity <= 0) {
                    Swal.fire('Nhắc nhở', 'Số lượng nhập phải lớn hơn 0.', 'warning');
                    return;
                }
                if (isNaN(importPrice) || importPrice < 0) {
                    Swal.fire('Nhắc nhở', 'Giá nhập không được âm.', 'warning');
                    return;
                }

                let itemDto = {
                    isNewPart: isNewPart,
                    quantity: quantity,
                    importPrice: importPrice,
                    expiredAt: expiredVal ? new Date(expiredVal).toISOString() : null
                };

                if (isNewPart) {
                    const supplierIdVal = row.querySelector('.new-part-supplier').value;
                    if (!supplierIdVal) {
                        Swal.fire('Nhắc nhở', 'Vui lòng chọn nhà cung cấp cho phụ tùng mới.', 'warning');
                        return;
                    }
                    const partName = row.querySelector('.new-part-name').value.trim();
                    const partCode = row.querySelector('.new-part-code').value.trim();
                    const categoryId = parseInt(row.querySelector('.new-part-category').value);
                    const brand = row.querySelector('.new-part-brand').value.trim();
                    const price = parseFloat(row.querySelector('.new-part-price-sell').value);
                    const uom = row.querySelector('.new-part-uom').value.trim();
                    const imageUrl = row.querySelector('.new-part-image-url').value.trim();

                    if (!partName || !partCode || isNaN(categoryId) || isNaN(price)) {
                        Swal.fire('Nhắc nhở', 'Vui lòng điền đầy đủ Tên, Mã, Danh mục và Giá bán cho phụ tùng mới.', 'warning');
                        return;
                    }

                    itemDto.supplierId = parseInt(supplierIdVal);
                    itemDto.newPart = {
                        categoryId: categoryId,
                        partName: partName,
                        partCode: partCode,
                        brand: brand || null,
                        price: price,
                        unitOfMeasure: uom || "Cái",
                        imageUrl: imageUrl || null
                    };
                } else {
                    const partIdVal = row.querySelector('.receipt-part-select-val').value;
                    if (!partIdVal) {
                        Swal.fire('Nhắc nhở', 'Vui lòng chọn tên hoặc mã phụ tùng từ danh sách.', 'warning');
                        return;
                    }
                    itemDto.partId = parseInt(partIdVal);
                    itemDto.supplierId = 0;
                }

                items.push(itemDto);
            }

            const saveBtn = $('#btnSaveReceipt');
            saveBtn.prop('disabled', true).text('Đang lưu...');

            $.ajax({
                url: '/Parts/CreateInventoryReceipt',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ notes: notes, items: items }),
                success: function(res) {
                    localStorage.setItem('partsActiveTab', '#inventory-tab-pane');
                    Swal.fire('Thành công', res.message || 'Lưu phiếu nhập kho thành công.', 'success').then(() => location.reload());
                },
                error: function(err) {
                    saveBtn.prop('disabled', false).html('<i class="bi bi-check-circle-fill me-1"></i> LƯU PHIẾU NHẬP');
                    let msg = 'Không thể lưu phiếu nhập';
                    if (err.responseJSON) {
                        msg = err.responseJSON.message || err.responseJSON.error || JSON.stringify(err.responseJSON);
                    } else if (err.responseText) {
                        msg = err.responseText;
                    }
                    Swal.fire('Thất bại', msg, 'error');
                }
            });
        }

        // ========================================================
        // CATEGORY & SUPPLIER MODAL HANDLERS
        // ========================================================
        function openAddCategoryModal() {
            $('#catId').val('0');
            $('#catName').val('');
            $('#catDesc').val('');
            $('#categoryModalTitle').text('Thêm danh mục mới');
            new bootstrap.Modal(document.getElementById('categoryModal')).show();
        }

        function openEditCategoryModal(id, name, desc) {
            $('#catId').val(id);
            $('#catName').val(name);
            $('#catDesc').val(desc);
            $('#categoryModalTitle').text('Chỉnh sửa danh mục');
            new bootstrap.Modal(document.getElementById('categoryModal')).show();
        }

        function saveCategoryForm(e) {
            e.preventDefault();
            const catId = parseInt($('#catId').val());
            const payload = {
                CategoryId: catId,
                CategoryName: $('#catName').val().trim(),
                Description: $('#catDesc').val().trim()
            };

            const targetUrl = catId > 0 ? `/Parts/UpdateCategory/${catId}` : '/Parts/CreateCategory';

            $.ajax({
                url: targetUrl,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function() {
                    localStorage.setItem('partsActiveTab', '#categories-tab-pane');
                    Swal.fire('Thành công', 'Lưu danh mục thành công.', 'success').then(() => location.reload());
                },
                error: function(err) {
                    Swal.fire('Lỗi', err.responseJSON?.message || 'Không thể lưu danh mục', 'error');
                }
            });
        }

        function openAddSupplierModal() {
            $('#supId').val('0');
            $('#supName').val('');
            $('#supContact').val('');
            $('#supPhone').val('');
            $('#supEmail').val('');
            $('#supAddress').val('');
