        function saveSupplierForm(e) {
            e.preventDefault();
            const supId = parseInt($('#supId').val());
            const payload = {
                SupplierId: supId,
                SupplierName: $('#supName').val().trim(),
                ContactName: $('#supContact').val().trim(),
                Phone: $('#supPhone').val().trim(),
                Email: $('#supEmail').val().trim(),
                Address: $('#supAddress').val().trim(),
                Status: $('#supStatus').val()
            };

            const targetUrl = supId > 0 ? `/Parts/UpdateSupplier/${supId}` : '/Parts/CreateSupplier';

            $.ajax({
                url: targetUrl,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function() {
                    localStorage.setItem('partsActiveTab', '#suppliers-tab-pane');
                    Swal.fire('Thành công', 'Lưu nhà cung cấp thành công.', 'success').then(() => location.reload());
                },
                error: function(err) {
                    Swal.fire('Lỗi', err.responseJSON?.message || 'Không thể lưu nhà cung cấp', 'error');
                }
            });
        }
    </script>
