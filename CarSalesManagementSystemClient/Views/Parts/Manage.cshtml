</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var partModal = new bootstrap.Modal(document.getElementById('partModal'));

        // Inventory Receipt flows
        var allSuppliersList = [];
        var receiptRowIndex = 0;
        let supplierOptionsHtml = '<option value="">-- Chọn nhà cung cấp * --</option>';
        let categoryFilterOptionsHtml = '<option value="">-- Tất cả danh mục --</option>';

        let categoryOptionsHtml = '<option value="">-- Chọn danh mục * --</option>';
        @foreach (var cat in categories)
        {
            <text>categoryOptionsHtml += `<option value="@cat.CategoryId">@cat.CategoryName</option>`;</text>
        }

        // Open Inventory Receipt Modal
        function openInventoryReceiptModal(preselectPartId) {
            const modalEl = document.getElementById('inventoryReceiptModal');
            if (!modalEl) return;
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();

            function resetAndInitRow() {
                const notes = document.getElementById('receiptNotes');
                if (notes) notes.value = '';
                const container = document.getElementById('receiptItemsContainer');
                if (container) container.innerHTML = '';
                addReceiptItemRow(preselectPartId);
            }

            if (allSuppliersList.length === 0) {
                fetch('http://localhost:5084/api/Suppliers')
                    .then(res => res.json())
                    .then(suppliers => {
                        allSuppliersList = suppliers;
                        supplierOptionsHtml = '<option value="">-- Chọn nhà cung cấp * --</option>';
                        allSuppliersList.forEach(s => {
                            if (s.status === 'Active') {
                                supplierOptionsHtml += `<option value="${s.supplierId}">${s.supplierName}</option>`;
                            }
                        });

                        categoryFilterOptionsHtml = '<option value="">-- Tất cả danh mục --</option>';
                        @foreach (var cat in categories)
                        {
                            <text>categoryFilterOptionsHtml += `<option value="@cat.CategoryId">@cat.CategoryName</option>`;</text>
                        }

                        resetAndInitRow();
                    })
                    .catch(err => {
                        Swal.fire('Lỗi', 'Không thể tải danh sách nhà cung cấp: ' + err.message, 'error');
                    });
            } else {
                resetAndInitRow();
            }
        }

        // Fetch parts list for a specific row based on row-level Supplier & Category filters
        function fetchPartsForRow(row, preselectPartId) {
            const supplierId = row.querySelector('.row-supplier-select')?.value || 0;
            const categoryId = row.querySelector('.row-category-filter')?.value || 0;
            
            const url = categoryId 
                ? `/Parts/GetFilteredParts?categoryId=${categoryId}&supplierId=${supplierId || 0}`
                : `/Parts/GetFilteredParts?categoryId=0&supplierId=${supplierId || 0}`;
            
            const valInput = row.querySelector('.receipt-part-select-val');
            if (valInput && !preselectPartId) valInput.value = '';
            
            fetch(url)
                .then(res => res.json())
                .then(parts => {
                    row.partsCache = parts;
                    populateSearchDropdownMenu(row);

                    if (preselectPartId) {
                        const target = parts.find(p => p.partId == preselectPartId);
                        if (target) {
                            const inputEl = row.querySelector('.search-part-input');
                            if (inputEl) {
                                inputEl.value = `${target.partCode} - ${target.partName}`;
                                onPartInputFromList(inputEl);
                            }
                        }
                    }
                })
                .catch(err => {
                    console.error("Lỗi tải phụ tùng cho dòng: ", err);
                    row.partsCache = [];
                });
        }

        function populateSearchDropdownMenu(row) {
            const input = row.querySelector('.search-part-input');
            if (!input) return;
            const datalistId = input.getAttribute('list');
            let datalist = datalistId ? document.getElementById(datalistId) : null;
            if (!datalist) {
                datalist = row.querySelector('.parts-datalist');
            }

            const parts = row.partsCache || [];
            let html = '';
            parts.forEach(p => {
                if (p.status !== 'Inactive') {
                    const valStr = `${p.partCode} - ${p.partName}`;
                    html += `<option value="${valStr}">${p.partName} (Mã: ${p.partCode} | Tồn: ${p.quantity} | Giá: ${p.price.toLocaleString()}đ)</option>`;
                }
            });
            if (datalist) {
                datalist.innerHTML = html;
            }
        }

        function onPartInputFromList(inputEl) {
            const row = inputEl.closest('.receipt-item-row');
            if (!row) return;

            const hiddenValInput = row.querySelector('.receipt-part-select-val');
            const val = inputEl.value.trim();
            const parts = row.partsCache || [];

            const matched = parts.find(p => 
                (p.partCode + ' - ' + p.partName) === val ||
                p.partCode.toLowerCase() === val.toLowerCase() ||
                p.partName.toLowerCase() === val.toLowerCase() ||
                (p.partName + ' (' + p.partCode + ')') === val
            );

            if (matched) {
                hiddenValInput.value = matched.partId;
                const priceInput = row.querySelector('.import-price-input') || row.querySelector('.receipt-price');
                if (priceInput && (!priceInput.value || priceInput.value == 0)) {
                    priceInput.value = matched.price;
                }
            } else {
                hiddenValInput.value = '';
            }
        }


        // Add a new item card to the receipt
        function addReceiptItemRow(preselectPartId) {
            const container = document.getElementById('receiptItemsContainer');
            const currentIndex = container.querySelectorAll('.receipt-item-row').length;


            const row = document.createElement('article');
            row.className = 'receipt-item-row';
            row.setAttribute('data-index', currentIndex);

            row.innerHTML = `
                <div class="receipt-item-row__header">
                    <div class="receipt-line-title">
                        <span class="receipt-line-number">${currentIndex + 1}</span>
                        <div>
                            <strong>Dòng phụ tùng</strong>
                            <small>Chọn nguồn hàng và thông tin nhập kho</small>
                        </div>
                    </div>
                    <button
                        type="button"
                        class="remove-line-btn"
                        onclick="removeReceiptRow(this)"
                        title="Xóa dòng"
                        aria-label="Xóa dòng">
                        <i class="bi bi-trash3"></i>
                    </button>
                </div>

                <div class="receipt-item-row__body">
                    <div class="receipt-source-panel">
                        <div class="panel-caption">
                            <i class="bi bi-truck"></i>
                            <span>Nguồn hàng</span>
                        </div>

                        <div class="field-group">
                            <label class="field-label">
                                Nhà cung cấp <span class="required-mark">*</span>
                            </label>
                            <select
                                class="app-select row-supplier-select"
                                name="Items[${currentIndex}].SupplierId"
                                required
                                onchange="fetchPartsForRow(this.closest('.receipt-item-row'))">
                                ${supplierOptionsHtml}
                            </select>
                        </div>

                        <div class="field-group mb-0">
                            <label class="field-label">
                                Lọc theo danh mục
                                <span class="field-label__optional">Tùy chọn</span>
                            </label>
                            <select
                                class="app-select row-category-filter"
                                onchange="fetchPartsForRow(this.closest('.receipt-item-row'))">
                                ${categoryFilterOptionsHtml}
                            </select>
                        </div>
                    </div>

                    <div class="receipt-product-panel">
                        <div class="product-panel-heading">
                            <div class="panel-caption mb-0">
                                <i class="bi bi-gear"></i>
                                <span>Thông tin phụ tùng</span>
                            </div>

                            <div class="mode-switch" role="group" aria-label="Chế độ chọn phụ tùng">
                                <button
                                    type="button"
                                    class="mode-switch__button btn-existing-mode active"
                                    onclick="setRowMode(this, false)">
                                    <i class="bi bi-search"></i>
                                    Chọn có sẵn
                                </button>
                                <button
                                    type="button"
                                    class="mode-switch__button btn-new-mode"
                                    onclick="setRowMode(this, true)">
                                    <i class="bi bi-plus-circle"></i>
                                    Tạo mới
                                </button>
                            </div>
                        </div>

                        <input
                            type="hidden"
                            class="row-is-new-part"
                            name="Items[${currentIndex}].IsNewPart"
                            value="false" />

                        <div class="existing-part-container position-relative">
                            <label class="field-label">Tìm và chọn phụ tùng <span class="required-mark">*</span></label>
                            <div class="searchable-select">
                                <i class="bi bi-search searchable-select__icon"></i>
                                <input
                                    type="text"
                                    class="search-part-input"
                                    list="partsDatalist_${currentIndex}"
                                    placeholder="Nhập tên hoặc mã phụ tùng..."
                                    onchange="onPartInputFromList(this)"
                                    oninput="onPartInputFromList(this)"
                                    autocomplete="off" />
                                <datalist id="partsDatalist_${currentIndex}" class="parts-datalist"></datalist>
                                <i class="bi bi-chevron-down searchable-select__arrow"></i>
                            </div>
                            <input
                                type="hidden"
                                class="receipt-part-select-val"
                                name="Items[${currentIndex}].PartId" />
                        </div>


                        <div class="new-part-container d-none">
                            <div class="new-part-banner">
                                <i class="bi bi-stars"></i>
                                <div>
                                    <strong>Tạo phụ tùng mới</strong>
                                    <span>Phụ tùng sẽ được tạo trước khi hệ thống ghi nhận giao dịch nhập kho.</span>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="field-label">Tên phụ tùng <span class="required-mark">*</span></label>
                                    <input type="text" class="app-input new-part-name" name="Items[${currentIndex}].NewPart.PartName" placeholder="Ví dụ: Kính chiếu hậu Vios" />
                                </div>
                                <div class="col-md-6">
                                    <label class="field-label">Mã phụ tùng <span class="required-mark">*</span></label>
                                    <input type="text" class="app-input new-part-code" name="Items[${currentIndex}].NewPart.PartCode" placeholder="Ví dụ: KCH-TOY-01" />
                                </div>
                                <div class="col-md-6">
                                    <label class="field-label">Danh mục <span class="required-mark">*</span></label>
                                    <select class="app-select new-part-category" name="Items[${currentIndex}].NewPart.CategoryId">
                                        ${categoryOptionsHtml}
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="field-label">Thương hiệu</label>
                                    <input type="text" class="app-input new-part-brand" name="Items[${currentIndex}].NewPart.Brand" placeholder="Ví dụ: Toyota OEM" />
                                </div>
                                <div class="col-md-4">
                                    <label class="field-label">Giá bán đề xuất <span class="required-mark">*</span></label>
                                    <div class="input-with-suffix">
                                        <input type="number" class="app-input new-part-price-sell" name="Items[${currentIndex}].NewPart.Price" placeholder="0" min="0" />
                                        <span>₫</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="field-label">Đơn vị tính</label>
                                    <input type="text" class="app-input new-part-uom" name="Items[${currentIndex}].NewPart.UnitOfMeasure" value="Cái" />
                                </div>
                                <div class="col-md-4">
                                    <label class="field-label">Bảo hành</label>
                                    <div class="input-with-suffix">
                                        <input type="number" class="app-input new-part-warranty" name="Items[${currentIndex}].NewPart.WarrantyMonths" value="0" min="0" />
                                        <span>tháng</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="field-label">Mức cảnh báo tối thiểu</label>
                                    <input type="number" class="app-input new-part-min" name="Items[${currentIndex}].NewPart.MinStockLevel" value="5" min="0" />
                                </div>
                                <div class="col-md-4">
                                    <label class="field-label">Sức chứa tối đa</label>
                                    <input type="number" class="app-input new-part-max" name="Items[${currentIndex}].NewPart.MaxStockLevel" value="100" min="1" />
                                </div>
                                <div class="col-md-4">
                                    <label class="field-label">Vị trí kho</label>
                                    <input type="text" class="app-input new-part-location" name="Items[${currentIndex}].NewPart.WarehouseLocation" placeholder="Ví dụ: Khu B - Kệ 2" />
                                </div>
                                <div class="col-12">
                                    <label class="field-label">Mô tả ngắn</label>
                                    <input type="text" class="app-input new-part-desc" name="Items[${currentIndex}].NewPart.Description" placeholder="Ghi chú thêm về phụ tùng..." />
                                </div>
                            </div>
                        </div>

                        <div class="receipt-values-grid">
                            <div class="field-group mb-0">
                                <label class="field-label">Số lượng <span class="required-mark">*</span></label>
                                <input
                                    type="number"
                                    class="app-input receipt-qty"
                                    name="Items[${currentIndex}].Quantity"
                                    min="1"
                                    value="1"
                                    required />
                            </div>

                            <div class="field-group mb-0">
                                <label class="field-label">Giá nhập <span class="required-mark">*</span></label>
                                <div class="input-with-suffix">
                                    <input
                                        type="number"
                                        class="app-input receipt-price"
                                        name="Items[${currentIndex}].ImportPrice"
                                        min="0"
                                        placeholder="0"
                                        required />
                                    <span>₫</span>
                                </div>
                            </div>

                            <div class="field-group mb-0">
                                <label class="field-label">
                                    Hạn sử dụng
                                    <span class="field-label__optional">Nếu có</span>
                                </label>
                                <input
                                    type="date"
                                    class="app-input receipt-expired"
                                    name="Items[${currentIndex}].ExpiredAt" />
                            </div>

                            <div class="line-subtotal-card">
                                <span>Thành tiền dòng</span>
                                <strong class="line-subtotal">0 ₫</strong>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            container.appendChild(row);
            fetchPartsForRow(row, preselectPartId);
            reindexRows();
            updateReceiptSummary();
        }


        // Toggle row edit modes
        function setRowMode(btn, isNew) {
            const row = btn.closest('.receipt-item-row');
            
            row.querySelector('.btn-existing-mode').classList.toggle('active', !isNew);
            row.querySelector('.btn-new-mode').classList.toggle('active', isNew);
            
            row.querySelector('.row-is-new-part').value = isNew;
            
            const existingPartContainer = row.querySelector('.existing-part-container');
            const newPartContainer = row.querySelector('.new-part-container');
            
            if (isNew) {
                existingPartContainer.classList.add('d-none');
                newPartContainer.classList.remove('d-none');
                row.querySelector('.receipt-part-select-val').value = "";
                row.querySelector('.search-part-input').value = "";
            } else {
                existingPartContainer.classList.remove('d-none');
                newPartContainer.classList.add('d-none');
                
                // Clear new part form inputs
                newPartContainer.querySelectorAll('input, select, textarea').forEach(el => {
                    if (el.tagName === 'SELECT') {
                        el.value = "";
                    } else if (el.classList.contains('new-part-uom')) {
                        el.value = "Cái";
                    } else if (el.classList.contains('new-part-min')) {
                        el.value = "5";
                    } else if (el.classList.contains('new-part-max')) {
                        el.value = "100";
                    } else if (el.classList.contains('new-part-warranty')) {
                        el.value = "0";
                    } else {
                        el.value = "";
                    }
                });
            }
        }

        // Reindex input fields sequentially
        function reindexRows() {
            const rows = document.querySelectorAll(".receipt-item-row");

            rows.forEach((row, index) => {
                row.setAttribute('data-index', index);

                const lineNumber = row.querySelector('.receipt-line-number');
                if (lineNumber) {
                    lineNumber.textContent = index + 1;
                }

                row.querySelectorAll("[name]").forEach(input => {
                    input.name = input.name.replace(/Items\[\d+\]/, `Items[${index}]`);
                });
            });
        }

        function formatCurrency(value) {
            return new Intl.NumberFormat('vi-VN').format(value || 0) + ' ₫';
        }

        function updateReceiptSummary() {
            const rows = document.querySelectorAll('.receipt-item-row');
            let grandTotal = 0;

            rows.forEach(row => {
                const quantity = parseInt(row.querySelector('.receipt-qty')?.value) || 0;
                const importPrice = parseFloat(row.querySelector('.receipt-price')?.value) || 0;
                const subtotal = quantity * importPrice;
                grandTotal += subtotal;

                const subtotalElement = row.querySelector('.line-subtotal');
                if (subtotalElement) {
                    subtotalElement.textContent = formatCurrency(subtotal);
                }
            });

            const lineCount = document.getElementById('receiptLineCount');
            const total = document.getElementById('receiptGrandTotal');

            if (lineCount) {
                lineCount.textContent = rows.length;
            }

            if (total) {
                total.textContent = formatCurrency(grandTotal);
            }
        }

        document.addEventListener('input', function (event) {
            if (event.target.matches('.receipt-qty, .receipt-price')) {
                updateReceiptSummary();
            }
        });

        // Remove row helper
        function removeReceiptRow(btn) {
            const container = document.getElementById('receiptItemsContainer');

            if (container.querySelectorAll('.receipt-item-row').length > 1) {
                btn.closest('.receipt-item-row').remove();
                reindexRows();
                updateReceiptSummary();
            } else {
                Swal.fire({
                    title: 'Không thể xóa dòng',
                    text: 'Phiếu nhập phải có ít nhất một phụ tùng.',
                    icon: 'info',
                    confirmButtonColor: '#2f7552'
                });
            }
        }

        // Submit Inventory Receipt
        function submitInventoryReceipt() {
            const notes = document.getElementById('receiptNotes').value.trim();
            const rows = document.querySelectorAll('.receipt-item-row');
            const items = [];
            
            // Check duplicates per supplier
            const supplierPartsMap = new Map();

            for (let row of rows) {
                const supplierIdVal = row.querySelector('.row-supplier-select').value;
                if (!supplierIdVal) {
                    Swal.fire('Nhắc nhở', 'Vui lòng chọn nhà cung cấp cho tất cả các hàng.', 'warning');
                    return;
                }
                const supplierId = parseInt(supplierIdVal);

                const isNewPart = row.querySelector('.row-is-new-part').value === 'true';
                const quantity = parseInt(row.querySelector('.receipt-qty').value);
                const importPrice = parseFloat(row.querySelector('.receipt-price').value);
                const expiredVal = row.querySelector('.receipt-expired').value;
                const expiredAt = expiredVal ? new Date(expiredVal).toISOString() : null;

                if (isNaN(quantity) || quantity <= 0) {
                    Swal.fire('Nhắc nhở', 'Số lượng phải lớn hơn 0.', 'warning');
                    return;
                }
                if (isNaN(importPrice) || importPrice < 0) {
                    Swal.fire('Nhắc nhở', 'Giá nhập không được âm.', 'warning');
                    return;
                }
                if (expiredVal && new Date(expiredVal).setHours(0,0,0,0) < new Date().setHours(0,0,0,0)) {
                    Swal.fire('Nhắc nhở', 'Hạn sử dụng không được nhỏ hơn ngày hiện tại.', 'warning');
                    return;
                }

                let itemDto = {
                    supplierId: supplierId,
                    isNewPart: isNewPart,
                    quantity: quantity,
                    importPrice: importPrice,
                    expiredAt: expiredAt
                };

                if (isNewPart) {
                    const partName = row.querySelector('.new-part-name').value.trim();
                    const partCode = row.querySelector('.new-part-code').value.trim();
                    const categoryId = parseInt(row.querySelector('.new-part-category').value);
                    const brand = row.querySelector('.new-part-brand').value.trim();
                    const price = parseFloat(row.querySelector('.new-part-price-sell').value);
                    const uom = row.querySelector('.new-part-uom').value.trim();
                    const warranty = parseInt(row.querySelector('.new-part-warranty').value) || 0;
                    const minLvl = parseInt(row.querySelector('.new-part-min').value) || 5;
                    const maxLvl = parseInt(row.querySelector('.new-part-max').value) || 100;
                    const location = row.querySelector('.new-part-location').value.trim();
                    const desc = row.querySelector('.new-part-desc').value.trim();

                    if (!partName || !partCode || isNaN(categoryId) || isNaN(price)) {
                        Swal.fire('Nhắc nhở', 'Vui lòng điền đầy đủ Tên, Mã, Danh mục và Giá bán ra cho tất cả các phụ tùng mới.', 'warning');
                        return;
                    }
                    if (price < 0) {
                        Swal.fire('Nhắc nhở', 'Giá bán ra của phụ tùng mới không được âm.', 'warning');
                        return;
                    }
                    if (minLvl < 0 || maxLvl <= 0 || minLvl > maxLvl) {
                        Swal.fire('Nhắc nhở', 'Hạn mức tồn kho không hợp lệ (Min <= Max, Max > 0).', 'warning');
                        return;
                    }

                    itemDto.partId = null;
                    itemDto.newPart = {
                        categoryId: categoryId,
                        partName: partName,
                        partCode: partCode,
                        brand: brand || null,
                        price: price,
                        minStockLevel: minLvl,
                        maxStockLevel: maxLvl,
                        unitOfMeasure: uom || "Cái",
                        warehouseLocation: location || null,
                        warrantyMonths: warranty,
                        description: desc || null
                    };
                } else {
                    const partIdVal = row.querySelector('.receipt-part-select-val').value;
                    if (!partIdVal) {
                        Swal.fire('Nhắc nhở', 'Vui lòng chọn phụ tùng cho tất cả các hàng.', 'warning');
                        return;
                    }
                    const partId = parseInt(partIdVal);

                    if (!supplierPartsMap.has(supplierId)) {
                        supplierPartsMap.set(supplierId, new Set());
                    }
                    const selectedPartIds = supplierPartsMap.get(supplierId);

                    if (selectedPartIds.has(partId)) {
                        const partText = row.querySelector('.search-part-input').value;
                        Swal.fire('Nhắc nhở', `Phụ tùng '${partText}' đã có trong phiếu nhập cho nhà cung cấp này. Vui lòng cập nhật số lượng ở dòng hiện tại.`, 'warning');
                        return;
                    }
                    selectedPartIds.add(partId);
                    itemDto.partId = partId;
                    itemDto.newPart = null;
                }

                items.push(itemDto);
            }

            const payload = {
                notes: notes,
                items: items
            };

            const saveBtn = document.getElementById('btnSaveReceipt');
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang lưu...';

            fetch('/Parts/CreateInventoryReceipt', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
            .then(res => {
                if (!res.ok) {
                    return res.json().then(err => { throw new Error(err.message || 'Lỗi lưu phiếu nhập kho'); });
                }
                return res.json();
            })
            .then(data => {
                Swal.fire({
                    title: 'Thành công!',
                    text: data.message || 'Tạo phiếu nhập kho thành công.',
                    icon: 'success',
                    confirmButtonColor: '#ffc107'
                }).then(() => {
                    location.reload();
                });
            })
            .catch(err => {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> LƯU PHIẾU NHẬP';
                Swal.fire('Thất bại', err.message, 'error');
            });
        }

        // Admin Modals actions
        function openAddCategoryModal() {
            const modal = new bootstrap.Modal(document.getElementById('addCategoryModal'));
            modal.show();
        }

        function submitAddCategory(e) {
            e.preventDefault();
            const name = document.getElementById('newCatName').value.trim();
            const desc = document.getElementById('newCatDesc').value.trim();

            const payload = {
                categoryName: name,
                description: desc
            };

            fetch('/Parts/CreateCategory', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
            .then(res => {
                if (!res.ok) {
                    return res.json().then(err => { throw new Error(err.message || 'Lỗi thêm danh mục'); });
                }
                return res.json();
            })
            .then(data => {
                Swal.fire('Thành công', 'Thêm danh mục mới thành công!', 'success').then(() => {
                    location.reload();
                });
            })
            .catch(err => {
                Swal.fire('Thất bại', err.message, 'error');
            });
        }

        function openAddSupplierModal() {
            const modal = new bootstrap.Modal(document.getElementById('addSupplierModal'));
            modal.show();
        }

        function submitAddSupplier(e) {
            e.preventDefault();
            const name = document.getElementById('newSupName').value.trim();
            const contact = document.getElementById('newSupContact').value.trim();
            const phone = document.getElementById('newSupPhone').value.trim();
            const email = document.getElementById('newSupEmail').value.trim();
            const address = document.getElementById('newSupAddress').value.trim();

            const payload = {
                supplierName: name,
                contactName: contact,
                phone: phone,
                email: email,
                address: address,
                status: 'Active'
            };

            fetch('/Parts/CreateSupplier', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
            .then(res => {
                if (!res.ok) {
                    return res.json().then(err => { throw new Error(err.message || 'Lỗi thêm nhà cung cấp'); });
                }
                return res.json();
            })
            .then(data => {
                Swal.fire('Thành công', 'Thêm nhà cung cấp mới thành công!', 'success').then(() => {
                    location.reload();
                });
            })
            .catch(err => {
                Swal.fire('Thất bại', err.message, 'error');
            });
        }

        var currentEditingPart = null;
        var inventoryAdjustmentModalEl = document.getElementById('inventoryAdjustmentModal');
        var inventoryAdjustmentModal = inventoryAdjustmentModalEl ? new bootstrap.Modal(inventoryAdjustmentModalEl) : null;

        function openAddModal() {
            currentEditingPart = null;
            $('#modalError').addClass('d-none');
            $('#partForm')[0].reset();
            $('#partId').val('0');
            $('#partModalLabel').text('THÊM PHỤ TÙNG MỚI');

            $('#partCode').prop('readonly', false);
            $('#partCodeLockBadge').addClass('d-none');
            $('#partCodeNotice').addClass('d-none');
            $('#stockReadOnlySection').addClass('d-none');

            partModal.show();
        }

        function openEditModal(partId) {
            $('#modalError').addClass('d-none');
            $('#partForm')[0].reset();

            $.ajax({
                url: '/Parts/GetPartJson/' + partId,
                type: 'GET',
                success: function(part) {
                    currentEditingPart = part;
                    $('#partId').val(part.partId);
                    $('#partName').val(part.partName);
                    $('#partCode').val(part.partCode);
                    $('#categoryId').val(part.categoryId);
                    $('#brand').val(part.brand || '');
                    $('#price').val(part.price);
                    $('#minStockLevel').val(part.minStockLevel || 5);
                    $('#maxStockLevel').val(part.maxStockLevel || 100);
                    $('#unitOfMeasure').val(part.unitOfMeasure || 'Cái');
                    $('#warehouseLocation').val(part.warehouseLocation || '');
                    $('#warrantyMonths').val(part.warrantyMonths || 0);
                    $('#status').val(part.status || 'Available');
                    $('#imageUrl').val(part.imageUrl || '');
                    $('#description').val(part.description || '');

                    // Lock PartCode if transactions exist
                    if (!part.canEditPartCode) {
                        $('#partCode').prop('readonly', true);
                        $('#partCodeLockBadge').removeClass('d-none');
                        $('#partCodeNotice').removeClass('d-none');
                    } else {
                        $('#partCode').prop('readonly', false);
                        $('#partCodeLockBadge').addClass('d-none');
                        $('#partCodeNotice').addClass('d-none');
                    }

                    // Display Read-only Stock Card
                    $('#stockReadOnlySection').removeClass('d-none');
                    $('#displayStockQty').text(part.currentQuantity);
                    $('#displayStockUnit').text(part.unitOfMeasure || 'Cái');
                    $('#displayMinStock').text(part.minStockLevel || 5);
                    $('#displayMaxStock').text(part.maxStockLevel || 100);

                    // Badge logic
                    var badgeEl = $('#displayStockBadge');
                    var now = new Date();
                    var expired = part.currentExpiredAt ? new Date(part.currentExpiredAt) : null;

                    if (expired && expired < now) {
                        badgeEl.attr('class', 'badge bg-danger ms-2').html('<i class="bi bi-exclamation-triangle-fill me-1"></i> Đã hết hạn');
                    } else if (part.currentQuantity <= 0) {
                        badgeEl.attr('class', 'badge bg-warning text-dark ms-2').text('Hết hàng');
                    } else if (part.status === 'Inactive') {
                        badgeEl.attr('class', 'badge bg-secondary ms-2').text('Ngừng bán');
                    } else {
                        badgeEl.attr('class', 'badge bg-success ms-2').text('Còn hàng');
                    }

                    if (part.currentExpiredAt) {
                        var d = new Date(part.currentExpiredAt);
                        var formattedDate = String(d.getDate()).padStart(2, '0') + '/' + String(d.getMonth() + 1).padStart(2, '0') + '/' + d.getFullYear();
                        $('#displayExpiredAt').text(formattedDate);
                    } else {
                        $('#displayExpiredAt').text('Chưa thiết lập');
                    }

                    $('#partModalLabel').text('CẬP NHẬT THÔNG TIN PHỤ TÙNG');
                    partModal.show();
                },
                error: function() {
                    Swal.fire('Lỗi!', 'Không thể tải thông tin phụ tùng.', 'error');
                }
            });
        }

        function triggerImportFromEdit() {
            var selectedId = currentEditingPart ? currentEditingPart.partId : null;
            partModal.hide();
            if (typeof openInventoryReceiptModal === 'function') {
                openInventoryReceiptModal(selectedId);
            }
        }


        function triggerAdjustFromEdit() {
            if (!currentEditingPart) return;
            partModal.hide();
            $('#adjustmentError').addClass('d-none');
            $('#adjustmentForm')[0].reset();

            $('#adjustPartId').val(currentEditingPart.partId);
            $('#adjustPartTitle').text('Phụ tùng: ' + currentEditingPart.partName + ' (' + currentEditingPart.partCode + ')');
            $('#adjustCurrentQty').text(currentEditingPart.currentQuantity);
            $('#adjustUnit').text(currentEditingPart.unitOfMeasure || 'Cái');

            if (inventoryAdjustmentModal) {
                inventoryAdjustmentModal.show();
            }
        }

        $('#partForm').on('submit', function(e) {
            e.preventDefault();
            var form = $(this);
            if (form.valid && !form.valid()) return;

            var btn = $('#btnSubmit');
            btn.prop('disabled', true).text('Đang lưu...');

            $.ajax({
                url: '/Parts/Save',
                type: 'POST',
                data: form.serialize(),
                success: function(res) {
                    btn.prop('disabled', false).text('Lưu thay đổi');
                    if (res.success) {
                        partModal.hide();
                        Swal.fire({
                            title: 'Thành công!',
                            text: res.message,
                            icon: 'success',
                            confirmButtonColor: '#ffc107'
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        $('#modalError').html(res.message).removeClass('d-none');
                    }
                },
                error: function() {
                    btn.prop('disabled', false).text('Lưu thay đổi');
                    Swal.fire('Lỗi!', 'Lỗi kết nối máy chủ.', 'error');
                }
            });
        });

        $('#adjustmentForm').on('submit', function(e) {
            e.preventDefault();
            var form = $(this);
            var btn = $('#btnSubmitAdjustment');
            btn.prop('disabled', true).text('Đang xử lý...');

            $.ajax({
                url: '/Parts/AdjustInventory',
                type: 'POST',
                data: form.serialize(),
                success: function(res) {
                    btn.prop('disabled', false).text('Xác nhận điều chỉnh');
                    if (res.success) {
                        if (inventoryAdjustmentModal) inventoryAdjustmentModal.hide();
                        Swal.fire({
                            title: 'Thành công!',
                            text: res.message,
                            icon: 'success',
                            confirmButtonColor: '#ffc107'
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        $('#adjustmentError').html(res.message).removeClass('d-none');
                    }
                },
                error: function() {
                    btn.prop('disabled', false).text('Xác nhận điều chỉnh');
                    Swal.fire('Lỗi!', 'Lỗi kết nối máy chủ.', 'error');
                }
            });
        });


        function confirmResell(partId, name) {
            Swal.fire({
                title: 'Bán lại phụ tùng',
                text: "Nhập số lượng bán lại cho phụ tùng '" + name + "':",
                input: 'number',
                inputAttributes: {
                    min: 1,
                    step: 1
                },
                inputValue: 1,
                showCancelButton: true,
                confirmButtonColor: '#198754',
                cancelButtonColor: '#262626',
                confirmButtonText: 'Xác nhận',
                cancelButtonText: 'Hủy',
                inputValidator: (value) => {
                    if (!value || parseInt(value) <= 0) {
                        return 'Vui lòng nhập số lượng lớn hơn 0!'
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    var qty = parseInt(result.value);
                    $.ajax({
                        url: '/Parts/Resell',
                        type: 'POST',
                        data: { id: partId, quantity: qty },
                        success: function(res) {
                            if (res.success) {
                                Swal.fire({
                                    title: 'Thành công!',
                                    text: res.message,
                                    icon: 'success',
                                    confirmButtonColor: '#ffc107'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Thất bại!', res.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Lỗi!', 'Lỗi kết nối mạng.', 'error');
                        }
                    });
                }
            });
        }

        function confirmDiscontinue(partId, name) {
            Swal.fire({
                title: 'Xác nhận ngưng bán?',
                text: "Bạn có chắc chắn muốn ngưng bán phụ tùng '" + name + "'? Khách hàng sẽ không thể mua sản phẩm này nữa!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ffc107',
                cancelButtonColor: '#262626',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Parts/Discontinue/' + partId,
                        type: 'POST',
                        success: function(res) {
                            if (res.success) {
                                Swal.fire({
                                    title: 'Thành công!',
                                    text: res.message,
                                    icon: 'success',
                                    confirmButtonColor: '#ffc107'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Thất bại!', res.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Lỗi!', 'Lỗi kết nối mạng.', 'error');
                        }
                    });
                }
            });
        }

        // Live Search & Category Filtering
        function filterPartsTable() {
            const searchVal = document.getElementById('searchTerm').value.toLowerCase().trim();
            const catVal = document.getElementById('filterCategory').value.toLowerCase().trim();
            const rows = document.querySelectorAll('table tbody tr');
            
            rows.forEach(row => {
                const nameCell = row.querySelector('.part-name-cell');
                const codeCell = row.querySelector('.part-code-cell');
                const catCell = row.querySelector('.part-cat-cell');
                
                if (!nameCell) return; // Skip if empty row
                
                const nameText = nameCell.textContent.toLowerCase();
                const codeText = codeCell.textContent.toLowerCase();
                const catText = catCell.textContent.toLowerCase();
                
                const matchesSearch = nameText.includes(searchVal) || codeText.includes(searchVal);
                const matchesCategory = !catVal || catText.includes(catVal);
                
                if (matchesSearch && matchesCategory) {
                    row.removeAttribute('style'); // Show row
                } else {
                    row.setAttribute('style', 'display: none !important;'); // Hide row
                }
            });
        }
    </script>
}

<style>
    :root {
        --app-primary: #2f7552;
        --app-primary-dark: #245c41;
        --app-primary-soft: #edf7f1;
        --app-ink: #17211b;
        --app-muted: #6f7c73;
        --app-border: #dde6df;
        --app-surface: #ffffff;
        --app-background: #f4f7f5;
        --app-danger: #c84343;
        --app-warning: #b97816;
        --app-shadow: 0 12px 34px rgba(26, 55, 39, 0.08);
    }

    .parts-admin-page {
        min-height: 100vh;
        background:
            radial-gradient(circle at top right, rgba(47, 117, 82, 0.08), transparent 28rem),
            var(--app-background);
        color: var(--app-ink);
        font-family: 'Outfit', sans-serif;
    }

