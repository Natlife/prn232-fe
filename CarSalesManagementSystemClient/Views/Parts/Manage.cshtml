@model IEnumerable<CarSalesManagementSystemClient.Models.PartViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Phụ tùng - Admin";
    var categories = ViewBag.Categories as IEnumerable<CarSalesManagementSystemClient.Models.PartCategoryViewModel> ?? new List<PartCategoryViewModel>();
}

<!-- Google Fonts Outfit & Bootstrap Icons -->
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="parts-admin-page">
    <div class="container-fluid px-3 px-lg-4 py-4 py-xl-5">

        <!-- Page hero -->
        <section class="page-hero mb-4">
            <div class="page-hero__content">
                <div class="page-hero__eyebrow">
                    <span class="page-hero__dot"></span>
                    INVENTORY CONTROL
                </div>
                <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-end gap-4">
                    <div>
                        <h1 class="page-hero__title">Quản lý phụ tùng</h1>
                        <p class="page-hero__subtitle mb-0">
                            Theo dõi danh mục, tồn kho, nhà cung cấp và các hoạt động nhập kho trong một màn hình.
                        </p>
                    </div>

                    <div class="page-actions">
                        @if (User.IsInRole("Admin"))
                        {
                            <button type="button" class="btn app-btn app-btn--secondary" onclick="openAddCategoryModal()">
                                <i class="bi bi-folder-plus"></i>
                                <span>Thêm danh mục</span>
                            </button>
                            <button type="button" class="btn app-btn app-btn--secondary" onclick="openAddSupplierModal()">
                                <i class="bi bi-building-add"></i>
                                <span>Thêm nhà cung cấp</span>
                            </button>
                        }
                        <button type="button" class="btn app-btn app-btn--primary" onclick="openInventoryReceiptModal()">
                            <i class="bi bi-box-arrow-in-down"></i>
                            <span>Tạo phiếu nhập</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="app-alert app-alert--danger mb-4" role="alert">
                <span class="app-alert__icon"><i class="bi bi-exclamation-triangle"></i></span>
                <div>
                    <strong>Không thể tải dữ liệu</strong>
                    <div>@ViewBag.ErrorMessage</div>
                </div>
            </div>
        }

        <!-- Overview -->
        <section class="row g-3 g-xl-4 mb-4">
            <div class="col-sm-6 col-xl-3">
                <div class="metric-card h-100">
                    <div class="metric-card__icon metric-card__icon--blue">
                        <i class="bi bi-grid"></i>
                    </div>
                    <div class="metric-card__body">
                        <span class="metric-card__label">Tổng phụ tùng</span>
                        <strong class="metric-card__value">@Model.Count()</strong>
                        <span class="metric-card__meta">Mã hàng trong hệ thống</span>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="metric-card h-100">
                    <div class="metric-card__icon metric-card__icon--green">
                        <i class="bi bi-boxes"></i>
                    </div>
                    <div class="metric-card__body">
                        <span class="metric-card__label">Tổng tồn kho</span>
                        <strong class="metric-card__value">@Model.Sum(p => p.Quantity)</strong>
                        <span class="metric-card__meta">Tổng số đơn vị hiện có</span>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="metric-card h-100">
                    <div class="metric-card__icon metric-card__icon--amber">
                        <i class="bi bi-exclamation-circle"></i>
                    </div>
                    <div class="metric-card__body">
                        <span class="metric-card__label">Sắp hết hàng</span>
                        <strong class="metric-card__value">@Model.Count(p => p.Quantity <= p.MinStockLevel && p.Status == "Available")</strong>
                        <span class="metric-card__meta">Đã chạm mức cảnh báo</span>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="metric-card h-100">
                    <div class="metric-card__icon metric-card__icon--red">
                        <i class="bi bi-pause-circle"></i>
                    </div>
                    <div class="metric-card__body">
                        <span class="metric-card__label">Ngưng kinh doanh</span>
                        <strong class="metric-card__value">@Model.Count(p => p.Status == "Inactive")</strong>
                        <span class="metric-card__meta">Không hiển thị cho khách hàng</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Toolbar -->
        <section class="content-card mb-4">
            <div class="content-card__body">
                <div class="toolbar-grid">
                    <div class="search-control">
                        <i class="bi bi-search"></i>
                        <input
                            type="search"
                            id="searchTerm"
                            placeholder="Tìm theo tên hoặc mã phụ tùng..."
                            oninput="filterPartsTable()" />
                    </div>

                    <div class="select-control">
                        <i class="bi bi-funnel"></i>
                        <select id="filterCategory" onchange="filterPartsTable()">
                            <option value="">Tất cả danh mục</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.CategoryName">@cat.CategoryName</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </section>

        <!-- Parts table -->
        <section class="content-card content-card--table mb-5">
            <div class="content-card__header">
                <div>
                    <h2 class="content-card__title">Danh sách phụ tùng</h2>
                    <p class="content-card__subtitle mb-0">Chọn một phụ tùng để xem lịch sử nhập, xuất và điều chỉnh kho.</p>
                </div>
                <span class="result-count">@Model.Count() mặt hàng</span>
            </div>

            <div class="table-responsive">
                <table class="table parts-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Phụ tùng</th>
                            <th>Mã sản phẩm</th>
                            <th>Danh mục</th>
                            <th>Thương hiệu</th>
                            <th>Giá bán</th>
                            <th>Tồn kho</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="empty-state">
                                        <span class="empty-state__icon"><i class="bi bi-box-seam"></i></span>
                                        <h3>Chưa có phụ tùng</h3>
                                        <p>Hãy tạo phiếu nhập hoặc thêm dữ liệu phụ tùng để bắt đầu quản lý kho.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var part in Model)
                            {
                                var displayImageUrl = string.IsNullOrWhiteSpace(part.ImageUrl)
                                    ? "https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=100&q=80"
                                    : part.ImageUrl;

                                <tr>
                                    <td class="ps-4">
                                        <a href="/Parts/History/@part.PartId" class="part-cell text-decoration-none" title="Xem lịch sử nhập xuất">
                                            <img src="@displayImageUrl" alt="@part.PartName" class="part-cell__image" />
                                            <div class="part-cell__info">
                                                <strong class="part-name-cell">@part.PartName</strong>
                                                <span>@(string.IsNullOrWhiteSpace(part.WarehouseLocation) ? "Chưa cập nhật vị trí kho" : part.WarehouseLocation)</span>
                                            </div>
                                        </a>
                                    </td>
                                    <td>
                                        <a href="/Parts/History/@part.PartId" class="part-code part-code-cell text-decoration-none">
                                            @part.PartCode
                                        </a>
                                    </td>
                                    <td>
                                        <span class="category-chip part-cat-cell">@part.Category?.CategoryName</span>
                                    </td>
                                    <td class="text-body-secondary fw-medium">@part.Brand</td>
                                    <td>
                                        <strong class="price-text">@part.Price.ToString("N0") ₫</strong>
                                    </td>
                                    <td>
                                        @if (part.Quantity <= part.MinStockLevel)
                                        {
                                            <div class="stock-value stock-value--low">
                                                <span>@part.Quantity</span>
                                                <small>Min: @part.MinStockLevel</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="stock-value">
                                                <span>@part.Quantity</span>
                                                <small>Min: @part.MinStockLevel</small>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (part.Status == "Available" && part.Quantity > 0)
                                        {
                                            <span class="status-pill status-pill--success">
                                                <span></span>Còn hàng
                                            </span>
                                        }
                                        else if (part.Status == "OutOfStock" || part.Quantity <= 0)
                                        {
                                            <span class="status-pill status-pill--warning">
                                                <span></span>Hết hàng
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-pill status-pill--danger">
                                                <span></span>Ngưng bán
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <button
                                            type="button"
                                            class="icon-btn"
                                            onclick="openEditModal(@part.PartId)"
                                            title="Chỉnh sửa phụ tùng"
                                            aria-label="Chỉnh sửa phụ tùng">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

<!-- Bootstrap CRUD Modal -->
<!-- Bootstrap CRUD / Edit Modal -->
<div class="modal fade" id="partModal" tabindex="-1" aria-labelledby="partModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header bg-dark text-white py-3">
                <div>
                    <h5 class="modal-title fw-bold" id="partModalLabel">CẬP NHẬT THÔNG TIN PHỤ TÙNG</h5>
                    <p class="text-white-50 mb-0 small">Chỉnh sửa thông tin sản phẩm và cấu hình quản lý kho</p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="modalError" class="alert alert-danger d-none"></div>
                <form id="partForm">
                    <input type="hidden" name="PartId" id="partId" value="0" />
                    
                    <!-- SECTION 1: THÔNG TIN CƠ BẢN -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary text-uppercase border-bottom pb-2 mb-3">
                            <i class="bi bi-info-circle me-1"></i> THÔNG TIN CƠ BẢN
                        </h6>
                        
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Tên phụ tùng <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="PartName" id="partName" required maxlength="150" placeholder="VD: Lốp xe Michelin Pilot Sport 4" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold d-flex justify-content-between">
                                    <span>Mã phụ tùng <span class="text-danger">*</span></span>
                                    <span id="partCodeLockBadge" class="badge bg-secondary d-none"><i class="bi bi-lock-fill"></i> Đã khóa</span>
                                </label>
                                <input type="text" class="form-control" name="PartCode" id="partCode" required maxlength="50" placeholder="VD: PT-MIC-PS4" />
                                <small id="partCodeNotice" class="text-muted d-block mt-1 d-none" style="font-size: 11px;">
                                    <i class="bi bi-info-circle me-1"></i> Mã phụ tùng không thể thay đổi sau khi đã phát sinh giao dịch kho.
                                </small>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                                <select class="form-select" name="CategoryId" id="categoryId" required>
                                    <option value="">-- Chọn danh mục --</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.CategoryId">@cat.CategoryName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Thương hiệu / Hãng</label>
                                <input type="text" class="form-control" name="Brand" id="brand" maxlength="100" placeholder="VD: Michelin, Bosch..." />
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Đơn vị tính <span class="text-danger">*</span></label>
                                <select class="form-select" name="UnitOfMeasure" id="unitOfMeasure">
                                    <option value="Cái">Cái</option>
                                    <option value="Bộ">Bộ</option>
                                    <option value="Lít">Lít</option>
                                    <option value="Hộp">Hộp</option>
                                    <option value="Cuộn">Cuộn</option>
                                    <option value="Chiếc">Chiếc</option>
                                    <option value="Kg">Kg</option>
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label fw-bold">URL hình ảnh</label>
                                <input type="url" class="form-control" name="ImageUrl" id="imageUrl" maxlength="500" placeholder="https://..." />
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: GIÁ BÁN VÀ CẤU HÌNH KHO -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary text-uppercase border-bottom pb-2 mb-3">
                            <i class="bi bi-gear-wide-connected me-1"></i> GIÁ BÁN VÀ CẤU HÌNH KHO
                        </h6>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Giá bán (VND) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="Price" id="price" required min="0" max="1000000000" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Bảo hành (tháng)</label>
                                <input type="number" class="form-control" name="WarrantyMonths" id="warrantyMonths" min="0" max="120" placeholder="VD: 12" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Mức cảnh báo tối thiểu <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="MinStockLevel" id="minStockLevel" required min="0" max="100000" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Sức chứa tối đa <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="MaxStockLevel" id="maxStockLevel" required min="1" max="100000" />
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Vị trí kho</label>
                                <input type="text" class="form-control" name="WarehouseLocation" id="warehouseLocation" maxlength="100" placeholder="VD: Khu A - Kệ 3" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Trạng thái kinh doanh</label>
                                <select class="form-select" name="Status" id="status">
                                    <option value="Available">Đang kinh doanh (Available)</option>
                                    <option value="Inactive">Ngừng kinh doanh (Inactive)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3: TỒN KHO HIỆN TẠI (CHỈ ĐỌC / CARD) -->
                    <div class="mb-4" id="stockReadOnlySection">
                        <h6 class="fw-bold text-primary text-uppercase border-bottom pb-2 mb-3">
                            <i class="bi bi-box-seam me-1"></i> TỒN KHO HIỆN TẠI
                        </h6>

                        <div class="card border-0 bg-light rounded-3 p-3 shadow-sm">
                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="fs-3 fw-bold text-dark" id="displayStockQty">0</span>
                                        <span class="fs-6 text-secondary" id="displayStockUnit">Cái</span>
                                        <span id="displayStockBadge" class="badge bg-success ms-2">Còn hàng</span>
                                    </div>
                                    <div class="text-secondary small">
                                        <span>Mức tối thiểu: <strong id="displayMinStock">10</strong></span>
                                        <span class="mx-2">|</span>
                                        <span>Sức chứa tối đa: <strong id="displayMaxStock">100</strong></span>
                                        <span class="mx-2">|</span>
                                        <span>Hạn sử dụng: <strong id="displayExpiredAt">Chưa thiết lập</strong></span>
                                    </div>
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-success fw-bold text-white px-3 btn-sm" onclick="triggerImportFromEdit()">
                                        <i class="bi bi-box-arrow-in-down me-1"></i> Nhập thêm hàng
                                    </button>
                                    <button type="button" class="btn btn-outline-warning fw-bold text-dark px-3 btn-sm" onclick="triggerAdjustFromEdit()">
                                        <i class="bi bi-sliders me-1"></i> Điều chỉnh tồn kho
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 4: MÔ TẢ -->
                    <div class="mb-4">
                        <label class="form-label fw-bold">Mô tả phụ tùng</label>
                        <textarea class="form-control" name="Description" id="description" rows="3" maxlength="1000" placeholder="Chi tiết kỹ thuật, đặc điểm sản phẩm..."></textarea>
                    </div>

                    <div class="text-end pt-3 border-top">
                        <button type="button" class="btn btn-secondary px-4 fw-bold me-2" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-warning px-4 fw-bold text-dark" style="background-color: #ffc107;" id="btnSubmit">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Điều chỉnh tồn kho -->
<div class="modal fade" id="inventoryAdjustmentModal" tabindex="-1" aria-labelledby="inventoryAdjustmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header bg-warning text-dark py-3">
                <h5 class="modal-title fw-bold" id="inventoryAdjustmentModalLabel">
                    <i class="bi bi-sliders me-2"></i> ĐIỀU CHỈNH TỒN KHO PHỤ TÙNG
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="adjustmentError" class="alert alert-danger d-none"></div>
                <form id="adjustmentForm">
                    <input type="hidden" name="PartId" id="adjustPartId" value="0" />

                    <div class="card bg-light border-0 p-3 mb-3">
                        <div class="fw-bold text-dark mb-1" id="adjustPartTitle">Phụ tùng: --</div>
                        <div class="text-secondary small">
                            Tồn kho hiện tại: <strong id="adjustCurrentQty" class="text-primary fs-6">0</strong> <span id="adjustUnit">Cái</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số lượng điều chỉnh <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="AdjustmentQuantity" id="adjustmentQuantity" required placeholder="Ví dụ: -2 (giảm) hoặc 5 (tăng)" />
                        <small class="text-muted d-block mt-1" style="font-size: 11px;">Nhập số âm để giảm tồn kho (hỏng, mất mát), số dương để tăng tồn kho.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Lý do điều chỉnh <span class="text-danger">*</span></label>
                        <select class="form-select" name="Reason" id="adjustReason" required>
                            <option value="">-- Chọn lý do --</option>
                            <option value="Hàng hư hỏng / Phế phẩm">Hàng hư hỏng / Phế phẩm</option>
                            <option value="Hàng hết hạn sử dụng">Hàng hết hạn sử dụng</option>
                            <option value="Sai lệch do kiểm kê kho">Sai lệch do kiểm kê kho</option>
                            <option value="Thất thoát / Mất mát">Thất thoát / Mất mát</option>
                            <option value="Lý do khác">Lý do khác</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Ghi chú chi tiết</label>
                        <textarea class="form-control" name="Notes" id="adjustNotes" rows="3" placeholder="Nhập mô tả cụ thể về lý do điều chỉnh..."></textarea>
                    </div>

                    <div class="text-end mt-4">
                        <button type="button" class="btn btn-secondary px-4 fw-bold me-2" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-warning px-4 fw-bold text-dark" id="btnSubmitAdjustment">Xác nhận điều chỉnh</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<!-- Inventory Receipt Modal -->
<div class="modal fade" id="inventoryReceiptModal" tabindex="-1" aria-labelledby="inventoryReceiptModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable inventory-dialog">
        <div class="modal-content inventory-modal">
            <div class="inventory-modal__header">
                <div class="inventory-modal__heading">
                    <span class="inventory-modal__icon">
                        <i class="bi bi-box-arrow-in-down"></i>
                    </span>
                    <div>
                        <span class="inventory-modal__eyebrow">WAREHOUSE RECEIPT</span>
                        <h5 class="modal-title" id="inventoryReceiptModalLabel">Tạo phiếu nhập kho</h5>
                        <p>Chọn phụ tùng có sẵn hoặc tạo nhanh phụ tùng mới trong cùng phiếu.</p>
                    </div>
                </div>
                <button type="button" class="modal-close-btn" data-bs-dismiss="modal" aria-label="Đóng">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-body inventory-modal__body">
                <div class="receipt-overview-grid">
                    <div class="receipt-note-card">
                        <label for="receiptNotes" class="field-label">
                            Ghi chú nhập kho
                            <span class="field-label__optional">Không bắt buộc</span>
                        </label>
                        <textarea
                            class="app-textarea"
                            id="receiptNotes"
                            rows="3"
                            placeholder="Ví dụ: Nhập bổ sung lô phụ tùng tháng 7..."></textarea>
                    </div>

                    <div class="receipt-help-card">
                        <span class="receipt-help-card__icon"><i class="bi bi-lightbulb"></i></span>
                        <div>
                            <strong>Cách nhập nhanh</strong>
                            <p class="mb-0">
                                Mỗi dòng có thể dùng một nhà cung cấp riêng. Chọn <b>Tạo mới</b> khi mã phụ tùng chưa có trong hệ thống.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="receipt-section-heading">
                    <div>
                        <span class="section-kicker">CHI TIẾT PHIẾU</span>
                        <h6>Danh sách phụ tùng nhập kho</h6>
                    </div>
                    <button type="button" class="btn add-line-btn" onclick="addReceiptItemRow()">
                        <i class="bi bi-plus-lg"></i>
                        Thêm dòng
                    </button>
                </div>

                <div id="receiptItemsContainer" class="receipt-items-stack">
                    <!-- Receipt item cards are rendered dynamically -->
                </div>
            </div>

            <div class="inventory-modal__footer">
                <div class="receipt-summary">
                    <div class="receipt-summary__item">
                        <span>Số dòng</span>
                        <strong id="receiptLineCount">0</strong>
                    </div>
                    <div class="receipt-summary__divider"></div>
                    <div class="receipt-summary__item receipt-summary__item--total">
                        <span>Tổng tiền nhập dự kiến</span>
                        <strong id="receiptGrandTotal">0 ₫</strong>
                    </div>
                </div>

                <div class="inventory-modal__actions">
                    <button type="button" class="btn footer-btn footer-btn--ghost" data-bs-dismiss="modal">
                        Hủy
                    </button>
                    <button type="button" class="btn footer-btn footer-btn--primary" id="btnSaveReceipt" onclick="submitInventoryReceipt()">
                        <i class="bi bi-check2-circle"></i>
                        Lưu phiếu nhập
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="addCategoryModalLabel">
                    <i class="bi bi-folder-plus me-2"></i> THÊM DANH MỤC MỚI
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="addCategoryForm" onsubmit="submitAddCategory(event)">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên danh mục <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="newCatName" required placeholder="Ví dụ: Má phanh, Lốp xe..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả chi tiết</label>
                        <textarea class="form-control" id="newCatDesc" rows="3" placeholder="Mô tả phân loại phụ tùng..."></textarea>
                    </div>
                    <div class="text-end mt-4">
                        <button type="button" class="btn btn-secondary px-4 fw-bold me-2" data-bs-dismiss="modal">HỦY</button>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">THÊM MỚI</button>
                    </div>
                </form>
            </div>
        </div>
