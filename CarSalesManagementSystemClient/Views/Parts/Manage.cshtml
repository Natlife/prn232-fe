        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.75);
        border-radius: 24px;
        background:
            linear-gradient(118deg, rgba(20, 46, 33, 0.98), rgba(42, 102, 72, 0.94)),
            #1e4934;
        box-shadow: 0 18px 50px rgba(24, 66, 44, 0.17);
        color: #fff;
    }

    .page-hero::after {
        position: absolute;
        top: -70px;
        right: -60px;
        width: 260px;
        height: 260px;
        border: 44px solid rgba(255, 255, 255, 0.06);
        border-radius: 50%;
        content: "";
    }

    .page-hero__content {
        position: relative;
        z-index: 1;
        padding: 32px;
    }

    .page-hero__eyebrow,
    .inventory-modal__eyebrow,
    .section-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
    }

    .page-hero__dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #9de0b5;
        box-shadow: 0 0 0 5px rgba(157, 224, 181, 0.12);
    }

    .page-hero__title {
        margin: 0 0 8px;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        letter-spacing: -0.045em;
    }

    .page-hero__subtitle {
        max-width: 650px;
        color: rgba(255, 255, 255, 0.72);
        font-size: 1rem;
    }

    .page-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .app-btn {
        display: inline-flex;
        min-height: 44px;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 0 17px;
        border-radius: 12px;
        font-weight: 650;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .app-btn:hover {
        transform: translateY(-2px);
    }

    .app-btn--primary {
        border: 1px solid #fff;
        background: #fff;
        color: var(--app-primary-dark);
        box-shadow: 0 8px 20px rgba(5, 23, 14, 0.16);
    }

    .app-btn--primary:hover {
        background: #f7fff9;
        color: var(--app-primary-dark);
    }

    .app-btn--secondary {
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.09);
        color: #fff;
        backdrop-filter: blur(10px);
    }

    .app-btn--secondary:hover {
        border-color: rgba(255, 255, 255, 0.4);
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
    }

    .app-alert {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        padding: 15px 17px;
        border: 1px solid;
        border-radius: 14px;
        background: #fff;
    }

    .app-alert--danger {
        border-color: #f0c8c8;
        color: #8c2d2d;
    }

    .app-alert__icon {
        display: grid;
        width: 36px;
        height: 36px;
        flex: 0 0 36px;
        place-items: center;
        border-radius: 10px;
        background: #fff0f0;
    }

    .metric-card {
        display: flex;
        align-items: center;
        gap: 17px;
        padding: 21px;
        border: 1px solid var(--app-border);
        border-radius: 18px;
        background: var(--app-surface);
        box-shadow: 0 8px 24px rgba(26, 55, 39, 0.045);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .metric-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--app-shadow);
    }

    .metric-card__icon {
        display: grid;
        width: 52px;
        height: 52px;
        flex: 0 0 52px;
        place-items: center;
        border-radius: 15px;
        font-size: 1.35rem;
    }

    .metric-card__icon--blue {
        background: #eef4ff;
        color: #4169b0;
    }

    .metric-card__icon--green {
        background: var(--app-primary-soft);
        color: var(--app-primary);
    }

    .metric-card__icon--amber {
        background: #fff6e8;
        color: #b97816;
    }

    .metric-card__icon--red {
        background: #fff0f0;
        color: #bd4646;
    }

    .metric-card__body {
        display: flex;
        min-width: 0;
        flex-direction: column;
    }

    .metric-card__label {
        color: var(--app-muted);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .metric-card__value {
        margin: 1px 0;
        color: var(--app-ink);
        font-size: 1.75rem;
        line-height: 1.1;
    }

    .metric-card__meta {
        overflow: hidden;
        color: #98a29b;
        font-size: 0.78rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .content-card {
        overflow: hidden;
        border: 1px solid var(--app-border);
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 8px 24px rgba(26, 55, 39, 0.04);
    }

    .content-card__body {
        padding: 16px;
    }

    .content-card__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 22px 24px;
        border-bottom: 1px solid #edf1ee;
    }

    .content-card__title {
        margin: 0 0 4px;
        font-size: 1.05rem;
        font-weight: 750;
    }

    .content-card__subtitle {
        color: var(--app-muted);
        font-size: 0.88rem;
    }

    .result-count {
        flex: 0 0 auto;
        padding: 7px 11px;
        border-radius: 999px;
        background: var(--app-primary-soft);
        color: var(--app-primary-dark);
        font-size: 0.78rem;
        font-weight: 700;
    }

    .toolbar-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(220px, 320px);
        gap: 12px;
    }

    .search-control,
    .select-control {
        position: relative;
        display: flex;
        min-height: 46px;
        align-items: center;
        border: 1px solid var(--app-border);
        border-radius: 12px;
        background: #f8faf9;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .search-control:focus-within,
    .select-control:focus-within {
        border-color: rgba(47, 117, 82, 0.55);
        background: #fff;
        box-shadow: 0 0 0 4px rgba(47, 117, 82, 0.1);
    }

    .search-control > i,
    .select-control > i {
        margin-left: 15px;
        color: #8d9991;
    }

    .search-control input,
    .select-control select {
        width: 100%;
        height: 44px;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--app-ink);
        font-size: 0.9rem;
    }

    .search-control input {
        padding: 0 15px 0 11px;
    }

    .select-control select {
        padding: 0 36px 0 11px;
    }

    .parts-table {
        min-width: 1020px;
    }

    .parts-table thead th {
        padding: 14px 12px;
        border: 0;
        border-bottom: 1px solid #e8ede9;
        background: #f8faf9;
        color: #68756c;
        font-size: 0.73rem;
        font-weight: 750;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .parts-table tbody td {
        padding: 15px 12px;
        border-color: #edf1ee;
        vertical-align: middle;
    }

    .parts-table tbody tr {
        transition: background 0.18s ease;
    }

    .parts-table tbody tr:hover {
        background: #fbfdfb;
    }

    .part-cell {
        display: flex;
        min-width: 250px;
        align-items: center;
        gap: 12px;
        color: var(--app-ink);
    }

    .part-cell:hover {
        color: var(--app-primary-dark);
    }

    .part-cell__image {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        border: 1px solid #e7ece8;
        border-radius: 13px;
        object-fit: cover;
    }

    .part-cell__info {
        display: flex;
        min-width: 0;
        flex-direction: column;
    }

    .part-cell__info strong {
        overflow: hidden;
        max-width: 250px;
        font-size: 0.92rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .part-cell__info span {
        overflow: hidden;
        max-width: 250px;
        color: #93a097;
        font-size: 0.76rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .part-code {
        display: inline-flex;
        padding: 5px 8px;
        border: 1px solid #e5ebe7;
        border-radius: 8px;
        background: #f8faf9;
        color: #566259;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.75rem;
        font-weight: 650;
    }

    .category-chip {
        display: inline-flex;
        padding: 6px 10px;
        border-radius: 999px;
        background: #f1f4f2;
        color: #5d6961;
        font-size: 0.75rem;
        font-weight: 650;
        white-space: nowrap;
    }

    .price-text {
        color: #26332b;
        font-size: 0.88rem;
        white-space: nowrap;
    }

    .stock-value {
        display: flex;
        flex-direction: column;
    }

    .stock-value span {
        color: var(--app-primary);
        font-size: 0.95rem;
        font-weight: 750;
    }

    .stock-value small {
        color: #9aa49d;
        font-size: 0.7rem;
    }

    .stock-value--low span {
        color: var(--app-danger);
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-pill > span {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .status-pill--success {
        background: #edf8f1;
        color: #2f7552;
    }

    .status-pill--success > span {
        background: #35a56d;
    }

    .status-pill--warning {
        background: #fff5e7;
        color: #9b671a;
    }

    .status-pill--warning > span {
        background: #e4a33d;
    }

    .status-pill--danger {
        background: #fff0f0;
        color: #a43c3c;
    }

    .status-pill--danger > span {
        background: #d95757;
    }

    .icon-btn {
        display: inline-grid;
        width: 36px;
        height: 36px;
        place-items: center;
        border: 1px solid #dfe7e1;
        border-radius: 10px;
        background: #fff;
        color: #66736a;
        transition: all 0.2s ease;
    }

    .icon-btn:hover {
        border-color: rgba(47, 117, 82, 0.35);
        background: var(--app-primary-soft);
        color: var(--app-primary);
        transform: translateY(-1px);
    }

    .empty-state {
        display: flex;
        min-height: 280px;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        padding: 40px;
        text-align: center;
    }

    .empty-state__icon {
        display: grid;
        width: 64px;
        height: 64px;
        margin-bottom: 15px;
        place-items: center;
        border-radius: 18px;
        background: var(--app-primary-soft);
        color: var(--app-primary);
        font-size: 1.7rem;
    }

    .empty-state h3 {
        margin: 0 0 6px;
        font-size: 1rem;
        font-weight: 750;
    }

    .empty-state p {
        max-width: 390px;
        margin: 0;
        color: var(--app-muted);
        font-size: 0.86rem;
    }

    /* Shared modal styling */
    .modal-content {
        border: 0;
        border-radius: 20px;
        box-shadow: 0 24px 80px rgba(23, 33, 27, 0.22);
    }

    .modal-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e8ede9;
        background: #fff !important;
        color: var(--app-ink) !important;
    }

    .modal-header .btn-close {
        filter: none !important;
    }

    .modal-body {
        padding: 24px;
    }

    .modal .form-label {
        margin-bottom: 7px;
        color: #4b5850;
        font-size: 0.82rem;
        font-weight: 650 !important;
    }

    .modal .form-control,
    .modal .form-select {
        min-height: 44px;
        border-color: #dce5df;
        border-radius: 11px;
        font-size: 0.9rem;
    }

    .modal .form-control:focus,
    .modal .form-select:focus {
        border-color: rgba(47, 117, 82, 0.6);
        box-shadow: 0 0 0 4px rgba(47, 117, 82, 0.1);
    }

    /* Inventory modal */
    .inventory-dialog {
        width: min(1380px, calc(100vw - 32px));
        max-width: none;
        height: calc(100vh - 32px);
        margin: 16px auto;
    }

    .inventory-modal {
        overflow: hidden;
        height: 100%;
        border-radius: 24px;
        background: #f7f9f7;
    }

    .inventory-modal__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 20px 24px;
        border-bottom: 1px solid #dde6df;
        background: #fff;
    }

    .inventory-modal__heading {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .inventory-modal__icon {
        display: grid;
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        place-items: center;
        border-radius: 14px;
        background: var(--app-primary-soft);
        color: var(--app-primary);
        font-size: 1.3rem;
    }

    .inventory-modal__eyebrow {
        margin: 0 0 2px;
        color: var(--app-primary);
        font-size: 0.66rem;
    }

    .inventory-modal__heading h5 {
        margin: 0;
        color: var(--app-ink);
        font-size: 1.22rem;
        font-weight: 780;
    }

    .inventory-modal__heading p {
        margin: 3px 0 0;
        color: var(--app-muted);
        font-size: 0.82rem;
    }

    .modal-close-btn {
        display: grid;
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        place-items: center;
        border: 0;
        border-radius: 11px;
        background: #f1f4f2;
        color: #677269;
        transition: background 0.2s ease, color 0.2s ease;
    }

    .modal-close-btn:hover {
        background: #e8eeea;
        color: var(--app-ink);
    }

    .inventory-modal__body {
        overflow-y: auto;
        padding: 22px 24px 28px;
    }

    .receipt-overview-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(300px, 0.55fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .receipt-note-card,
    .receipt-help-card {
        border: 1px solid var(--app-border);
        border-radius: 16px;
        background: #fff;
    }

    .receipt-note-card {
        padding: 18px;
    }

    .receipt-help-card {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 18px;
        background: linear-gradient(135deg, #f1f8f3, #f8fbf9);
    }

    .receipt-help-card__icon {
        display: grid;
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        place-items: center;
        border-radius: 11px;
        background: #fff;
        color: var(--app-primary);
        box-shadow: 0 5px 15px rgba(31, 81, 53, 0.08);
    }

    .receipt-help-card strong {
        display: block;
        margin: 1px 0 4px;
        font-size: 0.88rem;
    }

    .receipt-help-card p {
        color: #69766d;
        font-size: 0.79rem;
        line-height: 1.5;
    }

    .field-label {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 7px;
        color: #445149;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .field-label__optional {
        margin-left: auto;
        color: #9aa49d;
        font-size: 0.67rem;
        font-weight: 500;
    }

    .required-mark {
        color: #d44a4a;
    }

    .app-input,
    .app-select,
    .app-textarea {
        width: 100%;
        border: 1px solid #dbe4de;
        outline: 0;
        border-radius: 11px;
        background: #fff;
        color: var(--app-ink);
        font-size: 0.86rem;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .app-input,
    .app-select {
        height: 44px;
        padding: 0 12px;
    }

    .app-textarea {
        min-height: 78px;
        padding: 11px 12px;
        resize: vertical;
    }

    .app-input:focus,
    .app-select:focus,
    .app-textarea:focus,
    .searchable-select:focus-within {
        border-color: rgba(47, 117, 82, 0.62);
        box-shadow: 0 0 0 4px rgba(47, 117, 82, 0.1);
    }

    .receipt-section-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 13px;
    }

    .section-kicker {
        margin: 0 0 3px;
        color: var(--app-primary);
        font-size: 0.65rem;
    }

    .receipt-section-heading h6 {
        margin: 0;
        font-size: 1rem;
        font-weight: 760;
    }

    .add-line-btn {
        display: inline-flex;
        min-height: 40px;
        align-items: center;
        gap: 8px;
        padding: 0 14px;
        border: 1px solid rgba(47, 117, 82, 0.25);
        border-radius: 11px;
        background: #fff;
        color: var(--app-primary);
        font-size: 0.82rem;
        font-weight: 700;
    }

    .add-line-btn:hover {
        border-color: var(--app-primary);
        background: var(--app-primary-soft);
        color: var(--app-primary-dark);
    }

    .receipt-items-stack {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .receipt-item-row {
        overflow: visible;
        border: 1px solid #dce5df;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 7px 24px rgba(24, 62, 41, 0.045);
    }

    .receipt-item-row__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 13px 16px;
        border-bottom: 1px solid #edf1ee;
        background: #fbfcfb;
        border-radius: 18px 18px 0 0;
    }

    .receipt-line-title {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .receipt-line-number {
        display: grid;
        width: 30px;
        height: 30px;
        flex: 0 0 30px;
        place-items: center;
        border-radius: 9px;
        background: var(--app-primary);
        color: #fff;
        font-size: 0.78rem;
        font-weight: 750;
    }

    .receipt-line-title div {
        display: flex;
        flex-direction: column;
    }

    .receipt-line-title strong {
        font-size: 0.85rem;
    }

    .receipt-line-title small {
        color: #96a199;
        font-size: 0.7rem;
    }

    .remove-line-btn {
        display: grid;
        width: 34px;
        height: 34px;
        place-items: center;
        border: 1px solid #f0d2d2;
        border-radius: 10px;
        background: #fff7f7;
        color: #c24949;
        transition: all 0.2s ease;
    }

    .remove-line-btn:hover {
        border-color: #d55c5c;
        background: #fff0f0;
    }

    .receipt-item-row__body {
        display: grid;
        grid-template-columns: minmax(220px, 0.32fr) minmax(0, 1fr);
    }

    .receipt-source-panel {
        padding: 18px;
        border-right: 1px solid #edf1ee;
        background: #fbfcfb;
        border-radius: 0 0 0 18px;
    }

    .receipt-product-panel {
        min-width: 0;
        padding: 18px;
    }

    .panel-caption {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 15px;
        color: #6b786f;
        font-size: 0.74rem;
        font-weight: 750;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .panel-caption i {
        color: var(--app-primary);
    }

    .field-group {
        margin-bottom: 14px;
    }

    .product-panel-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 15px;
    }

    .mode-switch {
        display: inline-flex;
        gap: 3px;
        padding: 3px;
        border: 1px solid #dce5df;
        border-radius: 11px;
        background: #f2f5f3;
    }

    .mode-switch__button {
        display: inline-flex;
        height: 32px;
        align-items: center;
        gap: 6px;
        padding: 0 11px;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: #77837a;
        font-size: 0.72rem;
        font-weight: 700;
        transition: all 0.18s ease;
    }

    .mode-switch__button.active {
        background: #fff;
        color: var(--app-primary);
        box-shadow: 0 3px 9px rgba(37, 79, 53, 0.09);
    }

    .searchable-select {
        position: relative;
        display: flex;
        height: 46px;
        align-items: center;
        border: 1px solid #dbe4de;
        border-radius: 11px;
        background: #fff;
    }

    .searchable-select__icon {
        margin-left: 13px;
        color: #8d9991;
    }

    .searchable-select input {
        width: 100%;
        height: 44px;
        padding: 0 36px 0 10px;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--app-ink);
        font-size: 0.86rem;
    }

    .searchable-select__arrow {
        position: absolute;
        right: 13px;
        color: #8d9991;
        pointer-events: none;
    }

    .search-part-menu {
        top: calc(100% + 7px) !important;
        left: 0 !important;
        z-index: 1080;
        overflow-y: auto;
        max-height: 260px;
        padding: 6px !important;
        border: 1px solid #dce5df;
        border-radius: 12px;
        box-shadow: 0 16px 34px rgba(25, 51, 35, 0.16) !important;
    }

    .search-part-menu .dropdown-item {
        padding: 9px 10px !important;
        border: 0 !important;
        border-radius: 9px;
    }

    .search-part-menu .dropdown-item:hover {
        background: var(--app-primary-soft);
    }

    .new-part-container {
        margin-top: 14px;
        padding: 16px;
        border: 1px solid #d8e9dd;
        border-radius: 14px;
        background: #f8fcf9;
    }

    .new-part-banner {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 15px;
        padding-bottom: 13px;
        border-bottom: 1px solid #e0ece4;
        color: var(--app-primary);
    }

    .new-part-banner div {
        display: flex;
        flex-direction: column;
    }

    .new-part-banner strong {
        font-size: 0.82rem;
    }

    .new-part-banner span {
        color: #758178;
        font-size: 0.72rem;
    }

    .input-with-suffix {
        position: relative;
    }

    .input-with-suffix .app-input {
        padding-right: 55px;
    }

    .input-with-suffix > span {
        position: absolute;
        top: 50%;
        right: 12px;
        color: #8d9991;
        font-size: 0.72rem;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .receipt-values-grid {
        display: grid;
        grid-template-columns: minmax(110px, 0.75fr) minmax(170px, 1fr) minmax(170px, 1fr) minmax(180px, 0.9fr);
        gap: 12px;
        align-items: end;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid #edf1ee;
    }

    .line-subtotal-card {
        display: flex;
        min-height: 67px;
        justify-content: center;
        flex-direction: column;
        padding: 10px 13px;
        border: 1px solid #d8e9dd;
        border-radius: 12px;
        background: var(--app-primary-soft);
    }

    .line-subtotal-card span {
        color: #708078;
        font-size: 0.68rem;
        font-weight: 650;
    }

    .line-subtotal-card strong {
        margin-top: 2px;
        color: var(--app-primary-dark);
        font-size: 0.93rem;
    }

    .inventory-modal__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 15px 24px;
        border-top: 1px solid #dde6df;
        background: #fff;
    }

    .receipt-summary {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .receipt-summary__item {
        display: flex;
        flex-direction: column;
    }

    .receipt-summary__item span {
        color: #89958d;
        font-size: 0.68rem;
        font-weight: 650;
        text-transform: uppercase;
    }

    .receipt-summary__item strong {
        color: var(--app-ink);
        font-size: 0.95rem;
    }

    .receipt-summary__item--total strong {
        color: var(--app-primary);
        font-size: 1.05rem;
    }

    .receipt-summary__divider {
        width: 1px;
        height: 32px;
        background: #e2e8e4;
