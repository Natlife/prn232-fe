            })
            .then(data => {
                Swal.fire('Thành công', 'Thêm nhà cung cấp mới thành công!', 'success').then(() => {
                    location.reload();
                });
            })
            .catch(err => {
                Swal.fire('Thất bại', err.message, 'error');
            });
        }

        function openAddModal() {
            $('#modalError').addClass('d-none');
            $('#partForm')[0].reset();
            $('#partId').val('0');
            $('#partModalLabel').text('Thêm phụ tùng mới');
            partModal.show();
        }

        function openEditModal(partId) {
            $('#modalError').addClass('d-none');
            $('#partForm')[0].reset();
            
            $.ajax({
                url: '/Parts/GetPartJson/' + partId,
                type: 'GET',
                success: function(part) {
                    $('#partId').val(part.partId);
                    $('#partName').val(part.partName);
                    $('#partCode').val(part.partCode);
                    $('#categoryId').val(part.categoryId);
                    $('#brand').val(part.brand);
                    $('#price').val(part.price);
                    $('#quantity').val(part.quantity);
                    $('#status').val(part.status);
                    $('#imageUrl').val(part.imageUrl);
                    $('#description').val(part.description);
                    
                    $('#partModalLabel').text('Cập nhật thông tin phụ tùng');
                    partModal.show();
                },
                error: function() {
                    Swal.fire('Lỗi!', 'Không thể tải thông tin phụ tùng.', 'error');
                }
            });
        }

        $('#partForm').on('submit', function(e) {
            e.preventDefault();
            var form = $(this);
            if (!form.valid()) return;

            var btn = $('#btnSubmit');
            btn.prop('disabled', true).text('Đang lưu...');

            $.ajax({
                url: '/Parts/Save',
                type: 'POST',
                data: form.serialize(),
                success: function(res) {
                    btn.prop('disabled', false).text('Lưu lại');
                    if (res.success) {
                        partModal.hide();
                        Swal.fire({
                            title: 'Thành công!',
                            text: res.message,
                            icon: 'success',
                            confirmButtonColor: '#ffc107'
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        $('#modalError').html(res.message).removeClass('d-none');
                    }
                },
                error: function() {
                    btn.prop('disabled', false).text('Lưu lại');
                    Swal.fire('Lỗi!', 'Lỗi kết nối máy chủ.', 'error');
                }
            });
        });

        function confirmResell(partId, name) {
            Swal.fire({
                title: 'Bán lại phụ tùng',
                text: "Nhập số lượng bán lại cho phụ tùng '" + name + "':",
                input: 'number',
                inputAttributes: {
                    min: 1,
                    step: 1
                },
                inputValue: 1,
                showCancelButton: true,
                confirmButtonColor: '#198754',
                cancelButtonColor: '#262626',
                confirmButtonText: 'Xác nhận',
                cancelButtonText: 'Hủy',
                inputValidator: (value) => {
                    if (!value || parseInt(value) <= 0) {
                        return 'Vui lòng nhập số lượng lớn hơn 0!'
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    var qty = parseInt(result.value);
                    $.ajax({
                        url: '/Parts/Resell',
                        type: 'POST',
                        data: { id: partId, quantity: qty },
                        success: function(res) {
                            if (res.success) {
                                Swal.fire({
                                    title: 'Thành công!',
                                    text: res.message,
                                    icon: 'success',
                                    confirmButtonColor: '#ffc107'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Thất bại!', res.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Lỗi!', 'Lỗi kết nối mạng.', 'error');
                        }
                    });
                }
            });
        }

        function confirmDiscontinue(partId, name) {
            Swal.fire({
                title: 'Xác nhận ngưng bán?',
                text: "Bạn có chắc chắn muốn ngưng bán phụ tùng '" + name + "'? Khách hàng sẽ không thể mua sản phẩm này nữa!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ffc107',
                cancelButtonColor: '#262626',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Parts/Discontinue/' + partId,
                        type: 'POST',
                        success: function(res) {
                            if (res.success) {
                                Swal.fire({
                                    title: 'Thành công!',
                                    text: res.message,
                                    icon: 'success',
                                    confirmButtonColor: '#ffc107'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Thất bại!', res.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Lỗi!', 'Lỗi kết nối mạng.', 'error');
                        }
                    });
                }
            });
        }

        // Live Search & Category Filtering
        function filterPartsTable() {
            const searchVal = document.getElementById('searchTerm').value.toLowerCase().trim();
            const catVal = document.getElementById('filterCategory').value.toLowerCase().trim();
            const rows = document.querySelectorAll('table tbody tr');
            
            rows.forEach(row => {
                const nameCell = row.querySelector('.part-name-cell');
                const codeCell = row.querySelector('.part-code-cell');
                const catCell = row.querySelector('.part-cat-cell');
                
                if (!nameCell) return; // Skip if empty row
                
                const nameText = nameCell.textContent.toLowerCase();
                const codeText = codeCell.textContent.toLowerCase();
                const catText = catCell.textContent.toLowerCase();
                
                const matchesSearch = nameText.includes(searchVal) || codeText.includes(searchVal);
                const matchesCategory = !catVal || catText.includes(catVal);
                
                if (matchesSearch && matchesCategory) {
                    row.removeAttribute('style'); // Show row
                } else {
                    row.setAttribute('style', 'display: none !important;'); // Hide row
                }
            });
        }
    </script>
}

