@model IEnumerable<CarSalesManagementSystemClient.Models.PartViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Phụ tùng - Admin";
    var categories = ViewBag.Categories as IEnumerable<CarSalesManagementSystemClient.Models.PartCategoryViewModel> ?? new List<PartCategoryViewModel>();
}

<!-- Google Fonts Outfit & Bootstrap Icons -->
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container-fluid py-4 px-md-5" style="font-family: 'Outfit', sans-serif; background-color: #f8f9fa;">
    
    <!-- Header Block -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="fw-extrabold text-dark m-0 d-flex align-items-center gap-2" style="font-size: 2.2rem; font-weight: 800; letter-spacing: -0.5px;">
                <span class="text-warning">|</span> QUẢN LÝ PHỤ TÙNG
            </h1>
            <p class="text-muted m-0 mt-1" style="font-size: 15px; font-weight: 400;">
                <i class="bi bi-gear-wide-connected me-1 text-secondary"></i> Dashboard quản lý tồn kho &amp; nhập kho phụ tùng chính hãng
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2 justify-content-md-end">
            @if (User.IsInRole("Admin"))
            {
                <button class="btn btn-primary fw-semibold d-inline-flex align-items-center gap-2 px-3 py-2 border-0 shadow-sm btn-top-action" onclick="openAddCategoryModal()">
                    <i class="bi bi-folder-plus fs-5"></i> THÊM DANH MỤC
                </button>
                <button class="btn btn-info fw-semibold text-white d-inline-flex align-items-center gap-2 px-3 py-2 border-0 shadow-sm btn-top-action" onclick="openAddSupplierModal()">
                    <i class="bi bi-people fs-5"></i> THÊM NHÀ CUNG CẤP
                </button>
            }
            <button class="btn btn-success fw-semibold text-white d-inline-flex align-items-center gap-2 px-4 py-2 border-0 shadow-sm btn-top-action" onclick="openInventoryReceiptModal()">
                <i class="bi bi-box-seam fs-5"></i> NHẬP KHO PHỤ TÙNG
            </button>
        </div>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger border-0 rounded-3 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i> @ViewBag.ErrorMessage
        </div>
    }

    <!-- Stat Dashboard Cards -->
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 d-flex flex-row align-items-center bg-white stats-card h-100">
                <div class="rounded-4 bg-primary bg-opacity-10 p-3 me-3 text-primary d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                    <i class="bi bi-wrench-adjustable fs-3"></i>
                </div>
                <div>
                    <h6 class="text-secondary fw-semibold mb-1" style="font-size: 13px; letter-spacing: 0.5px;">TỔNG SỐ PHỤ TÙNG</h6>
                    <h3 class="fw-bold mb-0 text-dark" style="font-size: 1.8rem; font-weight: 700;">@Model.Count()</h3>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 d-flex flex-row align-items-center bg-white stats-card h-100">
                <div class="rounded-4 bg-success bg-opacity-10 p-3 me-3 text-success d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                    <i class="bi bi-box fs-3"></i>
                </div>
                <div>
                    <h6 class="text-secondary fw-semibold mb-1" style="font-size: 13px; letter-spacing: 0.5px;">TỔNG TỒN KHO</h6>
                    <h3 class="fw-bold mb-0 text-dark" style="font-size: 1.8rem; font-weight: 700;">@Model.Sum(p => p.Quantity)</h3>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 d-flex flex-row align-items-center bg-white stats-card h-100">
                <div class="rounded-4 bg-warning bg-opacity-10 p-3 me-3 text-warning d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                    <i class="bi bi-exclamation-octagon fs-3"></i>
                </div>
                <div>
                    <h6 class="text-secondary fw-semibold mb-1" style="font-size: 13px; letter-spacing: 0.5px;">SẮP HẾT HÀNG</h6>
                    <h3 class="fw-bold mb-0 text-dark" style="font-size: 1.8rem; font-weight: 700;">@Model.Count(p => p.Quantity <= 5 && p.Status == "Available")</h3>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 d-flex flex-row align-items-center bg-white stats-card h-100">
                <div class="rounded-4 bg-danger bg-opacity-10 p-3 me-3 text-danger d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                    <i class="bi bi-slash-circle fs-3"></i>
                </div>
                <div>
                    <h6 class="text-secondary fw-semibold mb-1" style="font-size: 13px; letter-spacing: 0.5px;">NGƯNG KINH DOANH</h6>
                    <h3 class="fw-bold mb-0 text-dark" style="font-size: 1.8rem; font-weight: 700;">@Model.Count(p => p.Status == "Inactive")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white p-3">
        <div class="row g-3">
            <div class="col-md-7 col-lg-8">
                <div class="input-group" style="border-radius: 10px; overflow: hidden;">
                    <span class="input-group-text border-0 bg-light text-secondary px-3"><i class="bi bi-search fs-5"></i></span>
                    <input type="text" class="form-control border-0 bg-light py-2" id="searchTerm" placeholder="Tìm kiếm nhanh phụ tùng theo tên hoặc mã sản phẩm..." onkeyup="filterPartsTable()" style="font-size: 14px;" />
                </div>
            </div>
            <div class="col-md-5 col-lg-4">
                <select class="form-select border-0 bg-light py-2" id="filterCategory" onchange="filterPartsTable()" style="font-size: 14px; border-radius: 10px;">
                    <option value="">Tất cả danh mục</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.CategoryName">@cat.CategoryName</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 10%;">Hình ảnh</th>
                            <th style="width: 15%;">Mã</th>
                            <th style="width: 25%;">Tên phụ tùng</th>
                            <th style="width: 15%;">Danh mục</th>
                            <th style="width: 12%;">Thương hiệu</th>
                            <th style="width: 13%;">Giá bán</th>
                            <th style="width: 10%;">Tồn kho</th>
                            <th style="width: 12%;">Trạng thái</th>
                            <th class="text-end pe-4" style="width: 18%;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-secondary">
                                    <i class="bi bi-tools fs-1 d-block mb-3 text-muted"></i>
                                    Chưa có phụ tùng nào được tạo trong hệ thống.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var part in Model)
                            {
                                var displayImageUrl = string.IsNullOrWhiteSpace(part.ImageUrl) 
                                    ? "https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=100&q=80" 
                                    : part.ImageUrl;
                                    
                                <tr>
                                    <td class="ps-4">
                                        <div class="img-wrapper">
                                            <img src="@displayImageUrl" alt="@part.PartName" class="part-img" />
                                        </div>
                                    </td>
                                    <td class="fw-semibold text-secondary part-code-cell" style="font-family: monospace; font-size: 13px;">@part.PartCode</td>
                                    <td>
                                        <div class="fw-bold text-dark part-name-cell" style="font-size: 15px;">@part.PartName</div>
                                    </td>
                                    <td>
                                        <span class="cat-tag part-cat-cell">@part.Category?.CategoryName</span>
                                    </td>
                                    <td class="text-secondary fw-medium" style="font-size: 14px;">@part.Brand</td>
                                    <td class="fw-bold text-danger" style="font-size: 15px;">@part.Price.ToString("N0") đ</td>
                                    <td>
                                        @if (part.Quantity <= part.MinStockLevel)
                                        {
                                            <span class="fw-bold text-danger d-flex align-items-center gap-1">
                                                <i class="bi bi-exclamation-triangle-fill"></i> @part.Quantity
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-success">@part.Quantity</span>
                                        }
                                    </td>
                                    <td>
                                        @if (part.Status == "Available")
                                        {
                                            <span class="badge badge-premium bg-success bg-opacity-10 text-success">Còn hàng</span>
                                        }
                                        else if (part.Status == "Out of Stock")
                                        {
                                            <span class="badge badge-premium bg-warning bg-opacity-10 text-warning text-dark">Hết hàng</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-premium bg-danger bg-opacity-10 text-danger">Ngưng bán</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-1">
                                            @if (part.Status != "Inactive")
                                            {
                                                <button class="btn btn-sm btn-action-premium btn-outline-warning border-0" onclick="confirmDiscontinue(@part.PartId, '@part.PartName')" title="Ngưng bán phụ tùng này">
                                                    <i class="bi bi-slash-circle fs-5"></i>
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-action-premium btn-outline-primary border-0" onclick="openEditModal(@part.PartId)" title="Chỉnh sửa thông tin">
                                                <i class="bi bi-pencil-square fs-5"></i>
                                            </button>
                                            <button class="btn btn-sm btn-action-premium btn-outline-success border-0" onclick="confirmResell(@part.PartId, '@part.PartName')" title="Bán lại phụ tùng">
                                                <i class="bi bi-arrow-repeat fs-5"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap CRUD Modal -->
<div class="modal fade" id="partModal" tabindex="-1" aria-labelledby="partModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="partModalLabel">Thêm phụ tùng mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="modalError" class="alert alert-danger d-none"></div>
                <form id="partForm">
                    <input type="hidden" name="PartId" id="partId" value="0" />
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Tên phụ tùng <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="PartName" id="partName" required maxlength="150" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Mã phụ tùng <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="PartCode" id="partCode" required maxlength="50" placeholder="VD: PT-LOPHIEU-MICH" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                            <select class="form-select" name="CategoryId" id="categoryId" required>
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.CategoryId">@cat.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Thương hiệu / Hãng</label>
                            <input type="text" class="form-control" name="Brand" id="brand" maxlength="100" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Giá bán (VND) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" name="Price" id="price" required min="1000" max="1000000000" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Số lượng tồn kho <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" name="Quantity" id="quantity" required min="0" max="100000" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Đường dẫn hình ảnh (URL)</label>
                            <input type="url" class="form-control" name="ImageUrl" id="imageUrl" maxlength="500" placeholder="https://..." />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả phụ tùng</label>
                        <textarea class="form-control" name="Description" id="description" rows="3" maxlength="1000"></textarea>
                    </div>

                    <div class="text-end mt-4">
                        <button type="button" class="btn btn-secondary px-4 fw-bold me-2" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-warning px-4 fw-bold text-dark" style="background-color: #ffc107;" id="btnSubmit">Lưu lại</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Inventory Receipt Modal -->
<div class="modal fade" id="inventoryReceiptModal" tabindex="-1" aria-labelledby="inventoryReceiptModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header bg-success text-white py-3">
                <h5 class="modal-title fw-bold" id="inventoryReceiptModalLabel">
                    <i class="bi bi-box-seam-fill me-2"></i> PHIẾU NHẬP KHO PHỤ TÙNG
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Nhà cung cấp <span class="text-danger">*</span></label>
                        <select class="form-select" id="receiptSupplierId" required onchange="onReceiptFilterChanged()">
                            <option value="">-- Đang tải nhà cung cấp... --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Danh mục phụ tùng <span class="text-danger">*</span></label>
                        <select class="form-select" id="receiptCategoryId" required onchange="onReceiptFilterChanged()">
                            <option value="">-- Chọn danh mục --</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.CategoryId" data-name="@cat.CategoryName">@cat.CategoryName</option>
                            }
                        </select>
                    </div>
                </div>
                
                <div class="mb-4">
                    <label class="form-label fw-bold">Ghi chú nhập kho</label>
                    <textarea class="form-control" id="receiptNotes" rows="2" placeholder="Ví dụ: Nhập kho phụ tùng định kỳ..."></textarea>
                </div>

                <h6 class="fw-bold mb-2 text-secondary d-flex align-items-center">
                    <i class="bi bi-list-stars me-2"></i> DANH SÁCH CHI TIẾT NHẬP KHO
                </h6>
                <div class="table-responsive mb-3 border rounded">
                    <table class="table align-middle mb-0" style="font-size: 14px;" id="receiptItemsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 35%;">Phụ tùng</th>
                                <th style="width: 15%;">Số lượng</th>
                                <th style="width: 20%;">Giá nhập (VND)</th>
                                <th style="width: 25%;">Hạn sử dụng</th>
                                <th style="width: 5%;"></th>
                            </tr>
                        </thead>
                        <tbody id="receiptItemsTableBody">
                            <!-- Rows added dynamically via JS -->
                        </tbody>
                    </table>
                </div>
                
                <button type="button" class="btn btn-outline-success btn-sm fw-bold px-3" onclick="addReceiptItemRow()">
                    <i class="bi bi-plus-circle-fill me-1"></i> THÊM DÒNG PHỤ TÙNG
                </button>

                <div class="text-end mt-4">
                    <button type="button" class="btn btn-secondary px-4 fw-bold me-2" data-bs-dismiss="modal">HỦY BỎ</button>
                    <button type="button" class="btn btn-success px-4 fw-bold" id="btnSaveReceipt" onclick="submitInventoryReceipt()">
                        <i class="bi bi-check-circle-fill me-1"></i> LƯU PHIẾU NHẬP
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="addCategoryModalLabel">
                    <i class="bi bi-folder-plus me-2"></i> THÊM DANH MỤC MỚI
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="addCategoryForm" onsubmit="submitAddCategory(event)">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên danh mục <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="newCatName" required placeholder="Ví dụ: Má phanh, Lốp xe..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả chi tiết</label>
                        <textarea class="form-control" id="newCatDesc" rows="3" placeholder="Mô tả phân loại phụ tùng..."></textarea>
                    </div>
                    <div class="text-end mt-4">
                        <button type="button" class="btn btn-secondary px-4 fw-bold me-2" data-bs-dismiss="modal">HỦY</button>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">THÊM MỚI</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Add Supplier Modal -->
<div class="modal fade" id="addSupplierModal" tabindex="-1" aria-labelledby="addSupplierModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header bg-info text-white py-3">
                <h5 class="modal-title fw-bold" id="addSupplierModalLabel">
                    <i class="bi bi-people-fill me-2"></i> THÊM NHÀ CUNG CẤP MỚI
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="addSupplierForm" onsubmit="submitAddSupplier(event)">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên nhà cung cấp <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="newSupName" required placeholder="Ví dụ: Công ty Phụ tùng Bosch Việt Nam" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Người liên hệ</label>
                        <input type="text" class="form-control" id="newSupContact" placeholder="Họ và tên người liên hệ" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Số điện thoại</label>
                        <input type="text" class="form-control" id="newSupPhone" placeholder="Ví dụ: 0912345678" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email liên hệ</label>
                        <input type="email" class="form-control" id="newSupEmail" placeholder="Ví dụ: info@bosch.vn" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Địa chỉ</label>
                        <input type="text" class="form-control" id="newSupAddress" placeholder="Địa chỉ trụ sở công ty" />
                    </div>
                    <div class="text-end mt-4">
                        <button type="button" class="btn btn-secondary px-4 fw-bold me-2" data-bs-dismiss="modal">HỦY</button>
                        <button type="submit" class="btn btn-info px-4 fw-bold text-white">THÊM MỚI</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var partModal = new bootstrap.Modal(document.getElementById('partModal'));

        // Inventory Receipt flows
        var allSuppliersList = [];
        var filteredPartsList = [];
        var receiptRowIndex = 0;

        // Open Inventory Receipt Modal
        function openInventoryReceiptModal() {
            const modal = new bootstrap.Modal(document.getElementById('inventoryReceiptModal'));
            modal.show();

            if (allSuppliersList.length === 0) {
                fetch('http://localhost:5084/api/Suppliers')
                    .then(res => res.json())
                    .then(suppliers => {
                        allSuppliersList = suppliers;

                        // Populate Supplier dropdown
                        const supplierSelect = document.getElementById('receiptSupplierId');
                        supplierSelect.innerHTML = '<option value="">-- Chọn nhà cung cấp --</option>';
                        allSuppliersList.forEach(s => {
                            if (s.status === 'Active') {
                                supplierSelect.innerHTML += `<option value="${s.supplierId}">${s.supplierName}</option>`;
                            }
                        });

                        // Reset rows and selection
                        document.getElementById('receiptCategoryId').value = '';
                        document.getElementById('receiptNotes').value = '';
                        document.getElementById('receiptItemsTableBody').innerHTML = '';
                        filteredPartsList = [];
                        addReceiptItemRow();
                    })
                    .catch(err => {
                        Swal.fire('Lỗi', 'Không thể tải danh sách nhà cung cấp: ' + err.message, 'error');
                    });
            } else {
                document.getElementById('receiptCategoryId').value = '';
                document.getElementById('receiptNotes').value = '';
                document.getElementById('receiptItemsTableBody').innerHTML = '';
                filteredPartsList = [];
                addReceiptItemRow();
            }
        }

        // Handle filter triggers (Category & Supplier)
        function onReceiptFilterChanged() {
            const supplierId = document.getElementById('receiptSupplierId').value;
            const categoryId = document.getElementById('receiptCategoryId').value;

            if (!categoryId) {
                filteredPartsList = [];
                updateAllRowDropdowns();
                return;
            }

            fetch(`/Parts/GetFilteredParts?categoryId=${categoryId}&supplierId=${supplierId || 0}`)
                .then(res => res.json())
                .then(parts => {
                    filteredPartsList = parts;
                    updateAllRowDropdowns();
                })
                .catch(err => {
                    console.error("Lỗi tải phụ tùng đã lọc: ", err);
                    filteredPartsList = [];
                    updateAllRowDropdowns();
                });
        }

        // Update dropdown list options on all rows
        function updateAllRowDropdowns() {
            const selects = document.querySelectorAll('.receipt-part-select');
            selects.forEach(selectEl => {
                const currentVal = selectEl.value;
                populatePartSelectOptions(selectEl);
                if (currentVal && selectEl.querySelector(`option[value="${currentVal}"]`)) {
                    selectEl.value = currentVal;
                } else {
                    selectEl.value = "";
                    onReceiptPartChange(selectEl);
                }
            });
        }

        // Populate options in a single select tag
        function populatePartSelectOptions(selectEl) {
            let partOptions = '<option value="">-- Chọn phụ tùng --</option>';

            const categorySelect = document.getElementById('receiptCategoryId');
            const categoryName = categorySelect.options[categorySelect.selectedIndex]?.getAttribute('data-name') || '';
            const isPerishable = ["Dầu nhớt", "Hóa chất", "Ắc quy"].includes(categoryName);
            const perishableBadge = isPerishable ? ' *Hạn sử dụng' : '';

            filteredPartsList.forEach(p => {
                partOptions += `<option value="${p.partId}" data-code="${p.partCode}" data-name="${p.partName}" data-perishable="${isPerishable}">${p.partName} (${p.partCode})${perishableBadge}</option>`;
            });

            // Add the special "[NEW]" option
            partOptions += `<option value="[NEW]" data-perishable="false" style="color: #198754; font-weight: bold;">[+] -- THÊM MỚI PHỤ TÙNG --</option>`;

            selectEl.innerHTML = partOptions;
        }

        // Add a new row to the receipt detail items table
        function addReceiptItemRow() {
            const tbody = document.getElementById('receiptItemsTableBody');
            const currentIndex = receiptRowIndex++;

            const trMain = document.createElement('tr');
            trMain.id = `receiptRow_Main_${currentIndex}`;
            trMain.setAttribute('data-index', currentIndex);

            const trForm = document.createElement('tr');
            trForm.id = `receiptRow_Form_${currentIndex}`;
            trForm.className = 'new-part-form-row d-none bg-light';
            trForm.setAttribute('data-index', currentIndex);

            const selectId = `receiptPartSelect_${currentIndex}`;

            trMain.innerHTML = `
                <td>
                    <select class="form-select form-select-sm receipt-part-select" id="${selectId}" onchange="onReceiptPartChange(this)">
                        <!-- Loaded dynamically -->
                    </select>
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm receipt-qty" min="1" value="1" required />
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm receipt-price" min="0" placeholder="0" required />
                </td>
                <td>
                    <input type="date" class="form-control form-control-sm receipt-expired" />
                    <small class="text-danger d-none expired-req">* Bắt buộc</small>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-link text-danger p-0" onclick="removeReceiptRow(${currentIndex})"><i class="bi bi-trash-fill fs-5"></i></button>
                </td>
            `;

            trForm.innerHTML = `
                <td colspan="5" class="p-3 border rounded shadow-sm" style="background-color: #fcfcfc;">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label fw-bold mb-1" style="font-size:11px; color:#555;">Tên phụ tùng mới <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm new-part-name" placeholder="Ví dụ: Kính chiếu hậu Vios" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold mb-1" style="font-size:11px; color:#555;">Mã phụ tùng mới <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm new-part-code" placeholder="Ví dụ: KCH-TOY-01" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold mb-1" style="font-size:11px; color:#555;">Thương hiệu</label>
                            <input type="text" class="form-control form-control-sm new-part-brand" placeholder="Ví dụ: Toyota OEM" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold mb-1" style="font-size:11px; color:#555;">Giá bán ra đề xuất (VND) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control form-control-sm new-part-price-sell" placeholder="Giá bán khách" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold mb-1" style="font-size:11px; color:#555;">Đơn vị tính</label>
                            <input type="text" class="form-control form-control-sm new-part-uom" value="Cái" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold mb-1" style="font-size:11px; color:#555;">Bảo hành (tháng)</label>
                            <input type="number" class="form-control form-control-sm new-part-warranty" value="0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold mb-1" style="font-size:11px; color:#555;">Vị trí kho</label>
                            <input type="text" class="form-control form-control-sm new-part-location" placeholder="Khu B - Kệ 2" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold mb-1" style="font-size:11px; color:#555;">Min Level (cảnh báo)</label>
                            <input type="number" class="form-control form-control-sm new-part-min" value="5" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold mb-1" style="font-size:11px; color:#555;">Max Level (chứa tối đa)</label>
                            <input type="number" class="form-control form-control-sm new-part-max" value="100" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold mb-1" style="font-size:11px; color:#555;">Mô tả ngắn</label>
                            <input type="text" class="form-control form-control-sm new-part-desc" placeholder="Ghi chú thêm..." />
