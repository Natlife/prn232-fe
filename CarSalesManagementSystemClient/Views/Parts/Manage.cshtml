                </td>
            `;

            tbody.appendChild(trMain);
            tbody.appendChild(trForm);

            const selectEl = document.getElementById(selectId);
            populatePartSelectOptions(selectEl);
        }

        // Toggle form sub-row based on selection (regular vs new part)
        function onReceiptPartChange(selectEl) {
            const val = selectEl.value;
            const row = selectEl.closest('tr');
            const currentIndex = row.getAttribute('data-index');
            const formRow = document.getElementById(`receiptRow_Form_${currentIndex}`);

            const expiredInput = row.querySelector('.receipt-expired');
            const expiredReq = row.querySelector('.expired-req');

            const categorySelect = document.getElementById('receiptCategoryId');
            const categoryName = categorySelect.options[categorySelect.selectedIndex]?.getAttribute('data-name') || '';
            const isPerishableCategory = ["Dầu nhớt", "Hóa chất", "Ắc quy"].includes(categoryName);

            if (val === "[NEW]") {
                formRow.classList.remove('d-none');
                if (isPerishableCategory) {
                    expiredInput.setAttribute('required', 'required');
                    expiredReq.classList.remove('d-none');
                } else {
                    expiredInput.removeAttribute('required');
                    expiredReq.classList.add('d-none');
                }
            } else {
                formRow.classList.add('d-none');
                const selectedOption = selectEl.options[selectEl.selectedIndex];
                const isPerishable = selectedOption?.getAttribute('data-perishable') === 'true';

                if (isPerishable) {
                    expiredInput.setAttribute('required', 'required');
                    expiredReq.classList.remove('d-none');
                } else {
                    expiredInput.removeAttribute('required');
                    expiredReq.classList.add('d-none');
                }
            }
        }

        // Remove row helper
        function removeReceiptRow(index) {
            const tbody = document.getElementById('receiptItemsTableBody');
            const mainRows = tbody.querySelectorAll('tr[id^="receiptRow_Main_"]');
            if (mainRows.length > 1) {
                document.getElementById(`receiptRow_Main_${index}`).remove();
                document.getElementById(`receiptRow_Form_${index}`).remove();
            } else {
                Swal.fire('Nhắc nhở', 'Phải có ít nhất 1 phụ tùng nhập kho.', 'warning');
            }
        }

        // Submit Inventory Receipt
        function submitInventoryReceipt() {
            const supplierId = document.getElementById('receiptSupplierId').value;
            const categoryId = document.getElementById('receiptCategoryId').value;

            if (!supplierId) {
                Swal.fire('Nhắc nhở', 'Vui lòng chọn nhà cung cấp.', 'warning');
                return;
            }
            if (!categoryId) {
                Swal.fire('Nhắc nhở', 'Vui lòng chọn danh mục phụ tùng nhập kho.', 'warning');
                return;
            }

            const notes = document.getElementById('receiptNotes').value.trim();
            const mainRows = document.querySelectorAll('#receiptItemsTableBody tr[id^="receiptRow_Main_"]');
            const items = [];

            const categorySelect = document.getElementById('receiptCategoryId');
            const categoryName = categorySelect.options[categorySelect.selectedIndex]?.getAttribute('data-name') || '';
            const isPerishableCategory = ["Dầu nhớt", "Hóa chất", "Ắc quy"].includes(categoryName);

            for (let row of mainRows) {
                const currentIndex = row.getAttribute('data-index');
                const partSelect = row.querySelector('.receipt-part-select');
                const partIdVal = partSelect.value;

                if (!partIdVal) {
                    Swal.fire('Nhắc nhở', 'Vui lòng chọn phụ tùng cho tất cả các hàng.', 'warning');
                    return;
                }

                const quantity = parseInt(row.querySelector('.receipt-qty').value);
                const importPrice = parseFloat(row.querySelector('.receipt-price').value);
                const expiredInput = row.querySelector('.receipt-expired');
                const expiredAt = expiredInput.value ? new Date(expiredInput.value).toISOString() : null;

                if (isNaN(quantity) || quantity <= 0) {
                    Swal.fire('Nhắc nhở', 'Số lượng phải lớn hơn 0.', 'warning');
                    return;
                }
                if (isNaN(importPrice) || importPrice < 0) {
                    Swal.fire('Nhắc nhở', 'Giá nhập không được âm.', 'warning');
                    return;
                }

                if (isPerishableCategory && !expiredAt) {
                    Swal.fire('Nhắc nhở', 'Nhóm danh mục này bắt buộc phải điền Hạn sử dụng (ExpiredAt).', 'warning');
                    return;
                }

                let itemDto = {
                    quantity: quantity,
                    importPrice: importPrice,
                    expiredAt: expiredAt
                };

                if (partIdVal === "[NEW]") {
                    const formContainer = document.getElementById(`receiptRow_Form_${currentIndex}`);
                    const newPartName = formContainer.querySelector('.new-part-name').value.trim();
                    const newPartCode = formContainer.querySelector('.new-part-code').value.trim();
                    const newPartBrand = formContainer.querySelector('.new-part-brand').value.trim();
                    const newPartPriceSell = parseFloat(formContainer.querySelector('.new-part-price-sell').value);
                    const newPartUom = formContainer.querySelector('.new-part-uom').value.trim();
                    const newPartWarranty = parseInt(formContainer.querySelector('.new-part-warranty').value) || 0;
                    const newPartLocation = formContainer.querySelector('.new-part-location').value.trim();
                    const newPartMin = parseInt(formContainer.querySelector('.new-part-min').value) || 5;
                    const newPartMax = parseInt(formContainer.querySelector('.new-part-max').value) || 100;
                    const newPartDesc = formContainer.querySelector('.new-part-desc').value.trim();

                    if (!newPartName || !newPartCode || isNaN(newPartPriceSell)) {
                        Swal.fire('Nhắc nhở', 'Vui lòng điền đầy đủ Tên, Mã phụ tùng và Giá bán ra cho phụ tùng thêm mới.', 'warning');
                        return;
                    }

                    itemDto.partId = 0;
                    itemDto.newPart = {
                        partName: newPartName,
                        partCode: newPartCode,
                        brand: newPartBrand || null,
                        price: newPartPriceSell,
                        minStockLevel: newPartMin,
                        maxStockLevel: newPartMax,
                        unitOfMeasure: newPartUom || "Cái",
                        warehouseLocation: newPartLocation || null,
                        warrantyMonths: newPartWarranty,
                        description: newPartDesc || null
                    };
                } else {
                    itemDto.partId = parseInt(partIdVal);
                }

                items.push(itemDto);
            }

            const payload = {
                supplierId: parseInt(supplierId),
                categoryId: parseInt(categoryId),
                notes: notes,
                items: items
            };

            const saveBtn = document.getElementById('btnSaveReceipt');
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang lưu...';

            fetch('/Parts/CreateInventoryReceipt', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
            .then(res => {
                if (!res.ok) {
                    return res.json().then(err => { throw new Error(err.message || 'Lỗi lưu phiếu nhập kho'); });
                }
                return res.json();
            })
            .then(data => {
                Swal.fire({
                    title: 'Thành công!',
                    text: 'Tạo phiếu nhập kho thành công.',
                    icon: 'success',
                    confirmButtonColor: '#ffc107'
                }).then(() => {
                    location.reload();
                });
            })
            .catch(err => {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> LƯU PHIẾU NHẬP';
                Swal.fire('Thất bại', err.message, 'error');
            });
        }

        // Admin Modals actions
        function openAddCategoryModal() {
            const modal = new bootstrap.Modal(document.getElementById('addCategoryModal'));
            modal.show();
        }

        function submitAddCategory(e) {
            e.preventDefault();
