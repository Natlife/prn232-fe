@model CarSalesManagementSystemClient.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<style>
    :root {
        --reset-primary: #111318;
        --reset-secondary: #1d2026;
        --reset-accent: #f5b800;
        --reset-accent-hover: #ffca28;
        --reset-text: #17191d;
        --reset-muted: #757a84;
        --reset-border: #e4e6ea;
        --reset-surface: #ffffff;
        --reset-danger: #dc3545;
        --reset-success: #198754;
        --reset-radius: 28px;
        --reset-shadow: 0 30px 80px rgba(17, 19, 24, 0.15);
    }

    .reset-password-page {
        position: relative;
        min-height: calc(100vh - 70px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 72px 20px;
        background: radial-gradient( circle at 12% 18%, rgba(245, 184, 0, 0.13), transparent 30% ), linear-gradient( 135deg, #f7f8fa 0%, #eceef1 52%, #f8f8f9 100% );
        overflow: hidden;
    }

        .reset-password-page::before {
            content: "";
            position: absolute;
            width: 420px;
            height: 420px;
            top: -270px;
            right: -150px;
            border: 70px solid rgba(17, 19, 24, 0.035);
            border-radius: 50%;
            pointer-events: none;
        }

        .reset-password-page::after {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            left: -170px;
            bottom: -170px;
            background-color: rgba(245, 184, 0, 0.08);
            border-radius: 50%;
            pointer-events: none;
        }

    .reset-password-container {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1060px;
        margin: 0 auto;
    }

    .reset-password-card {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        overflow: hidden;
        background-color: var(--reset-surface);
        border: 1px solid rgba(255, 255, 255, 0.9);
        border-radius: var(--reset-radius);
        box-shadow: var(--reset-shadow);
    }

    /* Visual panel */

    .reset-visual {
        position: relative;
        min-height: 640px;
        display: flex;
        align-items: flex-end;
        padding: 52px;
        color: #ffffff;
        background: linear-gradient( to top, rgba(7, 9, 13, 0.97), rgba(7, 9, 13, 0.5) 55%, rgba(7, 9, 13, 0.2) ), url('https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?q=80&w=1400') center / cover no-repeat;
        overflow: hidden;
    }

        .reset-visual::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient( circle at 28% 20%, rgba(245, 184, 0, 0.18), transparent 35% );
            pointer-events: none;
        }

        .reset-visual::after {
            content: "SECURE";
            position: absolute;
            top: 30px;
            left: 25px;
            color: rgba(255, 255, 255, 0.045);
            font-size: 5rem;
            font-weight: 900;
            line-height: 1;
            letter-spacing: -0.07em;
            writing-mode: vertical-rl;
            transform: rotate(180deg);
            pointer-events: none;
        }

    .reset-visual-content {
        position: relative;
        z-index: 2;
        max-width: 430px;
    }

    .reset-brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 22px;
        color: var(--reset-accent);
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

        .reset-brand::before {
            content: "";
            width: 36px;
            height: 2px;
            background-color: var(--reset-accent);
        }

    .reset-visual-title {
        margin-bottom: 18px;
        font-size: clamp(2.3rem, 4.5vw, 3.8rem);
        font-weight: 900;
        line-height: 1.03;
        letter-spacing: -0.05em;
        text-transform: uppercase;
    }

        .reset-visual-title span {
            display: block;
            color: var(--reset-accent);
        }

    .reset-visual-description {
        margin-bottom: 0;
        color: rgba(255, 255, 255, 0.68);
        font-size: 0.95rem;
        line-height: 1.8;
    }

    .reset-security-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 28px;
    }

    .reset-security-item {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        color: rgba(255, 255, 255, 0.78);
        background-color: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 999px;
        font-size: 0.73rem;
        backdrop-filter: blur(8px);
    }

        .reset-security-item i {
            color: var(--reset-accent);
        }

    /* Form panel */

    .reset-form-panel {
        display: flex;
        align-items: center;
        padding: 62px 70px;
    }

    .reset-form-content {
        width: 100%;
        max-width: 460px;
        margin: 0 auto;
    }

    .reset-icon {
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 28px;
        color: var(--reset-primary);
        background-color: var(--reset-accent);
        border-radius: 20px;
        font-size: 1.85rem;
        box-shadow: 0 15px 35px rgba(245, 184, 0, 0.26);
        transform: rotate(-4deg);
        transition: transform 0.3s ease, border-radius 0.3s ease;
    }

    .reset-password-card:hover .reset-icon {
        transform: rotate(0deg);
        border-radius: 50%;
    }

    .reset-page-label {
        margin-bottom: 10px;
        color: #a07800;
        font-size: 0.73rem;
        font-weight: 800;
        letter-spacing: 0.19em;
        text-transform: uppercase;
    }

    .reset-title {
        margin-bottom: 14px;
        color: var(--reset-primary);
        font-size: clamp(2rem, 4vw, 2.8rem);
        font-weight: 900;
        line-height: 1.08;
        letter-spacing: -0.045em;
    }

    .reset-description {
        margin-bottom: 29px;
        color: var(--reset-muted);
        font-size: 0.94rem;
        line-height: 1.75;
    }

    .reset-email {
        color: var(--reset-primary);
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    /* Alert */

    .reset-alert {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        margin-bottom: 22px;
        padding: 14px 16px;
        border-radius: 14px;
        font-size: 0.87rem;
        line-height: 1.55;
    }

        .reset-alert i {
            flex-shrink: 0;
            margin-top: 2px;
        }

    .reset-alert-danger {
        color: #991b1b;
        background-color: #fef2f2;
        border: 1px solid #fecaca;
    }

        .reset-alert-danger i {
            color: var(--reset-danger);
        }

    .reset-alert-success {
        color: #166534;
        background-color: #f0fdf4;
        border: 1px solid #bbf7d0;
    }

        .reset-alert-success i {
            color: var(--reset-success);
        }

    /* Form */

    .reset-form-group {
        margin-bottom: 21px;
    }

    .reset-label {
        display: block;
        margin-bottom: 10px;
        color: var(--reset-primary);
        font-size: 0.81rem;
        font-weight: 800;
    }

    .reset-input-wrapper {
        position: relative;
    }

    .reset-input-icon {
        position: absolute;
        z-index: 2;
        top: 50%;
        left: 17px;
        color: #989ca5;
        font-size: 1rem;
        transform: translateY(-50%);
        pointer-events: none;
        transition: color 0.25s ease;
    }

    .reset-input {
        width: 100%;
        min-height: 56px;
        padding: 14px 16px 14px 48px;
        color: var(--reset-text);
        background-color: #f8f9fa;
        border: 1px solid var(--reset-border);
        border-radius: 14px;
        outline: none;
        font-size: 0.94rem;
        transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

        .reset-input::placeholder {
            color: #a5a8ae;
        }

        .reset-input:hover {
            border-color: #cdd0d5;
        }

        .reset-input:focus {
            background-color: #ffffff;
            border-color: var(--reset-accent);
            box-shadow: 0 0 0 4px rgba(245, 184, 0, 0.13);
        }

    .reset-input-wrapper:focus-within .reset-input-icon {
        color: var(--reset-accent);
    }

    .reset-validation {
        display: block;
        margin-top: 7px;
        font-size: 0.77rem;
    }

    .reset-submit-button {
        width: 100%;
        min-height: 56px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        margin-top: 4px;
        padding: 14px 22px;
        color: var(--reset-primary);
        background-color: var(--reset-accent);
        border: 1px solid var(--reset-accent);
        border-radius: 14px;
        font-size: 0.81rem;
        font-weight: 900;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        box-shadow: 0 15px 34px rgba(245, 184, 0, 0.22);
        transition: transform 0.25s ease, background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

        .reset-submit-button:hover {
            color: var(--reset-primary);
            background-color: var(--reset-accent-hover);
            border-color: var(--reset-accent-hover);
            transform: translateY(-3px);
            box-shadow: 0 20px 42px rgba(245, 184, 0, 0.3);
        }

    .reset-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin: 22px 0 0;
        color: #999da5;
        font-size: 0.74rem;
        text-align: center;
    }

    /* Responsive */

    @@media (max-width: 991.98px) {
        .reset-password-page {
            padding: 55px 20px;
        }

        .reset-password-card {
            grid-template-columns: 1fr;
            max-width: 640px;
            margin: 0 auto;
        }

        .reset-visual {
            min-height: 320px;
            padding: 42px;
        }

        .reset-form-panel {
            padding: 58px;
        }
    }

    @@media (max-width: 575.98px) {
        .reset-password-page {
            min-height: calc(100vh - 56px);
            padding: 28px 12px;
        }

        .reset-password-card {
            border-radius: 22px;
        }

        .reset-visual {
            min-height: 235px;
            padding: 28px 24px;
        }

            .reset-visual::after {
                display: none;
            }

        .reset-visual-title {
            font-size: 2rem;
        }

        .reset-visual-description,
        .reset-security-list {
            display: none;
        }

        .reset-form-panel {
            padding: 40px 24px;
        }

        .reset-icon {
            width: 62px;
            height: 62px;
            margin-bottom: 24px;
            border-radius: 17px;
            font-size: 1.55rem;
        }

        .reset-title {
            font-size: 2rem;
        }

        .reset-description {
            font-size: 0.89rem;
        }

        .reset-input,
        .reset-submit-button {
            min-height: 54px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .reset-icon,
        .reset-submit-button {
            transition: none;
        }

            .reset-password-card:hover .reset-icon,
            .reset-submit-button:hover {
                transform: none;
            }
    }
</style>

<main class="reset-password-page">
    <div class="reset-password-container">
        <div class="reset-password-card">

            <!-- Visual panel -->
            <section class="reset-visual">
                <div class="reset-visual-content">
                    <div class="reset-brand">
                        Group7 ECO DRIVE
                    </div>

                    <h1 class="reset-visual-title">
                        Thiết lập
                        <span>mật khẩu mới</span>
                    </h1>

                    <p class="reset-visual-description">
                        Sử dụng mã OTP được gửi qua email để xác minh tài khoản
                        và hoàn tất quá trình khôi phục mật khẩu.
                    </p>

                    <div class="reset-security-list">
                        <span class="reset-security-item">
                            <i class="bi bi-shield-check"></i>
                            Xác minh OTP
                        </span>

                        <span class="reset-security-item">
                            <i class="bi bi-lock"></i>
                            Bảo mật tài khoản
                        </span>
                    </div>
                </div>
            </section>

            <!-- Form panel -->
            <section class="reset-form-panel">
                <div class="reset-form-content">

                    <div class="reset-icon">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>

                    <div class="reset-page-label">
                        Account recovery
                    </div>

                    <h2 class="reset-title">
                        Đặt lại mật khẩu
                    </h2>

                    <p class="reset-description">
                        Nhập mã OTP đã được gửi vào email
                        <span class="reset-email">@Model.Email</span>
                        cùng với mật khẩu mới.
                    </p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="reset-alert reset-alert-danger" role="alert">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span>@ViewBag.Error</span>
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="reset-alert reset-alert-success" role="alert">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>@TempData["Success"]</span>
                        </div>
                    }

                    <form asp-action="ResetPassword" method="post">
                        <input type="hidden" asp-for="Email" />

                        <div class="reset-form-group">
                            <label asp-for="Otp"
                                   class="reset-label">
                                Mã OTP (6 số)
                            </label>

                            <div class="reset-input-wrapper">
                                <i class="bi bi-123 reset-input-icon"></i>

                                <input asp-for="Otp"
                                       class="reset-input"
                                       placeholder="Nhập mã OTP"
                                       maxlength="6" />
                            </div>

                            <span asp-validation-for="Otp"
                                  class="text-danger reset-validation">
                            </span>
                        </div>

                        <div class="reset-form-group">
                            <label asp-for="NewPassword"
                                   class="reset-label">
                                Mật khẩu mới
                            </label>

                            <div class="reset-input-wrapper">
                                <i class="bi bi-lock reset-input-icon"></i>

                                <input asp-for="NewPassword"
                                       class="reset-input"
                                       placeholder="Nhập mật khẩu mới" />
                            </div>

                            <span asp-validation-for="NewPassword"
                                  class="text-danger reset-validation">
                            </span>
                        </div>

                        <button type="submit"
                                class="reset-submit-button">
                            Đổi mật khẩu
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </form>

                    <p class="reset-note">
                        <i class="bi bi-shield-check"></i>
                        Không chia sẻ mã OTP với bất kỳ ai.
                    </p>

                </div>
            </section>

        </div>
    </div>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}