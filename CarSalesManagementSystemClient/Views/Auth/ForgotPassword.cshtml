@model CarSalesManagementSystemClient.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
}

<style>
    :root {
        --forgot-primary: #111318;
        --forgot-secondary: #1c1f25;
        --forgot-accent: #f5b800;
        --forgot-accent-hover: #ffc928;
        --forgot-danger: #dc3545;
        --forgot-text: #17191d;
        --forgot-muted: #747983;
        --forgot-surface: #ffffff;
        --forgot-background: #f4f5f7;
        --forgot-border: #e4e6ea;
        --forgot-radius: 26px;
        --forgot-shadow: 0 28px 70px rgba(17, 19, 24, 0.13);
    }

    .forgot-password-page {
        position: relative;
        min-height: calc(100vh - 70px);
        display: flex;
        align-items: center;
        padding: 72px 20px;
        background: radial-gradient( circle at 10% 15%, rgba(245, 184, 0, 0.12), transparent 30% ), linear-gradient( 135deg, #f7f8fa 0%, #eef0f3 50%, #f8f8f9 100% );
        overflow: hidden;
    }

        .forgot-password-page::before {
            content: "";
            position: absolute;
            width: 380px;
            height: 380px;
            top: -230px;
            right: -120px;
            border: 65px solid rgba(17, 19, 24, 0.035);
            border-radius: 50%;
            pointer-events: none;
        }

        .forgot-password-page::after {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            left: -150px;
            bottom: -150px;
            background-color: rgba(245, 184, 0, 0.08);
            border-radius: 50%;
            pointer-events: none;
        }

    .forgot-password-container {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1060px;
        margin: 0 auto;
    }

    .forgot-password-card {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        overflow: hidden;
        background-color: var(--forgot-surface);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: var(--forgot-radius);
        box-shadow: var(--forgot-shadow);
    }

    /* =========================
           LEFT PANEL
        ========================== */

    .forgot-password-visual {
        position: relative;
        min-height: 590px;
        display: flex;
        align-items: flex-end;
        padding: 50px;
        color: #ffffff;
        background: linear-gradient( to top, rgba(8, 10, 14, 0.96), rgba(8, 10, 14, 0.35) ), url('https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?q=80&w=1200') center / cover no-repeat;
        overflow: hidden;
    }

        .forgot-password-visual::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient( circle at 30% 20%, rgba(245, 184, 0, 0.18), transparent 35% );
            pointer-events: none;
        }

        .forgot-password-visual::after {
            content: "RESET";
            position: absolute;
            top: 25px;
            left: 24px;
            color: rgba(255, 255, 255, 0.045);
            font-size: 6rem;
            font-weight: 900;
            line-height: 1;
            letter-spacing: -0.08em;
            transform: rotate(-90deg) translateX(-100%);
            transform-origin: top left;
            pointer-events: none;
        }

    .forgot-visual-content {
        position: relative;
        z-index: 2;
    }

    .forgot-brand-label {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        color: var(--forgot-accent);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

        .forgot-brand-label::before {
            content: "";
            width: 34px;
            height: 2px;
            background-color: var(--forgot-accent);
        }

    .forgot-visual-title {
        margin-bottom: 18px;
        font-size: clamp(2.2rem, 4vw, 3.6rem);
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: -0.045em;
        text-transform: uppercase;
    }

    .forgot-visual-description {
        max-width: 420px;
        margin-bottom: 0;
        color: rgba(255, 255, 255, 0.68);
        font-size: 0.95rem;
        line-height: 1.75;
    }

    /* =========================
           FORM PANEL
        ========================== */

    .forgot-password-form-panel {
        display: flex;
        align-items: center;
        padding: 65px 70px;
    }

    .forgot-form-content {
        width: 100%;
        max-width: 460px;
        margin: 0 auto;
    }

    .forgot-icon {
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 28px;
        color: var(--forgot-primary);
        background-color: var(--forgot-accent);
        border-radius: 20px;
        font-size: 1.8rem;
        box-shadow: 0 14px 32px rgba(245, 184, 0, 0.25);
        transform: rotate(-4deg);
        transition: transform 0.3s ease, border-radius 0.3s ease;
    }

    .forgot-password-card:hover .forgot-icon {
        transform: rotate(0deg);
        border-radius: 50%;
    }

    .forgot-page-label {
        margin-bottom: 10px;
        color: var(--forgot-accent);
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    .forgot-title {
        margin-bottom: 14px;
        color: var(--forgot-primary);
        font-size: clamp(2rem, 4vw, 2.8rem);
        font-weight: 900;
        line-height: 1.08;
        letter-spacing: -0.045em;
    }

    .forgot-description {
        margin-bottom: 30px;
        color: var(--forgot-muted);
        font-size: 0.95rem;
        line-height: 1.75;
    }

    /* =========================
           ALERT
        ========================== */

    .forgot-alert {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 24px;
        padding: 14px 16px;
        color: #991b1b;
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 14px;
        font-size: 0.88rem;
        line-height: 1.55;
    }

        .forgot-alert i {
            margin-top: 2px;
            color: var(--forgot-danger);
            font-size: 1rem;
        }

    /* =========================
           INPUT
        ========================== */

    .forgot-form-group {
        margin-bottom: 24px;
    }

    .forgot-label {
        display: block;
        margin-bottom: 10px;
        color: var(--forgot-primary);
        font-size: 0.82rem;
        font-weight: 800;
    }

    .forgot-input-wrapper {
        position: relative;
    }

    .forgot-input-icon {
        position: absolute;
        top: 50%;
        left: 17px;
        color: #989ca4;
        font-size: 1rem;
        transform: translateY(-50%);
        pointer-events: none;
        transition: color 0.25s ease;
    }

    .forgot-input {
        width: 100%;
        min-height: 56px;
        padding: 14px 16px 14px 48px;
        color: var(--forgot-text);
        background-color: #f8f9fa;
        border: 1px solid var(--forgot-border);
        border-radius: 14px;
        outline: none;
        font-size: 0.95rem;
        transition: border-color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease;
    }

        .forgot-input::placeholder {
            color: #a5a8ae;
        }

        .forgot-input:hover {
            border-color: #cdd0d5;
        }

        .forgot-input:focus {
            background-color: #ffffff;
            border-color: var(--forgot-accent);
            box-shadow: 0 0 0 4px rgba(245, 184, 0, 0.13);
        }

    .forgot-input-wrapper:focus-within .forgot-input-icon {
        color: var(--forgot-accent);
    }

    .forgot-validation {
        display: block;
        margin-top: 8px;
        font-size: 0.78rem;
    }

    /* =========================
           BUTTON
        ========================== */

    .forgot-submit-button {
        width: 100%;
        min-height: 56px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 22px;
        color: var(--forgot-primary);
        background-color: var(--forgot-accent);
        border: 1px solid var(--forgot-accent);
        border-radius: 14px;
        font-size: 0.8rem;
        font-weight: 900;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        box-shadow: 0 15px 32px rgba(245, 184, 0, 0.2);
        transition: transform 0.25s ease, background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

        .forgot-submit-button:hover {
            color: var(--forgot-primary);
            background-color: var(--forgot-accent-hover);
            border-color: var(--forgot-accent-hover);
            transform: translateY(-3px);
            box-shadow: 0 20px 40px rgba(245, 184, 0, 0.28);
        }

        .forgot-submit-button:active {
            transform: translateY(-1px);
        }

    .forgot-security-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin: 20px 0 0;
        color: #969aa2;
        font-size: 0.76rem;
        text-align: center;
    }

        .forgot-security-note i {
            color: #737780;
        }

    /* =========================
           RESPONSIVE
        ========================== */

    @@media (max-width: 991.98px) {
        .forgot-password-page {
            padding: 55px 20px;
        }

        .forgot-password-card {
            grid-template-columns: 1fr;
            max-width: 620px;
            margin: 0 auto;
        }

        .forgot-password-visual {
            min-height: 310px;
            padding: 40px;
        }

        .forgot-visual-title {
            max-width: 420px;
        }

        .forgot-password-form-panel {
            padding: 55px;
        }
    }

    @@media (max-width: 575.98px) {
        .forgot-password-page {
            min-height: calc(100vh - 56px);
            padding: 28px 12px;
        }

        .forgot-password-card {
            border-radius: 22px;
        }

        .forgot-password-visual {
            min-height: 235px;
            padding: 28px 24px;
        }

            .forgot-password-visual::after {
                display: none;
            }

        .forgot-visual-title {
            font-size: 2rem;
        }

        .forgot-visual-description {
            display: none;
        }

        .forgot-password-form-panel {
            padding: 38px 24px;
        }

        .forgot-icon {
            width: 62px;
            height: 62px;
            margin-bottom: 24px;
            border-radius: 17px;
            font-size: 1.5rem;
        }

        .forgot-title {
            font-size: 2rem;
        }

        .forgot-description {
            font-size: 0.9rem;
        }

        .forgot-input,
        .forgot-submit-button {
            min-height: 54px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .forgot-icon,
        .forgot-submit-button {
            transition: none;
        }

            .forgot-password-card:hover .forgot-icon,
            .forgot-submit-button:hover {
                transform: none;
            }
    }
</style>

<main class="forgot-password-page">
    <div class="forgot-password-container">
        <div class="forgot-password-card">

            <!-- Visual Panel -->
            <section class="forgot-password-visual">
                <div class="forgot-visual-content">
                    <div class="forgot-brand-label">
                        Group7 ECO DRIVE
                    </div>

                    <h1 class="forgot-visual-title">
                        Khôi phục tài khoản
                    </h1>

                    <p class="forgot-visual-description">
                        Nhập email đã đăng ký để nhận mã OTP và tiếp tục thiết lập
                        mật khẩu mới cho tài khoản của bạn.
                    </p>
                </div>
            </section>

            <!-- Form Panel -->
            <section class="forgot-password-form-panel">
                <div class="forgot-form-content">

                    <div class="forgot-icon">
                        <i class="bi bi-key-fill"></i>
                    </div>

                    <div class="forgot-page-label">
                        My account
                    </div>

                    <h2 class="forgot-title">
                        Quên mật khẩu?
                    </h2>

                    <p class="forgot-description">
                        Quên mật khẩu? Vui lòng nhập địa chỉ email. Bạn sẽ nhận
                        được một mã OTP tạo mật khẩu mới qua email.
                    </p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="forgot-alert" role="alert">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span>@ViewBag.Error</span>
                        </div>
                    }

                    <form asp-action="ForgotPassword" method="post">
                        <div class="forgot-form-group">
                            <label asp-for="Email"
                                   class="forgot-label">
                                Địa chỉ email *
                            </label>

                            <div class="forgot-input-wrapper">
                                <i class="bi bi-envelope forgot-input-icon"></i>

                                <input asp-for="Email"
                                       class="forgot-input"
                                       placeholder="Nhập địa chỉ email"
                                       autocomplete="email"
                                       required />
                            </div>

                            <span asp-validation-for="Email"
                                  class="text-danger forgot-validation">
                            </span>
                        </div>

                        <button type="submit"
                                class="forgot-submit-button">
                            <i class="bi bi-send-fill"></i>
                            Đặt lại mật khẩu
                        </button>
                    </form>

                    <p class="forgot-security-note">
                        <i class="bi bi-shield-check"></i>
                        Thông tin tài khoản của bạn được bảo mật.
                    </p>

                </div>
            </section>

        </div>
    </div>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}