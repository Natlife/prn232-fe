@model CarSalesManagementSystemClient.Models.UnifiedCart
@{
    ViewData["Title"] = "Giỏ Hàng Của Bạn";
}

<div class="container mt-4">
    <h2 class="mb-4">Giỏ Hàng Của Bạn</h2>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-info">
            Giỏ hàng của bạn đang trống.
            <a href="/" class="alert-link">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Sản phẩm/Dịch vụ</th>
                        <th>Loại</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" style="height: 50px; object-fit: cover; margin-right: 10px;" />
                                }
                                <strong>@item.Name</strong>
                            </td>
                            <td>
                                @if (item.ItemType == "Package")
                                {
                                    <span class="badge bg-primary">Gói Bảo Dưỡng</span>
                                }
                                else if (item.ItemType == "Service")
                                {
                                    <span class="badge bg-info">Dịch Vụ Lẻ</span>
                                }
                                else if (item.ItemType == "Car")
                                {
                                    <span class="badge bg-warning text-dark">Ô Tô</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Phụ Tùng</span>
                                }
                            </td>
                            <td>@item.Price.ToString("N0") VNĐ</td>
                            <td>
                                @if (item.ItemType == "Part")
                                {
                                    <form asp-action="UpdateQuantity" asp-controller="Cart" method="post" class="d-flex align-items-center">
                                        <input type="hidden" name="itemType" value="@item.ItemType" />
                                        <input type="hidden" name="itemId" value="@item.ItemId" />
                                        <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm me-2" style="width: 70px;" onchange="this.form.submit()" />
                                    </form>
                                }
                                else
                                {
                                    <span>@item.Quantity</span>
                                }
                            </td>
                            <td>@item.SubTotal.ToString("N0") VNĐ</td>
                            <td>
                                <form asp-action="RemoveFromCart" asp-controller="Cart" method="post">
                                    <input type="hidden" name="itemType" value="@item.ItemType" />
                                    <input type="hidden" name="itemId" value="@item.ItemId" />
                                    <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-end fw-bold fs-5">Tổng Tiền:</td>
                        <td colspan="2" class="text-danger fw-bold fs-5">@Model.TotalAmount.ToString("N0") VNĐ</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a href="/" class="btn btn-outline-secondary">Tiếp tục mua sắm</a>
            <a asp-action="Checkout" asp-controller="Cart" class="btn btn-success btn-lg">Tiến Hành Thanh Toán & Đặt Lịch</a>
        </div>
    }
</div>
