@model CarSalesManagementSystemClient.Models.UnifiedCheckoutPostModel
@{
    ViewData["Title"] = "Thanh Toán & Đặt Lịch Bảo Dưỡng";
    var cart = ViewBag.Cart as CarSalesManagementSystemClient.Models.UnifiedCart ?? new CarSalesManagementSystemClient.Models.UnifiedCart();
}

<style>
    .step-indicator {
        display: flex;
        justify-content: space-between;
        margin-bottom: 2rem;
        position: relative;
    }
    .step-indicator::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 2px;
        background-color: #dee2e6;
        z-index: 1;
        transform: translateY(-50%);
    }
    .step-indicator-item {
        position: relative;
        z-index: 2;
        background-color: #fff;
        border: 2px solid #dee2e6;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: #6c757d;
        transition: all 0.3s ease;
    }
    .step-indicator-item.active {
        border-color: #ffc107;
        background-color: #ffc107;
        color: #212529;
        box-shadow: 0 0 0 4px rgba(255, 193, 7, 0.25);
    }
    .step-indicator-item.completed {
        border-color: #198754;
        background-color: #198754;
        color: #fff;
    }
    .step-indicator-label {
        font-size: 11px;
        position: absolute;
        top: 45px;
        width: 80px;
        text-align: center;
        left: 50%;
        transform: translateX(-50%);
        font-weight: 600;
    }
    .wizard-step {
        display: none;
    }
    .wizard-step.active {
        display: block;
    }
    .btn-gold {
        background-color: #ffc107;
        border-color: #ffc107;
        color: #212529;
        font-weight: bold;
        transition: all 0.2s ease;
    }
    .btn-gold:hover {
        background-color: #e0a800;
        border-color: #d39e00;
        color: #212529;
    }
</style>

<div class="container py-5" style="min-height: 80vh;">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-md-11">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="bg-dark text-white p-4 text-center">
                    <h3 class="fw-bold m-0 text-warning"><i class="bi bi-cart-check-fill me-2"></i>Thanh Toán & Đặt Lịch</h3>
                    <p class="text-secondary mb-0 mt-1">Hoàn tất yêu cầu mua phụ tùng và đặt lịch hẹn bảo dưỡng</p>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <!-- Progress Step Indicator -->
                    <div class="step-indicator px-4 mb-5">
                        <div class="step-indicator-item active" id="ind-1">
                            1
                            <span class="step-indicator-label text-dark">Giỏ hàng</span>
                        </div>
                        <div class="step-indicator-item" id="ind-2">
                            2
                            <span class="step-indicator-label">Dịch vụ</span>
                        </div>
                        <div class="step-indicator-item" id="ind-3">
                            3
                            <span class="step-indicator-label">Thông tin xe</span>
                        </div>
                        <div class="step-indicator-item" id="ind-4">
                            4
                            <span class="step-indicator-label">Lịch hẹn</span>
                        </div>
                        <div class="step-indicator-item" id="ind-5">
                            5
                            <span class="step-indicator-label">Xác nhận</span>
                        </div>
                        <div class="step-indicator-item" id="ind-6">
                            ✓
                            <span class="step-indicator-label">Hoàn tất</span>
                        </div>
                    </div>

                    <div id="checkoutAlert" class="alert alert-danger d-none rounded-3 shadow-sm mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span id="checkoutAlertText"></span>
                    </div>

                    <!-- STEP 1: GIỎ HÀNG (PHỤ TÙNG MUA RIÊNG HOẶC DÙNG BẢO DƯỠNG) -->
                    <div class="wizard-step active" id="step-1">
                        <h4 class="fw-bold mb-4 text-dark"><i class="bi bi-gear-wide-connected text-warning me-2"></i>BƯỚC 1: Phân loại mục đích sử dụng phụ tùng</h4>
                        
                        @{
                            var partItems = cart.Items.Where(i => i.ItemType == "Part").ToList();
                        }
                        
                        @if (!partItems.Any())
                        {
                            <div class="alert alert-light border py-4 text-center rounded-3">
                                <i class="bi bi-info-circle text-secondary fs-4 d-block mb-2"></i>
                                Không có linh kiện, phụ tùng nào trong giỏ hàng của bạn.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive rounded-3 border mb-4">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="py-3 px-4">Tên phụ tùng</th>
                                            <th class="py-3 text-center" style="width: 100px;">Số lượng</th>
                                            <th class="py-3 text-end" style="width: 150px;">Thành tiền</th>
                                            <th class="py-3 px-4" style="width: 320px;">Mục đích sử dụng</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in partItems)
                                        {
                                            <tr data-item-id="@item.ItemId">
                                                <td class="py-3 px-4">
                                                    <strong>@item.Name</strong>
                                                    <div class="small text-muted">Đơn giá: @item.Price.ToString("N0") đ</div>
                                                </td>
                                                <td class="py-3 text-center">@item.Quantity</td>
                                                <td class="py-3 text-end fw-bold text-slate-800">@item.SubTotal.ToString("N0") đ</td>
                                                <td class="py-3 px-4">
                                                    <div class="d-flex flex-column gap-2">
                                                        <div class="form-check">
                                                            <input class="form-check-input purpose-radio" type="radio" 
                                                                   name="purpose-@item.ItemId" id="pur-std-@item.ItemId" 
                                                                   value="Standalone" @(item.Purpose != "Maintenance" ? "checked" : "")
                                                                   onchange="changePurpose('Part', @item.ItemId, 'Standalone')">
                                                            <label class="form-check-label small fw-semibold text-secondary" for="pur-std-@item.ItemId">
                                                                Mua riêng mang về
                                                            </label>
                                                        </div>
                                                        <div class="form-check">
                                                            <input class="form-check-input purpose-radio" type="radio" 
                                                                   name="purpose-@item.ItemId" id="pur-maint-@item.ItemId" 
                                                                   value="Maintenance" @(item.Purpose == "Maintenance" ? "checked" : "")
                                                                   onchange="changePurpose('Part', @item.ItemId, 'Maintenance')">
                                                            <label class="form-check-label small fw-semibold text-secondary" for="pur-maint-@item.ItemId">
                                                                Sử dụng trong lần bảo dưỡng này
                                                            </label>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        
                        <div class="d-flex justify-content-between mt-5">
                            <a href="/Cart" class="btn btn-outline-secondary rounded-3 px-4">Quay lại Giỏ hàng</a>
                            <button type="button" class="btn btn-gold rounded-3 px-5" onclick="goToStep(2)">Tiếp theo <i class="bi bi-arrow-right ms-1"></i></button>
                        </div>
                    </div>

                    <!-- STEP 2: DỊCH VỤ -->
                    <div class="wizard-step" id="step-2">
                        <h4 class="fw-bold mb-4 text-dark"><i class="bi bi-wrench-adjustable text-warning me-2"></i>BƯỚC 2: Chọn gói bảo dưỡng và dịch vụ lẻ</h4>
                        
                        @{
                            var serviceItems = cart.Items.Where(i => i.ItemType == "Package" || i.ItemType == "Service").ToList();
                        }
                        
                        @if (!serviceItems.Any())
                        {
                            <div class="alert alert-warning rounded-3 mb-4">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                Bạn chưa chọn gói bảo dưỡng hay dịch vụ nào. Nếu bạn có phụ tùng đánh dấu <em>"Sử dụng trong lần bảo dưỡng này"</em>, bạn bắt buộc phải chọn ít nhất một dịch vụ bảo dưỡng ở trang chủ để gắn kèm.
                            </div>
                            <div class="text-center py-3">
                                <a href="/" class="btn btn-outline-dark rounded-pill px-4"><i class="bi bi-plus-circle me-1"></i> Chọn dịch vụ bảo dưỡng ngay</a>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive rounded-3 border mb-4">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="py-3 px-4">Tên dịch vụ / gói</th>
                                            <th class="py-3">Phân loại</th>
                                            <th class="py-3 text-end px-4" style="width: 200px;">Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in serviceItems)
                                        {
                                            <tr>
                                                <td class="py-3 px-4 fw-bold text-slate-800">@item.Name</td>
                                                <td class="py-3">
                                                    @if (item.ItemType == "Package")
                                                    {
                                                        <span class="badge bg-primary">Gói bảo dưỡng định kỳ</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-info text-dark">Dịch vụ sửa chữa lẻ</span>
                                                    }
                                                </td>
                                                <td class="py-3 text-end fw-bold text-dark px-4">@item.Price.ToString("N0") đ</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        
                        <div class="d-flex justify-content-between mt-5">
                            <button type="button" class="btn btn-outline-secondary rounded-3 px-4" onclick="goToStep(1)"><i class="bi bi-arrow-left me-1"></i> Quay lại</button>
                            <button type="button" class="btn btn-gold rounded-3 px-5" onclick="goToStep(3)">Tiếp theo <i class="bi bi-arrow-right ms-1"></i></button>
                        </div>
                    </div>

                    <!-- STEP 3: THÔNG TIN XE -->
                    <div class="wizard-step" id="step-3">
                        <h4 class="fw-bold mb-4 text-dark"><i class="bi bi-car-front text-warning me-2"></i>BƯỚC 3: Thông tin xe cần bảo dưỡng</h4>

                        <!-- Chọn nguồn xe: chỉ hiện khi trong giỏ có mua xe -->
                        <div id="carSourceChoice" class="d-none mb-4">
                            <label class="form-label fw-semibold text-secondary mb-2">Bạn muốn bảo dưỡng xe nào?</label>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="w-100 p-3 border rounded-4 d-flex align-items-center gap-2 mb-0" style="cursor:pointer;">
                                        <input class="form-check-input mt-0" type="radio" name="carSource" id="carSourceInCart" value="InCart" checked>
                                        <span><strong>Xe trong giỏ hàng</strong><br><span class="small text-muted" id="carSourceInCartName">Xe bạn đang mua</span></span>
                                    </label>
                                </div>
                                <div class="col-md-6">
                                    <label class="w-100 p-3 border rounded-4 d-flex align-items-center gap-2 mb-0" style="cursor:pointer;">
                                        <input class="form-check-input mt-0" type="radio" name="carSource" id="carSourceOther" value="Other">
                                        <span><strong>Xe khác</strong><br><span class="small text-muted">Xe bạn đã có sẵn</span></span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div id="carInfoInputs" class="p-4 bg-light rounded-4 border mb-4">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="CarNameInput" class="form-label fw-semibold text-secondary">Tên xe / Mẫu xe</label>
                                    <input type="text" class="form-control rounded-3" id="CarNameInput" placeholder="VD: Toyota Vios 2022" value="@Model.CarName">
                                    <div class="small text-muted mt-1">Hãng xe, mẫu xe và đời xe cụ thể.</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="LicensePlateInput" class="form-label fw-semibold text-secondary">Biển số xe</label>
                                    <input type="text" class="form-control rounded-3" id="LicensePlateInput" placeholder="VD: 30A-123.45" value="@Model.LicensePlate">
                                    <div class="small text-muted mt-1">Biển số để nhận diện khi đến showroom.</div>
                                </div>
                            </div>
                        </div>

                        <div id="carInCartHint" class="alert alert-success rounded-3 small mb-0 d-none">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            Bảo dưỡng cho xe đang mua trong giỏ. Bạn có thể nhấn <strong>Tiếp theo</strong> để bỏ qua nhập thông tin (xe chưa có biển số).
                        </div>
                        <div id="carOtherHint" class="alert alert-info rounded-3 small mb-0">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            Nếu giỏ hàng không có gói/linh kiện bảo dưỡng nào, bạn có thể nhấn <strong>Tiếp theo</strong> để bỏ qua thông tin xe.
                        </div>

                        <div class="d-flex justify-content-between mt-5">
                            <button type="button" class="btn btn-outline-secondary rounded-3 px-4" onclick="goToStep(2)"><i class="bi bi-arrow-left me-1"></i> Quay lại</button>
                            <button type="button" class="btn btn-gold rounded-3 px-5" onclick="goToStep(4)">Tiếp theo <i class="bi bi-arrow-right ms-1"></i></button>
                        </div>
                    </div>

                    <!-- STEP 4: LỊCH HẸN -->
                    <div class="wizard-step" id="step-4">
                        <h4 class="fw-bold mb-4 text-dark"><i class="bi bi-calendar-event text-warning me-2"></i>BƯỚC 4: Chọn thời gian đặt lịch bảo dưỡng</h4>
                        
                        <div class="p-4 bg-light rounded-4 border mb-4">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="AppointmentDateInput" class="form-label fw-semibold text-secondary">Chọn ngày hẹn</label>
                                    <input type="date" class="form-control rounded-3" id="AppointmentDateInput" min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")">
                                </div>
                                <div class="col-md-6">
                                    <label for="AppointmentTimeInput" class="form-label fw-semibold text-secondary">Chọn giờ hẹn</label>
                                    <input type="time" class="form-control rounded-3" id="AppointmentTimeInput" value="09:00">
                                </div>
                                <div class="col-12 mt-3">
                                    <label for="NoteInput" class="form-label fw-semibold text-secondary">Ghi chú yêu cầu thêm cho showroom</label>
                                    <textarea class="form-control rounded-3" id="NoteInput" rows="3" placeholder="VD: Tôi muốn kiểm tra thêm hệ thống phanh xe..."></textarea>
                                </div>
                            </div>
                        </div>
                        
                        <div class="d-flex justify-content-between mt-5">
                            <button type="button" class="btn btn-outline-secondary rounded-3 px-4" onclick="goToStep(3)"><i class="bi bi-arrow-left me-1"></i> Quay lại</button>
                            <button type="button" class="btn btn-gold rounded-3 px-5" onclick="goToStep(5)">Xem trước & Xác nhận <i class="bi bi-arrow-right ms-1"></i></button>
                        </div>
                    </div>

                    <!-- STEP 5: XÁC NHẬN -->
                    <div class="wizard-step" id="step-5">
                        <h4 class="fw-bold mb-4 text-dark"><i class="bi bi-clipboard-check text-warning me-2"></i>BƯỚC 5: Xác nhận chi phí và thông tin đơn hàng</h4>
                        
                        <div class="row g-4">
                            <!-- Left columns: Summary list -->
                            <div class="col-md-7">
                                <!-- Section 0: Ô tô (yêu cầu mua) -->
                                <div class="card border mb-3 rounded-3 shadow-sm overflow-hidden d-none" id="summaryCarCard">
                                    <div class="card-header bg-dark text-warning fw-bold py-2.5 d-flex align-items-center">
                                        🚗 Ô TÔ (YÊU CẦU MUA)
                                        <a tabindex="0" role="button" class="ms-2 text-warning" data-bs-toggle="popover" data-bs-trigger="focus" title="Về việc mua ô tô"
                                           data-bs-content="Xe cần nhân viên xác nhận. Sau khi đặt hàng, bạn vào 'Hóa đơn của tôi', liên hệ nhân viên nhận mã và nhập để xác thực đặt cọc/mua đứt.">
                                            <i class="bi bi-exclamation-circle-fill"></i>
                                        </a>
                                    </div>
                                    <div class="card-body p-0">
                                        <ul class="list-group list-group-flush small" id="summaryCarList"></ul>
                                    </div>
                                </div>

                                <!-- Section A: Standalone Parts -->
                                <div class="card border mb-3 rounded-3 shadow-sm overflow-hidden" id="summaryStandaloneCard">
                                    <div class="card-header bg-dark text-warning fw-bold py-2.5">
                                        🛒 PHỤ TÙNG MUA RIÊNG MANG VỀ
                                    </div>
                                    <div class="card-body p-0">
                                        <ul class="list-group list-group-flush small" id="summaryStandaloneList">
                                            <!-- Dynamically rendered -->
                                        </ul>
                                    </div>
                                    <div class="card-footer bg-light">
                                        @* Tạm thời chỉ hỗ trợ nhận tại showroom — ẩn lựa chọn giao hàng. *@
                                        <input type="radio" name="deliveryMethod" id="del-pickup" value="Pickup" checked class="d-none">
                                        <div class="small text-secondary">
                                            <i class="bi bi-shop me-1 text-warning"></i>Hình thức nhận: <strong>Nhận tại showroom</strong>
                                        </div>
                                        <div class="mb-2 d-none" id="shippingAddressContainer">
                                            <label for="ShippingAddressInput" class="form-label fw-bold text-secondary small">Địa chỉ nhận phụ tùng:</label>
                                            <input type="text" class="form-control form-control-sm rounded-2" id="ShippingAddressInput" placeholder="Nhập địa chỉ nhà của bạn">
                                        </div>
                                    </div>
                                </div>

                                <!-- Section B: Maintenance Appointment -->
                                <div class="card border mb-3 rounded-3 shadow-sm overflow-hidden" id="summaryMaintenanceCard">
                                    <div class="card-header bg-dark text-warning fw-bold py-2.5">
                                        🔧 LỊCH HẸN & DỊCH VỤ BẢO DƯỠNG
                                    </div>
                                    <div class="card-body p-0">
                                        <ul class="list-group list-group-flush small" id="summaryMaintenanceList">
                                            <!-- Dynamically rendered -->
                                        </ul>
                                        <div class="p-3 bg-light border-top">
                                            <div class="row g-2 text-secondary small">
                                                <div class="col-6">Thông tin xe:</div>
                                                <div class="col-6 fw-bold text-dark text-end" id="summaryCarText"></div>
                                                
                                                <div class="col-6">Thời gian hẹn:</div>
                                                <div class="col-6 fw-bold text-dark text-end" id="summaryTimeText"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right column: Customer and Total cost -->
                            <div class="col-md-5">
                                <div class="card border rounded-3 bg-light shadow-sm mb-3">
                                    <div class="card-body">
                                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="bi bi-person-circle"></i> Thông tin liên hệ nhận đơn</h6>
                                        <div class="mb-3">
                                            <label for="CustomerNameInput" class="form-label small text-muted mb-1">Họ và tên</label>
                                            <input type="text" class="form-control form-control-sm rounded-2" id="CustomerNameInput" value="@Model.CustomerName" required>
                                        </div>
                                        <div class="mb-3">
                                            <label for="CustomerPhoneInput" class="form-label small text-muted mb-1">Số điện thoại</label>
                                            <input type="text" class="form-control form-control-sm rounded-2" id="CustomerPhoneInput" value="@Model.CustomerPhone" required>
                                        </div>
                                        <div class="mb-0">
                                            <label for="CustomerEmailInput" class="form-label small text-muted mb-1">Email</label>
                                            <input type="email" class="form-control form-control-sm rounded-2" id="CustomerEmailInput" value="@Model.CustomerEmail">
                                        </div>
                                    </div>
                                </div>

                                <div class="card border rounded-3 bg-dark text-white shadow-sm">
                                    <div class="card-body">
                                        <h6 class="fw-bold text-warning border-bottom border-secondary pb-2 mb-3">TỔNG CHI PHÍ TẠM TÍNH</h6>
                                        
                                        <div class="d-flex justify-content-between mb-2 small">
                                            <span>Ô tô (yêu cầu mua):</span>
                                            <span class="fw-bold text-warning" id="totalCarDisplay">0 đ</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2 small">
                                            <span>Phụ tùng mua riêng:</span>
                                            <span class="fw-bold" id="totalStandaloneDisplay">0 đ</span>
                                        </div>
                                        <div id="maintenanceCostBlock" class="border-bottom border-secondary pb-2 mb-2 d-none">
                                            <div class="d-flex justify-content-between small fw-bold text-warning mb-1">
                                                <span>
                                                    Chi phí bảo dưỡng dự kiến
                                                    <a tabindex="0" role="button" class="text-info ms-1" data-bs-toggle="popover" data-bs-trigger="focus" title="Chi phí dự kiến"
                                                       data-bs-content="Chi phí bảo dưỡng là dự kiến, có thể thay đổi nếu phát sinh phụ tùng/dịch vụ bổ sung và chỉ chốt sau khi bạn xác nhận.">
                                                        <i class="bi bi-exclamation-circle-fill"></i>
                                                    </a>:
                                                </span>
                                                <span id="totalMaintenanceDisplay">0 đ</span>
                                            </div>
                                            <div class="d-flex justify-content-between small ps-3 text-white-50" id="rowPackage">
                                                <span>• Gói bảo dưỡng:</span><span id="totalPackageDisplay">0 đ</span>
                                            </div>
                                            <div class="d-flex justify-content-between small ps-3 text-white-50" id="rowService">
                                                <span>• Dịch vụ lẻ:</span><span id="totalServiceDisplay">0 đ</span>
                                            </div>
                                            <div class="d-flex justify-content-between small ps-3 text-white-50" id="rowMaintParts">
                                                <span>• Phụ tùng bảo dưỡng:</span><span id="totalMaintPartsDisplay">0 đ</span>
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between pt-1">
                                            <span class="fw-bold fs-6">Tổng cộng:</span>
                                            <span class="fw-bold fs-5 text-danger" id="totalOrderDisplay">0 đ</span>
                                        </div>
                                        <div class="small text-white-50 mt-2"><i class="bi bi-info-circle me-1"></i>Phụ tùng/dịch vụ phát sinh (nếu có) sẽ được tính bổ sung khi bảo dưỡng và cần bạn duyệt.</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Chọn hình thức thanh toán cho hóa đơn tổng -->
                        <div class="card border rounded-3 shadow-sm mt-3">
                            <div class="card-body">
                                <h6 class="fw-bold text-dark mb-3">
                                    Hình thức thanh toán
                                    <a tabindex="0" role="button" class="text-info ms-1" data-bs-toggle="popover" data-bs-trigger="focus" title="Đặt cọc / Mua đứt"
                                       data-bs-content="Đặt cọc: trả trước 10% để giữ chỗ (tối đa 2 tuần), sau đó tất toán phần còn lại. Mua đứt: thanh toán toàn bộ. Cả hai đều xác thực bằng mã do nhân viên cấp ở trang Hóa đơn của tôi.">
                                        <i class="bi bi-exclamation-circle-fill"></i>
                                    </a>
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="w-100 p-3 border rounded-4 d-flex align-items-start gap-2 mb-0" style="cursor:pointer;">
                                            <input class="form-check-input mt-1" type="radio" name="purchaseType" value="Deposit">
                                            <span><strong>Đặt cọc</strong><br><span class="small text-muted">Cọc ~10% giữ chỗ tối đa 2 tuần, tất toán sau.</span></span>
                                        </label>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="w-100 p-3 border rounded-4 d-flex align-items-start gap-2 mb-0" style="cursor:pointer;">
                                            <input class="form-check-input mt-1" type="radio" name="purchaseType" value="Buyout" checked>
                                            <span><strong>Mua đứt</strong><br><span class="small text-muted">Thanh toán toàn bộ một lần.</span></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <button type="button" class="btn btn-outline-secondary rounded-3 px-4" onclick="goToStep(4)"><i class="bi bi-arrow-left me-1"></i> Quay lại</button>
                            <button type="button" class="btn btn-dark text-warning fw-bold rounded-3 px-5" id="btnSubmitOrder" onclick="submitCheckout()"><i class="bi bi-check2-circle me-1"></i> Xác nhận & tạo hóa đơn</button>
                        </div>
                    </div>

                    <!-- STEP 6: HOÀN TẤT -->
                    <div class="wizard-step text-center py-4" id="step-6">
                        <div class="mb-4">
                            <span class="display-3 text-success"><i class="bi bi-check-circle-fill"></i></span>
                        </div>
                        <h3 class="fw-bold text-dark">Đặt yêu cầu thành công</h3>
                        <p class="text-secondary mb-4">Cảm ơn bạn đã lựa chọn dịch vụ của chúng tôi. Yêu cầu của bạn đã được gửi đến hệ thống.</p>
                        
                        <div class="row justify-content-center mb-5">
                            <div class="col-md-8">
                                <div class="p-4 bg-light border rounded-4 text-start">
                                    <div class="d-none mb-3" id="resPartOrder">
                                        <div class="fw-bold text-dark">Đơn phụ tùng mua riêng <span class="text-primary font-monospace" id="lblPartOrderId"></span>:</div>
                                        <div class="text-secondary small"><i class="bi bi-hourglass-split me-1 text-warning"></i>Đang chờ showroom xác nhận đơn hàng.</div>
                                    </div>
                                    <div class="d-none" id="resMaintenance">
                                        <div class="fw-bold text-dark">Lịch bảo dưỡng <span class="text-primary font-monospace" id="lblAppointmentId"></span>:</div>
                                        <div class="text-secondary small"><i class="bi bi-hourglass-split me-1 text-warning"></i>Đang chờ duyệt lịch hẹn sửa chữa.</div>
                                    </div>
                                    <div class="d-none mt-3" id="resCar">
                                        <div class="fw-bold text-dark">Yêu cầu mua xe <span class="text-primary font-monospace" id="lblCarRequestIds"></span>:</div>
                                        <div class="text-secondary small"><i class="bi bi-hourglass-split me-1 text-warning"></i>Nhân viên sẽ liên hệ lập hóa đơn và cấp mã xác thực để bạn hoàn tất.</div>
                                    </div>
                                    <div class="d-none mt-3 border-top pt-3" id="resInvoice">
                                        <div class="fw-bold text-dark">Hóa đơn tổng <span class="text-success font-monospace" id="lblInvoiceNumber"></span> — <span id="lblPurchaseType"></span></div>
                                        <div class="text-secondary small"><i class="bi bi-shield-lock me-1 text-warning"></i>Vào <strong>Hóa đơn của tôi</strong>, liên hệ nhân viên (hotline (+84) 0359492991) để nhận mã và nhập xác thực.</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning d-inline-block rounded-3 small mx-auto" style="max-width: 550px;">
                            <i class="bi bi-info-circle-fill me-1"></i> Với hóa đơn <strong>đặt cọc</strong>, cọc giữ chỗ tối đa <strong>2 tuần</strong>; quá hạn đơn tự hủy và không hoàn cọc. Chi phí bảo dưỡng cuối cùng thanh toán sau khi hoàn thành dịch vụ.
                        </div>

                        <div class="mt-4">
                            <a href="/Invoices" class="btn btn-gold rounded-pill px-4 me-2"><i class="bi bi-receipt-cutoff"></i> Hóa đơn của tôi</a>
                            <a href="/" class="btn btn-outline-secondary rounded-pill px-4">Về Trang chủ</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const cartData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cart));
        let activeStep = 1;

        // Xe đang có trong giỏ (nếu có) — dùng cho lựa chọn "bảo dưỡng xe trong giỏ".
        const carInCart = cartData.Items.find(i => i.ItemType === 'Car') || null;

        $(document).ready(function() {
            // Setup delivery address toggle
            $('input[name="deliveryMethod"]').change(function() {
                if ($(this).val() === 'Shipping') {
                    $('#shippingAddressContainer').removeClass('d-none');
                } else {
                    $('#shippingAddressContainer').addClass('d-none');
                }
            });

            // Bước 3: nếu giỏ có xe -> hiện 2 lựa chọn nguồn xe.
            if (carInCart) {
                $('#carSourceChoice').removeClass('d-none');
                $('#carSourceInCartName').text(carInCart.Name);
                $('input[name="carSource"]').change(applyCarSource);
                applyCarSource();
            }

            // Initialize total price calculations
            recalculateSummary();

            // Kích hoạt popover cho các icon dấu "!" giải thích.
            try {
                document.querySelectorAll('[data-bs-toggle="popover"]').forEach(function (el) {
                    new bootstrap.Popover(el);
                });
            } catch (e) { /* bootstrap chưa sẵn sàng - bỏ qua */ }
        });

        // Trả về nguồn xe hiện chọn: 'InCart' | 'Other'. Nếu giỏ không có xe -> luôn 'Other'.
        function getCarSource() {
            if (!carInCart) return 'Other';
            return $('input[name="carSource"]:checked').val() || 'InCart';
        }

        function applyCarSource() {
            const src = getCarSource();
            if (src === 'InCart') {
                $('#carInfoInputs').addClass('d-none');
                $('#carInCartHint').removeClass('d-none');
                $('#carOtherHint').addClass('d-none');
            } else {
                $('#carInfoInputs').removeClass('d-none');
                $('#carInCartHint').addClass('d-none');
                $('#carOtherHint').removeClass('d-none');
            }
        }

        function changePurpose(itemType, itemId, purpose) {
            $.ajax({
                url: '/Cart/UpdatePurpose',
                type: 'POST',
                data: { itemType: itemType, itemId: itemId, purpose: purpose },
                success: function(res) {
                    if (res.success) {
                        // Update local array
                        const item = cartData.Items.find(i => i.ItemType === itemType && i.ItemId === itemId);
                        if (item) {
                            item.Purpose = purpose;
                        }
                        recalculateSummary();
                    }
                }
            });
        }

        function recalculateSummary() {
            let totalStandalone = 0, totalCar = 0;
            let totalPackage = 0, totalService = 0, totalMaintParts = 0;

            cartData.Items.forEach(item => {
                const line = item.Price * item.Quantity;
                if (item.ItemType === 'Part') {
                    if (item.Purpose === 'Maintenance') totalMaintParts += line;
                    else totalStandalone += line;
                } else if (item.ItemType === 'Package') {
                    totalPackage += line;
                } else if (item.ItemType === 'Service') {
                    totalService += line;
                } else if (item.ItemType === 'Car') {
                    totalCar += line;
                }
            });

            const totalMaintenance = totalPackage + totalService + totalMaintParts;
            const fmt = v => v.toLocaleString('vi-VN') + ' đ';

            $('#totalCarDisplay').text(fmt(totalCar));
            $('#totalStandaloneDisplay').text(fmt(totalStandalone));
            $('#totalMaintenanceDisplay').text(fmt(totalMaintenance));
            $('#totalPackageDisplay').text(fmt(totalPackage));
            $('#totalServiceDisplay').text(fmt(totalService));
            $('#totalMaintPartsDisplay').text(fmt(totalMaintParts));
            $('#totalOrderDisplay').text(fmt(totalStandalone + totalMaintenance + totalCar));

            // Ẩn/hiện các dòng theo dữ liệu thực tế cho gọn.
            $('#maintenanceCostBlock').toggleClass('d-none', totalMaintenance === 0);
            $('#rowPackage').toggleClass('d-none', totalPackage === 0);
            $('#rowService').toggleClass('d-none', totalService === 0);
            $('#rowMaintParts').toggleClass('d-none', totalMaintParts === 0);
        }

        function goToStep(step) {
            // Validation check before proceeding
            $('#checkoutAlert').addClass('d-none');

            const hasStandalone = cartData.Items.some(i => i.ItemType === 'Part' && i.Purpose !== 'Maintenance');
            const hasMaintenance = cartData.Items.some(i => i.ItemType === 'Package' || i.ItemType === 'Service' || (i.ItemType === 'Part' && i.Purpose === 'Maintenance'));

            if (step === 3 && activeStep === 2) {
                // If they have maintenance items, they must provide Car info
                if (hasMaintenance) {
                    const packages = cartData.Items.filter(i => i.ItemType === 'Package' || i.ItemType === 'Service');
                    if (packages.length === 0) {
                        showError("Đặt lịch hẹn bảo dưỡng yêu cầu ít nhất một gói bảo dưỡng hoặc một dịch vụ lẻ được chọn.");
                        return;
                    }
                } else {
                    // Skip step 3 & 4 if there are no maintenance items at all
                    step = 5;
                }
            }

            if (step === 4 && activeStep === 3) {
                // Nếu chọn bảo dưỡng "xe trong giỏ" thì bỏ qua yêu cầu nhập tên xe/biển số.
                if (hasMaintenance && getCarSource() === 'Other') {
                    const carName = $('#CarNameInput').val().trim();
                    const licensePlate = $('#LicensePlateInput').val().trim();
                    if (!carName || !licensePlate) {
                        showError("Vui lòng điền thông tin tên xe và biển số xe để đặt lịch bảo dưỡng.");
                        return;
                    }
                }
            }

            if (step === 5) {
                // Validate Step 4 if coming from step 4
                if (hasMaintenance && activeStep === 4) {
                    const date = $('#AppointmentDateInput').val();
                    const time = $('#AppointmentTimeInput').val();
                    if (!date || !time) {
                        showError("Vui lòng chọn đầy đủ ngày hẹn và giờ hẹn bảo dưỡng.");
                        return;
                    }
                    const selectedDateTime = new Date(date + 'T' + time);
                    if (selectedDateTime <= new Date()) {
                        showError("Ngày giờ hẹn bảo dưỡng phải thuộc về tương lai.");
                        return;
                    }
                }

                // Populate Step 5 display labels
                renderStep5Summary(hasStandalone, hasMaintenance);
            }

            // Perform step switch
            $(`#step-${activeStep}`).removeClass('active');
            $(`#step-${step}`).addClass('active');
            
            // Update Indicators
            for(let i=1; i<=6; i++) {
                if (i < step) {
                    $(`#ind-${i}`).addClass('completed').removeClass('active');
                } else if (i === step) {
                    $(`#ind-${i}`).addClass('active').removeClass('completed');
                } else {
                    $(`#ind-${i}`).removeClass('active completed');
                }
            }

            activeStep = step;
        }

        function showError(msg) {
            $('#checkoutAlertText').text(msg);
            $('#checkoutAlert').removeClass('d-none');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function renderStep5Summary(hasStandalone, hasMaintenance) {
            const hasCar = cartData.Items.some(i => i.ItemType === 'Car');

            // 0. Ô tô (yêu cầu mua) — danh mục riêng
            if (hasCar) {
                $('#summaryCarCard').removeClass('d-none');
                let carHtml = "";
                cartData.Items.forEach(i => {
                    if (i.ItemType === 'Car') {
                        carHtml += `
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge bg-warning text-dark me-1">Ô Tô</span>
                                    <span class="fw-semibold">${i.Name}</span>
                                </div>
                                <span class="fw-bold">${(i.Price * i.Quantity).toLocaleString('vi-VN')} đ</span>
                            </li>
                        `;
                    }
                });
                $('#summaryCarList').html(carHtml);
            } else {
                $('#summaryCarCard').addClass('d-none');
            }

            // A. Standalone Parts list
            if (hasStandalone) {
                $('#summaryStandaloneCard').removeClass('d-none');
                let html = "";
                cartData.Items.forEach(i => {
                    if (i.ItemType === 'Part' && i.Purpose !== 'Maintenance') {
                        html += `
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-semibold">${i.Name}</span>
                                    <div class="text-muted" style="font-size: 11px;">Số lượng: ${i.Quantity}</div>
                                </div>
                                <span class="fw-bold">${(i.Price * i.Quantity).toLocaleString('vi-VN')} đ</span>
                            </li>
                        `;
                    }
                });
                $('#summaryStandaloneList').html(html);
            } else {
                $('#summaryStandaloneCard').addClass('d-none');
            }

            // B. Maintenance Appointment
            if (hasMaintenance) {
                $('#summaryMaintenanceCard').removeClass('d-none');
                let html = "";
                
                // Show packages & services
                cartData.Items.forEach(i => {
                    if (i.ItemType === 'Package' || i.ItemType === 'Service') {
                        let badge = i.ItemType === 'Package' ? '<span class="badge bg-primary me-1">Gói</span>' : '<span class="badge bg-info text-dark me-1">Dịch vụ</span>';
                        html += `
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>${badge} <span class="fw-semibold">${i.Name}</span></div>
                                <span class="fw-bold">${i.Price.toLocaleString('vi-VN')} đ</span>
                            </li>
                        `;
                    }
                });

                // Show parts for maintenance
                cartData.Items.forEach(i => {
                    if (i.ItemType === 'Part' && i.Purpose === 'Maintenance') {
                        html += `
                            <li class="list-group-item d-flex justify-content-between align-items-center list-group-item-light">
                                <div><span class="badge bg-warning text-dark me-1">Linh kiện</span> ${i.Name} <small class="text-muted">(SL: ${i.Quantity})</small></div>
                                <span class="fw-bold">${(i.Price * i.Quantity).toLocaleString('vi-VN')} đ</span>
                            </li>
                        `;
                    }
                });

                $('#summaryMaintenanceList').html(html);
                
                // Details text (tôn trọng lựa chọn nguồn xe)
                if (getCarSource() === 'InCart' && carInCart) {
                    $('#summaryCarText').text(carInCart.Name + ' (xe trong giỏ hàng)');
                } else {
                    $('#summaryCarText').text($('#CarNameInput').val() + ' (' + $('#LicensePlateInput').val() + ')');
                }
                $('#summaryTimeText').text($('#AppointmentTimeInput').val() + ', ngày ' + $('#AppointmentDateInput').val());
            } else {
                $('#summaryMaintenanceCard').addClass('d-none');
            }
        }

        function submitCheckout() {
            $('#checkoutAlert').addClass('d-none');
            
            const hasStandalone = cartData.Items.some(i => i.ItemType === 'Part' && i.Purpose !== 'Maintenance');
            const hasMaintenance = cartData.Items.some(i => i.ItemType === 'Package' || i.ItemType === 'Service' || (i.ItemType === 'Part' && i.Purpose === 'Maintenance'));

            const name = $('#CustomerNameInput').val().trim();
            const phone = $('#CustomerPhoneInput').val().trim();
            const email = $('#CustomerEmailInput').val().trim();

            if (!name || !phone) {
                showError("Vui lòng cung cấp Họ tên và Số điện thoại liên hệ nhận đơn hàng.");
                return;
            }

            const payload = {
                CustomerName: name,
                CustomerPhone: phone,
                CustomerEmail: email,
                DeliveryMethod: $('input[name="deliveryMethod"]:checked').val(),
                ShippingAddress: $('#ShippingAddressInput').val().trim(),
                CarName: hasMaintenance ? (getCarSource() === 'InCart' && carInCart ? carInCart.Name : $('#CarNameInput').val().trim()) : null,
                LicensePlate: hasMaintenance ? (getCarSource() === 'InCart' ? 'Chưa cấp biển' : $('#LicensePlateInput').val().trim()) : null,
                AppointmentDate: hasMaintenance ? $('#AppointmentDateInput').val() : null,
                AppointmentTime: hasMaintenance ? $('#AppointmentTimeInput').val() : null,
                Note: hasMaintenance ? $('#NoteInput').val().trim() : null,
                PurchaseType: $('input[name="purchaseType"]:checked').val() || 'Buyout'
            };

            // Toggle spinner on submit button
            $('#btnSubmitOrder').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang xử lý...');

            $.ajax({
                url: '/Cart/Checkout',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    if (res.success) {
                        // Render step 6
                        if (res.partOrderId) {
                            $('#resPartOrder').removeClass('d-none');
                            $('#lblPartOrderId').text(res.partOrderId);
                        } else {
                            $('#resPartOrder').addClass('d-none');
                        }

                        if (res.appointmentId) {
                            $('#resMaintenance').removeClass('d-none');
                            $('#lblAppointmentId').text(res.appointmentId);
                        } else {
                            $('#resMaintenance').addClass('d-none');
                        }

                        if (res.carRequestIds && res.carRequestIds.length > 0) {
                            $('#resCar').removeClass('d-none');
                            $('#lblCarRequestIds').text(res.carRequestIds.join(', '));
                        } else {
                            $('#resCar').addClass('d-none');
                        }

                        if (res.invoiceNumber) {
                            $('#resInvoice').removeClass('d-none');
                            $('#lblInvoiceNumber').text(res.invoiceNumber);
                            $('#lblPurchaseType').text(res.purchaseType === 'Deposit' ? 'Đặt cọc' : 'Mua đứt');
                        } else {
                            $('#resInvoice').addClass('d-none');
                        }

                        goToStep(6);
                    } else {
                        showError(res.message);
                        $('#btnSubmitOrder').prop('disabled', false).html('<i class="bi bi-check2-circle me-1"></i> Xác nhận & tạo hóa đơn');
                    }
                },
                error: function() {
                    showError("Lỗi hệ thống khi gửi yêu cầu. Vui lòng kiểm tra lại kết nối.");
                    $('#btnSubmitOrder').prop('disabled', false).html('<i class="bi bi-check2-circle me-1"></i> Xác nhận & tạo hóa đơn');
                }
            });
        }
    </script>
}
