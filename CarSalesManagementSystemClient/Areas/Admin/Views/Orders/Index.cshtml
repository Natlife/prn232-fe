        function cancelMaintenance(id) {
            Swal.fire({
                title: 'Hủy lịch bảo dưỡng?',
                text: 'Nhập lý do hủy lịch hẹn:',
                input: 'text',
                inputAttributes: {
                    autocapitalize: 'off'
                },
                showCancelButton: true,
                confirmButtonText: 'Hủy lịch',
                cancelButtonText: 'Bỏ qua',
                showLoaderOnConfirm: true,
                preConfirm: (reason) => {
                    if (!reason) {
                        Swal.showValidationMessage('Vui lòng nhập lý do hủy lịch');
                        return false;
                    }
                    return $.post('/Admin/Orders/CancelMaintenance/' + id, { reason: reason });
                },
                allowOutsideClick: () => !Swal.isLoading()
            }).then((result) => {
                if (result.isConfirmed && result.value.success) {
                    Swal.fire('Đã hủy', 'Đã hủy lịch bảo dưỡng thành công.', 'success').then(() => location.reload());
                } else if (result.value && !result.value.success) {
                    Swal.fire('Thất bại', result.value.message, 'error');
                }
            });
        }

