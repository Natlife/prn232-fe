@model IEnumerable<CarSalesManagementSystemClient.Models.AppointmentHistoryViewModel>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0 text-primary fw-bold">
            <i class="bi bi-receipt me-2"></i>Quản lý Đơn Hàng
        </h4>
        <div>
            <span class="badge bg-primary fs-6">
                Tổng số đơn: @Model.Count()
            </span>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4 py-3 text-secondary" style="width: 120px;">Mã Đơn</th>
                            <th class="py-3 text-secondary">Khách Hàng</th>
                            <th class="py-3 text-secondary">Ngày Đặt</th>
                            <th class="py-3 text-secondary text-end">Tổng Tiền</th>
                            <th class="py-3 text-secondary text-center">Trạng Thái</th>
                            <th class="px-4 py-3 text-secondary text-end">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                    Chưa có đơn dịch vụ nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                var totalServices = item.Details?.Sum(d => d.UnitPrice * d.Quantity) ?? 0;
                                var totalParts = item.ConsumedParts?.Sum(p => p.UnitPrice * p.Quantity) ?? 0;
                                var totalAmount = totalServices + totalParts;

                                <tr>
                                    <td class="px-4 fw-bold text-primary">
                                        #ORD-@item.AppointmentId.ToString("D4")
                                    </td>
                                    <td>
                                        <div class="fw-bold">@item.CustomerName</div>
                                        <div class="small text-muted"><i class="bi bi-telephone-fill me-1"></i>@item.CustomerPhone</div>
                                    </td>
                                    <td>
                                        <div>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                        <div class="small text-muted">Hẹn: @item.AppointmentDate.ToString("dd/MM/yyyy") @item.AppointmentTime.ToString("HH:mm")</div>
                                    </td>
                                    <td class="text-end fw-bold text-danger">
                                        @totalAmount.ToString("N0") đ
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsPaid)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán</span>
                                        }
                                        else if (item.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt</span>
                                        }
                                        else if (item.Status == "Confirmed")
                                        {
                                            <span class="badge bg-info text-dark"><i class="bi bi-check2-circle me-1"></i>Đã xác nhận</span>
                                        }
                                        else if (item.Status == "InProgress")
                                        {
                                            <span class="badge bg-primary"><i class="bi bi-tools me-1"></i>Đang xử lý</span>
                                        }
                                        else if (item.Status == "Completed")
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-check-circle me-1"></i>Chờ thanh toán</span>
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Đã hủy</span>
                                        }
                                    </td>
                                    <td class="px-4 text-end">
                                        <button class="btn btn-sm btn-outline-primary" onclick="showInvoiceDetails(@item.AppointmentId)">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </button>
                                        
                                        @if ((item.Status == "Completed" || (item.CustomerCar != null && item.CustomerCar.Model == "N/A - Đơn phụ tùng")) && !item.IsPaid && item.Status != "Cancelled")
                                        {
                                            <button class="btn btn-sm btn-success ms-1" onclick="markAsPaid(@item.AppointmentId)" title="Thanh toán">
                                                <i class="bi bi-cash"></i> Thanh toán
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger ms-1" onclick="cancelAppointment(@item.AppointmentId)" title="Hủy đơn">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- Phân trang -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white py-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal hiển thị chi tiết hóa đơn (tái sử dụng từ view Details nhưng làm cho gọn nhẹ bằng JS hoặc partial) -->
<div class="modal fade" id="invoiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-receipt me-2"></i>Chi Tiết Hóa Đơn</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" id="invoiceModalContent">
                <!-- Nội dung hóa đơn sẽ được render ở đây thông qua logic hiển thị ẩn/hiện hoặc AJAX -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer me-2"></i>In hóa đơn</button>
            </div>
        </div>
    </div>
</div>

<!-- Render dử liệu chi tiết ra JS variable -->
<script>
    const orderData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

    function showInvoiceDetails(appointmentId) {
        const order = orderData.find(o => o.AppointmentId === appointmentId);
        if (!order) return;

        let html = `
            <div class="p-4 bg-white invoice-print-area">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-uppercase mb-0">HÓA ĐƠN DỊCH VỤ</h3>
                    <div class="text-muted">Mã số: ORD-${String(order.AppointmentId).padStart(4, '0')}</div>
                    <div class="text-muted">Ngày: ${new Date().toLocaleDateString('vi-VN')}</div>
                </div>

                <div class="row mb-4">
                    <div class="col-sm-6">
                        <h6 class="fw-bold mb-1">Thông tin khách hàng:</h6>
                        <div><strong>Họ tên:</strong> ${order.CustomerName}</div>
                        <div><strong>Điện thoại:</strong> ${order.CustomerPhone}</div>
                        ${order.CustomerCar ? `<div><strong>Xe:</strong> ${order.CustomerCar.Model} - ${order.CustomerCar.LicensePlate}</div>` : ''}
                    </div>
                </div>
        `;

        let totalAmount = 0;

        // Dịch vụ/Gói
        if (order.Details && order.Details.length > 0) {
            html += `
                <h6 class="fw-bold mb-2">Dịch vụ & Gói bảo dưỡng</h6>
                <table class="table table-bordered table-sm mb-4">
                    <thead class="table-light">
                        <tr>
                            <th>Tên Dịch Vụ / Gói</th>
                            <th class="text-end" style="width: 100px;">Đ.Giá</th>
                            <th class="text-center" style="width: 60px;">SL</th>
                            <th class="text-end" style="width: 120px;">Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody>
            `;
            
            order.Details.forEach(d => {
                const subTotal = d.UnitPrice * d.Quantity;
                totalAmount += subTotal;
                html += `
                    <tr>
                        <td>${d.PackageId ? d.PackageName : d.ServiceName}</td>
                        <td class="text-end">${d.UnitPrice.toLocaleString('vi-VN')}</td>
                        <td class="text-center">${d.Quantity}</td>
                        <td class="text-end">${subTotal.toLocaleString('vi-VN')} đ</td>
                    </tr>
                `;
            });
            html += `</tbody></table>`;
        }

        // Phụ tùng
        html += `
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0">Phụ tùng sử dụng / Mua kèm</h6>
                <button type="button" class="btn btn-sm btn-outline-primary d-print-none" onclick="openAddPartModal(${order.AppointmentId}, '${order.CustomerName}')">
                    <i class="bi bi-plus-circle"></i> Thêm phụ tùng
                </button>
            </div>
        `;
        
        if (order.ConsumedParts && order.ConsumedParts.length > 0) {
            html += `
                <table class="table table-bordered table-sm mb-4">
                    <thead class="table-light">
                        <tr>
                            <th>Tên Phụ Tùng</th>
                            <th class="text-end" style="width: 100px;">Đ.Giá</th>
                            <th class="text-center" style="width: 60px;">SL</th>
                            <th class="text-end" style="width: 120px;">Thành Tiền</th>
                            <th class="text-center d-print-none" style="width: 40px;"></th>
                        </tr>
                    </thead>
                    <tbody>
            `;
            
            order.ConsumedParts.forEach(p => {
                const subTotal = p.UnitPrice * p.Quantity;
                totalAmount += subTotal;
                html += `
                    <tr>
                        <td>
                            ${p.PartName}
                            ${p.IsIncurred ? '<span class="badge bg-warning text-dark ms-2 d-print-none" style="font-size: 0.7em;">Phát sinh</span>' : ''}
                        </td>
                        <td class="text-end">${p.UnitPrice.toLocaleString('vi-VN')}</td>
                        <td class="text-center">${p.Quantity}</td>
                        <td class="text-end">${subTotal.toLocaleString('vi-VN')} đ</td>
                        <td class="text-center d-print-none">
                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 border-0" title="Xóa phụ tùng này" onclick="removePart(${p.ConsumedPartId})">
                                <i class="bi bi-x-circle"></i>
                            </button>
                        </td>
                    </tr>
                `;
            });
            html += `</tbody></table>`;
        } else {
            html += `<p class="text-muted small fst-italic mb-4">Không có phụ tùng</p>`;
        }

        let extraFee = 0;
        if (order.Note) {
            let match = order.Note.match(/\[PhiPhatSinh:\s*(\d+)\]/);
            if (match) {
                extraFee = parseInt(match[1]);
            }
        }
        let finalTotal = totalAmount + extraFee;

        html += `
                <div class="row">
                    <div class="col-6"></div>
                    <div class="col-6">
                        <table class="table table-borderless table-sm">
                            <tr>
                                <td class="fw-bold align-middle">Phí phát sinh (nếu có):</td>
                                <td class="text-end">
                                    <div class="input-group input-group-sm d-print-none">
                                        <input type="number" class="form-control text-end" id="extraFeeInput" value="${extraFee}" min="0" oninput="updateInvoiceTotal(${totalAmount})">
                                        <button class="btn btn-outline-secondary" type="button" onclick="saveExtraFee(${order.AppointmentId})" title="Lưu phí này">
                                            <i class="bi bi-save"></i>
                                        </button>
                                    </div>
                                    <span class="d-none d-print-block fw-bold text-danger" id="extraFeeText">${extraFee.toLocaleString('vi-VN')} đ</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-bold align-middle">TỔNG CỘNG:</td>
                                <td class="text-end fw-bold fs-5 text-danger" id="invoiceTotalAmount">${finalTotal.toLocaleString('vi-VN')} đ</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        `;

        document.getElementById('invoiceModalContent').innerHTML = html;
        var myModal = new bootstrap.Modal(document.getElementById('invoiceModal'));
        myModal.show();
    }

    function updateInvoiceTotal(baseTotal) {
        let fee = parseInt(document.getElementById('extraFeeInput').value) || 0;
        let newTotal = baseTotal + fee;
        document.getElementById('invoiceTotalAmount').innerText = newTotal.toLocaleString('vi-VN') + ' đ';
        document.getElementById('extraFeeText').innerText = fee.toLocaleString('vi-VN') + ' đ';
    }

    function saveExtraFee(appointmentId) {
        let fee = parseInt(document.getElementById('extraFeeInput').value) || 0;
        $.ajax({
            url: '@Url.Action("SaveExtraFee", "Orders")',
            type: 'POST',
            data: { id: appointmentId, fee: fee },
            success: function (res) {
                if (res.success) {
                    Swal.fire({
                        title: 'Thành công',
                        text: res.message,
                        icon: 'success',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire('Lỗi', res.message, 'error');
                }
            },
            error: function () {
                Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
            }
        });
    }

    function markAsPaid(appointmentId) {
        Swal.fire({
            title: 'Xác nhận thanh toán?',
            text: "Xác nhận đã nhận đủ tiền và hoàn thành đơn dịch vụ này?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#198754',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Đã thanh toán',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("MarkAsPaid", "Orders")',
                    type: 'POST',
                    data: { id: appointmentId },
                    success: function (res) {
                        if (res.success) {
                            Swal.fire('Thành công', res.message, 'success').then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
                    }
                });
            }
        });
    }

    function cancelAppointment(id) {
        Swal.fire({
            title: 'Hủy đơn hàng',
            input: 'textarea',
            inputLabel: 'Lý do hủy (Không bắt buộc)',
            inputPlaceholder: 'Nhập lý do khách hàng hủy...',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Xác nhận Hủy',
            cancelButtonText: 'Đóng'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Admin/MaintenanceAppointments/UpdateStatus',
                    type: 'POST',
                    data: {
                        id: id,
                        status: 'Cancelled',
                        reason: result.value
                    },
                    success: function(res) {
                        if (res.success) {
                            Swal.fire('Thành công!', "Đã hủy đơn hàng.", 'success').then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Lỗi!', res.message, 'error');
                        }
                    },
                    error: function() {
                        Swal.fire('Lỗi!', 'Không thể kết nối đến máy chủ.', 'error');
                    }
                });
            }
        });
    }

    function removePart(consumedPartId) {
        Swal.fire({
            title: 'Xóa phụ tùng?',
            text: "Bạn có chắc chắn muốn xóa phụ tùng này khỏi hóa đơn?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Xóa',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Admin/MaintenanceAppointments/RemoveIncurredPart',
                    type: 'POST',
                    data: { consumedPartId: consumedPartId },
                    success: function(res) {
                        if (res.success) {
                            Swal.fire('Thành công!', "Đã xóa phụ tùng.", 'success').then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Lỗi!', res.message, 'error');
                        }
                    },
                    error: function() {
                        Swal.fire('Lỗi!', 'Không thể kết nối đến máy chủ.', 'error');
                    }
                });
            }
        });
    }

    let incurredModal;
    
    function openAddPartModal(appointmentId, customerName) {
        if (!incurredModal) {
            incurredModal = new bootstrap.Modal(document.getElementById('incurredPartModal'));
            
            // Khởi tạo select2
            $('#incurredPartId').select2({
                placeholder: "-- Chọn phụ tùng --",
                dropdownParent: $('#incurredPartModal'),
                allowClear: true
            });

            // Tải danh sách phụ tùng
            fetch('http://localhost:5084/odata/Parts?$filter=Status ne \'Inactive\'&$select=PartId,PartName,Price')
                .then(response => response.json())
                .then(data => {
                    const select = $('#incurredPartId');
                    select.empty();
                    select.append(new Option('-- Chọn phụ tùng --', '', true, true));
                    if (data && data.value) {
                        data.value.forEach(part => {
                            const optionText = `${part.PartName} - ${new Intl.NumberFormat('vi-VN').format(part.Price)} đ`;
                            select.append(new Option(optionText, part.PartId));
                        });
                    }
                })
                .catch(error => {
                    console.error('Error fetching parts:', error);
                    const select = $('#incurredPartId');
                    select.empty();
                    select.append(new Option('-- Lỗi khi tải phụ tùng --', ''));
                });
        }
        
        document.getElementById('incurredAppointmentId').value = appointmentId;
        document.getElementById('incurredCustomerName').innerText = customerName;
        document.getElementById('incurredPartForm').reset();
        
        // Hide the invoice modal and show the add part modal
        const invoiceModalEl = document.getElementById('invoiceModal');
        const invoiceModalObj = bootstrap.Modal.getInstance(invoiceModalEl);
        if (invoiceModalObj) invoiceModalObj.hide();
        
        incurredModal.show();
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('incurredPartForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            const btn = document.getElementById('btnSaveIncurred');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang xử lý...';

            try {
                const formData = new FormData();
                formData.append('appointmentId', form.AppointmentId.value);
                formData.append('partId', form.PartId.value);
                formData.append('quantity', form.Quantity.value);
                formData.append('notes', form.Notes.value);

                const response = await fetch('/Admin/MaintenanceAppointments/AddPart', {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                
                if (result.success) {
                    incurredModal.hide();
                    Swal.fire('Thành công!', "Đã thêm phụ tùng thành công", 'success').then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire('Lỗi!', result.message || 'Lưu thất bại', 'error');
                }
            } catch (error) {
                Swal.fire('Lỗi!', 'Không thể kết nối máy chủ.', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Thêm';
            }
        });
    });
</script>

<!-- Modal Thêm Phụ Tùng -->
<div class="modal fade" id="incurredPartModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title">Thêm phụ tùng</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="incurredPartForm">
                    <input type="hidden" id="incurredAppointmentId" name="AppointmentId" />
                    <p>Khách hàng: <strong id="incurredCustomerName"></strong></p>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Phụ tùng <span class="text-danger">*</span></label>
                        <select class="form-select" id="incurredPartId" name="PartId" style="width: 100%;" required>
                            <option value="">-- Đang tải danh sách phụ tùng --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Số lượng <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="Quantity" min="1" value="1" required>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-muted">Ghi chú</label>
                        <textarea class="form-control" name="Notes" rows="2"></textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary shadow-sm" id="btnSaveIncurred">
                            <i class="bi bi-check2-circle me-1"></i> Thêm
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        body * {
            visibility: hidden;
        }
        .invoice-print-area, .invoice-print-area * {
            visibility: visible;
        }
        .invoice-print-area {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }
    }
</style>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        .select2-container .select2-selection--single {
            height: 38px;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 36px;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }
    </style>
}
