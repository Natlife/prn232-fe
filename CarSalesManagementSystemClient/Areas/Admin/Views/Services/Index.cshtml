@model IEnumerable<CarSalesManagementSystemClient.Models.ServiceSummaryViewModel>

@{
    ViewData["Title"] = "Quản lý dịch vụ lẻ";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-tools text-primary me-2"></i>Quản lý dịch vụ lẻ</h2>
            <p class="text-muted mb-0">Quản lý danh sách các dịch vụ sửa chữa/bảo dưỡng lẻ</p>
        </div>
        <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#serviceModal" onclick="resetForm()">
            <i class="bi bi-plus-lg me-1"></i> Thêm dịch vụ mới
        </button>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="px-4 py-3">ID</th>
                            <th class="py-3">Tên dịch vụ</th>
                            <th class="py-3">Mô tả</th>
                            <th class="py-3">Giá cơ bản</th>
                            <th class="py-3">Thời gian (phút)</th>
                            <th class="text-end px-4 py-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                    Chưa có dịch vụ nào
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4"><span class="badge bg-secondary">#@item.ServiceId</span></td>
                                    <td class="fw-bold">@item.ServiceName</td>
                                    <td><small class="text-muted">@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</small></td>
                                    <td class="text-danger fw-bold">@item.BasePrice.ToString("N0") VNĐ</td>
                                    <td><i class="bi bi-clock me-1 text-muted"></i>@item.EstimatedDurationMinutes phút</td>
                                    <td class="text-end px-4">
                                        <button class="btn btn-sm btn-outline-primary me-2" onclick="editService(@item.ServiceId)">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteService(@item.ServiceId, '@item.ServiceName')">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm/Sửa Dịch Vụ -->
<div class="modal fade" id="serviceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title" id="modalTitle">Thêm dịch vụ mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="serviceForm">
                    <input type="hidden" id="ServiceId" name="ServiceId" value="0" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Tên dịch vụ <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="ServiceName" name="ServiceName" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Mô tả</label>
                        <textarea class="form-control" id="Description" name="Description" rows="2"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Giá cơ bản (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="BasePrice" name="BasePrice" min="0" required>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-muted">Thời gian dự kiến (phút) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="EstimatedDurationMinutes" name="EstimatedDurationMinutes" min="1" required>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary shadow-sm" id="btnSave">
                            <i class="bi bi-check2-circle me-1"></i> Lưu thông tin
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modal = new bootstrap.Modal(document.getElementById('serviceModal'));

        function resetForm() {
            document.getElementById('serviceForm').reset();
            document.getElementById('ServiceId').value = "0";
            document.getElementById('modalTitle').innerText = "Thêm dịch vụ mới";
        }

        async function editService(id) {
            try {
                const response = await fetch(`/Admin/Services/Get/${id}`);
                const result = await response.json();
                
                if (result.success) {
                    document.getElementById('ServiceId').value = result.data.serviceId;
                    document.getElementById('ServiceName').value = result.data.serviceName;
                    document.getElementById('Description').value = result.data.description || '';
                    document.getElementById('BasePrice').value = result.data.basePrice;
                    document.getElementById('EstimatedDurationMinutes').value = result.data.estimatedDurationMinutes;
                    
                    document.getElementById('modalTitle').innerText = "Cập nhật dịch vụ";
                    modal.show();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert("Lỗi khi tải dữ liệu dịch vụ.");
            }
        }

        document.getElementById('serviceForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            const btn = document.getElementById('btnSave');
            
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang xử lý...';

            try {
                const formData = new FormData(form);
                const response = await fetch('/Admin/Services/Save', {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                
                if (result.success) {
                    modal.hide();
                    location.reload();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert("Lỗi kết nối đến máy chủ.");
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Lưu thông tin';
            }
        });

        async function deleteService(id, name) {
            if (!confirm(`Bạn có chắc chắn muốn xóa dịch vụ "${name}" không?`)) return;

            try {
                const response = await fetch(`/Admin/Services/Delete/${id}`, {
                    method: 'DELETE'
                });
                const result = await response.json();
                
                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert("Lỗi kết nối đến máy chủ.");
            }
        }
    </script>
}
