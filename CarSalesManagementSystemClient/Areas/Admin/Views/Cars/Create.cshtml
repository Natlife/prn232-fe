@model CarSalesManagementSystemClient.Models.CarFormViewModel

@{
    ViewData["Title"] = "Thêm xe mới";

    var brands =
        ViewBag.Brands
            as IEnumerable<CarSalesManagementSystemClient.Models.CarBrandViewModel>
        ?? new List<CarSalesManagementSystemClient.Models.CarBrandViewModel>();
}

<style>
    :root {
        --car-create-primary: #17191e;
        --car-create-secondary: #292c33;
        --car-create-accent: #f5b800;
        --car-create-accent-hover: #ffca28;
        --car-create-bg: #f3f4f6;
        --car-create-surface: #ffffff;
        --car-create-border: #e5e7eb;
        --car-create-text: #181a1f;
        --car-create-muted: #747983;
        --car-create-danger: #dc3545;
        --car-create-success: #198754;
        --car-create-radius-xl: 24px;
        --car-create-radius-lg: 17px;
        --car-create-radius-md: 12px;
        --car-create-shadow: 0 18px 48px rgba(17, 19, 24, 0.08);
        --car-create-shadow-soft: 0 10px 28px rgba(17, 19, 24, 0.055);
    }

    .car-create-page {
        min-height: 100vh;
        padding: 32px 0 72px;
        color: var(--car-create-text);
        background: radial-gradient( circle at 96% 2%, rgba(245, 184, 0, 0.11), transparent 31rem ), radial-gradient( circle at 3% 88%, rgba(17, 19, 24, 0.035), transparent 30rem ), var(--car-create-bg);
    }

    .car-create-container {
        width: 100%;
        max-width: 1120px;
        margin: 0 auto;
        padding-right: 24px;
        padding-left: 24px;
    }

    /* Breadcrumb */

    .car-create-breadcrumb {
        margin-bottom: 18px;
    }

        .car-create-breadcrumb .breadcrumb {
            margin: 0;
            padding: 11px 14px;
            background-color: var(--car-create-surface);
            border: 1px solid var(--car-create-border);
            border-radius: 12px;
            box-shadow: var(--car-create-shadow-soft);
        }

        .car-create-breadcrumb .breadcrumb-item {
            color: #90959d;
            font-size: 0.69rem;
            font-weight: 800;
        }

            .car-create-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
                color: #b5b9c0;
            }

        .car-create-breadcrumb a {
            color: #5e646d;
            text-decoration: none;
            transition: color 0.2s ease;
        }

            .car-create-breadcrumb a:hover {
                color: #8a6800;
            }

        .car-create-breadcrumb .active {
            color: #8a6800;
            font-weight: 900;
        }

    /* Hero */

    .car-create-hero {
        position: relative;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 28px;
        margin-bottom: 20px;
        padding: 30px 32px;
        color: #ffffff;
        background: radial-gradient( circle at 89% 10%, rgba(245, 184, 0, 0.2), transparent 32% ), linear-gradient( 135deg, var(--car-create-primary), var(--car-create-secondary) );
        border: 1px solid rgba(255, 255, 255, 0.055);
        border-radius: var(--car-create-radius-xl);
        box-shadow: 0 22px 54px rgba(17, 19, 24, 0.17);
        overflow: hidden;
    }

        .car-create-hero::after {
            content: "NEW CAR";
            position: absolute;
            top: -38px;
            right: 22px;
            color: rgba(255, 255, 255, 0.035);
            font-size: clamp(5rem, 11vw, 8.5rem);
            font-weight: 900;
            line-height: 1;
            letter-spacing: -0.08em;
            pointer-events: none;
        }

    .car-create-hero-content,
    .car-create-hero-icon {
        position: relative;
        z-index: 2;
    }

    .car-create-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 9px;
        color: var(--car-create-accent);
        font-size: 0.64rem;
        font-weight: 900;
        letter-spacing: 0.17em;
        text-transform: uppercase;
    }

        .car-create-eyebrow::before {
            content: "";
            width: 29px;
            height: 2px;
            background-color: var(--car-create-accent);
        }

    .car-create-title {
        display: flex;
        align-items: center;
        gap: 11px;
        margin: 0 0 8px;
        color: #ffffff;
        font-size: clamp(1.8rem, 3vw, 2.5rem);
        font-weight: 950;
        line-height: 1.13;
        letter-spacing: -0.045em;
    }

        .car-create-title i {
            color: var(--car-create-accent);
        }

    .car-create-description {
        max-width: 720px;
        margin: 0;
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.8rem;
        line-height: 1.68;
    }

    .car-create-hero-icon {
        width: 68px;
        height: 68px;
        display: grid;
        flex: 0 0 auto;
        place-items: center;
        color: var(--car-create-primary);
        background-color: var(--car-create-accent);
        border-radius: 19px;
        font-size: 1.65rem;
        box-shadow: 0 14px 32px rgba(245, 184, 0, 0.22);
        transform: rotate(-4deg);
    }

    /* Main form card */

    .car-create-card {
        overflow: hidden;
        background-color: var(--car-create-surface);
        border: 1px solid var(--car-create-border);
        border-radius: var(--car-create-radius-xl);
        box-shadow: var(--car-create-shadow);
    }

    .car-create-card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        padding: 22px 25px;
        background: linear-gradient( 135deg, #ffffff, #fafafa );
        border-bottom: 1px solid var(--car-create-border);
    }

        .car-create-card-header h2 {
            margin: 0 0 4px;
            color: var(--car-create-primary);
            font-size: 0.98rem;
            font-weight: 950;
        }

        .car-create-card-header p {
            margin: 0;
            color: var(--car-create-muted);
            font-size: 0.67rem;
            line-height: 1.55;
        }

    .car-create-required-note {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        color: #805f00;
        background-color: #fff8d6;
        border: 1px solid #fde68a;
        border-radius: 999px;
        font-size: 0.59rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .car-create-form-body {
        padding: 25px;
    }

    /* Validation */

    .car-create-validation {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 20px;
        padding: 14px 16px;
        color: #991b1b;
        background-color: #fff2f3;
        border: 1px solid #fecaca;
        border-radius: 14px;
        font-size: 0.73rem;
        line-height: 1.6;
    }

        .car-create-validation > i {
            flex: 0 0 auto;
            margin-top: 2px;
        }

        .car-create-validation ul {
            margin-bottom: 0;
            padding-left: 18px;
        }

    /* Section */

    .car-form-section {
        margin-bottom: 25px;
        padding-bottom: 25px;
        border-bottom: 1px solid var(--car-create-border);
    }

        .car-form-section:last-of-type {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: 0;
        }

    .car-form-section-heading {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 18px;
    }

    .car-form-section-icon {
        width: 39px;
        height: 39px;
        display: grid;
        flex: 0 0 auto;
        place-items: center;
        color: #8a6800;
        background-color: #fff8d6;
        border: 1px solid #fde68a;
        border-radius: 11px;
        font-size: 0.9rem;
    }

    .car-form-section-heading h3 {
        margin: 0 0 3px;
        color: var(--car-create-primary);
        font-size: 0.8rem;
        font-weight: 950;
        letter-spacing: 0.025em;
        text-transform: uppercase;
    }

    .car-form-section-heading p {
        margin: 0;
        color: var(--car-create-muted);
        font-size: 0.63rem;
    }

    /* Controls */

    .car-form-label {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 7px;
        color: #444951;
        font-size: 0.68rem;
        font-weight: 900;
    }

    .car-form-label-required::after {
        content: "*";
        color: var(--car-create-danger);
    }

    .car-input-wrapper {
        position: relative;
    }

    .car-input-icon {
        position: absolute;
        z-index: 2;
        top: 50%;
        left: 14px;
        color: #9398a0;
        font-size: 0.82rem;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .car-form-control,
    .car-form-select,
    .car-form-textarea {
        width: 100%;
        color: var(--car-create-text);
        background-color: #f8f9fa;
        border: 1px solid var(--car-create-border);
        border-radius: 12px;
        outline: none;
        font-size: 0.73rem;
        transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .car-form-control,
    .car-form-select {
        min-height: 47px;
        padding: 10px 13px;
    }

    .car-input-wrapper .car-form-control,
    .car-input-wrapper .car-form-select {
        padding-left: 42px;
    }

    .car-form-select {
        padding-right: 38px;
    }

    .car-form-textarea {
        min-height: 118px;
        padding: 12px 13px;
        resize: vertical;
        line-height: 1.65;
    }

        .car-form-control::placeholder,
        .car-form-textarea::placeholder {
            color: #a7abb2;
        }

        .car-form-control:hover,
        .car-form-select:hover,
        .car-form-textarea:hover {
            border-color: #cfd2d7;
        }

        .car-form-control:focus,
        .car-form-select:focus,
        .car-form-textarea:focus {
            background-color: #ffffff;
            border-color: var(--car-create-accent);
            box-shadow: 0 0 0 4px rgba(245, 184, 0, 0.13);
        }

    .car-form-help {
        display: block;
        margin-top: 6px;
        color: #9398a0;
        font-size: 0.58rem;
        line-height: 1.5;
    }

    /* Actions */

    .car-create-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 27px;
        padding-top: 22px;
        border-top: 1px solid var(--car-create-border);
    }

    .car-create-button {
        min-height: 45px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 10px 17px;
        border-radius: 11px;
        font-size: 0.67rem;
        font-weight: 900;
        text-decoration: none;
        transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

        .car-create-button:hover {
            transform: translateY(-2px);
        }

    .car-create-button-cancel {
        color: #626871;
        background-color: #ffffff;
        border: 1px solid var(--car-create-border);
    }

        .car-create-button-cancel:hover {
            color: var(--car-create-primary);
            background-color: #f6f7f8;
            border-color: #cfd2d7;
        }

    .car-create-button-submit {
        color: var(--car-create-primary);
        background-color: var(--car-create-accent);
        border: 1px solid var(--car-create-accent);
        box-shadow: 0 11px 26px rgba(245, 184, 0, 0.19);
    }

        .car-create-button-submit:hover {
            color: var(--car-create-primary);
            background-color: var(--car-create-accent-hover);
            border-color: var(--car-create-accent-hover);
            box-shadow: 0 15px 31px rgba(245, 184, 0, 0.26);
        }

    /* Responsive */

    @@media (max-width: 767.98px) {
        .car-create-page {
            padding-top: 22px;
        }

        .car-create-container {
            padding-right: 13px;
            padding-left: 13px;
        }

        .car-create-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 24px 21px;
            border-radius: 20px;
        }

            .car-create-hero::after {
                display: none;
            }

        .car-create-hero-icon {
            display: none;
        }

        .car-create-card {
            border-radius: 20px;
        }

        .car-create-card-header {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .car-create-form-body {
            padding: 20px;
        }

        .car-create-actions {
            align-items: stretch;
            flex-direction: column-reverse;
        }

        .car-create-button {
            width: 100%;
        }
    }

    @@media (max-width: 575.98px) {
        .car-create-title {
            font-size: 1.52rem;
        }

        .car-create-description {
            font-size: 0.74rem;
        }

        .car-form-section-heading {
            align-items: flex-start;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .car-create-breadcrumb a,
        .car-form-control,
        .car-form-select,
        .car-form-textarea,
        .car-create-button {
            transition: none;
        }

            .car-create-button:hover {
                transform: none;
            }
    }
</style>

<main class="car-create-page">
    <div class="car-create-container">

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb"
             class="car-create-breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-action="Index">
                        Quản lý xe
                    </a>
                </li>

                <li class="breadcrumb-item active"
                    aria-current="page">
                    Thêm xe mới
                </li>
            </ol>
        </nav>

        <!-- Hero -->
        <header class="car-create-hero">
            <div class="car-create-hero-content">
                <div class="car-create-eyebrow">
                    Vehicle management
                </div>

                <h1 class="car-create-title">
                    <i class="bi bi-car-front-fill"></i>
                    Thêm xe mới
                </h1>

                <p class="car-create-description">
                    Nhập đầy đủ thông tin cơ bản, thông số vận hành, giá bán
                    và trạng thái để đưa xe vào hệ thống quản lý showroom.
                </p>
            </div>

            <div class="car-create-hero-icon">
                <i class="bi bi-plus-lg"></i>
            </div>
        </header>

        <!-- Form -->
        <section class="car-create-card">
            <div class="car-create-card-header">
                <div>
                    <h2>Thông tin xe</h2>

                    <p>
                        Các trường có dấu sao là thông tin bắt buộc trước khi lưu.
                    </p>
                </div>

                <span class="car-create-required-note">
                    <i class="bi bi-asterisk"></i>
                    Trường bắt buộc
                </span>
            </div>

            <div class="car-create-form-body">
                <form asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="car-create-validation"
                             role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>

                            <div asp-validation-summary="ModelOnly"></div>
                        </div>
                    }

                    <!-- Basic information -->
                    <section class="car-form-section">
                        <div class="car-form-section-heading">
                            <div class="car-form-section-icon">
                                <i class="bi bi-info-circle-fill"></i>
                            </div>

                            <div>
                                <h3>Thông tin cơ bản</h3>

                                <p>
                                    Tên xe, thương hiệu, model, năm sản xuất và màu sắc.
                                </p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="CarName"
                                       class="car-form-label car-form-label-required">
                                    Tên xe
                                </label>

                                <div class="car-input-wrapper">
                                    <i class="bi bi-car-front car-input-icon"></i>

                                    <input asp-for="CarName"
                                           class="car-form-control"
                                           placeholder="VD: Toyota Camry 2.5Q"
                                           required />
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="BrandId"
                                       class="car-form-label car-form-label-required">
                                    Thương hiệu
                                </label>

                                <div class="car-input-wrapper">
                                    <i class="bi bi-award-fill car-input-icon"></i>

                                    <select asp-for="BrandId"
                                            class="car-form-select"
                                            required>
                                        <option value="">
                                            -- Chọn hãng --
                                        </option>

                                        @foreach (var b in brands)
                                        {
                                            <option value="@b.BrandId">
                                                @b.BrandName
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Model"
                                       class="car-form-label">
                                    Model
                                </label>

                                <div class="car-input-wrapper">
                                    <i class="bi bi-grid-fill car-input-icon"></i>

                                    <input asp-for="Model"
                                           class="car-form-control"
                                           placeholder="VD: Camry" />
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Year"
                                       class="car-form-label car-form-label-required">
                                    Năm sản xuất
                                </label>

                                <div class="car-input-wrapper">
                                    <i class="bi bi-calendar-event car-input-icon"></i>

                                    <input asp-for="Year"
                                           type="number"
                                           class="car-form-control"
                                           min="1990"
                                           max="2030"
                                           required />
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Color"
                                       class="car-form-label">
                                    Màu sắc
                                </label>

                                <div class="car-input-wrapper">
                                    <i class="bi bi-palette-fill car-input-icon"></i>

                                    <input asp-for="Color"
                                           class="car-form-control"
                                           placeholder="VD: Trắng ngọc trai" />
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Technical information -->
                    <section class="car-form-section">
                        <div class="car-form-section-heading">
                            <div class="car-form-section-icon">
                                <i class="bi bi-speedometer2"></i>
                            </div>

                            <div>
                                <h3>Thông số vận hành</h3>

                                <p>
                                    Loại nhiên liệu, hộp số và số kilomet đã sử dụng.
                                </p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="FuelType"
                                       class="car-form-label car-form-label-required">
                                    Nhiên liệu
                                </label>

                                <div class="car-input-wrapper">
                                    <i class="bi bi-fuel-pump-fill car-input-icon"></i>

                                    <select asp-for="FuelType"
                                            class="car-form-select"
                                            required>
                                        <option value="Gasoline">
                                            Xăng
                                        </option>

                                        <option value="Diesel">
                                            Dầu diesel
                                        </option>

                                        <option value="Electric">
                                            Điện
                                        </option>

                                        <option value="Hybrid">
                                            Hybrid
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Transmission"
                                       class="car-form-label car-form-label-required">
                                    Hộp số
                                </label>

                                <div class="car-input-wrapper">
                                    <i class="bi bi-gear-wide-connected car-input-icon"></i>

                                    <select asp-for="Transmission"
                                            class="car-form-select"
                                            required>
                                        <option value="Automatic">
                                            Tự động
                                        </option>

                                        <option value="Manual">
                                            Số sàn
                                        </option>

                                        <option value="CVT">
                                            CVT
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Mileage"
                                       class="car-form-label car-form-label-required">
                                    Số km đã đi
                                </label>

                                <div class="car-input-wrapper">
                                    <i class="bi bi-signpost-2-fill car-input-icon"></i>

                                    <input asp-for="Mileage"
                                           type="number"
                                           class="car-form-control"
                                           min="0"
                                           required />
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Sales information -->
                    <section class="car-form-section">
                        <div class="car-form-section-heading">
                            <div class="car-form-section-icon">
                                <i class="bi bi-cash-coin"></i>
                            </div>

                            <div>
                                <h3>Thông tin kinh doanh</h3>

                                <p>
                                    Giá bán, trạng thái hiển thị, hình ảnh và mô tả xe.
                                </p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Price"
                                       class="car-form-label car-form-label-required">
                                    Giá bán (VNĐ)
                                </label>

                                <div class="car-input-wrapper">
                                    <i class="bi bi-currency-dollar car-input-icon"></i>

                                    <input asp-for="Price"
                                           type="number"
                                           class="car-form-control"
                                           min="0"
                                           step="1000000"
                                           required />
                                </div>

                                <span class="car-form-help">
                                    Giá được nhập theo đơn vị Việt Nam đồng.
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Status"
                                       class="car-form-label car-form-label-required">
                                    Trạng thái
                                </label>

                                <div class="car-input-wrapper">
                                    <i class="bi bi-toggle-on car-input-icon"></i>

                                    <select asp-for="Status"
                                            class="car-form-select"
                                            required>
                                        <option value="Available">
                                            Có sẵn
                                        </option>

                                        <option value="Reserved">
                                            Đang đặt cọc
                                        </option>

                                        <option value="Sold">
                                            Đã bán
                                        </option>

                                        <option value="Inactive">
                                            Ẩn
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="ImageUrl"
                                       class="car-form-label">
                                    URL ảnh
                                </label>

                                <div class="car-input-wrapper">
                                    <i class="bi bi-image-fill car-input-icon"></i>

                                    <input asp-for="ImageUrl"
                                           class="car-form-control"
                                           placeholder="https://..." />
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description"
                                       class="car-form-label">
                                    Mô tả
                                </label>

                                <textarea asp-for="Description"
                                          class="car-form-textarea"
                                          rows="3"
                                          placeholder="Mô tả chi tiết về xe..."></textarea>
                            </div>
                        </div>
                    </section>

                    <!-- Actions -->
                    <div class="car-create-actions">
                        <a asp-action="Index"
                           class="car-create-button car-create-button-cancel">
                            <i class="bi bi-x-lg"></i>
                            Hủy
                        </a>

                        <button type="submit"
                                class="car-create-button car-create-button-submit">
                            <i class="bi bi-plus-circle-fill"></i>
                            Thêm xe
                        </button>
                    </div>
                </form>
            </div>
        </section>

    </div>
</main>
