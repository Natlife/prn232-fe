@model CarSalesManagementSystemClient.Models.InvoiceListItemViewModel

@{
    ViewData["Title"] = "Chi tiết hóa đơn " + Model.InvoiceNumber;

    string Money(decimal v) => v.ToString("N0") + " đ";

    string TypeLabel(string t) => t switch
    {
        "Car" => "Ô tô",
        "Part" => "Phụ tùng",
        "Service" => "Dịch vụ",
        "Combined" => "Gộp",
        _ => t
    };
}

<style>
    :root {
        --admin-invoice-primary: #17191e;
        --admin-invoice-secondary: #292c33;
        --admin-invoice-accent: #f5b800;
        --admin-invoice-accent-hover: #ffca28;
        --admin-invoice-bg: #f3f4f6;
        --admin-invoice-surface: #ffffff;
        --admin-invoice-border: #e5e7eb;
        --admin-invoice-text: #181a1f;
        --admin-invoice-muted: #747983;
        --admin-invoice-danger: #dc3545;
        --admin-invoice-success: #198754;
        --admin-invoice-info: #0f6f9f;
        --admin-invoice-radius-xl: 24px;
        --admin-invoice-radius-lg: 17px;
        --admin-invoice-radius-md: 12px;
        --admin-invoice-shadow: 0 18px 48px rgba(17, 19, 24, 0.08);
        --admin-invoice-shadow-soft: 0 10px 28px rgba(17, 19, 24, 0.055);
    }

    .admin-invoice-page {
        min-height: 100vh;
        padding: 32px 0 70px;
        color: var(--admin-invoice-text);
        background: radial-gradient( circle at 96% 2%, rgba(245, 184, 0, 0.11), transparent 31rem ), radial-gradient( circle at 3% 88%, rgba(17, 19, 24, 0.035), transparent 30rem ), var(--admin-invoice-bg);
    }

    .admin-invoice-container {
        width: 100%;
        max-width: 1040px;
        margin: 0 auto;
        padding-right: 24px;
        padding-left: 24px;
    }

    /* Breadcrumb */

    .admin-invoice-breadcrumb {
        margin-bottom: 18px;
    }

        .admin-invoice-breadcrumb .breadcrumb {
            margin: 0;
            padding: 11px 14px;
            background-color: var(--admin-invoice-surface);
            border: 1px solid var(--admin-invoice-border);
            border-radius: 12px;
            box-shadow: var(--admin-invoice-shadow-soft);
        }

        .admin-invoice-breadcrumb .breadcrumb-item {
            color: #8f949c;
            font-size: 0.7rem;
            font-weight: 800;
        }

            .admin-invoice-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
                color: #b5b9c0;
            }

        .admin-invoice-breadcrumb a {
            color: #5f646d !important;
            text-decoration: none;
            transition: color 0.2s ease;
        }

            .admin-invoice-breadcrumb a:hover {
                color: #8a6800 !important;
            }

        .admin-invoice-breadcrumb .active {
            color: #8a6800 !important;
            font-family: monospace;
            font-weight: 900 !important;
        }

    /* Alert */

    .admin-invoice-alert {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 18px;
        padding: 14px 16px;
        border: 1px solid transparent;
        border-radius: 14px;
        box-shadow: var(--admin-invoice-shadow-soft);
        font-size: 0.76rem;
        line-height: 1.6;
    }

        .admin-invoice-alert i {
            flex: 0 0 auto;
            margin-top: 2px;
        }

    .admin-invoice-alert-success {
        color: #166534;
        background-color: #effbf4;
        border-color: #bbf7d0;
    }

    .admin-invoice-alert-danger {
        color: #991b1b;
        background-color: #fff2f3;
        border-color: #fecaca;
    }

    /* Hero */

    .admin-invoice-hero {
        position: relative;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 26px;
        margin-bottom: 20px;
        padding: 29px 31px;
        color: #ffffff;
        background: radial-gradient( circle at 89% 10%, rgba(245, 184, 0, 0.2), transparent 32% ), linear-gradient( 135deg, var(--admin-invoice-primary), var(--admin-invoice-secondary) );
        border: 1px solid rgba(255, 255, 255, 0.055);
        border-radius: var(--admin-invoice-radius-xl);
        box-shadow: 0 22px 54px rgba(17, 19, 24, 0.17);
        overflow: hidden;
    }

        .admin-invoice-hero::after {
            content: "INVOICE";
            position: absolute;
            top: -37px;
            right: 22px;
            color: rgba(255, 255, 255, 0.035);
            font-size: clamp(5rem, 11vw, 8.4rem);
            font-weight: 900;
            line-height: 1;
            letter-spacing: -0.08em;
            pointer-events: none;
        }

    .admin-invoice-hero-content,
    .admin-invoice-hero-icon {
        position: relative;
        z-index: 2;
    }

    .admin-invoice-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 9px;
        color: var(--admin-invoice-accent);
        font-size: 0.64rem;
        font-weight: 900;
        letter-spacing: 0.17em;
        text-transform: uppercase;
    }

        .admin-invoice-eyebrow::before {
            content: "";
            width: 29px;
            height: 2px;
            background-color: var(--admin-invoice-accent);
        }

    .admin-invoice-title {
        margin: 0 0 8px;
        color: #ffffff;
        font-size: clamp(1.75rem, 3vw, 2.45rem);
        font-weight: 950;
        line-height: 1.13;
        letter-spacing: -0.045em;
    }

    .admin-invoice-description {
        max-width: 640px;
        margin: 0;
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.8rem;
        line-height: 1.65;
    }

    .admin-invoice-hero-icon {
        width: 66px;
        height: 66px;
        display: grid;
        flex: 0 0 auto;
        place-items: center;
        color: var(--admin-invoice-primary);
        background-color: var(--admin-invoice-accent);
        border-radius: 19px;
        font-size: 1.6rem;
        box-shadow: 0 14px 32px rgba(245, 184, 0, 0.22);
        transform: rotate(-4deg);
    }

    /* Cards */

    .admin-invoice-card {
        overflow: hidden;
        margin-bottom: 20px;
        background-color: var(--admin-invoice-surface);
        border: 1px solid var(--admin-invoice-border);
        border-radius: var(--admin-invoice-radius-xl);
        box-shadow: var(--admin-invoice-shadow);
    }

    .admin-invoice-summary-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        padding: 23px 25px;
        background: linear-gradient( 135deg, #ffffff, #fafafa );
        border-bottom: 1px solid var(--admin-invoice-border);
    }

    .admin-invoice-number-label {
        display: block;
        margin-bottom: 5px;
        color: #92969e;
        font-size: 0.6rem;
        font-weight: 900;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .admin-invoice-number {
        margin-bottom: 7px;
        color: var(--admin-invoice-primary);
        font-family: monospace;
        font-size: 1.22rem;
        font-weight: 900;
        letter-spacing: 0.045em;
    }

    .admin-invoice-customer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
        margin-bottom: 12px;
        color: var(--admin-invoice-muted);
        font-size: 0.7rem;
    }

        .admin-invoice-customer i {
            color: #8a6800;
        }

        .admin-invoice-customer strong {
            color: var(--admin-invoice-primary);
            font-weight: 900;
        }

    .admin-invoice-badge-row {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
    }

    .admin-invoice-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 10px;
        border: 1px solid transparent;
        border-radius: 999px;
        font-size: 0.61rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .admin-invoice-type-badge {
        color: #555b64;
        background-color: #f1f2f4;
        border-color: #dfe1e5;
    }

    .admin-invoice-purchase-badge {
        color: #ffffff;
        background-color: var(--admin-invoice-primary);
        border-color: var(--admin-invoice-primary);
    }

    .admin-invoice-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 11px;
        border: 1px solid transparent;
        border-radius: 999px;
        font-size: 0.64rem;
        font-weight: 900;
        white-space: nowrap;
    }

        .admin-invoice-status::before {
            content: "";
            width: 7px;
            height: 7px;
            background-color: currentColor;
            border-radius: 50%;
        }

    .admin-invoice-status-cancelled {
        color: #991b1b;
        background-color: #fee2e2;
        border-color: #fecaca;
    }

    .admin-invoice-status-paid {
        color: #166534;
        background-color: #dcfce7;
        border-color: #bbf7d0;
    }

    .admin-invoice-status-deposited {
        color: #075985;
        background-color: #e0f2fe;
        border-color: #bae6fd;
    }

    .admin-invoice-status-pending {
        color: #805f00;
        background-color: #fff8d6;
        border-color: #fde68a;
    }

    .admin-invoice-card-body {
        padding: 25px;
    }

    /* Section title */

    .admin-invoice-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 16px;
        color: var(--admin-invoice-primary);
        font-size: 0.76rem;
        font-weight: 950;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .admin-invoice-section-icon {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        color: #8a6800;
        background-color: #fff8d6;
        border: 1px solid #fde68a;
        border-radius: 10px;
        font-size: 0.8rem;
    }

    /* Invoice lines */

    .admin-invoice-lines {
        overflow: hidden;
        margin: 0 0 22px;
        padding: 0;
        border: 1px solid var(--admin-invoice-border);
        border-radius: 14px;
        list-style: none;
    }

    .admin-invoice-line {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 14px 16px;
        background-color: #ffffff;
        border-bottom: 1px solid #edf0f3;
        transition: background-color 0.16s ease;
    }

        .admin-invoice-line:last-child {
            border-bottom: 0;
        }

        .admin-invoice-line:hover {
            background-color: #fffdf6;
        }

    .admin-invoice-line-main {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 9px;
    }

    .admin-invoice-line-badge {
        flex: 0 0 auto;
        display: inline-flex;
        padding: 6px 9px;
        border: 1px solid transparent;
        border-radius: 999px;
        font-size: 0.58rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .admin-invoice-line-car {
        color: #805f00;
        background-color: #fff8d6;
        border-color: #fde68a;
    }

    .admin-invoice-line-part {
        color: #555b64;
        background-color: #f1f2f4;
        border-color: #dfe1e5;
    }

    .admin-invoice-line-service {
        color: #075985;
        background-color: #e0f2fe;
        border-color: #bae6fd;
    }

    .admin-invoice-line-description {
        color: #50565f;
        font-size: 0.72rem;
        font-weight: 700;
        line-height: 1.5;
    }

    .admin-invoice-line-amount {
        flex: 0 0 auto;
        color: var(--admin-invoice-primary);
        font-size: 0.73rem;
        font-weight: 900;
        white-space: nowrap;
    }

    /* Totals */

    .admin-invoice-total-layout {
        display: flex;
        justify-content: flex-end;
    }

    .admin-invoice-total-card {
        width: 100%;
        max-width: 450px;
        padding: 19px;
        background-color: #f8f9fa;
        border: 1px solid var(--admin-invoice-border);
        border-radius: 15px;
    }

    .admin-invoice-total-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 9px;
        color: #656b74;
        font-size: 0.7rem;
    }

        .admin-invoice-total-row:last-child {
            margin-bottom: 0;
        }

        .admin-invoice-total-row span:last-child {
            color: var(--admin-invoice-primary);
            font-weight: 800;
            text-align: right;
        }

    .admin-invoice-grand-total {
        margin: 14px 0 11px;
        padding-top: 14px;
        color: var(--admin-invoice-primary);
        border-top: 1px solid #dfe2e6;
        font-size: 0.88rem;
        font-weight: 950;
    }

        .admin-invoice-grand-total span:last-child {
            color: #b42318;
            font-size: 1.08rem;
        }

    .admin-invoice-deposit-summary {
        margin-top: 11px;
        padding-top: 11px;
        border-top: 1px dashed #d9dce1;
    }

    .admin-invoice-paid-value {
        color: var(--admin-invoice-success) !important;
    }

    .admin-invoice-remaining-value {
        color: var(--admin-invoice-danger) !important;
    }

    /* Captcha section */

    .admin-captcha-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        padding: 22px 25px;
        color: #ffffff;
        background: radial-gradient( circle at 90% 10%, rgba(245, 184, 0, 0.16), transparent 34% ), linear-gradient( 135deg, var(--admin-invoice-primary), var(--admin-invoice-secondary) );
    }

        .admin-captcha-header h2 {
            margin: 0 0 4px;
            color: #ffffff;
            font-size: 0.95rem;
            font-weight: 950;
        }

        .admin-captcha-header p {
            margin: 0;
            color: rgba(255, 255, 255, 0.56);
            font-size: 0.67rem;
        }

    .admin-captcha-header-icon {
        width: 42px;
        height: 42px;
        display: grid;
        flex: 0 0 auto;
        place-items: center;
        color: var(--admin-invoice-primary);
        background-color: var(--admin-invoice-accent);
        border-radius: 12px;
        font-size: 1rem;
    }

    .admin-captcha-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 15px;
    }

    .admin-captcha-box {
        height: 100%;
        padding: 18px;
        background-color: #f8f9fa;
        border: 1px solid var(--admin-invoice-border);
        border-radius: 15px;
    }

    .admin-captcha-box-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 11px;
    }

    .admin-captcha-box-label {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #555b64;
        font-size: 0.68rem;
        font-weight: 900;
    }

        .admin-captcha-box-label i {
            color: #8a6800;
        }

    .admin-captcha-code {
        min-height: 54px;
        display: flex;
        align-items: center;
        margin-bottom: 13px;
        padding: 11px 14px;
        color: var(--admin-invoice-primary);
        background-color: #ffffff;
        border: 1px dashed #cfd2d7;
        border-radius: 12px;
        font-family: monospace;
        font-size: 1rem;
        font-weight: 950;
        letter-spacing: 0.14em;
        overflow-wrap: anywhere;
    }

    .admin-captcha-code-deposit {
        color: #805f00;
    }

    .admin-captcha-code-final {
        color: #166534;
    }

    .admin-captcha-used {
        display: inline-flex;
        align-items: center;
        padding: 5px 8px;
        color: #626871;
        background-color: #f1f2f4;
        border: 1px solid #dfe1e5;
        border-radius: 999px;
        font-family: inherit;
        font-size: 0.57rem;
        font-weight: 900;
        letter-spacing: 0;
    }

    .admin-captcha-button {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 13px;
        border-radius: 10px;
        font-size: 0.64rem;
        font-weight: 900;
        transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

        .admin-captcha-button:hover {
            transform: translateY(-2px);
        }

    .admin-captcha-button-deposit {
        color: var(--admin-invoice-primary);
        background-color: var(--admin-invoice-accent);
        border: 1px solid var(--admin-invoice-accent);
        box-shadow: 0 10px 23px rgba(245, 184, 0, 0.17);
    }

        .admin-captcha-button-deposit:hover {
            color: var(--admin-invoice-primary);
            background-color: var(--admin-invoice-accent-hover);
            border-color: var(--admin-invoice-accent-hover);
        }

    .admin-captcha-button-final {
        color: #ffffff;
        background-color: var(--admin-invoice-success);
        border: 1px solid var(--admin-invoice-success);
        box-shadow: 0 10px 23px rgba(25, 135, 84, 0.16);
    }

        .admin-captcha-button-final:hover {
            color: #ffffff;
            background-color: #157347;
            border-color: #157347;
        }

    .admin-captcha-note {
        display: flex;
        align-items: flex-start;
        gap: 7px;
        margin-top: 11px;
        color: var(--admin-invoice-muted);
        font-size: 0.64rem;
        line-height: 1.55;
    }

        .admin-captcha-note i {
            flex: 0 0 auto;
            margin-top: 2px;
            color: #8a6800;
        }

    /* Responsive */

    @@media (max-width: 767.98px) {
        .admin-invoice-page {
            padding-top: 22px;
        }

        .admin-invoice-container {
            padding-right: 13px;
            padding-left: 13px;
        }

        .admin-invoice-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 24px 21px;
            border-radius: 20px;
        }

            .admin-invoice-hero::after {
                display: none;
            }

        .admin-invoice-hero-icon {
            display: none;
        }

        .admin-invoice-card {
            border-radius: 20px;
        }

        .admin-invoice-summary-header {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        .admin-invoice-card-body {
            padding: 20px;
        }

        .admin-invoice-line {
            align-items: flex-start;
            flex-direction: column;
            gap: 9px;
        }

        .admin-invoice-line-main {
            align-items: flex-start;
        }

        .admin-invoice-line-amount {
            align-self: flex-end;
        }

        .admin-invoice-total-card {
            max-width: none;
        }

        .admin-captcha-header {
            padding: 20px;
        }

        .admin-captcha-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575.98px) {
        .admin-invoice-title {
            font-size: 1.55rem;
        }

        .admin-invoice-description {
            font-size: 0.74rem;
        }

        .admin-invoice-number {
            font-size: 1.05rem;
        }

        .admin-invoice-line-main {
            flex-direction: column;
        }

        .admin-invoice-grand-total {
            align-items: flex-start;
            flex-direction: column;
            gap: 5px;
        }

            .admin-invoice-grand-total span:last-child {
                text-align: left;
            }

        .admin-captcha-button {
            width: 100%;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .admin-invoice-line,
        .admin-captcha-button,
        .admin-invoice-breadcrumb a {
            transition: none;
        }

            .admin-captcha-button:hover {
                transform: none;
            }
    }
</style>

<main class="admin-invoice-page">
    <div class="admin-invoice-container">

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb"
             class="admin-invoice-breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-area="Admin"
                       asp-controller="Captchas"
                       asp-action="Index">
                        Hóa đơn & Captcha
                    </a>
                </li>

                <li class="breadcrumb-item active"
                    aria-current="page">
                    @Model.InvoiceNumber
                </li>
            </ol>
        </nav>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="admin-invoice-alert admin-invoice-alert-success"
                 role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="admin-invoice-alert admin-invoice-alert-danger"
                 role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }

        <!-- Hero -->
        <header class="admin-invoice-hero">
            <div class="admin-invoice-hero-content">
                <div class="admin-invoice-eyebrow">
                    Admin invoice management
                </div>

                <h1 class="admin-invoice-title">
                    Chi tiết hóa đơn
                </h1>

                <p class="admin-invoice-description">
                    Kiểm tra thông tin giao dịch, trạng thái thanh toán và quản lý
                    mã xác thực đặt cọc hoặc tất toán của khách hàng.
                </p>
            </div>

            <div class="admin-invoice-hero-icon">
                <i class="bi bi-receipt-cutoff"></i>
            </div>
        </header>

        <!-- Invoice details -->
        <section class="admin-invoice-card">
            <div class="admin-invoice-summary-header">
                <div>
                    <span class="admin-invoice-number-label">
                        Mã hóa đơn
                    </span>

                    <div class="admin-invoice-number">
                        @Model.InvoiceNumber
                    </div>

                    <div class="admin-invoice-customer">
                        <i class="bi bi-person-fill"></i>

                        <span>
                            Khách:
                            <strong>@Model.CustomerName</strong>
                        </span>

                        <span>•</span>

                        <span>
                            Lập @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </span>
                    </div>

                    <div class="admin-invoice-badge-row">
                        <span class="admin-invoice-badge admin-invoice-type-badge">
                            <i class="bi bi-tag-fill"></i>
                            @TypeLabel(Model.InvoiceType)
                        </span>

                        <span class="admin-invoice-badge admin-invoice-purchase-badge">
                            <i class="bi bi-cash-stack"></i>
                            @(Model.IsDeposit ? "Đặt cọc" : "Mua đứt")
                        </span>
                    </div>
                </div>

                <div>
                    @if (Model.IsCancelled)
                    {
                        <span class="admin-invoice-status admin-invoice-status-cancelled">
                            Đã hủy
                        </span>
                    }
                    else if (Model.IsPaid)
                    {
                        <span class="admin-invoice-status admin-invoice-status-paid">
                            Đã thanh toán
                        </span>
                    }
                    else if (Model.IsDeposited)
                    {
                        <span class="admin-invoice-status admin-invoice-status-deposited">
                            Đã cọc · còn @Money(Model.RemainingAmount)
                        </span>
                    }
                    else
                    {
                        <span class="admin-invoice-status admin-invoice-status-pending">
                            Chờ xác thực
                        </span>
                    }
                </div>
            </div>

            <div class="admin-invoice-card-body">
                <h2 class="admin-invoice-section-title">
                    <span class="admin-invoice-section-icon">
                        <i class="bi bi-list-check"></i>
                    </span>
                    Danh mục hóa đơn
                </h2>

                <ul class="admin-invoice-lines">
                    @foreach (var line in Model.Lines)
                    {
                        <li class="admin-invoice-line">
                            <div class="admin-invoice-line-main">
                                <span class="admin-invoice-line-badge @(line.ItemType == "Car"
                                                                        ? "admin-invoice-line-car"
                                                                        : line.ItemType == "Part"
                                                                            ? "admin-invoice-line-part"
                                                                            : "admin-invoice-line-service")">

                                    @TypeLabel(line.ItemType)
                                </span>

                                <span class="admin-invoice-line-description">
                                    @line.Description
                                </span>
                            </div>

                            <span class="admin-invoice-line-amount">
                                @Money(line.SubTotal)
                            </span>
                        </li>
                    }
                </ul>

                <div class="admin-invoice-total-layout">
                    <div class="admin-invoice-total-card">
                        <div class="admin-invoice-total-row">
                            <span>Tạm tính</span>
                            <span>@Money(Model.TotalSubTotal)</span>
                        </div>

                        <div class="admin-invoice-total-row">
                            <span>Chiết khấu</span>
                            <span>- @Money(Model.DiscountAmount)</span>
                        </div>

                        <div class="admin-invoice-total-row">
                            <span>Thuế</span>
                            <span>@Money(Model.TaxAmount)</span>
                        </div>

                        <div class="admin-invoice-total-row admin-invoice-grand-total">
                            <span>Tổng cộng</span>
                            <span>@Money(Model.TotalAmount)</span>
                        </div>

                        @if (Model.IsDeposit && Model.DepositAmount.HasValue)
                        {
                            <div class="admin-invoice-deposit-summary">
                                <div class="admin-invoice-total-row">
                                    <span>Tiền cọc</span>
                                    <span>@Money(Model.DepositAmount.Value)</span>
                                </div>

                                @if (Model.IsDeposited)
                                {
                                    <div class="admin-invoice-total-row">
                                        <span>Đã cọc</span>

                                        <span class="admin-invoice-paid-value">
                                            @Money(Model.DepositPaidAmount ?? 0)
                                        </span>
                                    </div>

                                    <div class="admin-invoice-total-row">
                                        <span>Còn phải trả</span>

                                        <span class="admin-invoice-remaining-value">
                                            @Money(Model.RemainingAmount)
                                        </span>
                                    </div>

                                    @if (Model.DepositExpiresAt.HasValue)
                                    {
                                        <div class="admin-invoice-total-row">
                                            <span>Giữ chỗ đến</span>

                                            <span>
                                                @Model.DepositExpiresAt.Value.ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- Captcha management -->
        <section class="admin-invoice-card">
            <div class="admin-captcha-header">
                <div>
                    <h2>Quản lý mã xác thực</h2>

                    <p>
                        Sinh mã tương ứng với giai đoạn thanh toán hiện tại của hóa đơn.
                    </p>
                </div>

                <div class="admin-captcha-header-icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
            </div>

            <div class="admin-invoice-card-body">
                <div class="admin-captcha-grid">

                    <!-- Deposit captcha -->
                    <article class="admin-captcha-box">
                        <div class="admin-captcha-box-header">
                            <div class="admin-captcha-box-label">
                                <i class="bi bi-cash-stack"></i>
                                Mã đặt cọc
                            </div>
                        </div>

                        <div class="admin-captcha-code admin-captcha-code-deposit justify-content-between">
                            <span class="font-monospace">
                                @(string.IsNullOrEmpty(Model.DepositCaptchaCode)
                                    ? "—"
                                    : Model.DepositCaptchaCode)
                            </span>

                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(Model.DepositCaptchaCode))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-dark btn-copy-captcha border py-1 px-2 fw-bold" data-code="@Model.DepositCaptchaCode" title="Sao chép mã cọc">
                                        <i class="bi bi-clipboard me-1"></i> Copy
                                    </button>
                                }

                                @if (Model.IsDepositCaptchaUsed)
                                {
                                    <span class="admin-captcha-used">
                                        Đã dùng
                                    </span>
                                }
                            </div>
                        </div>

                        @if (Model.IsDeposit
                            && !Model.IsDepositCaptchaUsed
                            && !Model.IsCancelled
                            && !Model.IsPaid)
                        {
                            <form asp-area="Admin"
                                  asp-controller="Captchas"
                                  asp-action="GenerateDeposit"
                                  method="post">

                                <input type="hidden"
                                       name="masterInvoiceId"
                                       value="@Model.MasterInvoiceId" />

                                <button type="submit"
                                        class="admin-captcha-button admin-captcha-button-deposit">
                                    <i class="bi bi-cash-stack"></i>
                                    Sinh mã đặt cọc
                                </button>
                            </form>
                        }
                    </article>

                    <!-- Final captcha -->
                    <article class="admin-captcha-box">
                        <div class="admin-captcha-box-header">
                            <div class="admin-captcha-box-label">
                                <i class="bi bi-check2-circle"></i>
                                Mã tất toán / mua đứt
                            </div>
                        </div>

                        <div class="admin-captcha-code admin-captcha-code-final justify-content-between">
                            <span class="font-monospace">
                                @(string.IsNullOrEmpty(Model.FinalCaptchaCode)
                                    ? "—"
                                    : Model.FinalCaptchaCode)
                            </span>

                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(Model.FinalCaptchaCode))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-dark btn-copy-captcha border py-1 px-2 fw-bold" data-code="@Model.FinalCaptchaCode" title="Sao chép mã tất toán">
                                        <i class="bi bi-clipboard me-1"></i> Copy
                                    </button>
                                }

                                @if (Model.IsFinalCaptchaUsed)
                                {
                                    <span class="admin-captcha-used">
                                        Đã dùng
                                    </span>
                                }
                            </div>
                        </div>

                        @if (!Model.IsFinalCaptchaUsed
                            && !Model.IsCancelled
                            && !Model.IsPaid
                            && (!Model.IsDeposit || Model.IsDeposited))
                        {
                            <form asp-area="Admin"
                                  asp-controller="Captchas"
                                  asp-action="GenerateFinal"
                                  method="post">

                                <input type="hidden"
                                       name="masterInvoiceId"
                                       value="@Model.MasterInvoiceId" />

                                <button type="submit"
                                        class="admin-captcha-button admin-captcha-button-final">
                                    <i class="bi bi-check2-circle"></i>

                                    Sinh mã
                                    @(Model.IsDeposit
                                        ? "tất toán"
                                        : "mua đứt")
                                </button>
                            </form>
                        }
                        else if (Model.IsDeposit && !Model.IsDeposited)
                        {
                            <div class="admin-captcha-note">
                                <i class="bi bi-info-circle-fill"></i>

                                <span>
                                    Khách cần xác nhận đặt cọc trước.
                                </span>
                            </div>
                        }
                    </article>
                </div>
            </div>
        </section>

    </div>
</main>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-copy-captcha').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                const code = btn.getAttribute('data-code');
                if (!code) return;

                navigator.clipboard.writeText(code).then(function () {
                    const icon = btn.querySelector('i');
                    if (icon) {
                        icon.className = 'bi bi-check-lg text-success me-1';
                    }
                    if (window.Swal) {
                        const Toast = Swal.mixin({
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 2000,
                            timerProgressBar: true
                        });
                        Toast.fire({
                            icon: 'success',
                            title: 'Đã chép mã: ' + code
                        });
                    }
                }).catch(function () {
                    alert('Đã chép mã: ' + code);
                });
            });
        });
    </script>
}
