@model List<CarSalesManagementSystemClient.Models.InvoiceListItemViewModel>
@{
    ViewData["Title"] = "Quản lý hóa đơn & sinh mã captcha";
    string Money(decimal v) => v.ToString("N0") + " đ";
    string TypeLabel(string t) => t switch { "Car" => "Ô tô", "Part" => "Phụ tùng", "Service" => "Dịch vụ", "Combined" => "Gộp", _ => t };
}

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Cars" asp-action="Index" class="text-decoration-none text-dark">Admin</a></li>
            <li class="breadcrumb-item active text-warning fw-bold" aria-current="page">Hóa đơn & Captcha</li>
        </ol>
    </nav>

    <h3 class="fw-bold mb-3"><i class="bi bi-shield-lock me-2 text-warning"></i>Hóa đơn tổng — Sinh mã xác thực</h3>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="alert alert-info small">
        <i class="bi bi-info-circle-fill me-1"></i>
        Sinh mã <strong>Đặt cọc</strong> hoặc <strong>Mua đứt / Tất toán</strong> cho hóa đơn, rồi đọc mã cho khách để khách nhập xác thực ở trang "Hóa đơn của tôi".
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5"><i class="bi bi-inbox display-5 d-block mb-2"></i>Chưa có hóa đơn nào.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle bg-white shadow-sm rounded-3 overflow-hidden">
                <thead class="table-dark">
                    <tr>
                        <th>Số HĐ</th>
                        <th>Khách</th>
                        <th>Loại</th>
                        <th>Hình thức</th>
                        <th class="text-end">Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Mã hiện có</th>
                        <th class="text-center">Sinh mã</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model)
                    {
                        <tr>
                            <td class="font-monospace"><a asp-area="Admin" asp-controller="Captchas" asp-action="Details" asp-route-id="@inv.MasterInvoiceId" class="text-decoration-none fw-semibold">@inv.InvoiceNumber</a></td>
                            <td>@inv.CustomerName</td>
                            <td><span class="badge bg-secondary">@TypeLabel(inv.InvoiceType)</span></td>
                            <td>@(inv.IsDeposit ? "Đặt cọc" : "Mua đứt")</td>
                            <td class="text-end fw-bold">@Money(inv.TotalAmount)</td>
                            <td>
                                @if (inv.IsCancelled)
                                {
                                    <span class="badge bg-danger">Đã hủy</span>
                                }
                                else if (inv.IsPaid)
                                {
                                    <span class="badge bg-success">Đã thanh toán</span>
                                }
                                else if (inv.IsDeposited)
                                {
                                    <span class="badge bg-info text-dark">Đã cọc</span>
                                    <div class="small text-muted">Còn @Money(inv.RemainingAmount)</div>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Chờ xác thực</span>
                                }
                            </td>
                            <td class="small">
                                @if (!string.IsNullOrEmpty(inv.DepositCaptchaCode))
                                {
                                    <div>Cọc: <span class="font-monospace fw-bold text-primary">@inv.DepositCaptchaCode</span> @(inv.IsDepositCaptchaUsed ? "(đã dùng)" : "")</div>
                                }
                                @if (!string.IsNullOrEmpty(inv.FinalCaptchaCode))
                                {
                                    <div>Tất toán: <span class="font-monospace fw-bold text-success">@inv.FinalCaptchaCode</span> @(inv.IsFinalCaptchaUsed ? "(đã dùng)" : "")</div>
                                }
                            </td>
                            <td class="text-center">
                                @if (inv.IsCancelled || inv.IsPaid)
                                {
                                    <span class="text-muted small">—</span>
                                }
                                else if (inv.IsDeposit && !inv.IsDepositCaptchaUsed)
                                {
                                    <form asp-area="Admin" asp-controller="Captchas" asp-action="GenerateDeposit" method="post" class="d-inline">
                                        <input type="hidden" name="masterInvoiceId" value="@inv.MasterInvoiceId" />
                                        <button type="submit" class="btn btn-sm btn-warning fw-bold text-dark">
                                            <i class="bi bi-cash-stack"></i> Mã đặt cọc
                                        </button>
                                    </form>
                                }
                                else if (!inv.IsFinalCaptchaUsed)
                                {
                                    <form asp-area="Admin" asp-controller="Captchas" asp-action="GenerateFinal" method="post" class="d-inline">
                                        <input type="hidden" name="masterInvoiceId" value="@inv.MasterInvoiceId" />
                                        <button type="submit" class="btn btn-sm btn-success fw-bold">
                                            <i class="bi bi-check2-circle"></i> @(inv.IsDeposit ? "Mã tất toán" : "Mã mua đứt")
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
