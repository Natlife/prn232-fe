@model IEnumerable<CarSalesManagementSystemClient.Models.AppointmentHistoryViewModel>
@{
    ViewData["Title"] = "Quản lý Lịch hẹn";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0 text-gray-800">Danh sách Lịch hẹn Bảo dưỡng</h2>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4 py-3">Khách hàng</th>
                        <th class="py-3">Gói dịch vụ</th>
                        <th class="py-3">Thông tin Xe</th>
                        <th class="py-3">Lịch hẹn</th>
                        <th class="py-3">Trạng thái</th>
                        <th class="py-3 text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        if (item.CustomerCar != null && item.CustomerCar.Model == "N/A - Đơn phụ tùng")
                        {
                            continue;
                        }
                        <tr id="row-@item.AppointmentId">
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.CustomerName</div>
                                <div class="small text-muted"><i class="bi bi-telephone-fill me-1"></i>@item.CustomerPhone</div>
                            </td>
                            <td>
                                @if (item.Details != null && item.Details.Any())
                                {
                                    <ul class="list-unstyled mb-0 small">
                                        @foreach(var d in item.Details)
                                        {
                                            <li>- @(d.PackageId.HasValue ? d.PackageName : d.ServiceName)</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa chọn dịch vụ</span>
                                }

                                @if (item.ConsumedParts != null && item.ConsumedParts.Any(p => p.IsIncurred))
                                {
                                    <div class="mt-2 pt-2 border-top">
                                        <div class="fw-bold text-danger" style="font-size: 11px;">PHỤ TÙNG PHÁT SINH:</div>
                                        <ul class="list-unstyled mb-0 small mt-1">
                                            @foreach(var p in item.ConsumedParts.Where(x => x.IsIncurred))
                                            {
                                                <li class="text-danger d-flex align-items-center">
                                                    <span>- @p.PartName (SL: @p.Quantity)</span>
                                                    @if (item.Status == "Confirmed")
                                                    {
                                                        <button class="btn btn-sm btn-link text-danger p-0 ms-2" onclick="removeIncurredPart(@p.ConsumedPartId)" title="Hủy phụ tùng này">
                                                            <i class="bi bi-x-circle-fill"></i>
                                                        </button>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </td>
                            <td>
                                @if (item.CustomerCar != null)
                                {
                                    <div class="fw-bold">@item.CustomerCar.Model</div>
                                    <div class="small text-muted">Biển số: @item.CustomerCar.LicensePlate</div>
                                }
                            </td>
                            <td>
                                <div class="text-danger fw-bold">@item.AppointmentDate.ToString("dd/MM/yyyy")</div>
                                <div class="small text-muted"><i class="bi bi-clock me-1"></i>@item.AppointmentTime.ToString("HH:mm")</div>
                            </td>
                            <td id="status-@item.AppointmentId">
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Đang chờ</span>
                                }
                                else if (item.Status == "Confirmed")
                                {
                                    <span class="badge bg-info text-dark">Đã xác nhận</span>
                                }
                                else if (item.Status == "Completed")
                                {
                                    <span class="badge bg-success">Đã hoàn thành</span>
                                }
                                else if (item.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">Đã hủy</span>
                                    @if (!string.IsNullOrEmpty(item.Note) && item.Note.Contains("[Lý do hủy:"))
                                    {
                                        var reasonStart = item.Note.LastIndexOf("[Lý do hủy:") + 12;
                                        var reasonText = item.Note.Substring(reasonStart).Replace("]", "").Trim();
                                        <div class="mt-1 small text-danger fw-bold"><i class="bi bi-x-circle-fill me-1"></i>@reasonText</div>
                                    }
                                }
                            </td>
                            <td class="text-end pe-4" id="actions-@item.AppointmentId">
                                @{
                                    string displayNote = item.Note;
                                    bool hasRealNote = false;
                                    if (!string.IsNullOrWhiteSpace(displayNote))
                                    {
                                        displayNote = System.Text.RegularExpressions.Regex.Replace(displayNote, @"\[PhiPhatSinh:\s*\d+\]\n?", "").Trim();
                                        
                                        if (displayNote.Contains("[Lý do hủy:"))
                                        {
                                            int startIndex = displayNote.LastIndexOf("[Lý do hủy:");
                                            displayNote = displayNote.Substring(0, startIndex).Trim();
                                        }
                                        hasRealNote = !string.IsNullOrWhiteSpace(displayNote);
                                    }
                                }

                                @if (hasRealNote)
                                {
                                    <button class="btn btn-sm btn-warning me-1 shadow-sm" onclick="viewNote(this, '@item.CustomerName')" data-note="@displayNote" title="Xem ghi chú">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary me-1" onclick="viewNote(this, '@item.CustomerName')" data-note="Khách hàng không để lại ghi chú gì." title="Không có ghi chú">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                }
                                
                                @if (item.Status == "Pending")
                                {
                                    <button class="btn btn-sm btn-outline-info me-1" onclick="updateStatus(@item.AppointmentId, 'Confirmed')" title="Xác nhận">
                                        <i class="bi bi-check-circle"></i>
                                    </button>
                                }
                                @if (item.Status == "Confirmed")
                                {
                                    <button class="btn btn-sm btn-outline-primary me-1" onclick="reportIncurredPart(@item.AppointmentId, '@item.CustomerName')" title="Báo cáo phụ tùng phát sinh">
                                        <i class="bi bi-tools"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-success me-1" onclick="updateStatus(@item.AppointmentId, 'Completed')" title="Hoàn thành">
                                        <i class="bi bi-check2-all"></i>
                                    </button>
                                }
                                
                                @if (item.Status == "Pending" || item.Status == "Confirmed")
                                {
                                    <button class="btn btn-sm btn-outline-danger" onclick="cancelAppointment(@item.AppointmentId)" title="Từ chối/Hủy">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-4 mb-3">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)">Trước</a>
                    </li>
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link" href="?page=@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

<!-- Modal Báo Cáo Phụ Tùng Phát Sinh -->
<div class="modal fade" id="incurredPartModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title">Báo cáo phụ tùng phát sinh</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="incurredPartForm">
                    <input type="hidden" id="incurredAppointmentId" name="AppointmentId" />
                    <p>Khách hàng: <strong id="incurredCustomerName"></strong></p>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Phụ tùng <span class="text-danger">*</span></label>
                        <select class="form-select" id="incurredPartId" name="PartId" style="width: 100%;" required>
                            <option value="">-- Đang tải danh sách phụ tùng --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Số lượng <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="Quantity" min="1" value="1" required>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-muted">Ghi chú (Lý do thay thế)</label>
                        <textarea class="form-control" name="Notes" rows="2"></textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary shadow-sm" id="btnSaveIncurred">
                            <i class="bi bi-check2-circle me-1"></i> Báo cáo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        .select2-container .select2-selection--single {
            height: 38px;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 36px;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }
    </style>
    <script>
        $(document).ready(function() {
            // Khởi tạo select2
            $('#incurredPartId').select2({
                placeholder: "-- Chọn phụ tùng --",
                dropdownParent: $('#incurredPartModal'),
                allowClear: true
            });

            // Tải danh sách phụ tùng
            fetch('http://localhost:5084/odata/Parts?$filter=Status ne \'Inactive\'&$select=PartId,PartName,Price')
                .then(response => response.json())
                .then(data => {
                    const select = $('#incurredPartId');
                    select.empty();
                    select.append(new Option('-- Chọn phụ tùng --', '', true, true));
                    if (data && data.value) {
                        data.value.forEach(part => {
                            const optionText = `${part.PartName} - ${new Intl.NumberFormat('vi-VN').format(part.Price)} đ`;
                            select.append(new Option(optionText, part.PartId));
                        });
                    }
                })
                .catch(error => {
                    console.error('Error fetching parts:', error);
                    const select = $('#incurredPartId');
                    select.empty();
                    select.append(new Option('-- Lỗi khi tải phụ tùng --', ''));
                });
        });
        function viewNote(btn, name) {
            let note = $(btn).attr('data-note');
            Swal.fire({
                title: 'Ghi chú của ' + name,
                text: note,
                icon: 'info',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'Đóng'
            });
        }

        function updateStatus(id, newStatus) {
            let statusText = newStatus === 'Confirmed' ? 'Xác nhận' : 'Hoàn thành';
            let iconType = newStatus === 'Confirmed' ? 'question' : 'success';

            Swal.fire({
                title: 'Chuyển sang ' + statusText + '?',
                text: "Bạn có chắc chắn cập nhật lịch hẹn này không?",
                icon: iconType,
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    executeStatusUpdate(id, newStatus, null);
                }
            });
        }

        function cancelAppointment(id) {
            Swal.fire({
                title: 'Từ chối lịch hẹn',
                input: 'textarea',
                inputLabel: 'Lý do từ chối (Không bắt buộc)',
                inputPlaceholder: 'Nhập lý do khách hàng hủy hoặc cửa hàng từ chối...',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Xác nhận Hủy',
                cancelButtonText: 'Đóng'
            }).then((result) => {
                if (result.isConfirmed) {
                    executeStatusUpdate(id, 'Cancelled', result.value);
                }
            });
        }

        function executeStatusUpdate(id, status, reason) {
            $.ajax({
                url: '/Admin/MaintenanceAppointments/UpdateStatus',
                type: 'POST',
                data: {
                    id: id,
                    status: status,
                    reason: reason
                },
                success: function(res) {
                    if (res.success) {
                        Swal.fire('Thành công!', res.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Lỗi!', res.message, 'error');
                    }
                },
                error: function() {
                    Swal.fire('Lỗi!', 'Không thể kết nối đến máy chủ.', 'error');
                }
            });
        }

        const incurredModal = new bootstrap.Modal(document.getElementById('incurredPartModal'));

        function reportIncurredPart(appointmentId, customerName) {
            document.getElementById('incurredAppointmentId').value = appointmentId;
            document.getElementById('incurredCustomerName').innerText = customerName;
            document.getElementById('incurredPartForm').reset();
            incurredModal.show();
        }

        document.getElementById('incurredPartForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            const btn = document.getElementById('btnSaveIncurred');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang xử lý...';

            const payload = {
                AppointmentId: parseInt(form.AppointmentId.value),
                PartId: parseInt(form.PartId.value),
                Quantity: parseInt(form.Quantity.value),
                Notes: form.Notes.value
            };

            try {
                const formData = new FormData();
                formData.append('appointmentId', form.AppointmentId.value);
                formData.append('partId', form.PartId.value);
                formData.append('quantity', form.Quantity.value);
                formData.append('notes', form.Notes.value);

                const response = await fetch('/Admin/MaintenanceAppointments/ReportIncurredPart', {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                
                if (result.success) {
                    incurredModal.hide();
                    Swal.fire('Thành công!', result.message, 'success').then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire('Lỗi!', result.message || 'Lưu thất bại', 'error');
                }
            } catch (error) {
                Swal.fire('Lỗi!', 'Không thể kết nối máy chủ.', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Báo cáo';
            }
        });

        function removeIncurredPart(consumedPartId) {
            Swal.fire({
                title: 'Hủy phụ tùng này?',
                text: "Bạn có chắc chắn muốn hủy phụ tùng phát sinh này không?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý Hủy',
                cancelButtonText: 'Đóng'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Admin/MaintenanceAppointments/RemoveIncurredPart',
                        type: 'POST',
                        data: { consumedPartId: consumedPartId },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire('Thành công!', res.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Lỗi!', res.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Lỗi!', 'Không thể kết nối đến máy chủ.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
