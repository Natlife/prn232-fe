@model IEnumerable<CarSalesManagementSystemClient.Models.MaintenancePackageViewModel>

@{
    ViewData["Title"] = "Quản lý Gói Bảo dưỡng";
}

<style>
    :root {
        --package-admin-primary: #17191e;
        --package-admin-secondary: #292c33;
        --package-admin-accent: #f5b800;
        --package-admin-accent-hover: #ffca28;
        --package-admin-bg: #f3f4f6;
        --package-admin-surface: #ffffff;
        --package-admin-border: #e5e7eb;
        --package-admin-text: #181a1f;
        --package-admin-muted: #747983;
        --package-admin-danger: #dc3545;
        --package-admin-success: #198754;
        --package-admin-radius-xl: 24px;
        --package-admin-radius-lg: 17px;
        --package-admin-radius-md: 12px;
        --package-admin-shadow: 0 18px 48px rgba(17, 19, 24, 0.08);
        --package-admin-shadow-soft: 0 10px 28px rgba(17, 19, 24, 0.055);
    }

    .package-admin-page {
        min-height: 100vh;
        padding: 32px 0 72px;
        color: var(--package-admin-text);
        background: radial-gradient( circle at 96% 2%, rgba(245, 184, 0, 0.11), transparent 31rem ), radial-gradient( circle at 3% 88%, rgba(17, 19, 24, 0.035), transparent 30rem ), var(--package-admin-bg);
    }

    .package-admin-container {
        width: 100%;
        max-width: 1480px;
        margin: 0 auto;
        padding-right: 24px;
        padding-left: 24px;
    }

    /* Hero */

    .package-admin-hero {
        position: relative;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 28px;
        margin-bottom: 20px;
        padding: 30px 32px;
        color: #ffffff;
        background: radial-gradient( circle at 89% 10%, rgba(245, 184, 0, 0.2), transparent 32% ), linear-gradient( 135deg, var(--package-admin-primary), var(--package-admin-secondary) );
        border: 1px solid rgba(255, 255, 255, 0.055);
        border-radius: var(--package-admin-radius-xl);
        box-shadow: 0 22px 54px rgba(17, 19, 24, 0.17);
        overflow: hidden;
    }

        .package-admin-hero::after {
            content: "PACKAGES";
            position: absolute;
            top: -38px;
            right: 22px;
            color: rgba(255, 255, 255, 0.035);
            font-size: clamp(5rem, 11vw, 8.5rem);
            font-weight: 900;
            line-height: 1;
            letter-spacing: -0.08em;
            pointer-events: none;
        }

    .package-admin-hero-content,
    .package-admin-add-button {
        position: relative;
        z-index: 2;
    }

    .package-admin-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 9px;
        color: var(--package-admin-accent);
        font-size: 0.64rem;
        font-weight: 900;
        letter-spacing: 0.17em;
        text-transform: uppercase;
    }

        .package-admin-eyebrow::before {
            content: "";
            width: 29px;
            height: 2px;
            background-color: var(--package-admin-accent);
        }

    .package-admin-title {
        display: flex;
        align-items: center;
        gap: 11px;
        margin: 0 0 8px;
        color: #ffffff;
        font-size: clamp(1.8rem, 3vw, 2.5rem);
        font-weight: 950;
        line-height: 1.13;
        letter-spacing: -0.045em;
    }

        .package-admin-title i {
            color: var(--package-admin-accent);
        }

    .package-admin-description {
        max-width: 720px;
        margin: 0;
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.8rem;
        line-height: 1.68;
    }

    .package-admin-add-button {
        min-height: 45px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 10px 16px;
        color: var(--package-admin-primary);
        background-color: var(--package-admin-accent);
        border: 1px solid var(--package-admin-accent);
        border-radius: 11px;
        font-size: 0.67rem;
        font-weight: 900;
        white-space: nowrap;
        box-shadow: 0 11px 26px rgba(245, 184, 0, 0.2);
        transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

        .package-admin-add-button:hover {
            color: var(--package-admin-primary);
            background-color: var(--package-admin-accent-hover);
            border-color: var(--package-admin-accent-hover);
            transform: translateY(-2px);
            box-shadow: 0 15px 31px rgba(245, 184, 0, 0.27);
        }

    /* Card */

    .package-admin-card {
        overflow: hidden;
        background-color: var(--package-admin-surface);
        border: 1px solid var(--package-admin-border);
        border-radius: var(--package-admin-radius-xl);
        box-shadow: var(--package-admin-shadow);
    }

    .package-admin-card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        padding: 22px 24px;
        background: linear-gradient( 135deg, #ffffff, #fafafa );
        border-bottom: 1px solid var(--package-admin-border);
    }

        .package-admin-card-header h2 {
            display: flex;
            align-items: center;
            gap: 9px;
            margin: 0 0 4px;
            color: var(--package-admin-primary);
            font-size: 0.98rem;
            font-weight: 950;
        }

            .package-admin-card-header h2 i {
                color: #8a6800;
            }

        .package-admin-card-header p {
            margin: 0;
            color: var(--package-admin-muted);
            font-size: 0.67rem;
            line-height: 1.55;
        }

    .package-admin-count {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        color: #805f00;
        background-color: #fff8d6;
        border: 1px solid #fde68a;
        border-radius: 999px;
        font-size: 0.61rem;
        font-weight: 900;
        white-space: nowrap;
    }

    /* Table */

    .package-admin-table {
        min-width: 1120px;
        margin-bottom: 0;
    }

        .package-admin-table thead th {
            padding: 13px 15px;
            color: #777d86;
            background-color: #f8f9fa;
            border-bottom: 1px solid var(--package-admin-border);
            font-size: 0.57rem;
            font-weight: 900;
            letter-spacing: 0.055em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .package-admin-table tbody td {
            padding: 15px;
            color: #50565f;
            background-color: #ffffff;
            border-bottom: 1px solid #edf0f3;
            font-size: 0.67rem;
            vertical-align: middle;
        }

        .package-admin-table tbody tr {
            transition: background-color 0.16s ease;
        }

            .package-admin-table tbody tr:hover td {
                background-color: #fffdf6;
            }

            .package-admin-table tbody tr:last-child td {
                border-bottom: 0;
            }

    .package-admin-name {
        max-width: 235px;
        overflow: hidden;
        color: var(--package-admin-primary);
        font-size: 0.73rem;
        font-weight: 950;
        line-height: 1.45;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .package-admin-services {
        min-width: 210px;
        max-width: 310px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

        .package-admin-services li {
            position: relative;
            margin-bottom: 5px;
            padding-left: 13px;
            color: #676d76;
            font-size: 0.62rem;
            line-height: 1.45;
        }

            .package-admin-services li:last-child {
                margin-bottom: 0;
            }

            .package-admin-services li::before {
                content: "";
                position: absolute;
                top: 0.53em;
                left: 0;
                width: 5px;
                height: 5px;
                background-color: var(--package-admin-accent);
                border-radius: 50%;
            }

    .package-admin-no-service {
        color: #989da5;
        font-size: 0.61rem;
        font-style: italic;
    }

    .package-admin-price {
        color: #b42318;
        font-size: 0.72rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .package-admin-saving {
        color: #166534;
        font-size: 0.69rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .package-admin-duration {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #626871;
        white-space: nowrap;
    }

        .package-admin-duration i {
            color: #8a6800;
        }

    .package-admin-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border: 1px solid transparent;
        border-radius: 999px;
        font-size: 0.57rem;
        font-weight: 900;
        white-space: nowrap;
    }

        .package-admin-status::before {
            content: "";
            width: 7px;
            height: 7px;
            background-color: currentColor;
            border-radius: 50%;
        }

    .package-admin-status-available {
        color: #166534;
        background-color: #effbf4;
        border-color: #bbf7d0;
    }

    .package-admin-status-inactive {
        color: #626871;
        background-color: #f1f2f4;
        border-color: #dfe1e5;
    }

    /* Row actions */

    .package-admin-row-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 7px;
    }

    .package-admin-row-button {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border-radius: 9px;
        font-size: 0.72rem;
        transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

        .package-admin-row-button:hover {
            transform: translateY(-2px);
        }

    .package-admin-edit-button {
        color: #805f00;
        background-color: #fffdf6;
        border: 1px solid #e8cf7d;
    }

        .package-admin-edit-button:hover {
            color: var(--package-admin-primary);
            background-color: var(--package-admin-accent);
            border-color: var(--package-admin-accent);
            box-shadow: 0 9px 20px rgba(245, 184, 0, 0.17);
        }

    .package-admin-delete-button {
        color: #991b1b;
        background-color: #fff7f7;
        border: 1px solid #fecaca;
    }

        .package-admin-delete-button:hover {
            color: #ffffff;
            background-color: var(--package-admin-danger);
            border-color: var(--package-admin-danger);
            box-shadow: 0 9px 20px rgba(220, 53, 69, 0.16);
        }

    /* Pagination */

    .package-admin-pagination {
        gap: 6px;
        margin: 24px 0;
    }

        .package-admin-pagination .page-link {
            min-width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 8px 12px;
            color: #575d66;
            background-color: #ffffff;
            border: 1px solid var(--package-admin-border);
            border-radius: 10px !important;
            font-size: 0.65rem;
            font-weight: 900;
            box-shadow: 0 8px 20px rgba(17, 19, 24, 0.05);
        }

        .package-admin-pagination .page-item.active .page-link {
            color: var(--package-admin-primary);
            background-color: var(--package-admin-accent);
            border-color: var(--package-admin-accent);
        }

        .package-admin-pagination .page-item.disabled {
            opacity: 0.48;
        }

    /* Modal */

    #packageModal .modal-content {
        overflow: hidden;
        background-color: #ffffff;
        border: 0 !important;
        border-radius: 21px;
        box-shadow: 0 30px 80px rgba(17, 19, 24, 0.26) !important;
    }

    #packageModal .modal-header {
        padding: 20px 23px;
        color: #ffffff;
        background: radial-gradient( circle at 90% 10%, rgba(245, 184, 0, 0.18), transparent 34% ), linear-gradient( 135deg, var(--package-admin-primary), var(--package-admin-secondary) );
        border: 0;
    }

    #packageModal .modal-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #ffffff;
        font-size: 0.9rem;
        font-weight: 950 !important;
    }

        #packageModal .modal-title::before {
            content: "\F4CA";
            color: var(--package-admin-accent);
            font-family: "bootstrap-icons";
            font-size: 1rem;
        }

    #packageModal .btn-close {
        filter: invert(1) grayscale(1);
        opacity: 0.78;
    }

    #packageModal .modal-body {
        padding: 23px;
        background-color: #ffffff;
    }

    #packageModal .form-label {
        margin-bottom: 7px;
        color: #444951;
        font-size: 0.67rem;
        font-weight: 900 !important;
    }

    #packageModal .form-control,
    #packageModal .form-select {
        min-height: 45px;
        color: var(--package-admin-text);
        background-color: #f8f9fa;
        border: 1px solid var(--package-admin-border);
        border-radius: 11px;
        outline: none;
        font-size: 0.72rem;
        transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    #packageModal textarea.form-control {
        min-height: 100px;
        resize: vertical;
    }

    #packageModal .form-control:focus,
    #packageModal .form-select:focus {
        background-color: #ffffff;
        border-color: var(--package-admin-accent);
        box-shadow: 0 0 0 4px rgba(245, 184, 0, 0.13);
    }

    .package-service-selector {
        max-height: 220px;
        overflow-y: auto;
        padding: 7px;
        background-color: #f8f9fa;
        border: 1px solid var(--package-admin-border);
        border-radius: 13px;
        scrollbar-width: thin;
    }

    .package-service-option {
        margin: 0;
        padding: 10px 11px 10px 34px;
        background-color: #ffffff;
        border: 1px solid transparent;
        border-radius: 9px;
        transition: background-color 0.16s ease, border-color 0.16s ease;
    }

        .package-service-option + .package-service-option {
            margin-top: 6px;
        }

        .package-service-option:hover {
            background-color: #fffdf6;
            border-color: #fde68a;
        }

        .package-service-option .form-check-input {
            margin-left: -23px;
            border-color: #bfc3ca;
        }

            .package-service-option .form-check-input:checked {
                background-color: var(--package-admin-accent);
                border-color: var(--package-admin-accent);
            }

        .package-service-option .form-check-label {
            color: #4f555d;
            font-size: 0.66rem;
            font-weight: 800;
            line-height: 1.5;
        }

            .package-service-option .form-check-label span {
                color: #91969e !important;
                font-size: 0.58rem !important;
            }

    #packageModal .modal-footer {
        padding: 16px 23px;
        background-color: #f8f9fa !important;
        border-top: 1px solid var(--package-admin-border);
    }

        #packageModal .modal-footer .btn {
            min-height: 42px;
            padding: 9px 14px;
            border-radius: 10px;
            font-size: 0.65rem;
            font-weight: 900 !important;
        }

    #packageModal .btn-secondary {
        color: #626871;
        background-color: #ffffff;
        border-color: var(--package-admin-border);
    }

    #packageModal .btn-warning {
        color: var(--package-admin-primary);
        background-color: var(--package-admin-accent);
        border-color: var(--package-admin-accent);
    }

        #packageModal .btn-warning:hover {
            background-color: var(--package-admin-accent-hover);
            border-color: var(--package-admin-accent-hover);
        }

    /* Responsive */

    @@media (max-width: 991.98px) {
        .package-admin-hero {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @@media (max-width: 767.98px) {
        .package-admin-page {
            padding-top: 22px;
        }

        .package-admin-container {
            padding-right: 13px;
            padding-left: 13px;
        }

        .package-admin-hero {
            padding: 24px 21px;
            border-radius: 20px;
        }

            .package-admin-hero::after {
                display: none;
            }

        .package-admin-add-button {
            width: 100%;
        }

        .package-admin-card {
            border-radius: 20px;
        }

        .package-admin-card-header {
            align-items: flex-start;
            flex-direction: column;
            padding: 20px;
        }

        #packageModal .modal-body {
            padding: 19px;
        }
    }

    @@media (max-width: 575.98px) {
        .package-admin-title {
            font-size: 1.52rem;
        }

        .package-admin-description {
            font-size: 0.74rem;
        }

        #packageModal .modal-dialog {
            margin: 9px;
        }

        #packageModal .modal-footer {
            align-items: stretch;
            flex-direction: column-reverse;
        }

            #packageModal .modal-footer .btn {
                width: 100%;
                margin: 0;
            }
    }

    @@media (prefers-reduced-motion: reduce) {
        .package-admin-add-button,
        .package-admin-table tbody tr,
        .package-admin-row-button,
        .package-service-option {
            transition: none;
        }

            .package-admin-add-button:hover,
            .package-admin-row-button:hover {
                transform: none;
            }
    }
</style>

<main class="package-admin-page">
    <div class="package-admin-container">

        <!-- Hero -->
        <header class="package-admin-hero">
            <div class="package-admin-hero-content">
                <div class="package-admin-eyebrow">
                    Maintenance management
                </div>

                <h1 class="package-admin-title">
                    <i class="bi bi-tools"></i>
                    Quản lý Gói Bảo dưỡng
                </h1>

                <p class="package-admin-description">
                    Quản lý danh sách gói bảo dưỡng, dịch vụ đi kèm,
                    giá bán, mức tiết kiệm và trạng thái cung cấp.
                </p>
            </div>

            <button type="button"
                    class="package-admin-add-button"
                    onclick="openAddModal()">
                <i class="bi bi-plus-circle-fill"></i>
                Thêm Gói Mới
            </button>
        </header>

        <!-- Package list -->
        <section class="package-admin-card">
            <div class="package-admin-card-header">
                <div>
                    <h2>
                        <i class="bi bi-table"></i>
                        Danh sách Gói Bảo dưỡng
                    </h2>

                    <p>
                        Chỉnh sửa nội dung, dịch vụ và trạng thái của từng gói.
                    </p>
                </div>

                <span class="package-admin-count">
                    <i class="bi bi-collection-fill"></i>
                    @Model.Count() gói
                </span>
            </div>

            <div class="table-responsive">
                <table class="table package-admin-table">
                    <thead>
                        <tr>
                            <th class="ps-4">Tên Gói</th>
                            <th>Các Dịch vụ</th>
                            <th>Giá Gói (VNĐ)</th>
                            <th>Tiết kiệm</th>
                            <th>Thời gian (phút)</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr id="row-@item.PackageId">
                                <td class="ps-4">
                                    <div class="package-admin-name"
                                         title="@item.PackageName">
                                        @item.PackageName
                                    </div>
                                </td>

                                <td>
                                    @if (item.Services != null && item.Services.Any())
                                    {
                                        <ul class="package-admin-services">
                                            @foreach (var srv in item.Services)
                                            {
                                                <li>@srv.ServiceName</li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <span class="package-admin-no-service">
                                            Chưa có dịch vụ
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="package-admin-price">
                                        @item.PackagePrice.ToString("N0")
                                    </span>
                                </td>

                                <td>
                                    <span class="package-admin-saving">
                                        @item.SavingAmount.ToString("N0")
                                    </span>
                                </td>

                                <td>
                                    <span class="package-admin-duration">
                                        <i class="bi bi-clock-fill"></i>
                                        @item.TotalDurationMinutes p
                                    </span>
                                </td>

                                <td>
                                    @if (item.Status == "Available")
                                    {
                                        <span class="package-admin-status package-admin-status-available">
                                            Sẵn sàng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="package-admin-status package-admin-status-inactive">
                                            Ngừng CC
                                        </span>
                                    }
                                </td>

                                <td class="pe-4">
                                    <div class="package-admin-row-actions">
                                        <button type="button"
                                                class="package-admin-row-button package-admin-edit-button"
                                                onclick="openEditModal(@item.PackageId)"
                                                title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                        <button type="button"
                                                class="package-admin-row-button package-admin-delete-button"
                                                onclick="deletePackage(@item.PackageId)"
                                                title="Xóa">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center package-admin-pagination">
                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                               href="?page=@(ViewBag.CurrentPage - 1)">
                                Trước
                            </a>
                        </li>

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                                <a class="page-link"
                                   href="?page=@i">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               href="?page=@(ViewBag.CurrentPage + 1)">
                                Sau
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </section>

    </div>
</main>

<!-- Modal Form -->
<div class="modal fade"
     id="packageModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"
                    id="modalTitle">
                    Thêm Gói Bảo Dưỡng
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <form id="packageForm">
                <div class="modal-body">
                    <input type="hidden"
                           id="PackageId"
                           name="PackageId"
                           value="0" />

                    <div class="mb-3">
                        <label class="form-label">
                            Tên gói
                            <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               class="form-control"
                               id="PackageName"
                               name="PackageName"
                               required />
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">
                                Giá gói (VNĐ)
                                <span class="text-danger">*</span>
                            </label>

                            <input type="number"
                                   class="form-control"
                                   id="PackagePrice"
                                   name="PackagePrice"
                                   required
                                   min="0" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Các Dịch Vụ Có Trong Gói
                        </label>

                        <div class="package-service-selector">
                            @if (ViewBag.Services != null)
                            {
                                foreach (
                                    var srv
                                    in (List<CarSalesManagementSystemClient.Models.ServiceSummaryViewModel>)ViewBag.Services
                                )
                                {
                                    <div class="form-check package-service-option">
                                        <input class="form-check-input service-checkbox"
                                               type="checkbox"
                                               name="ServiceIds"
                                               value="@srv.ServiceId"
                                               id="srv_@srv.ServiceId" />

                                        <label class="form-check-label"
                                               for="srv_@srv.ServiceId">
                                            @srv.ServiceName

                                            <span class="text-muted small">
                                                (@srv.BasePrice.ToString("N0") VNĐ
                                                - @srv.EstimatedDurationMinutes p)
                                            </span>
                                        </label>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">
                                    Không có dữ liệu dịch vụ
                                </span>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Mô tả
                        </label>

                        <textarea class="form-control"
                                  id="Description"
                                  name="Description"
                                  rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Trạng thái
                        </label>

                        <select class="form-select"
                                id="Status"
                                name="Status">
                            <option value="Available">
                                Sẵn sàng
                            </option>

                            <option value="Inactive">
                                Ngừng cung cấp
                            </option>
                        </select>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Hủy
                    </button>

                    <button type="button"
                            class="btn btn-warning"
                            onclick="savePackage()">
                        <i class="bi bi-save-fill me-1"></i>
                        Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getPackageModal() {
            return bootstrap.Modal.getOrCreateInstance(document.getElementById('packageModal'));
        }

        const adminAlert = window.Swal || {
            fire: function(title, text, icon) {
                if (typeof title === 'object') {
                    return Promise.resolve({ isConfirmed: confirm(title.text || title.title || 'Xac nhan thao tac?') });
                }

                if (icon === 'warning') {
                    return Promise.resolve({ isConfirmed: confirm(text || title) });
                }

                alert(text || title);
                return Promise.resolve({ isConfirmed: true });
            }
        };

        function openAddModal() {
            $('#packageForm')[0].reset();
            $('#PackageId').val(0);
            $('#modalTitle').text('Them goi bao duong');
            getPackageModal().show();
        }

        function openEditModal(id) {
            $.ajax({
                url: '/Admin/MaintenancePackages/Get/' + id,
                type: 'GET',
                success: function(res) {
                    if (res.success) {
                        $('#PackageId').val(res.data.packageId);
                        $('#PackageName').val(res.data.packageName);
                        $('#PackagePrice').val(res.data.packagePrice);
                        $('#Description').val(res.data.description);
                        $('#Status').val(res.data.status);

                        // Check boxes
                        $('.service-checkbox').prop('checked', false);
                        if (res.data.serviceIds) {
                            res.data.serviceIds.forEach(function(id) {
                                $('#srv_' + id).prop('checked', true);
                            });
                        }

                        $('#modalTitle').text('Cap nhat goi bao duong');
                        getPackageModal().show();
                    } else {
                        adminAlert.fire('Loi!', res.message, 'error');
                    }
                },
                error: function(xhr) {
                    adminAlert.fire('Loi!', xhr.responseText || 'Khong the tai du lieu.', 'error');
                }
            });
        }

        function savePackage() {
            var form = $('#packageForm')[0];
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            $.ajax({
                url: '/Admin/MaintenancePackages/Save',
                type: 'POST',
                data: new FormData(form),
                processData: false,
                contentType: false,
                success: function(res) {
                    if (res.success) {
                        getPackageModal().hide();
                        adminAlert.fire('Thanh cong!', res.message, 'success').then(() => location.reload());
                    } else {
                        adminAlert.fire('That bai!', res.message, 'error');
                    }
                },
                error: function(xhr) {
                    adminAlert.fire('Loi!', xhr.responseText || 'Da xay ra loi khi luu du lieu.', 'error');
                }
            });
        }

        function deletePackage(id) {
            adminAlert.fire({
                title: 'Ban co chac chan?',
                text: 'Ban se khong the khoi phuc goi bao duong nay!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Dong y, xoa!',
                cancelButtonText: 'Huy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Admin/MaintenancePackages/Delete/' + id,
                        type: 'DELETE',
                        success: function(res) {
                            if (res.success) {
                                adminAlert.fire('Da xoa!', res.message, 'success').then(() => {
                                    $('#row-' + id).fadeOut();
                                });
                            } else {
                                adminAlert.fire('Loi!', res.message, 'error');
                            }
                        },
                        error: function(xhr) {
                            adminAlert.fire('Loi!', xhr.responseText || 'Khong the xoa do loi mang hoac may chu.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
